// quiz_view.fitz — el render del contrarreloj.
//
// Deriva el ejercicio actual desde (seed, idx, grade) — no lo guarda: la
// plantilla del componente es "tonta", llama a `quiz_screen(...)` con los
// campos de estado y esta capa arma el HTML. Todo texto pasa por `t()`; todo
// número por `fmt_int()` (reglas del proyecto).
//
// Los botones de opción llevan el valor CRUDO en `data-flv-value-v` (para que
// el server lo parsee) y el valor FORMATEADO como texto visible. El `ei`
// (índice del ejercicio) viaja también, para descartar taps viejos server-side.

from fitz_liveviews import Html, html, flv, h_join
from gen_arith import gen_mix, gen_for, op_symbol
from i18n import t, t1
from fmt import fmt_int, fmt_operando
from game_ui import resumen_estrellas

// Punto de entrada. `mode` decide la pantalla:
//   - "practice": práctica libre (sin reloj ni puntaje, tema+banda fijos).
//   - "desafio": Desafío del día (sin reloj, progreso X/N, mix adaptativo).
//   - "adaptive" / "timed" (contrarreloj): partida en curso o resumen final.
// Los `r_*` son el snapshot de mastery (ratings por operación); los usa la
// selección adaptativa (gen_for "adaptive"/"desafio"). En práctica se ignoran.
fn quiz_screen(seed: Int, idx: Int, grade: Int, locale: Str, score: Int, correct: Int, total: Int, time_left: Int, phase: Str, feedback: Str, last_answer: Int, topic: Str, band: Int, mode: Str, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float, limit: Int) -> Html {
    if (mode == "practice") {
        return quiz_practica(seed, idx, grade, locale, topic, band, correct, feedback, last_answer)
    }
    if (phase == "done") {
        return quiz_resumen(locale, score, correct, total, mode)
    }
    if (mode == "potencias") {
        return quiz_potencias(seed, idx, grade, locale, correct, total, limit, feedback, last_answer)
    }
    if (mode == "desafio") {
        return quiz_desafio(seed, idx, grade, locale, correct, total, limit, feedback, last_answer, r_add, r_sub, r_mul, r_div)
    }
    return quiz_jugando(mode, seed, idx, grade, locale, score, time_left, feedback, last_answer, r_add, r_sub, r_mul, r_div)
}

// Desafío del día: mismo ejercicio adaptativo que el contrarreloj, pero sin
// reloj — un progreso "X de N" en lugar del cronómetro. Termina al completar N
// (el componente marca phase="done" → quiz_resumen).
fn quiz_desafio(seed: Int, idx: Int, grade: Int, locale: Str, correct: Int, total: Int, limit: Int, feedback: Str, last_answer: Int, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Html {
    let ex = gen_for("desafio", "mix", 2, seed, idx, grade, r_add, r_sub, r_mul, r_div)
    let a = flv(fmt_operando(locale, ex.a))
    let b = flv(fmt_operando(locale, ex.b))
    let sym = flv(op_symbol(ex.op))
    let opciones = h_join(ex.options.map(fn(o) => opt_button(locale, o, idx)))
    let banner = feedback_banner(locale, feedback, last_answer, idx)
    let hecho = flv(fmt_int(locale, total))
    let de_lbl = flv(t(locale, "juego.de"))
    let de_total = flv(fmt_int(locale, limit))
    let vas_lbl = flv(t(locale, "juego.aciertos"))
    let co = flv(fmt_int(locale, correct))
    return html("""<div class="q-hud">
<div class="q-mode">🎯 {hecho} {de_lbl} {de_total}</div>
<div class="q-score">{vas_lbl}<span class="q-snum">{co}</span></div>
</div>
<div class="q-prompt">{a} {sym} {b}</div>
<div class="q-options">{opciones}</div>
<div class="q-fbwrap">{banner}</div>""")
}

// Prompt del juego "Potencias y raíces" (F7.1.b). No es `a op b`: la potencia es
// `base^exp` (base negativa entre paréntesis) y la raíz es unaria `√rad` / `∛rad`
// (b lleva el índice). Devuelve un Str; el caller lo pasa por flv.
fn prompt_potencia(locale: Str, a: Int, b: Int, op: Str) -> Str {
    if (op == "raiz") {
        let rad = fmt_int(locale, a)
        if (b == 3) {
            return "∛" + rad
        }
        return "√" + rad
    }
    if (op == "scinot") {
        // Notación científica: mantisa × 10^exponente.
        let mant = fmt_int(locale, a)
        let exp = fmt_int(locale, b)
        return mant + " × 10^" + exp
    }
    let base = fmt_operando(locale, a)
    let exp = fmt_int(locale, b)
    return base + "^" + exp
}

// Pantalla del juego "Potencias y raíces": misma estructura que el Desafío
// (progreso X/N, sin reloj), pero el prompt lo arma prompt_potencia. No es
// adaptativo (gen_potencia ignora los ratings), así que pasa r_* neutros.
fn quiz_potencias(seed: Int, idx: Int, grade: Int, locale: Str, correct: Int, total: Int, limit: Int, feedback: Str, last_answer: Int) -> Html {
    let ex = gen_for("potencias", "mix", 2, seed, idx, grade, 800.0, 800.0, 800.0, 800.0)
    let prompt = flv(prompt_potencia(locale, ex.a, ex.b, ex.op))
    let opciones = h_join(ex.options.map(fn(o) => opt_button(locale, o, idx)))
    let banner = feedback_banner(locale, feedback, last_answer, idx)
    let hecho = flv(fmt_int(locale, total))
    let de_lbl = flv(t(locale, "juego.de"))
    let de_total = flv(fmt_int(locale, limit))
    let vas_lbl = flv(t(locale, "juego.aciertos"))
    let co = flv(fmt_int(locale, correct))
    return html("""<div class="q-hud">
<div class="q-mode">🔷 {hecho} {de_lbl} {de_total}</div>
<div class="q-score">{vas_lbl}<span class="q-snum">{co}</span></div>
</div>
<div class="q-prompt">{prompt}</div>
<div class="q-options">{opciones}</div>
<div class="q-fbwrap">{banner}</div>""")
}

// Un botón de opción. Valor crudo en el atributo, formateado en el texto.
fn opt_button(locale: Str, o: Int, idx: Int) -> Html {
    let etiqueta = flv(fmt_int(locale, o))
    return html("""<button class="q-opt" type="button" data-flv-click="answer" data-flv-value-v="{o}" data-flv-value-ei="{idx}">{etiqueta}</button>""")
}

// Banner de feedback tras responder: verde si acertó, ámbar con la respuesta
// correcta si no. Vacío al empezar cada ejercicio nuevo.
// `idx` (respuestas dadas, único por respuesta) va como data-fb-seq: el JS de
// sonido (public/sound.js) suena solo cuando ese valor cambia, sin repetir.
fn feedback_banner(locale: Str, feedback: Str, last_answer: Int, idx: Int) -> Str {
    if (feedback == "ok") {
        return html("""<div class="q-fb ok" role="status" data-fb-seq="{idx}">{flv(t(locale, "juego.correcto"))}</div>""").raw
    }
    if (feedback == "bad") {
        let resp = fmt_int(locale, last_answer)
        return html("""<div class="q-fb bad" role="status" data-fb-seq="{idx}">{flv(t1(locale, "juego.incorrecto", resp))}</div>""").raw
    }
    return ""
}

fn quiz_jugando(mode: Str, seed: Int, idx: Int, grade: Int, locale: Str, score: Int, time_left: Int, feedback: Str, last_answer: Int, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Html {
    // El contrarreloj usa modo "adaptive" (selección 70/20/10 por rating). El
    // "topic"/"band" no aplican acá — gen_for los ignora en modo adaptativo.
    let ex = gen_for(mode, "mix", 2, seed, idx, grade, r_add, r_sub, r_mul, r_div)
    let a = flv(fmt_operando(locale, ex.a))
    let b = flv(fmt_operando(locale, ex.b))
    let sym = flv(op_symbol(ex.op))
    let opciones = h_join(ex.options.map(fn(o) => opt_button(locale, o, idx)))
    let banner = feedback_banner(locale, feedback, last_answer, idx)
    let t_lbl = flv(t(locale, "juego.tiempo"))
    let seg = flv(t(locale, "juego.unidad_seg"))
    let tiempo = flv(fmt_int(locale, time_left))
    let pts_lbl = flv(t(locale, "juego.puntaje"))
    let pts = flv(fmt_int(locale, score))
    return html("""<div class="q-hud">
<div class="q-timer" aria-label="{t_lbl}"><span class="q-tnum">{tiempo}</span><span class="q-unit">{seg}</span></div>
<div class="q-score">{pts_lbl}<span class="q-snum">{pts}</span></div>
</div>
<div class="q-prompt">{a} {sym} {b}</div>
<div class="q-options">{opciones}</div>
<div class="q-fbwrap">{banner}</div>""")
}

// Práctica libre: mismo ejercicio de opción múltiple, pero SIN reloj ni puntaje
// (§6). El ejercicio sale de `gen_for("practice", ...)` — el tema y la banda
// fijan la operación y el rango; el mismo generador que corrige en Quiz.fitzv,
// así lo mostrado y lo puntuado coinciden. Se juega abierto: no hay resumen, se
// sale con "Terminar". Mostramos las correctas como progreso, no como score.
fn quiz_practica(seed: Int, idx: Int, grade: Int, locale: Str, topic: Str, band: Int, correct: Int, feedback: Str, last_answer: Int) -> Html {
    // Práctica libre NO es adaptativa: tema+banda fijos. Los ratings del
    // snapshot no aplican (por eso pasa 800.0 — gen_for los ignora en "practice").
    let ex = gen_for("practice", topic, band, seed, idx, grade, 800.0, 800.0, 800.0, 800.0)
    let a = flv(fmt_operando(locale, ex.a))
    let b = flv(fmt_operando(locale, ex.b))
    let sym = flv(op_symbol(ex.op))
    let opciones = h_join(ex.options.map(fn(o) => opt_button(locale, o, idx)))
    let banner = feedback_banner(locale, feedback, last_answer, idx)
    let modo = flv(t(locale, "practica.modo"))
    let vas_lbl = flv(t(locale, "juego.aciertos"))
    let co = flv(fmt_int(locale, correct))
    let salir = flv(t(locale, "juego.terminar"))
    return html("""<div class="q-hud">
<div class="q-mode">{modo}</div>
<div class="q-score">{vas_lbl}<span class="q-snum">{co}</span></div>
</div>
<div class="q-prompt">{a} {sym} {b}</div>
<div class="q-options">{opciones}</div>
<div class="q-fbwrap">{banner}</div>
<a class="mh-btn sec" href="/">{salir}</a>""")
}

fn quiz_resumen(locale: Str, score: Int, correct: Int, total: Int, mode: Str) -> Html {
    let sc = flv(fmt_int(locale, score))
    let co = flv(fmt_int(locale, correct))
    let to = flv(fmt_int(locale, total))
    let de = flv(t(locale, "juego.de"))
    // "Jugar de nuevo" vuelve al mismo modo (contrarreloj o desafío).
    let de_nuevo_href = match mode == "desafio" {
        true => "/desafio",
        false => "/jugar",
    }
    let estrellas = resumen_estrellas(locale, correct, total)
    return html("""<div class="q-done">
<div class="q-medal">🧉</div>
<h2>{flv(t(locale, "juego.resumen"))}</h2>
<div class="q-stat"><span class="q-big">{sc}</span><span class="q-lbl">{flv(t(locale, "juego.puntaje"))}</span></div>
<div class="q-stat"><span class="q-big">{co} {de} {to}</span><span class="q-lbl">{flv(t(locale, "juego.aciertos"))}</span></div>
{estrellas}
<div class="q-actions">
<a class="mh-btn" href="{de_nuevo_href}">{flv(t(locale, "juego.de_nuevo"))}</a>
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>
</div>
</div>""")
}
