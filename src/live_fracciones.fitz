// live_fracciones.fitz — "Fracciones a la vista" en vivo: página, socket, persistencia.
//
// Ronda fija de N sin reloj (modelo Completá/Kiosco). Reusa gen_frac +
// persistencia por respuesta → alimenta mastery (`frac.parte`) + racha igual que
// el contrarreloj. La respuesta es un STRING ("n/d"): el server re-deriva la
// fracción y compara given == it.correct. No-adaptativo: escala por el grado del
// perfil (el snapshot sólo tiene las 4 operaciones).

from fitz_liveviews import Html, html, LiveFrame, component_with, dispatch_component_events, flv_frame, component_state, flv_evict, live_embed
from config import db_url
from records import leer_record, guardar_record
from i18n import t, locale_from_cookie
from layout import page, responder_html, redirect_a
from models import GameSession, Attempt
from engine import desafio_n
from mastery import actualizar_mastery
from streaks import registrar_y_premiar
from gen_frac import gen_frac
from live_game import resolver_contexto, pget_int
from Fracciones import fracciones

async fn crear_sesion_frac(profile_id: Int, seed: Int, grade: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let sess = GameSession.insert(conn, GameSession {
        profile_id: profile_id,
        mode: "fracciones",        // CHECK sessions_mode_valido (0001_init.sql)
        topic_code: "frac.parte",
        level: grade,
        seed: seed,
    }).await?
    return Ok(sess.id)
}

async fn persistir_frac(sess_id: Int, profile_id: Int, seed: Int, idx: Int, grade: Int, given: Str) -> Result<Int> {
    let it = gen_frac(seed, idx, grade)
    let acierto = given == it.correct
    let prompt = "{it.num}/{it.den} pintado"
    let conn = db.connect(db_url()).await?
    let row = Attempt.insert(conn, Attempt {
        session_id: sess_id,
        profile_id: profile_id,
        skill_code: "frac.parte",
        idx: idx,
        prompt: prompt,
        expected: it.correct,
        given: given,
        correct: acierto,
        ms: 0,
        difficulty: it.difficulty,
    }).await?
    let _ = actualizar_mastery(profile_id, "frac.parte", it.difficulty, acierto, 0).await
    return Ok(row.id)
}

async fn cerrar_frac(sess_id: Int, total: Int, correct: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let _ = GameSession.where(fn(s) => s.id == sess_id).update(conn, {
        "total": total,
        "correct": correct,
    }).await?
    return Ok(1)
}

// Lee el payload string de una clave (Fitz no exporta un pget_str en live_game).
fn pget_str(p: Map<Str, Str>, k: Str) -> Str {
    return match p.get(k) {
        Ok(v) => v,
        Err(_) => "",
    }
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/fracciones")
async fn frac_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    let inicial = component_with("fracciones", "ssr", fracciones {
        seed: 1,
        grade: ctx.grade,
        locale: locale,
        limit: desafio_n(),
    })
    let embed = live_embed("/live/fracciones", "fracciones-app", inicial)
    let titulo = t(locale, "juego.fracciones") + " — MatHelp"
    return responder_html(page(locale, titulo, embed, html("")))
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@ws("/live/fracciones")
async fn frac_socket(ws: WsConn<LiveFrame>, session: Str?, lang: Str?) {
    let locale = locale_from_cookie(lang)
    let ctx = resolver_contexto(session).await?
    let cid = Uuid.v4().to_str()
    let seed = rand.int(1, 2000000000)
    let sess_id = crear_sesion_frac(ctx.profile_id, seed, ctx.grade).await?
    let record_prev = leer_record(ctx.profile_id, "fracciones").await
    let _ = component_with("fracciones", cid, fracciones {
        record_prev: record_prev,
        seed: seed,
        grade: ctx.grade,
        locale: locale,
        limit: desafio_n(),
    }).raw
    ws.send(flv_frame("fracciones", cid))?
    let next_idx = 0
    let finalizado = false
    loop {
        let frame = match ws.recv() {
            Ok(f) => f,
            Err(_) => { break },
        }
        let ev = frame.event
        let _ = dispatch_component_events(frame)
        if (ev == "answer") {
            let ei = pget_int(frame.payload, "ei", -1)
            let given = pget_str(frame.payload, "v")
            if (ei == next_idx and given != "") {
                let _ = persistir_frac(sess_id, ctx.profile_id, seed, ei, ctx.grade, given).await
                let _ = registrar_y_premiar(ctx.profile_id, ctx.daily_goal).await
                next_idx = next_idx + 1
            }
        }
        match ws.send(flv_frame("fracciones", cid)) {
            Ok(_) => 0,
            Err(_) => { break },
        }
        let st: fracciones = component_state("fracciones", cid)
        if (st.phase == "done") {
            if (not finalizado) {
                let _ = cerrar_frac(sess_id, st.total, st.correct).await
                let _ = guardar_record(ctx.profile_id, "fracciones", st.racha_max).await
                finalizado = true
            }
        }
    }
    let _ = flv_evict("fracciones", cid)
}
