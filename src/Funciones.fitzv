// Funciones.fitzv — el juego "Funciones" (F7.5), como LiveComponent SSR.
//
// Evaluar f(x) de tres familias (lineal, cuadrática, exponencial), con la fórmula
// + el gráfico de la familia (SVG). La respuesta puede ser NEGATIVA → teclado con
// ± (evento signo, como Ecuaciones). Ronda fija de N, sin reloj, no adaptativo
// (gen_func no usa ratings). La persistencia la hace el loop del @ws en
// live_funciones.fitz.
//
// Cuatro eventos: digito / borrar / signo / answer.

from gen_arith import gen_func
from keypad import kp_append, kp_borrar, kp_signo
from engine import a_int
from func_view import func_screen

component funciones {
  state {
    seed: Int = 0
    idx: Int = 0
    grade: Int = 12
    locale: Str = "es-AR"
    correct: Int = 0
    total: Int = 0
    racha: Int = 0
    racha_max: Int = 0
    record_prev: Int = 999999
    phase: Str = "playing"         // "playing" | "done"
    feedback: Str = ""             // "" | "ok" | "bad"
    last_answer: Int = 0           // la respuesta del ejercicio recién fallado
    entrada: Int = 0               // lo tipeado (puede ser negativo)
    touched: Bool = false          // ¿tipeó algo? (la respuesta puede ser 0)
    limit: Int = 10                // ejercicios por ronda
  }

  event digito() {
    if (phase == "playing") {
      if (payload.has("d")) {
        entrada = kp_append(entrada, a_int(payload["d"]), 9999)
        touched = true
      }
    }
  }

  event borrar() {
    if (phase == "playing") {
      entrada = kp_borrar(entrada)
    }
  }

  event signo() {
    if (phase == "playing") {
      entrada = kp_signo(entrada)
    }
  }

  event answer() {
    if (phase == "playing") {
      if (payload.has("v")) {
        if (payload.has("ei")) {
          let ei = a_int(payload["ei"])
          if (ei == idx) {
            let given = a_int(payload["v"])
            if (touched) {
              let ex = gen_func(seed, idx, grade)
              let acierto = given == ex.answer
              total = total + 1
              if (acierto) {
                correct = correct + 1
                feedback = "ok"
                racha = racha + 1
                if (racha > racha_max) {
                  racha_max = racha
                }
              }
              if (not acierto) {
                feedback = "bad"
                racha = 0
                last_answer = ex.answer
              }
              entrada = 0
              touched = false
              idx = idx + 1
              if (total >= limit) {
                phase = "done"
              }
            }
          }
        }
      }
    }
  }

  <template>
    <div id="funciones-app" class="mh-quiz">
      {func_screen(seed, idx, grade, locale, correct, total, limit, phase, feedback, last_answer, entrada, touched, racha, racha_max, record_prev).raw}
    </div>
  </template>
}
