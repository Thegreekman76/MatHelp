// Quiz.fitzv — el contrarreloj, como LiveComponent SSR.
//
// El estado es todo primitivo y vive en el component store (keyed por el
// instance_id del socket): el reloj lo empuja el server, así que un tick tiene
// que poder re-renderizar el componente por su cuenta (patrón del clock de
// liveviews). El ejercicio NO se guarda: se DERIVA de (seed, idx, grade) en cada
// render — con eso la partida entera se reconstruye desde el seed (F5).
//
// Dos eventos:
//   - answer(): el chico tocó una opción. El payload trae el valor elegido `v`
//     y el índice del ejercicio `ei` (para descartar taps viejos). Deriva el
//     ejercicio, corrige, actualiza puntaje y avanza al siguiente.
//   - tick(): un segundo menos. Al llegar a cero, la partida termina.
//
// La PERSISTENCIA (cada respuesta a `attempts`, el resumen a `sessions`) NO
// vive acá: la hace el loop del `@ws` en live_game.fitz, que lee el estado con
// `component_state(...)` y el contexto del payload. Los `event` de un `.fitzv`
// son mutaciones puras en memoria — sin `.await`, sin DB (patrón Admin ABM).

from gen_arith import gen_for
from engine import puntos, a_int
from quiz_view import quiz_screen

component quiz {
  state {
    seed: Int = 0
    idx: Int = 0
    grade: Int = 4
    locale: Str = "es-AR"
    score: Int = 0
    correct: Int = 0
    total: Int = 0
    racha: Int = 0
    racha_max: Int = 0
    record_prev: Int = 999999
    time_left: Int = 60
    phase: Str = "playing"      // "playing" | "done"
    feedback: Str = ""          // "" | "ok" | "bad"
    last_answer: Int = 0        // la respuesta correcta del ejercicio recién fallado
    topic: Str = "mix"          // tema fijo en práctica ("add".."div"|"mix"); "mix" en contrarreloj
    band: Int = 2               // banda de dificultad de práctica (1=fácil,2=medio,3=difícil)
    mode: Str = "timed"         // "adaptive" (contrarreloj F3) | "practice" | "timed" (legacy)
    // Snapshot de mastery: rating Elo-lite por operación, congelado al abrir la
    // partida (el @ws lo lee de la DB y lo siembra). La selección adaptativa
    // (gen_for "adaptive") elige el próximo ejercicio con esto. 800 = a ciegas.
    r_add: Float = 800.0
    r_sub: Float = 800.0
    r_mul: Float = 800.0
    r_div: Float = 800.0
    limit: Int = 0              // 0 = sin límite (contrarreloj/práctica); >0 = termina tras N (Desafío)
  }

  event answer() {
    if (phase == "playing") {
      if (payload.has("v")) {
        if (payload.has("ei")) {
          let ei = a_int(payload["ei"])
          if (ei == idx) {
            let chosen = a_int(payload["v"])
            let ex = gen_for(mode, topic, band, seed, idx, grade, r_add, r_sub, r_mul, r_div)
            let acierto = chosen == ex.answer
            total = total + 1
            if (acierto) {
              correct = correct + 1
              score = score + puntos(true, ex.difficulty)
              feedback = "ok"
              racha = racha + 1
              if (racha > racha_max) {
                racha_max = racha
              }
            }
            if (not acierto) {
              feedback = "bad"
              racha = 0
              last_answer = ex.answer
            }
            idx = idx + 1
            // Desafío del día: termina al completar N ejercicios (sin reloj).
            if (limit > 0) {
              if (total >= limit) {
                phase = "done"
              }
            }
          }
        }
      }
    }
  }

  event tick() {
    if (phase == "playing") {
      time_left = time_left - 1
      if (time_left <= 0) {
        time_left = 0
        phase = "done"
      }
    }
  }

  // Fin del reloj: lo dispara el server UNA vez al agotarse el tiempo. El
  // contrarreloj ya NO tickea por segundo (el conteo visible es client-side, para
  // no re-renderizar el componente entero cada segundo — eso parpadeaba); el
  // server sigue siendo autoritativo del fin y marca "done" acá.
  event timeup() {
    if (phase == "playing") {
      time_left = 0
      phase = "done"
    }
  }

  <template>
    <div id="quiz-app" class="mh-quiz">
      {quiz_screen(seed, idx, grade, locale, score, correct, total, time_left, phase, feedback, last_answer, topic, band, mode, r_add, r_sub, r_mul, r_div, limit, racha, racha_max, record_prev).raw}
    </div>
  </template>
}
