// --- Estimación ---------------------------------------------------------------

// Redondear: recta 40..50, 48 se va al 50.
fn svg_estim_redondeo() -> Str {
    let ticks = ""
    let labels = ""
    let n = 40
    while (n <= 50) {
        let x = 20 + (n - 40) * 28
        ticks = ticks + html("""<line x1="{x}" y1="54" x2="{x}" y2="70" class="rn-tick" />""").raw
        labels = labels + html("""<text x="{x}" y="88" class="rn-lbl">{n}</text>""").raw
        n = n + 1
    }
    return html("""<svg viewBox="0 0 320 100" class="ap-svg" role="img" aria-label="redondear 48 a 50">
<line x1="14" y1="62" x2="306" y2="62" class="rn-axis" />
<polygon points="306,62 298,57 298,67" class="rn-arrow" />
{ticks}
{labels}
<path d="M 244 56 Q 268 20 292 56" class="ap-jump" />
<text x="268" y="24" class="ap-jump-lbl">→ 50</text>
<circle cx="244" cy="62" r="5" class="ap-mark" />
<circle cx="292" cy="62" r="6" class="ap-mark end" />
</svg>""").raw
}

// Estimar una suma redondeando.
fn svg_estim_suma() -> Str {
    return html("""<svg viewBox="0 0 300 130" class="ap-svg" role="img" aria-label="estimar una suma">
<text x="150" y="32" class="tk-eq">48 ≈ 50</text>
<text x="150" y="62" class="tk-eq">37 ≈ 40</text>
<line x1="40" y1="76" x2="260" y2="76" class="tk-arrow-line" />
<text x="150" y="112" class="tk-eq strong">≈ 90</text>
</svg>""").raw
}

