// Comparar por cifras.
fn svg_ord_cifras() -> Str {
    return html("""<svg viewBox="0 0 300 128" class="ap-svg" role="img" aria-label="comparar por cifras">
<text x="150" y="34" class="tk-eq">325 &gt; 47</text>
<line x1="30" y1="52" x2="270" y2="52" class="tk-arrow-line" />
<text x="150" y="92" class="tk-eq strong">352 &gt; 348</text>
</svg>""").raw
