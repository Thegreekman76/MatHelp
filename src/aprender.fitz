// Cálculo mental: 43 − 19 → 43 − 20 = 23 → 23 + 1 = 24.
fn svg_resta_mental() -> Str {
    return html("""<svg viewBox="0 0 300 128" class="ap-svg" role="img" aria-label="43 - 19 = 24">
<text x="150" y="30" class="tk-eq">43 − 19</text>
<text x="150" y="66" class="tk-eq">43 − 20 = 23</text>
<line x1="30" y1="82" x2="270" y2="82" class="tk-arrow-line" />
