</svg>""").raw
}

// --- Multiplicación -----------------------------------------------------------

// Grupos iguales: 3 cajas con 4 puntos cada una → 12.
fn svg_mult_grupos() -> Str {
    return html("""<svg viewBox="0 0 340 116" class="ap-svg" role="img" aria-label="3 x 4 = 12">
<rect x="8" y="12" width="84" height="72" rx="12" class="ap-box" />
<circle cx="34" cy="38" r="12" class="ap-dot a" /><circle cx="66" cy="38" r="12" class="ap-dot a" /><circle cx="34" cy="66" r="12" class="ap-dot a" /><circle cx="66" cy="66" r="12" class="ap-dot a" />
<rect x="104" y="12" width="84" height="72" rx="12" class="ap-box" />
<circle cx="130" cy="38" r="12" class="ap-dot a" /><circle cx="162" cy="38" r="12" class="ap-dot a" /><circle cx="130" cy="66" r="12" class="ap-dot a" /><circle cx="162" cy="66" r="12" class="ap-dot a" />
<rect x="200" y="12" width="84" height="72" rx="12" class="ap-box" />
<circle cx="226" cy="38" r="12" class="ap-dot a" /><circle cx="258" cy="38" r="12" class="ap-dot a" /><circle cx="226" cy="66" r="12" class="ap-dot a" /><circle cx="258" cy="66" r="12" class="ap-dot a" />
<text x="316" y="54" class="tk-eq strong">12</text>
<text x="146" y="106" class="ap-cap">3 × 4</text>
</svg>""").raw
}

// Cuadrícula: 3 filas de 4 puntos = 12.
fn svg_mult_array() -> Str {
    let dots = ""
    let r = 0
    while (r < 3) {
        let c = 0
        while (c < 4) {
            let x = 60 + c * 44
            let y = 24 + r * 30
            dots = dots + html("""<circle cx="{x}" cy="{y}" r="11" class="ap-dot a" />""").raw
            c = c + 1
        }
        r = r + 1
    }
    return html("""<svg viewBox="0 0 300 132" class="ap-svg" role="img" aria-label="3 x 4 = 12">
{dots}
<text x="150" y="122" class="ap-cap">3 filas × 4 = 12</text>
</svg>""").raw
}

// Tabla del 4.
fn svg_mult_tabla() -> Str {
    return html("""<svg viewBox="0 0 220 156" class="ap-svg" role="img" aria-label="tabla del 4">
<text x="110" y="34" class="tk-eq">4 × 1 = 4</text>
<text x="110" y="72" class="tk-eq">4 × 2 = 8</text>
<line x1="24" y1="88" x2="196" y2="88" class="tk-arrow-line" />
<text x="110" y="122" class="tk-eq strong">4 × 3 = 12</text>
</svg>""").raw
}

// Multiplicar por partes: 6 × 13 = 78.
fn svg_mult_descomp() -> Str {
    return html("""<svg viewBox="0 0 300 160" class="ap-svg" role="img" aria-label="6 x 13 = 78">
<text x="150" y="30" class="tk-eq">6 × 13</text>
<text x="150" y="64" class="tk-eq">6 × 10 = 60</text>
<text x="150" y="98" class="tk-eq">6 × 3 = 18</text>
<line x1="30" y1="114" x2="270" y2="114" class="tk-arrow-line" />
<text x="150" y="146" class="tk-eq strong">60 + 18 = 78</text>
</svg>""").raw
}

// Multiplicar en columna: 24 × 3 = 72 (me llevo 1).
fn svg_mult_columna() -> Str {
    return html("""<svg viewBox="0 0 200 172" class="ap-svg" role="img" aria-label="24 x 3 = 72">
<text x="122" y="34" class="ap-carry">1</text>
<text x="150" y="68" class="ap-col">24</text>
<text x="150" y="108" class="ap-col">× 3</text>
<line x1="60" y1="122" x2="150" y2="122" class="ap-col-line" />
<text x="150" y="158" class="ap-col strong">72</text>
</svg>""").raw
}

// --- División -----------------------------------------------------------------

// Repartir: 12 en 3 cajas → 4 en cada una.
fn svg_div_reparto() -> Str {
    return html("""<svg viewBox="0 0 340 116" class="ap-svg" role="img" aria-label="12 dividido 3 = 4">
<rect x="8" y="12" width="84" height="72" rx="12" class="ap-box" />
<circle cx="34" cy="38" r="12" class="ap-dot a" /><circle cx="66" cy="38" r="12" class="ap-dot a" /><circle cx="34" cy="66" r="12" class="ap-dot a" /><circle cx="66" cy="66" r="12" class="ap-dot a" />
<rect x="104" y="12" width="84" height="72" rx="12" class="ap-box" />
<circle cx="130" cy="38" r="12" class="ap-dot a" /><circle cx="162" cy="38" r="12" class="ap-dot a" /><circle cx="130" cy="66" r="12" class="ap-dot a" /><circle cx="162" cy="66" r="12" class="ap-dot a" />
<rect x="200" y="12" width="84" height="72" rx="12" class="ap-box" />
<circle cx="226" cy="38" r="12" class="ap-dot a" /><circle cx="258" cy="38" r="12" class="ap-dot a" /><circle cx="226" cy="66" r="12" class="ap-dot a" /><circle cx="258" cy="66" r="12" class="ap-dot a" />
<text x="316" y="54" class="tk-eq strong">4</text>
<text x="146" y="106" class="ap-cap">12 ÷ 3 = 4</text>
</svg>""").raw
}

// Cuántos grupos: 4 grupos de 3 en 12.
fn svg_div_agrupar() -> Str {
    let grupos = ""
    let g = 0
    while (g < 4) {
        let bx = 20 + g * 80
        let x1 = bx + 20
        let x2 = bx + 6
        let x3 = bx + 34
        grupos = grupos + html("""<circle cx="{x1}" cy="30" r="11" class="ap-dot a" /><circle cx="{x2}" cy="60" r="11" class="ap-dot a" /><circle cx="{x3}" cy="60" r="11" class="ap-dot a" />""").raw
        g = g + 1
    }
    return html("""<svg viewBox="0 0 340 106" class="ap-svg" role="img" aria-label="12 dividido 3 = 4 grupos">
{grupos}
<text x="170" y="98" class="ap-cap">12 ÷ 3 = 4 grupos de 3</text>
</svg>""").raw
}

// Tabla al revés: 3 × ? = 12.
fn svg_div_tabla() -> Str {
    return html("""<svg viewBox="0 0 300 128" class="ap-svg" role="img" aria-label="12 dividido 3 = 4">
<text x="150" y="30" class="tk-eq">12 ÷ 3</text>
<text x="150" y="66" class="tk-eq">3 × ? = 12</text>
<line x1="30" y1="82" x2="270" y2="82" class="tk-arrow-line" />
<text x="150" y="114" class="tk-eq strong">? = 4</text>
</svg>""").raw
}

// División larga (casita): 96 ÷ 4 = 24.
fn svg_div_larga() -> Str {
    return html("""<svg viewBox="0 0 240 140" class="ap-svg" role="img" aria-label="96 dividido 4 = 24">
<text x="176" y="40" class="ap-col strong">24</text>
<line x1="96" y1="52" x2="192" y2="52" class="ap-col-line" />
<line x1="96" y1="52" x2="96" y2="98" class="ap-col-line" />
<text x="80" y="86" class="ap-col">4</text>
<text x="176" y="86" class="ap-col">96</text>
<text x="120" y="128" class="ap-cap">96 ÷ 4 = 24</text>
</svg>""").raw
}

// --- Fracciones ---------------------------------------------------------------

// Leer 3/4: barra en 4 partes, 3 pintadas.
fn svg_frac_leer() -> Str {
    return html("""<svg viewBox="0 0 300 120" class="ap-svg" role="img" aria-label="tres cuartos">
<rect x="30" y="30" width="240" height="52" class="ap-fbar" />
<rect x="30" y="30" width="60" height="52" class="ap-fseg on" />
<rect x="90" y="30" width="60" height="52" class="ap-fseg on" />
<rect x="150" y="30" width="60" height="52" class="ap-fseg on" />
<line x1="90" y1="30" x2="90" y2="82" class="ap-fdiv" /><line x1="150" y1="30" x2="150" y2="82" class="ap-fdiv" /><line x1="210" y1="30" x2="210" y2="82" class="ap-fdiv" />
<text x="150" y="106" class="ap-cap">3/4</text>
</svg>""").raw
}

// Equivalentes: 1/2 = 2/4 (mismo largo pintado).
fn svg_frac_equiv() -> Str {
    return html("""<svg viewBox="0 0 300 152" class="ap-svg" role="img" aria-label="un medio igual a dos cuartos">
<rect x="30" y="20" width="240" height="42" class="ap-fbar" />
<rect x="30" y="20" width="120" height="42" class="ap-fseg on" />
<line x1="150" y1="20" x2="150" y2="62" class="ap-fdiv" />
<rect x="30" y="80" width="240" height="42" class="ap-fbar" />
<rect x="30" y="80" width="120" height="42" class="ap-fseg on" />
<line x1="90" y1="80" x2="90" y2="122" class="ap-fdiv" /><line x1="150" y1="80" x2="150" y2="122" class="ap-fdiv" /><line x1="210" y1="80" x2="210" y2="122" class="ap-fdiv" />
<text x="150" y="146" class="ap-cap">1/2 = 2/4</text>
</svg>""").raw
}

// Comparar: 1/2 pinta más que 1/3.
fn svg_frac_comparar() -> Str {
    return html("""<svg viewBox="0 0 300 152" class="ap-svg" role="img" aria-label="un medio mayor que un tercio">
<rect x="30" y="20" width="240" height="42" class="ap-fbar" />
<rect x="30" y="20" width="120" height="42" class="ap-fseg on" />
<line x1="150" y1="20" x2="150" y2="62" class="ap-fdiv" />
<rect x="30" y="80" width="240" height="42" class="ap-fbar" />
<rect x="30" y="80" width="80" height="42" class="ap-fseg on" />
<line x1="110" y1="80" x2="110" y2="122" class="ap-fdiv" /><line x1="190" y1="80" x2="190" y2="122" class="ap-fdiv" />
<text x="150" y="146" class="ap-cap">1/2 &gt; 1/3</text>
</svg>""").raw
}

// Fracción de una cantidad: 3/4 de 12 = 9.
fn svg_frac_de_cantidad() -> Str {
    return html("""<svg viewBox="0 0 300 128" class="ap-svg" role="img" aria-label="tres cuartos de 12 = 9">
<text x="150" y="30" class="tk-eq">¾ de 12</text>
<text x="150" y="66" class="tk-eq">12 ÷ 4 = 3</text>
<line x1="30" y1="82" x2="270" y2="82" class="tk-arrow-line" />
<text x="150" y="114" class="tk-eq strong">3 × 3 = 9</text>
</svg>""").raw
}

// Operar: 1/4 + 2/4 = 3/4.
fn svg_frac_operar() -> Str {
    return html("""<svg viewBox="0 0 300 128" class="ap-svg" role="img" aria-label="un cuarto mas dos cuartos = tres cuartos">
<rect x="30" y="26" width="240" height="48" class="ap-fbar" />
<rect x="30" y="26" width="60" height="48" class="ap-fseg on" />
<rect x="90" y="26" width="60" height="48" class="ap-fseg hi" />
<rect x="150" y="26" width="60" height="48" class="ap-fseg hi" />
<line x1="90" y1="26" x2="90" y2="74" class="ap-fdiv" /><line x1="150" y1="26" x2="150" y2="74" class="ap-fdiv" /><line x1="210" y1="26" x2="210" y2="74" class="ap-fdiv" />
<text x="150" y="110" class="ap-cap">1/4 + 2/4 = 3/4</text>
</svg>""").raw
}

// --- Porcentaje ---------------------------------------------------------------

// 25% = 25 de 100 (cuadrícula 10×10).
fn svg_pct_fraccion() -> Str {
    let cells = ""
    let i = 0
    while (i < 100) {
        let col = i % 10
        let row = i / 10
        let x = 12 + col * 13
        let y = 12 + row * 13
        let cls = match i < 25 {
            true => "ap-pcell on",
            false => "ap-pcell",
        }
        cells = cells + html("""<rect x="{x}" y="{y}" width="11" height="11" class="{cls}" />""").raw
        i = i + 1
    }
    return html("""<svg viewBox="0 0 156 176" class="ap-svg" role="img" aria-label="25 por ciento">
{cells}
<text x="78" y="164" class="ap-cap">25% = 25 de 100</text>
</svg>""").raw
}

// El 10% y combinar: 15% de 80.
fn svg_pct_diez() -> Str {
    return html("""<svg viewBox="0 0 270 150" class="ap-svg" role="img" aria-label="15 por ciento de 80">
<text x="135" y="32" class="tk-eq">10% de 80 = 8</text>
<text x="135" y="76" class="tk-eq">5% = 4</text>
<line x1="30" y1="92" x2="240" y2="92" class="tk-arrow-line" />
<text x="135" y="128" class="tk-eq strong">15% = 8 + 4 = 12</text>
</svg>""").raw
}

// Regla de tres.
fn svg_pct_regla3() -> Str {
    return html("""<svg viewBox="0 0 300 150" class="ap-svg" role="img" aria-label="regla de tres">
<text x="150" y="34" class="tk-eq">100% → 80</text>
<text x="150" y="72" class="tk-eq">15% → ?</text>
<line x1="30" y1="88" x2="270" y2="88" class="tk-arrow-line" />
<text x="150" y="124" class="tk-eq strong">80 × 15 ÷ 100 = 12</text>
</svg>""").raw
}

// Descuento: 20% de 500.
fn svg_pct_descuento() -> Str {
    return html("""<svg viewBox="0 0 300 150" class="ap-svg" role="img" aria-label="20 por ciento de descuento de 500">
<text x="150" y="34" class="tk-eq">$500</text>
<text x="150" y="76" class="tk-eq">− 20% = $100</text>
<line x1="30" y1="92" x2="270" y2="92" class="tk-arrow-line" />
<text x="150" y="128" class="tk-eq strong">500 − 100 = $400</text>
</svg>""").raw
}

// --- Enteros ------------------------------------------------------------------

// Recta con negativos −5..5.
fn svg_ent_recta() -> Str {
    let ticks = ""
    let labels = ""
    let n = 0 - 5
    while (n <= 5) {
        let x = 160 + n * 26
        ticks = ticks + html("""<line x1="{x}" y1="46" x2="{x}" y2="62" class="rn-tick" />""").raw
        let cls = match n == 0 {
            true => "rn-lbl zero",
            false => "rn-lbl",
        }
        labels = labels + html("""<text x="{x}" y="80" class="{cls}">{n}</text>""").raw
        n = n + 1
    }
    return html("""<svg viewBox="0 0 320 96" class="ap-svg" role="img" aria-label="recta con negativos">
<line x1="14" y1="54" x2="306" y2="54" class="rn-axis" />
<polygon points="306,54 298,49 298,59" class="rn-arrow" />
<polygon points="14,54 22,49 22,59" class="rn-arrow" />
{ticks}
<circle cx="160" cy="54" r="4" class="rn-zero" />
{labels}
</svg>""").raw
}

// Tener y deber: +3 (tengo) / −3 (debo).
fn svg_ent_deudas() -> Str {
    return html("""<svg viewBox="0 0 260 116" class="ap-svg" role="img" aria-label="positivo y negativo">
<text x="130" y="48" class="ap-ent-pos">+3  ▲</text>
<text x="130" y="94" class="ap-ent-neg">−3  ▼</text>
</svg>""").raw
}

// Sumar con signo: (−5) + 3 = −2 (salto a la derecha en la recta).
fn svg_ent_sumar() -> Str {
    let ticks = ""
    let labels = ""
    let n = 0 - 6
    while (n <= 3) {
        let x = 40 + (n + 6) * 26
        ticks = ticks + html("""<line x1="{x}" y1="60" x2="{x}" y2="72" class="rn-tick" />""").raw
        let cls = match n == 0 {
            true => "rn-lbl zero",
            false => "rn-lbl",
        }
        labels = labels + html("""<text x="{x}" y="90" class="{cls}">{n}</text>""").raw
        n = n + 1
    }
    return html("""<svg viewBox="0 0 320 108" class="ap-svg" role="img" aria-label="menos 5 mas 3 = menos 2">
<line x1="14" y1="66" x2="306" y2="66" class="rn-axis" />
<polygon points="306,66 298,61 298,71" class="rn-arrow" />
<polygon points="14,66 22,61 22,71" class="rn-arrow" />
{ticks}
{labels}
<circle cx="196" cy="66" r="4" class="rn-zero" />
<path d="M 66 58 Q 105 22 144 58" class="ap-jump" />
<text x="105" y="20" class="ap-jump-lbl">+3</text>
<circle cx="66" cy="66" r="5" class="ap-mark" />
<circle cx="144" cy="66" r="6" class="ap-mark end" />
</svg>""").raw
}

// Regla de los signos (× y ÷).
fn svg_ent_signos() -> Str {
    return html("""<svg viewBox="0 0 220 168" class="ap-svg" role="img" aria-label="regla de los signos">
<text x="110" y="30" class="tk-signo">(+) · (+) = <tspan class="tk-pos">+</tspan></text>
<text x="110" y="70" class="tk-signo">(+) · (−) = <tspan class="tk-neg">−</tspan></text>
<text x="110" y="110" class="tk-signo">(−) · (+) = <tspan class="tk-neg">−</tspan></text>
<text x="110" y="150" class="tk-signo">(−) · (−) = <tspan class="tk-pos">+</tspan></text>
</svg>""").raw
}

// --- Geometría ----------------------------------------------------------------

// Perímetro: rectángulo 5×3 con los lados rotulados.
fn svg_geo_perimetro() -> Str {
    return html("""<svg viewBox="0 0 300 166" class="ap-svg" role="img" aria-label="perimetro de un rectangulo">
<rect x="70" y="34" width="160" height="76" class="ap-shape" />
<text x="150" y="26" class="ap-cap">5</text>
<text x="150" y="126" class="ap-cap">5</text>
<text x="58" y="76" class="ap-cap">3</text>
<text x="242" y="76" class="ap-cap">3</text>
<text x="150" y="154" class="tk-eq strong">5+3+5+3 = 16</text>
</svg>""").raw
}

// Área del rectángulo: cuadrícula 5×3.
fn svg_geo_area_rect() -> Str {
    let cells = ""
    let r = 0
    while (r < 3) {
        let c = 0
        while (c < 5) {
            let x = 70 + c * 24
            let y = 20 + r * 24
            cells = cells + html("""<rect x="{x}" y="{y}" width="24" height="24" class="ap-pcell on" />""").raw
            c = c + 1
        }
        r = r + 1
    }
    return html("""<svg viewBox="0 0 300 128" class="ap-svg" role="img" aria-label="area de un rectangulo 5 por 3">
{cells}
<text x="150" y="116" class="tk-eq strong">5 × 3 = 15</text>
</svg>""").raw
}

// Área del triángulo: la mitad de un rectángulo.
fn svg_geo_area_tri() -> Str {
    return html("""<svg viewBox="0 0 300 160" class="ap-svg" role="img" aria-label="area de un triangulo">
<rect x="60" y="24" width="180" height="96" class="ap-shape-dash" />
<polygon points="60,120 240,120 60,24" class="tk-tri" />
<text x="150" y="138" class="ap-cap">6</text>
<text x="48" y="76" class="ap-cap">4</text>
<text x="150" y="156" class="tk-eq strong">6 × 4 ÷ 2 = 12</text>
</svg>""").raw
}

// Figura compuesta: una L partida en dos rectángulos.
fn svg_geo_compuesta() -> Str {
    return html("""<svg viewBox="0 0 300 160" class="ap-svg" role="img" aria-label="figura compuesta en L">
<polygon points="70,20 160,20 160,80 240,80 240,130 70,130" class="ap-shape" />
<line x1="160" y1="80" x2="160" y2="130" class="ap-shape-dash" />
<text x="115" y="82" class="ap-cap">1</text>
<text x="200" y="110" class="ap-cap">2</text>
<text x="150" y="152" class="tk-eq strong">área 1 + área 2</text>
</svg>""").raw
}

// --- Volumen ------------------------------------------------------------------

// Contar cubitos: caja 3D con la cara frontal en cuadrícula.
fn svg_vol_cubos() -> Str {
    return html("""<svg viewBox="0 0 220 156" class="ap-svg" role="img" aria-label="contar cubitos">
<polygon points="60,60 90,40 180,40 150,60" class="ap-shape-2" />
<polygon points="150,60 180,40 180,100 150,120" class="ap-shape-3" />
<rect x="60" y="60" width="90" height="60" class="ap-shape" />
<line x1="90" y1="60" x2="90" y2="120" class="ap-fdiv" /><line x1="120" y1="60" x2="120" y2="120" class="ap-fdiv" /><line x1="60" y1="90" x2="150" y2="90" class="ap-fdiv" />
<text x="110" y="144" class="tk-eq strong">3 × 2 × 2 = 12</text>
</svg>""").raw
}

// Prisma: área de la base × altura.
fn svg_vol_prisma() -> Str {
    return html("""<svg viewBox="0 0 240 156" class="ap-svg" role="img" aria-label="volumen de un prisma">
<polygon points="60,60 90,40 180,40 150,60" class="ap-shape-2" />
<polygon points="150,60 180,40 180,100 150,120" class="ap-shape-3" />
<rect x="60" y="60" width="90" height="60" class="ap-shape" />
<text x="105" y="138" class="ap-cap">3</text>
<text x="48" y="94" class="ap-cap">4</text>
<text x="170" y="128" class="tk-eq strong">6 × 4 = 24</text>
</svg>""").raw
}

// Cilindro: área del círculo × altura.
fn svg_vol_cilindro() -> Str {
    return html("""<svg viewBox="0 0 220 160" class="ap-svg" role="img" aria-label="volumen de un cilindro">
<rect x="60" y="45" width="90" height="70" class="ap-shape" />
<ellipse cx="105" cy="115" rx="45" ry="14" class="ap-shape" />
<ellipse cx="105" cy="45" rx="45" ry="14" class="ap-shape-2" />
<text x="105" y="150" class="tk-eq strong">π × 2² × 5 ≈ 63</text>
</svg>""").raw
}

// --- Hora ---------------------------------------------------------------------

// Marcas del reloj (12 ticks). Se comparten entre las carátulas.
fn reloj_ticks() -> Str {
    let ticks = ""
    let i = 0
    while (i < 12) {
        let ang = i * 30
        ticks = ticks + html("""<line x1="100" y1="16" x2="100" y2="28" class="clk-tick" transform="rotate({ang} 100 100)" />""").raw
        i = i + 1
    }
    return ticks
}

// Las dos agujas: 2 en punto (corta a la hora, larga a los minutos).
fn svg_hora_aguja() -> Str {
    let ticks = reloj_ticks()
    return html("""<svg viewBox="0 0 200 200" class="ap-svg" role="img" aria-label="las dos agujas del reloj">
<circle cx="100" cy="100" r="90" class="clk-face" />
{ticks}
<line x1="100" y1="100" x2="100" y2="58" class="clk-hour" transform="rotate(60 100 100)" />
<line x1="100" y1="100" x2="100" y2="32" class="clk-min" transform="rotate(0 100 100)" />
<circle cx="100" cy="100" r="6" class="clk-center" />
</svg>""").raw
}

// En punto y media hora: 3:00.
fn svg_hora_en_punto() -> Str {
    let ticks = reloj_ticks()
    return html("""<svg viewBox="0 0 200 200" class="ap-svg" role="img" aria-label="las 3 en punto">
<circle cx="100" cy="100" r="90" class="clk-face" />
{ticks}
<line x1="100" y1="100" x2="100" y2="58" class="clk-hour" transform="rotate(90 100 100)" />
<line x1="100" y1="100" x2="100" y2="32" class="clk-min" transform="rotate(0 100 100)" />
<circle cx="100" cy="100" r="6" class="clk-center" />
</svg>""").raw
}

// Y cuarto: 3:15 (larga en el 3, corta pasando el 3).
fn svg_hora_cuartos() -> Str {
    let ticks = reloj_ticks()
    return html("""<svg viewBox="0 0 200 200" class="ap-svg" role="img" aria-label="las 3 y cuarto">
<circle cx="100" cy="100" r="90" class="clk-face" />
{ticks}
<line x1="100" y1="100" x2="100" y2="58" class="clk-hour" transform="rotate(98 100 100)" />
<line x1="100" y1="100" x2="100" y2="32" class="clk-min" transform="rotate(90 100 100)" />
<circle cx="100" cy="100" r="6" class="clk-center" />
</svg>""").raw
}

// Reloj digital y las 24 horas: 3:15 = 15:15.
fn svg_hora_digital() -> Str {
    return html("""<svg viewBox="0 0 220 140" class="ap-svg" role="img" aria-label="reloj digital">
<text x="110" y="58" class="tk-eq strong">3:15</text>
<line x1="30" y1="76" x2="190" y2="76" class="tk-arrow-line" />
<text x="110" y="116" class="tk-eq">15:15</text>
</svg>""").raw
}

// --- Potencias ----------------------------------------------------------------

// Qué es una potencia: 2³ = 2 × 2 × 2 = 8.
fn svg_pot_que_es() -> Str {
    return html("""<svg viewBox="0 0 300 96" class="ap-svg" role="img" aria-label="2 al cubo = 8">
<text x="150" y="40" class="tk-eq">2³ = 2 × 2 × 2</text>
<text x="150" y="80" class="tk-eq strong">= 8</text>
</svg>""").raw
}

// Cuadrado: 5² como el área de un cuadrado de lado 5 (cuadrícula 5×5).
fn svg_pot_cuadrado() -> Str {
    let cells = ""
    let r = 0
    while (r < 5) {
        let c = 0
        while (c < 5) {
            let x = 40 + c * 22
            let y = 12 + r * 22
            cells = cells + html("""<rect x="{x}" y="{y}" width="22" height="22" class="ap-pcell on" />""").raw
            c = c + 1
        }
        r = r + 1
    }
    return html("""<svg viewBox="0 0 300 156" class="ap-svg" role="img" aria-label="5 al cuadrado = 25">
{cells}
<text x="200" y="80" class="tk-eq strong">5² = 25</text>
