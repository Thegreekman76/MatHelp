// Ubicar en la recta (2, 5, 9 marcados).
fn svg_ord_recta() -> Str {
    let ticks = ""
    let labels = ""
    let marks = ""
    let n = 0
    while (n <= 10) {
        let x = 20 + n * 28
        ticks = ticks + html("""<line x1="{x}" y1="46" x2="{x}" y2="62" class="rn-tick" />""").raw
        labels = labels + html("""<text x="{x}" y="80" class="rn-lbl">{n}</text>""").raw
        if (n == 2 or n == 5 or n == 9) {
            marks = marks + html("""<circle cx="{x}" cy="54" r="6" class="ap-mark end" />""").raw
        }
        n = n + 1
    }
    return html("""<svg viewBox="0 0 320 96" class="ap-svg" role="img" aria-label="2 menor que 5 menor que 9">
<line x1="14" y1="54" x2="306" y2="54" class="rn-axis" />
<polygon points="306,54 298,49 298,59" class="rn-arrow" />
{ticks}
{labels}
{marks}
</svg>""").raw
}

