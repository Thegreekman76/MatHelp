    return html("""<svg viewBox="0 0 300 128" class="ap-svg" role="img" aria-label="calcular mental descomponiendo">
<text x="150" y="30" class="tk-eq">8 × 7</text>
<text x="150" y="66" class="tk-eq">8×5 + 8×2</text>
<line x1="30" y1="82" x2="270" y2="82" class="tk-arrow-line" />
<text x="150" y="114" class="tk-eq strong">40 + 16 = 56</text>
</svg>""").raw
}

// Resta contando la diferencia: desde 8 hacia adelante hasta 12 (+4).
fn svg_resta_contar_hasta() -> Str {
    let ticks = ""
    let labels = ""
    let n = 6
    while (n <= 14) {
        let x = 30 + (n - 6) * 34
        ticks = ticks + html("""<line x1="{x}" y1="54" x2="{x}" y2="70" class="rn-tick" />""").raw
        labels = labels + html("""<text x="{x}" y="88" class="rn-lbl">{n}</text>""").raw
        n = n + 1
    }
    return html("""<svg viewBox="0 0 320 100" class="ap-svg" role="img" aria-label="contar de 8 hasta 12">
<line x1="14" y1="62" x2="306" y2="62" class="rn-axis" />
<polygon points="306,62 298,57 298,67" class="rn-arrow" />
{ticks}
{labels}
<path d="M 98 56 Q 166 14 234 56" class="ap-jump" />
<text x="166" y="22" class="ap-jump-lbl">+4</text>
<circle cx="98" cy="62" r="5" class="ap-mark" />
<circle cx="234" cy="62" r="6" class="ap-mark end" />
</svg>""").raw
}

// División por restas repetidas: 12 − 3 − 3 − 3 − 3 = 0 (4 saltos hacia atrás).
fn svg_div_restas_rep() -> Str {
    let ticks = ""
    let labels = ""
    let n = 0
    while (n <= 12) {
        let x = 24 + n * 23
        ticks = ticks + html("""<line x1="{x}" y1="54" x2="{x}" y2="70" class="rn-tick" />""").raw
        if (n % 3 == 0) {
            labels = labels + html("""<text x="{x}" y="88" class="rn-lbl">{n}</text>""").raw
        }
        n = n + 1
    }
    return html("""<svg viewBox="0 0 320 100" class="ap-svg" role="img" aria-label="12 menos 3 cuatro veces">
<line x1="14" y1="62" x2="306" y2="62" class="rn-axis" />
<polygon points="14,62 22,57 22,67" class="rn-arrow" />
{ticks}
{labels}
<path d="M 300 56 Q 265 18 231 56" class="ap-jump" />
<path d="M 231 56 Q 196 18 162 56" class="ap-jump" />
<path d="M 162 56 Q 127 18 93 56" class="ap-jump" />
<path d="M 93 56 Q 58 18 24 56" class="ap-jump" />
<text x="265" y="20" class="ap-jump-lbl">−3</text>
<circle cx="300" cy="62" r="5" class="ap-mark" />
<circle cx="24" cy="62" r="6" class="ap-mark end" />
</svg>""").raw
}

// Simplificar una fracción: dividir arriba y abajo por el mismo número.
fn svg_frac_simplificar() -> Str {
    return html("""<svg viewBox="0 0 300 130" class="ap-svg" role="img" aria-label="simplificar 6 octavos a 3 cuartos">
<text x="150" y="34" class="tk-eq strong">6/8 = 3/4</text>
<line x1="30" y1="50" x2="270" y2="50" class="tk-arrow-line" />
<text x="150" y="84" class="tk-eq">6 ÷ 2 = 3</text>
<text x="150" y="116" class="tk-eq">8 ÷ 2 = 4</text>
</svg>""").raw
}

fn metodo_svg(tema: Str, metodo: Str) -> Str {
    if (tema == "suma") {
        return match metodo {
            "objetos" => svg_suma_objetos(),
            "recta" => svg_suma_recta(),
            "descomp" => svg_suma_descomp(),
            "columna" => svg_suma_columna(),
            "mental" => svg_suma_mental(),
            _ => "",
        }
    }
    if (tema == "resta") {
        return match metodo {
            "objetos" => svg_resta_objetos(),
            "recta" => svg_resta_recta(),
            "contar_hasta" => svg_resta_contar_hasta(),
            "descomp" => svg_resta_descomp(),
            "columna" => svg_resta_columna(),
            "mental" => svg_resta_mental(),
            _ => "",
        }
    }
    if (tema == "multiplicacion") {
        return match metodo {
            "grupos" => svg_mult_grupos(),
            "array" => svg_mult_array(),
            "tabla" => svg_mult_tabla(),
            "descomp" => svg_mult_descomp(),
            "columna" => svg_mult_columna(),
            _ => "",
        }
    }
    if (tema == "division") {
        return match metodo {
            "reparto" => svg_div_reparto(),
            "agrupar" => svg_div_agrupar(),
            "restas_rep" => svg_div_restas_rep(),
            "tabla" => svg_div_tabla(),
            "larga" => svg_div_larga(),
            _ => "",
        }
    }
    if (tema == "fracciones") {
        return match metodo {
            "leer" => svg_frac_leer(),
            "equiv" => svg_frac_equiv(),
            "simplificar" => svg_frac_simplificar(),
            "comparar" => svg_frac_comparar(),
            "de_cantidad" => svg_frac_de_cantidad(),
            "operar" => svg_frac_operar(),
            _ => "",
        }
    }
    if (tema == "porcentaje") {
        return match metodo {
            "fraccion" => svg_pct_fraccion(),
            "diez" => svg_pct_diez(),
            "regla3" => svg_pct_regla3(),
            "descuento" => svg_pct_descuento(),
            _ => "",
        }
    }
    if (tema == "enteros") {
        return match metodo {
            "recta" => svg_ent_recta(),
            "deudas" => svg_ent_deudas(),
            "sumar" => svg_ent_sumar(),
            "signos" => svg_ent_signos(),
            _ => "",
        }
    }
    if (tema == "geometria") {
        return match metodo {
            "perimetro" => svg_geo_perimetro(),
            "area_rect" => svg_geo_area_rect(),
            "area_tri" => svg_geo_area_tri(),
            "compuesta" => svg_geo_compuesta(),
            _ => "",
        }
    }
    if (tema == "volumen") {
        return match metodo {
            "cubos" => svg_vol_cubos(),
            "prisma" => svg_vol_prisma(),
            "cilindro" => svg_vol_cilindro(),
            _ => "",
        }
    }
    if (tema == "hora") {
        return match metodo {
            "aguja" => svg_hora_aguja(),
            "en_punto" => svg_hora_en_punto(),
            "cuartos" => svg_hora_cuartos(),
            "digital" => svg_hora_digital(),
            _ => "",
        }
    }
    if (tema == "potencias") {
        return match metodo {
            "que_es" => svg_pot_que_es(),
            "cuadrado" => svg_pot_cuadrado(),
            "raiz" => svg_pot_raiz(),
            "reglas" => svg_pot_reglas(),
            _ => "",
        }
    }
    if (tema == "ecuaciones") {
        return match metodo {
            "balanza" => svg_ec_balanza(),
            "despejar" => svg_ec_despejar(),
            "inversas" => svg_ec_inversas(),
            "cuadratica" => svg_ec_cuadratica(),
            _ => "",
        }
    }
    if (tema == "trigonometria") {
        return match metodo {
            "pitagoras" => svg_trig_pitagoras(),
            "razones" => svg_trig_razones(),
            "terna" => svg_trig_terna(),
            "angulos" => svg_trig_angulos(),
            _ => "",
        }
    }
    if (tema == "funciones") {
        return match metodo {
            "que_es" => svg_func_que_es(),
            "evaluar" => svg_func_evaluar(),
            "lineal" => svg_func_lineal(),
            "grafico" => svg_func_grafico(),
            _ => "",
        }
    }
    if (tema == "estadistica") {
        return match metodo {
            "promedio" => svg_est_promedio(),
            "mediana" => svg_est_mediana(),
            "moda" => svg_est_moda(),
            "rango" => svg_est_rango(),
            _ => "",
        }
    }
    if (tema == "estimacion") {
        return match metodo {
            "redondeo" => svg_estim_redondeo(),
            "suma_est" => svg_estim_suma(),
            "producto_est" => svg_estim_producto(),
            "razonable" => svg_estim_razonable(),
            _ => "",
        }
    }
    if (tema == "series") {
        return match metodo {
            "sumar_fijo" => svg_ser_sumar(),
            "multiplicar" => svg_ser_multiplicar(),
            "figuras" => svg_ser_figuras(),
            "especiales" => svg_ser_especiales(),
            _ => "",
        }
    }
    if (tema == "problemas") {
        return match metodo {
            "entender" => svg_prob_entender(),
            "datos" => svg_prob_datos(),
            "operacion" => svg_prob_operacion(),
            "verificar" => svg_prob_verificar(),
            _ => "",
        }
    }
    if (tema == "ordenar") {
        return match metodo {
            "comparar" => svg_ord_comparar(),
            "cifras" => svg_ord_cifras(),
            "recta" => svg_ord_recta(),
            "decimales" => svg_ord_decimales(),
            _ => "",
        }
    }
    if (tema == "memoria") {
        return match metodo {
            "parejas" => svg_mem_parejas(),
            "dobles" => svg_mem_dobles(),
            "tablas" => svg_mem_tablas(),
            "descomponer" => svg_mem_descomponer(),
            _ => "",
        }
    }
    return ""
}

// --- Render -------------------------------------------------------------------

// Una ficha de método (acordeón <details>): título + SVG + 3 pasos + ejemplo.
// El destacado abre con `open` y lleva el badge "Para tu grado".
fn ficha_metodo(locale: Str, tema: Str, metodo: Str, abierto: Bool) -> Html {
    let tit = flv(t(locale, "aprender.{tema}.m.{metodo}.tit"))
    let p1 = flv(t(locale, "aprender.{tema}.m.{metodo}.p1"))
    let p2 = flv(t(locale, "aprender.{tema}.m.{metodo}.p2"))
    let p3 = flv(t(locale, "aprender.{tema}.m.{metodo}.p3"))
    let ej = flv(t(locale, "aprender.{tema}.m.{metodo}.ej"))
    let svg = metodo_svg(tema, metodo)
    let badge = match abierto {
        true => html("""<span class="ap-badge">{flv(t(locale, "aprender.tu_metodo"))}</span>""").raw,
        false => "",
    }
    let open_attr = match abierto {
        true => "open",
        false => "",
    }
    return html("""<details class="ap-metodo" {open_attr}>
<summary class="ap-metodo-sum"><span class="ap-metodo-tit">{tit}</span>{badge}</summary>
<div class="ap-metodo-body">
<div class="ap-fig">{svg}</div>
<ol class="ap-pasos"><li>{p1}</li><li>{p2}</li><li>{p3}</li></ol>
<div class="ap-ej"><span class="ap-ej-lbl">{flv(t(locale, "trucos.ejemplo"))}</span> <span class="ap-ej-txt">{ej}</span></div>
</div>
</details>""")
}

fn carta_tema(locale: Str, c: Str) -> Html {
    let em = flv(tema_emoji(c))
    let tit = flv(t(locale, "aprender.{c}.tit"))
    let sub = flv(t(locale, "aprender.{c}.card"))
    return html("""<a class="mh-truco-card" href="/aprender/{c}">
<span class="mh-truco-card-em" aria-hidden="true">{em}</span>
<span class="mh-truco-card-txt">
<span class="mh-truco-card-tit">{tit}</span>
<span class="mh-truco-card-sub">{sub}</span>
</span>
</a>""")
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/aprender")
async fn aprender_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    let visibles = temas().filter(fn(c) => tema_min_grade(c) <= ctx.grade)
    let cartas = h_join(visibles.map(fn(c) => carta_tema(locale, c)))
    let body = html("""<div class="mh-card">
<h2>{flv(t(locale, "aprender.titulo"))}</h2>
<p class="mh-trucos-sub">{flv(t(locale, "aprender.sub"))}</p>
<div class="mh-trucos">
{cartas}
</div>
</div>
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>""")
    let titulo = t(locale, "aprender.titulo") + " — MatHelp"
    return responder_html(page(locale, titulo, body, html("")))
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/aprender/{code}")
async fn aprender_detalle(session: Str?, lang: Str?, code: Str) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    if (not tema_valido(code)) {
        return redirect_a("/aprender")
    }
    let em = flv(tema_emoji(code))
    let tit = flv(t(locale, "aprender.{code}.tit"))
    let intro = flv(t(locale, "aprender.{code}.intro"))
    let uso1 = flv(t(locale, "aprender.{code}.uso1"))
    let uso2 = flv(t(locale, "aprender.{code}.uso2"))
    let uso3 = flv(t(locale, "aprender.{code}.uso3"))
    let uemo = tema_uso_emojis(code)
    let em1 = flv(uemo[0])
    let em2 = flv(uemo[1])
    let em3 = flv(uemo[2])
    let historia = flv(t(locale, "aprender.{code}.historia"))
    let destacado = metodo_destacado(code, ctx.grade)
    let metodos = h_join(metodos_de(code).map(fn(m) => ficha_metodo(locale, code, m, m == destacado)))
    let route = tema_route(code)
    let truco = tema_truco(code)
    let truco_link = match truco == "" {
        true => "",
        false => html("""<a class="mh-btn sec" href="/trucos/{truco}"><span aria-hidden="true">💡</span>{flv(t(locale, "aprender.truco_link"))}</a>""").raw,
    }
    let body = html("""<div class="mh-card ap-ficha">
<div class="mh-truco-head"><span class="mh-truco-em" aria-hidden="true">{em}</span><h2>{tit}</h2></div>
<p class="mh-truco-intro">{intro}</p>
<h3 class="ap-h">{flv(t(locale, "aprender.usos"))}</h3>
<ul class="ap-usos">
<li><span class="ap-uso-em" aria-hidden="true">{em1}</span><span>{uso1}</span></li>
<li><span class="ap-uso-em" aria-hidden="true">{em2}</span><span>{uso2}</span></li>
<li><span class="ap-uso-em" aria-hidden="true">{em3}</span><span>{uso3}</span></li>
</ul>
<h3 class="ap-h">{flv(t(locale, "aprender.metodos"))}</h3>
<div class="ap-metodos">
{metodos}
</div>
<h3 class="ap-h">{flv(t(locale, "aprender.historia"))}</h3>
<p class="ap-historia"><span class="ap-hist-em" aria-hidden="true">📜</span><span>{historia}</span></p>
<a class="mh-btn" href="{route}"><span aria-hidden="true">▶️</span>{flv(t(locale, "aprender.practicar"))}</a>
{truco_link}
</div>
<a class="mh-btn sec" href="/aprender">{flv(t(locale, "aprender.volver"))}</a>""")
    let titulo = t(locale, "aprender.{code}.tit") + " — MatHelp"
    return responder_html(page(locale, titulo, body, html("")))
}
