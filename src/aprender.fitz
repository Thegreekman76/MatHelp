// Los métodos de cada tema, del más simple al más avanzado.
fn metodos_de(c: Str) -> List<Str> {
    return match c {
        "suma" => ["objetos", "recta", "descomp", "columna", "mental"],
        "resta" => ["objetos", "recta", "contar_hasta", "descomp", "columna", "mental"],
        "multiplicacion" => ["grupos", "array", "tabla", "descomp", "columna"],
        "division" => ["reparto", "agrupar", "restas_rep", "tabla", "larga"],
        "fracciones" => ["leer", "equiv", "simplificar", "comparar", "de_cantidad", "operar"],
        "porcentaje" => ["fraccion", "diez", "regla3", "descuento"],
        "enteros" => ["recta", "deudas", "sumar", "signos"],
        "geometria" => ["perimetro", "area_rect", "area_tri", "compuesta"],
        "volumen" => ["cubos", "prisma", "cilindro"],
        "hora" => ["aguja", "en_punto", "cuartos", "digital"],
        "potencias" => ["que_es", "cuadrado", "raiz", "reglas"],
        "ecuaciones" => ["balanza", "despejar", "inversas", "cuadratica"],
        "trigonometria" => ["pitagoras", "razones", "terna", "angulos"],
        "funciones" => ["que_es", "evaluar", "lineal", "grafico"],
        "estadistica" => ["promedio", "mediana", "moda", "rango"],
        "estimacion" => ["redondeo", "suma_est", "producto_est", "razonable"],
        "series" => ["sumar_fijo", "multiplicar", "figuras", "especiales"],
        "problemas" => ["entender", "datos", "operacion", "verificar"],
        "ordenar" => ["comparar", "cifras", "recta", "decimales"],
        "memoria" => ["parejas", "dobles", "tablas", "descomponer"],
        _ => [],
    }
}

// El método recomendado según el grado (se abre por default; los otros quedan
// colapsados pero visibles).
fn metodo_destacado(tema: Str, grade: Int) -> Str {
    if (tema == "suma" or tema == "resta") {
        if (grade <= 1) {
            return "objetos"
        }
        if (grade == 2) {
            return "descomp"
        }
        if (grade <= 4) {
            return "columna"
        }
        return "mental"
    }
    if (tema == "multiplicacion") {
        if (grade <= 2) {
            return "grupos"
        }
        if (grade == 3) {
            return "tabla"
        }
        if (grade <= 5) {
            return "columna"
        }
        return "descomp"
    }
    if (tema == "division") {
        if (grade <= 3) {
            return "reparto"
        }
        if (grade == 4) {
            return "tabla"
        }
        return "larga"
    }
    if (tema == "fracciones") {
        if (grade <= 5) {
            return "leer"
        }
        if (grade <= 7) {
            return "comparar"
        }
        return "operar"
    }
    if (tema == "porcentaje") {
        if (grade <= 6) {
            return "fraccion"
        }
        if (grade == 7) {
            return "diez"
        }
        return "regla3"
    }
    if (tema == "enteros") {
        if (grade <= 7) {
            return "recta"
        }
        if (grade == 8) {
            return "sumar"
        }
        return "signos"
    }
    if (tema == "geometria") {
        if (grade <= 5) {
            return "perimetro"
        }
        if (grade == 6) {
            return "area_rect"
        }
        if (grade <= 8) {
            return "area_tri"
        }
        return "compuesta"
    }
    if (tema == "volumen") {
        if (grade <= 6) {
            return "cubos"
        }
        if (grade <= 8) {
            return "prisma"
        }
        return "cilindro"
    }
    if (tema == "hora") {
        if (grade <= 2) {
            return "aguja"
        }
        if (grade == 3) {
            return "en_punto"
        }
        if (grade <= 5) {
            return "cuartos"
        }
        return "digital"
    }
    if (tema == "potencias") {
        if (grade <= 8) {
            return "que_es"
        }
        if (grade == 9) {
            return "cuadrado"
        }
        if (grade <= 11) {
            return "reglas"
        }
        return "raiz"
    }
    if (tema == "ecuaciones") {
        if (grade <= 8) {
            return "balanza"
        }
        if (grade == 9) {
            return "despejar"
        }
        if (grade <= 11) {
            return "inversas"
        }
        return "cuadratica"
    }
    if (tema == "trigonometria") {
        if (grade <= 10) {
            return "pitagoras"
        }
        if (grade == 11) {
            return "terna"
        }
        if (grade == 12) {
            return "razones"
        }
        return "angulos"
    }
    if (tema == "funciones") {
        if (grade <= 11) {
            return "que_es"
        }
        if (grade == 12) {
            return "evaluar"
        }
        return "lineal"
    }
    if (tema == "estadistica") {
        if (grade <= 6) {
            return "promedio"
        }
        if (grade == 7) {
            return "mediana"
        }
        if (grade <= 8) {
            return "moda"
        }
        return "rango"
    }
    if (tema == "estimacion") {
        if (grade <= 3) {
            return "redondeo"
        }
        if (grade == 4) {
            return "suma_est"
        }
        if (grade <= 5) {
            return "producto_est"
        }
        return "razonable"
    }
    if (tema == "series") {
        if (grade <= 2) {
            return "sumar_fijo"
        }
        if (grade <= 4) {
            return "multiplicar"
        }
        if (grade <= 6) {
            return "figuras"
        }
        return "especiales"
    }
    if (tema == "problemas") {
        if (grade <= 4) {
            return "entender"
        }
        if (grade <= 6) {
            return "datos"
        }
        if (grade <= 8) {
            return "operacion"
        }
        return "verificar"
    }
    if (tema == "ordenar") {
        if (grade <= 2) {
            return "comparar"
        }
        if (grade <= 4) {
            return "cifras"
        }
        if (grade <= 6) {
            return "recta"
        }
        return "decimales"
    }
    if (tema == "memoria") {
        if (grade <= 1) {
            return "parejas"
        }
        if (grade <= 3) {
            return "dobles"
        }
        if (grade <= 5) {
            return "tablas"
        }
        return "descomponer"
    }
    return ""
}

// --- Ilustraciones SVG (números = rótulos de gráfico, literales) --------------

// Contar objetos: dos grupos (3 + 2) y el total (5).
fn svg_suma_objetos() -> Str {
    return html("""<svg viewBox="0 0 300 108" class="ap-svg" role="img" aria-label="3 + 2 = 5">
<circle cx="30" cy="42" r="15" class="ap-dot a" /><circle cx="66" cy="42" r="15" class="ap-dot a" /><circle cx="102" cy="42" r="15" class="ap-dot a" />
<text x="140" y="50" class="tk-eq">+</text>
<circle cx="178" cy="42" r="15" class="ap-dot b" /><circle cx="214" cy="42" r="15" class="ap-dot b" />
<text x="270" y="50" class="tk-eq strong">= 5</text>
<text x="66" y="90" class="ap-cap">3</text>
<text x="196" y="90" class="ap-cap">2</text>
</svg>""").raw
}

// Recta numérica 0..10: parado en el 4, salto de +3 hasta el 7.
fn svg_suma_recta() -> Str {
    let ticks = ""
    let labels = ""
    let n = 0
    while (n <= 10) {
        let x = 20 + n * 28
        ticks = ticks + html("""<line x1="{x}" y1="54" x2="{x}" y2="70" class="rn-tick" />""").raw
        labels = labels + html("""<text x="{x}" y="88" class="rn-lbl">{n}</text>""").raw
        n = n + 1
    }
    return html("""<svg viewBox="0 0 320 100" class="ap-svg" role="img" aria-label="4 + 3 = 7">
<line x1="14" y1="62" x2="306" y2="62" class="rn-axis" />
<polygon points="306,62 298,57 298,67" class="rn-arrow" />
{ticks}
{labels}
<path d="M 132 56 Q 174 10 216 56" class="ap-jump" />
<text x="174" y="24" class="ap-jump-lbl">+3</text>
<circle cx="132" cy="62" r="5" class="ap-mark" />
<circle cx="216" cy="62" r="6" class="ap-mark end" />
</svg>""").raw
}

// Descomponer: 28 + 15 → (20 + 10) y (8 + 5) → 30 + 13 = 43.
fn svg_suma_descomp() -> Str {
    return html("""<svg viewBox="0 0 300 128" class="ap-svg" role="img" aria-label="28 + 15 = 43">
<text x="150" y="30" class="tk-eq">28 + 15</text>
<text x="150" y="66" class="tk-eq">(20+10) + (8+5)</text>
<line x1="30" y1="82" x2="270" y2="82" class="tk-arrow-line" />
<text x="150" y="114" class="tk-eq strong">30 + 13 = 43</text>
</svg>""").raw
}

// Sumar en columna con llevada: 28 + 15 = 43 (me llevo 1).
fn svg_suma_columna() -> Str {
    return html("""<svg viewBox="0 0 200 172" class="ap-svg" role="img" aria-label="28 + 15 = 43">
<text x="122" y="34" class="ap-carry">1</text>
<text x="150" y="68" class="ap-col">28</text>
<text x="150" y="108" class="ap-col">+ 15</text>
<line x1="60" y1="122" x2="150" y2="122" class="ap-col-line" />
<text x="150" y="158" class="ap-col strong">43</text>
</svg>""").raw
}

// Cálculo mental: 28 + 15 → 30 + 15 = 45 → 45 − 2 = 43.
fn svg_suma_mental() -> Str {
    return html("""<svg viewBox="0 0 300 128" class="ap-svg" role="img" aria-label="28 + 15 = 43">
<text x="150" y="30" class="tk-eq">28 + 15</text>
<text x="150" y="66" class="tk-eq">30 + 15 = 45</text>
<line x1="30" y1="82" x2="270" y2="82" class="tk-arrow-line" />
<text x="150" y="114" class="tk-eq strong">45 − 2 = 43</text>
</svg>""").raw
}

// Quitar objetos: 5 caramelos, saco 2 (apagados) → quedan 3.
fn svg_resta_objetos() -> Str {
    return html("""<svg viewBox="0 0 300 108" class="ap-svg" role="img" aria-label="5 - 2 = 3">
<circle cx="30" cy="42" r="15" class="ap-dot a" /><circle cx="66" cy="42" r="15" class="ap-dot a" /><circle cx="102" cy="42" r="15" class="ap-dot a" />
<circle cx="138" cy="42" r="15" class="ap-dot off" /><circle cx="174" cy="42" r="15" class="ap-dot off" />
<text x="258" y="50" class="tk-eq strong">= 3</text>
<text x="102" y="90" class="ap-cap">5 − 2</text>
</svg>""").raw
}

// Recta numérica 0..10: parado en el 7, salto de −3 hacia atrás hasta el 4.
fn svg_resta_recta() -> Str {
    let ticks = ""
    let labels = ""
    let n = 0
    while (n <= 10) {
        let x = 20 + n * 28
        ticks = ticks + html("""<line x1="{x}" y1="54" x2="{x}" y2="70" class="rn-tick" />""").raw
        labels = labels + html("""<text x="{x}" y="88" class="rn-lbl">{n}</text>""").raw
        n = n + 1
    }
    return html("""<svg viewBox="0 0 320 100" class="ap-svg" role="img" aria-label="7 - 3 = 4">
<line x1="14" y1="62" x2="306" y2="62" class="rn-axis" />
<polygon points="306,62 298,57 298,67" class="rn-arrow" />
{ticks}
{labels}
<path d="M 216 56 Q 174 10 132 56" class="ap-jump" />
<text x="174" y="24" class="ap-jump-lbl">−3</text>
<circle cx="216" cy="62" r="5" class="ap-mark" />
<circle cx="132" cy="62" r="6" class="ap-mark end" />
</svg>""").raw
}

// Restar por partes: 43 − 15 → 43 − 10 = 33 → 33 − 5 = 28.
fn svg_resta_descomp() -> Str {
    return html("""<svg viewBox="0 0 300 128" class="ap-svg" role="img" aria-label="43 - 15 = 28">
<text x="150" y="30" class="tk-eq">43 − 15</text>
<text x="150" y="66" class="tk-eq">43 − 10 = 33</text>
<line x1="30" y1="82" x2="270" y2="82" class="tk-arrow-line" />
<text x="150" y="114" class="tk-eq strong">33 − 5 = 28</text>
</svg>""").raw
}

// Restar en columna con préstamo: 43 − 15 = 28 (pido 1 decena a las unidades).
fn svg_resta_columna() -> Str {
    return html("""<svg viewBox="0 0 200 172" class="ap-svg" role="img" aria-label="43 - 15 = 28">
<text x="126" y="46" class="ap-carry">1</text>
<text x="150" y="68" class="ap-col">43</text>
