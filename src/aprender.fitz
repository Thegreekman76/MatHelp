// aprender.fitz — sección "Aprendé": enseña cada cálculo desde los fundamentos.
//
// Complementa a /trucos (atajos rápidos): acá se explica QUÉ es cada operación,
// PARA QUÉ sirve en la vida real, un poco de HISTORIA, y VARIOS MÉTODOS para
// resolverla, del más simple al más avanzado. Todos los métodos quedan visibles;
// el recomendado para el grado del perfil aparece abierto por default (el resto
// colapsados con <details>, HTML nativo, sin JS). Páginas F0 estáticas, mismo
// molde que trucos.fitz.
//
// Prototipo: solo "suma". Los demás temas se agregan replicando este patrón
// (una entrada en temas() + su emoji/ruta/métodos + los SVG + las claves i18n).
//
// Reglas del proyecto (i18n.fitz): los textos van por t(locale, ...); los números
// de los SVG son rótulos de gráfico, literales (igual que recta_svg / trucos).

from fitz_liveviews import Html, html, flv, h_join
from i18n import t, locale_from_cookie
from layout import page, responder_html, redirect_a
from live_game import resolver_contexto

// --- Catálogo de temas --------------------------------------------------------

// Todos los temas de "Aprendé", ordenados por grado. La grilla filtra por el
// grado del perfil (tema_min_grade <= grade), igual que /trucos y el menú.
fn temas() -> List<Str> {
    return ["suma", "resta", "multiplicacion", "division", "fracciones", "porcentaje", "enteros", "geometria", "volumen", "hora", "potencias", "ecuaciones", "trigonometria", "funciones", "estadistica", "estimacion", "series", "problemas", "ordenar", "memoria"]
}

fn tema_valido(c: Str) -> Bool {
    for x in temas() {
        if (x == c) {
            return true
        }
    }
    return false
}

fn tema_emoji(c: Str) -> Str {
    return match c {
        "suma" => "➕",
        "resta" => "➖",
        "multiplicacion" => "✖️",
        "division" => "➗",
        "fracciones" => "🍕",
        "porcentaje" => "％",
        "enteros" => "±",
        "geometria" => "📐",
        "volumen" => "🧊",
        "hora" => "🕒",
        "potencias" => "🔷",
        "ecuaciones" => "🟰",
        "trigonometria" => "🔺",
        "funciones" => "📈",
        "estadistica" => "📊",
        "estimacion" => "🎯",
        "series" => "🔁",
        "problemas" => "📝",
        "ordenar" => "🔢",
        "memoria" => "🧠",
        _ => "📘",
    }
}

// Grado a partir del cual el tema aparece en la grilla.
fn tema_min_grade(c: Str) -> Int {
    return match c {
        "suma" => 1,
        "resta" => 1,
        "multiplicacion" => 2,
        "division" => 3,
        "fracciones" => 4,
        "porcentaje" => 6,
        "enteros" => 7,
        "geometria" => 5,
        "volumen" => 6,
        "hora" => 2,
        "potencias" => 8,
        "ecuaciones" => 8,
        "trigonometria" => 10,
        "funciones" => 11,
        "estadistica" => 6,
        "estimacion" => 3,
        "series" => 1,
        "problemas" => 4,
        "ordenar" => 1,
        "memoria" => 1,
        _ => 1,
    }
}

// El juego que practica el tema (respeta las rutas existentes).
