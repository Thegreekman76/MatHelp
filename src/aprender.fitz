    return match c {
        "suma" => "/jugar",
        "resta" => "/jugar",
        "multiplicacion" => "/jugar",
        "division" => "/jugar",
        "fracciones" => "/fracciones",
        "porcentaje" => "/porcentaje",
        "enteros" => "/enteros",
        "geometria" => "/geometria",
        "volumen" => "/volumen",
        "hora" => "/hora",
        "potencias" => "/potencias",
        "ecuaciones" => "/ecuaciones",
        "trigonometria" => "/trigonometria",
        "funciones" => "/funciones",
        "estadistica" => "/estadistica",
        "estimacion" => "/estimar",
        "series" => "/series",
        "problemas" => "/problemas",
        "ordenar" => "/ordenar",
        "memoria" => "/memoria",
        _ => "/juegos",
