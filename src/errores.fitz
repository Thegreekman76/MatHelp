// errores.fitz — "Repasá tus errores" (sistema #1 de la tanda post-trucos).
//
// Cada `attempt` guarda el prompt ("7 × 8") y el expected ("56"), así que podemos
// re-preguntar el ejercicio EXACTO que el chico falló, sin reconstruirlo con el
// generador. La cola son los prompts cuyo ÚLTIMO intento fue un error y que no se
// repasaron desde entonces. Repasar uno lo marca en `review_resolved` (sin insertar
// un attempt falso — no ensucia la precisión del panel del padre); si acierta,
// además sube el rating de esa destreza (motor adaptativo).
//
// La tabla se crea lazy (CREATE TABLE IF NOT EXISTS): las migraciones sólo corren
// en DB fresca (docker-entrypoint-initdb.d), así que esto hace que ande también en
// bases ya existentes. El archivo migrations/0018 la documenta para instalaciones
// nuevas.

from fitz_liveviews import Html, html, flv
from config import db_url
from i18n import t, t1, locale_from_cookie
from layout import page, responder_html, redirect_a
from auth import read_session, pid_from_token
from engine import a_int
from mastery import actualizar_mastery
from progreso import skill_label_key, skill_icon

type RespuestaError {
    prompt: Str = ""
    respuesta: Str = ""
}

type ResErr {
    found: Bool = false
    correct: Bool = false
    expected: Str = ""
    skill_code: Str = ""
}

// Crea review_resolved si no existe (idempotente, best-effort).
async fn asegurar_tabla() -> Result<Int> {
    let conn = db.connect(db_url()).await?
    return conn.exec("CREATE TABLE IF NOT EXISTS review_resolved (id SERIAL PRIMARY KEY, profile_id INTEGER NOT NULL REFERENCES profiles(id) ON DELETE CASCADE, prompt TEXT NOT NULL, resolved_at TIMESTAMPTZ NOT NULL DEFAULT now(), UNIQUE (profile_id, prompt))", []).await
}

// --- render ------------------------------------------------------------------

fn tarjeta_vacia(locale: Str) -> Html {
    return html("""<div class="mh-card mh-err-vacio">
<span class="mh-err-emoji" aria-hidden="true">🎉</span>
<h2>{flv(t(locale, "errores.vacio_titulo"))}</h2>
<p class="mh-err-sub">{flv(t(locale, "errores.vacio_sub"))}</p>
<a class="mh-btn" href="/jugar"><span aria-hidden="true">▶️</span>{flv(t(locale, "home.jugar_ya"))}</a>
</div>
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>""")
}

fn tarjeta_pregunta(locale: Str, prompt: Str, skill_code: Str, n: Int) -> Html {
    let icon = flv(skill_icon(skill_code))
    let tema = flv(t(locale, skill_label_key(skill_code)))
    let cuenta = flv(t1(locale, "errores.pendientes", "{n}"))
    let prompt_disp = flv(prompt)
    return html("""<div class="mh-card mh-errores">
<h2>{flv(t(locale, "errores.titulo"))}</h2>
<p class="mh-err-sub">{cuenta} · {icon} {tema}</p>
<div class="mh-err-prompt">{prompt_disp} = ?</div>
<form method="POST" action="/errores/responder" class="mh-err-form">
<input type="hidden" name="prompt" value="{prompt}" />
<input class="mh-input mh-err-input" type="text" name="respuesta" inputmode="numeric" autocomplete="off" autofocus required />
<button class="mh-btn" type="submit">{flv(t(locale, "errores.responder"))}</button>
</form>
</div>
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>""")
}

fn tarjeta_feedback(locale: Str, prompt: Str, expected: Str, correct: Bool) -> Html {
    let cuenta = html("""<div class="mh-err-eq">{flv(prompt)} = {flv(expected)}</div>""").raw
    if (correct) {
        return html("""<div class="mh-card mh-err-fb ok">
<span class="mh-err-emoji" aria-hidden="true">✅</span>
<h2>{flv(t(locale, "errores.correcto"))}</h2>
{cuenta}
<a class="mh-btn" href="/errores">{flv(t(locale, "errores.siguiente"))}</a>
</div>
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>""")
    }
    return html("""<div class="mh-card mh-err-fb bad">
<span class="mh-err-emoji" aria-hidden="true">💡</span>
<h2>{flv(t(locale, "errores.incorrecto"))}</h2>
{cuenta}
<a class="mh-btn" href="/errores">{flv(t(locale, "errores.siguiente"))}</a>
</div>
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>""")
}

// Cuerpo de /errores: la próxima pregunta de la cola, o la tarjeta de "sin errores".
async fn cuerpo_errores(locale: Str, pid: Int) -> Html {
    let conn = match db.connect(db_url()).await {
        Ok(c) => c,
        Err(_) => { return tarjeta_vacia(locale) },
    }
    // Prompts cuyo ÚLTIMO intento es un error (sin acierto posterior) y no repasados
    // desde ese error. DISTINCT ON (prompt) + orden por id DESC = el más reciente.
    let q = "SELECT DISTINCT ON (a.prompt) a.prompt AS prompt, a.expected AS expected, a.skill_code AS skill_code FROM attempts a WHERE a.profile_id = $1 AND a.correct = false AND NOT EXISTS (SELECT 1 FROM attempts c WHERE c.profile_id = $1 AND c.prompt = a.prompt AND c.correct = true AND c.id > a.id) AND NOT EXISTS (SELECT 1 FROM review_resolved r WHERE r.profile_id = $1 AND r.prompt = a.prompt AND r.resolved_at > a.created_at) ORDER BY a.prompt, a.id DESC LIMIT 30"
    let rows = match conn.query(q, [pid]).await {
        Ok(r) => r,
        Err(_) => { return tarjeta_vacia(locale) },
    }
    if (rows.len() == 0) {
        return tarjeta_vacia(locale)
    }
    let prompt = match rows[0].get_str("prompt") {
        Ok(p) => p,
        Err(_) => { return tarjeta_vacia(locale) },
    }
    let sc = match rows[0].get_str("skill_code") {
        Ok(s) => s,
        Err(_) => "",
    }
    return tarjeta_pregunta(locale, prompt, sc, rows.len())
}

// Chequea la respuesta, marca el prompt como repasado y (si acertó) sube el rating.
async fn resolver_error(pid: Int, prompt: Str, given: Str) -> ResErr {
    // `return Ident { ... }` se parsea como Response-con-status; devolvemos una
    // variable local para evitarlo (patrón conocido del codegen de Fitz).
    let vacio = ResErr {}
    let conn = match db.connect(db_url()).await {
        Ok(c) => c,
        Err(_) => { return vacio },
    }
    let rows = match conn.query("SELECT expected, skill_code FROM attempts WHERE profile_id = $1 AND prompt = $2 AND correct = false ORDER BY id DESC LIMIT 1", [pid, prompt]).await {
        Ok(r) => r,
        Err(_) => { return vacio },
    }
    if (rows.len() == 0) {
        return vacio
    }
    let expected = match rows[0].get_str("expected") {
        Ok(e) => e,
        Err(_) => "",
    }
    let sc = match rows[0].get_str("skill_code") {
        Ok(s) => s,
        Err(_) => "",
    }
    let ok = given == expected
    // Marcá el prompt como repasado (upsert atómico — el ORM no tiene upsert nativo).
    let _ = conn.exec("INSERT INTO review_resolved (profile_id, prompt) VALUES ($1, $2) ON CONFLICT (profile_id, prompt) DO UPDATE SET resolved_at = now()", [pid, prompt]).await
    if (ok) {
        let _ = actualizar_mastery(pid, sc, 2, true, 0).await
    }
    let out = ResErr { found: true, correct: ok, expected: expected, skill_code: sc }
    return out
}

// --- rutas -------------------------------------------------------------------

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/errores")
async fn errores_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    match read_session(session).await {
        Ok(_) => 0,
        Err(_) => return redirect_a("/login"),
    }
    let pid = a_int(pid_from_token(session))
    if (pid <= 0) {
        return redirect_a("/perfiles")
    }
    let _ = asegurar_tabla().await
    let body = cuerpo_errores(locale, pid).await
    let titulo = t(locale, "errores.titulo") + " — MatHelp"
    return responder_html(page(locale, titulo, body, html("")))
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@post("/errores/responder")
async fn errores_post(session: Str?, lang: Str?, form: RespuestaError) -> Response {
    let locale = locale_from_cookie(lang)
    match read_session(session).await {
        Ok(_) => 0,
        Err(_) => return redirect_a("/login"),
    }
    let pid = a_int(pid_from_token(session))
    if (pid <= 0) {
        return redirect_a("/perfiles")
    }
    let _ = asegurar_tabla().await
    let res = resolver_error(pid, form.prompt, form.respuesta).await
    if (not res.found) {
        return redirect_a("/errores")
    }
    let body = tarjeta_feedback(locale, form.prompt, res.expected, res.correct)
    let titulo = t(locale, "errores.titulo") + " — MatHelp"
    return responder_html(page(locale, titulo, body, html("")))
}
