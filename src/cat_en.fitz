        "landing.cta_crear" => "Create a free account",
        "landing.f1_text" => "From the 4 operations to fractions, equations, geometry and more.",
        "landing.f1_title" => "24 games",
        "landing.f2_text" => "Difficulty goes up and down on its own based on how they're doing.",
        "landing.f2_title" => "Adapts to each kid",
        "landing.f3_text" => "See progress, streaks and what to reinforce, per child.",
        "landing.f3_title" => "Parent dashboard",
        "landing.f4_text" => "One profile per child, with content for every age.",
        "landing.f4_title" => "Primary to secondary",
        "landing.f5_text" => "Install it as an app on your phone and play offline.",
        "landing.f5_title" => "Works offline",
        "landing.f6_text" => "No advertising, no in-game purchases. Peace of mind.",
        "landing.f6_title" => "No ads",
        "landing.f7_text" => "Every Monday you get an email summary of each child's progress.",
        "landing.f7_title" => "Weekly email reports",
        "landing.f8_text" => "Every calculation explained from scratch: what it's for, several methods by age, with drawings and even a bit of history.",
        "landing.f8_title" => "Learn, don't just practice",
        "landing.f9_text" => "Shortcuts to calculate faster in your head (friends of 10, ×9 with your hands, and more), then practice them by playing.",
        "landing.f9_title" => "Mental math tricks",
        "landing.features_title" => "Why MatHelp",
        "landing.final_text" => "Creating an account is free and takes a minute.",
        "landing.final_title" => "Ready to start?",
        "landing.hero_nota" => "Free. No ads. Takes a minute.",
        "landing.hero_sub" => "24 calculation games, from primary to secondary school. They adapt to each kid's level and you follow their progress.",
        "landing.hero_title" => "Math your kids actually want to practice",
        "landing.how_title" => "How to start",
        "landing.step1_text" => "One account for the whole family, in a minute.",
