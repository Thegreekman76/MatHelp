        "acc.fuente.normal" => "Normal",
        "acc.sub" => "Adjust contrast and text size.",
        "acc.titulo" => "Accessibility",
        "activar.codigo" => "Activation code",
        "activar.error" => "The email or code don't match.",
        "activar.error_password" => "The password must be at least 6 characters.",
        "activar.error_password2" => "The passwords don't match.",
        "activar.password" => "Create your password",
        "activar.password2" => "Repeat your password",
        "activar.password_hint" => "At least 6 characters. You'll use it to sign in from now on.",
        "activar.submit" => "Activate and enter",
        "activar.texto" => "Ask an adult in your family for the activation code.",
        "activar.titulo" => "Activate your login",
        "activar.ya" => "Already activated? Sign in",
        "admin.altas_titulo" => "Signups per day (7 days)",
        "admin.error" => "Couldn't load the statistics.",
        "admin.flojas_titulo" => "Weakest skills (% errors)",
        "admin.juegos_titulo" => "Most played games",
        "admin.registros_titulo" => "Latest signups",
        "admin.ret_hint" => "Of families registered each week, how many played within 7 days.",
        "admin.ret_reg" => "Signups",
        "admin.ret_ret" => "Retained",
        "admin.ret_semana" => "Week",
        "admin.retencion_titulo" => "Retention by cohort (D7)",
        "admin.sin_datos" => "No data yet.",
        "admin.sin_registros" => "No signups yet.",
        "admin.stat.dau" => "Active today",
        "admin.stat.dau_hint" => "Profiles that played today",
        "admin.stat.familias" => "Families",
        "admin.stat.perfiles" => "Profiles",
        "admin.stat.reg7" => "Signups (7 days)",
        "admin.stat.reg7_hint" => "New families in the last week",
        "admin.stat.sesiones" => "Sessions played",
        "admin.stat.wau" => "Active (7 days)",
        "admin.stat.wau_hint" => "Profiles active this week",
        "admin.titulo" => "Site administration",
        "admin.volver" => "Back to family",
        "aliento.mejorando" => "You're getting better! 🌟",
        "aliento.muybien" => "Great job! Keep it up 💪",
        "aliento.perfecto" => "Perfect! 🏆",
        "aliento.seguir" => "Keep practicing! 🌱",
        "app.description" => "A math game to practise operations, from primary through secondary school.",
        "app.name" => "MatHelp",
        "app.tagline" => "Math worth sharing",
        "aprender.division.card" => "Sharing into equal parts, or seeing how many times a number fits into another.",
        "aprender.division.historia" => "Dividing to share is a need as old as trade: the Egyptians were already dividing bread and grain over 3500 years ago, with methods written on papyri. The ÷ symbol (called an obelus) started being used about 360 years ago.",
        "aprender.division.intro" => "Dividing is sharing an amount into equal parts, or finding how many times one number fits into another. The result is called the quotient, the sign is ÷ (or /), and what's left over is the remainder.",
        "aprender.division.m.agrupar.ej" => "12 ÷ 3: how many groups of 3 are in 12? → 4 groups.",
        "aprender.division.m.agrupar.p1" => "Think in groups of the second number.",
        "aprender.division.m.agrupar.p2" => "Count how many complete groups you can make.",
        "aprender.division.m.agrupar.p3" => "That number of groups is the quotient.",
        "aprender.division.m.agrupar.tit" => "How many groups fit",
        "aprender.division.m.larga.ej" => "96 ÷ 4 = 24 (9 ÷ 4 = 2 remainder 1; bring down the 6 and 16 ÷ 4 = 4).",
        "aprender.division.m.larga.p1" => "Write the dividend inside the bracket and the divisor outside.",
        "aprender.division.m.larga.p2" => "Divide digit by digit from left to right, bringing down the next one each time.",
        "aprender.division.m.larga.p3" => "The number on top is the quotient; what couldn't be shared is the remainder.",
        "aprender.division.m.larga.tit" => "Long division",
        "aprender.division.m.reparto.ej" => "12 ÷ 3: I share 12 into 3 boxes → 4 in each.",
        "aprender.division.m.reparto.p1" => "Draw as many boxes as the number you divide by.",
        "aprender.division.m.reparto.p2" => "Deal one into each box, going round, until nothing is left.",
        "aprender.division.m.reparto.p3" => "What's in each box is the answer.",
        "aprender.division.m.reparto.tit" => "Sharing into equal parts",
        "aprender.division.m.restas_rep.ej" => "12 ÷ 3: 12 − 3 − 3 − 3 − 3 = 0 → I subtracted 4 times → 4.",
        "aprender.division.m.restas_rep.p1" => "Subtract the divisor over and over, until you reach 0.",
        "aprender.division.m.restas_rep.p2" => "Count how many times you could subtract.",
        "aprender.division.m.restas_rep.p3" => "That number of subtractions is the quotient.",
        "aprender.division.m.restas_rep.tit" => "Repeated subtraction",
        "aprender.division.m.tabla.ej" => "12 ÷ 3: 3 × ? = 12 → ? = 4.",
        "aprender.division.m.tabla.p1" => "Think what number, times the divisor, gives the total.",
        "aprender.division.m.tabla.p2" => "Find it in the times table.",
        "aprender.division.m.tabla.p3" => "That number is the answer to the division.",
        "aprender.division.m.tabla.tit" => "Using the table backwards",
        "aprender.division.tit" => "Division",
        "aprender.division.uso1" => "At the shop: if 12 sweets cost $60, you divide to know the price of each one.",
        "aprender.division.uso2" => "With time: if you must read 90 pages in 3 days, you divide to know how many per day.",
        "aprender.division.uso3" => "In a game: if 20 coins are shared among 4 players, you divide to know how many each one gets.",
        "aprender.ecuaciones.card" => "Finding the hidden number (the x) that makes an equality true.",
        "aprender.ecuaciones.historia" => "The word 'algebra' comes from the Arabic al-jabr, from the title of a book by the mathematician Al-Khwarizmi about 1200 years ago, which taught how to solve equations. His name also gives us the word 'algorithm'. Using the letter x for the unknown was made popular by Descartes.",
        "aprender.ecuaciones.intro" => "An equation is an equality with a hidden number, which we call x. Solving it means finding the value of x that makes both sides worth the same. The = sign is like a balance: what's on one side weighs the same as the other.",
        "aprender.ecuaciones.m.balanza.ej" => "If in x + 5 = 12 you subtract 5 from both sides, you get x = 7.",
        "aprender.ecuaciones.m.balanza.p1" => "Think of the = as a balance in equilibrium.",
        "aprender.ecuaciones.m.balanza.p2" => "Whatever you do to one side, do to the other too.",
        "aprender.ecuaciones.m.balanza.p3" => "That way the equality holds while you isolate x.",
        "aprender.ecuaciones.m.balanza.tit" => "The balance: both sides weigh the same",
        "aprender.ecuaciones.m.cuadratica.ej" => "x² = 25 → x = √25 → x = 5.",
        "aprender.ecuaciones.m.cuadratica.p1" => "If x² appears, first isolate x² alone.",
        "aprender.ecuaciones.m.cuadratica.p2" => "Apply the square root to both sides.",
        "aprender.ecuaciones.m.cuadratica.p3" => "That gives you the value of x.",
        "aprender.ecuaciones.m.cuadratica.tit" => "Equations with x² (square root)",
        "aprender.ecuaciones.m.despejar.ej" => "x + 5 = 12 → x = 12 − 5 → x = 7.",
        "aprender.ecuaciones.m.despejar.p1" => "Get x alone on one side.",
        "aprender.ecuaciones.m.despejar.p2" => "What's adding moves as subtracting (and vice versa).",
        "aprender.ecuaciones.m.despejar.p3" => "What's multiplying moves as dividing (and vice versa).",
        "aprender.ecuaciones.m.despejar.tit" => "Isolating: moving to the other side",
        "aprender.ecuaciones.m.dos_pasos.ej" => "2x + 3 = 11 → 2x = 8 → x = 4.",
        "aprender.ecuaciones.m.dos_pasos.p1" => "When x has two operations (for example 2x + 3).",
        "aprender.ecuaciones.m.dos_pasos.p2" => "First undo the addition or subtraction.",
        "aprender.ecuaciones.m.dos_pasos.p3" => "Then undo the multiplication or division.",
        "aprender.ecuaciones.m.dos_pasos.tit" => "Two-step equations",
        "aprender.ecuaciones.m.inversas.ej" => "3x = 12 → divide by 3 → x = 4.",
        "aprender.ecuaciones.m.inversas.p1" => "Each operation is undone by its inverse: + with −, × with ÷.",
        "aprender.ecuaciones.m.inversas.p2" => "Apply the inverse to free x.",
        "aprender.ecuaciones.m.inversas.p3" => "If there are several, undo one at a time, in order.",
        "aprender.ecuaciones.m.inversas.tit" => "Inverse operations (undoing)",
        "aprender.ecuaciones.tit" => "Equations",
        "aprender.ecuaciones.uso1" => "In problems: when you know the result but a value is missing, you call it x and solve for it.",
        "aprender.ecuaciones.uso2" => "In logic: 'I thought of a number, added 5 and got 12' is an equation (x + 5 = 12).",
        "aprender.ecuaciones.uso3" => "In science: formulas are equations where you solve for what you want to find.",
        "aprender.enteros.card" => "Positives and negatives: what's above and below zero.",
        "aprender.enteros.historia" => "Negative numbers took time to be accepted: Indian and Chinese mathematicians were already using them over 1500 years ago to represent debts, but in Europe they were viewed with suspicion (they were called 'absurd numbers') until about 400 years ago.",
        "aprender.enteros.intro" => "Integers are the positive numbers, zero and the negatives (…, −2, −1, 0, 1, 2, …). Negatives are for what's below zero or against: temperatures below zero, debts, basement floors. They're written with a − sign in front.",
        "aprender.enteros.m.absoluto.ej" => "|−3| = 3 and |3| = 3: both are 3 steps from 0.",
        "aprender.enteros.m.absoluto.p1" => "The absolute value is how far the number is from 0.",
        "aprender.enteros.m.absoluto.p2" => "It's always positive (or zero): the sign is ignored.",
        "aprender.enteros.m.absoluto.p3" => "It's written between bars: |−3|.",
        "aprender.enteros.m.absoluto.tit" => "Absolute value (distance to 0)",
        "aprender.enteros.m.comparar.ej" => "−4 < −1 < 0 < 3.",
        "aprender.enteros.m.comparar.p1" => "On the line, further left is smaller.",
        "aprender.enteros.m.comparar.p2" => "Careful: −4 is less than −1 (even though 4 is bigger).",
        "aprender.enteros.m.comparar.p3" => "The bigger the negative, the smaller the number.",
        "aprender.enteros.m.comparar.tit" => "Comparing and ordering negatives",
        "aprender.enteros.m.deudas.ej" => "I have 3 and owe 5 → 3 − 5 = −2 (I'm 2 in debt).",
        "aprender.enteros.m.deudas.p1" => "A positive number is what you have; a negative one is what you owe.",
        "aprender.enteros.m.deudas.p2" => "If you owe more than you have, the result stays negative.",
        "aprender.enteros.m.deudas.p3" => "This trick makes signed calculations easy.",
        "aprender.enteros.m.deudas.tit" => "Thinking of it as having and owing",
        "aprender.enteros.m.recta.ej" => "−5 is to the left of −2, so −5 is smaller.",
        "aprender.enteros.m.recta.p1" => "Place 0 in the middle: positives to the right, negatives to the left.",
        "aprender.enteros.m.recta.p2" => "The further left, the smaller the number.",
        "aprender.enteros.m.recta.p3" => "It helps to order and compare integers.",
        "aprender.enteros.m.recta.tit" => "The number line",
        "aprender.enteros.m.signos.ej" => "(−4) × (−2) = 8; (−4) × 2 = −8.",
        "aprender.enteros.m.signos.p1" => "Same signs give positive: (+)(+) and (−)(−) → +.",
        "aprender.enteros.m.signos.p2" => "Different signs give negative: (+)(−) and (−)(+) → −.",
        "aprender.enteros.m.signos.p3" => "It works for multiplying and dividing.",
        "aprender.enteros.m.signos.tit" => "Rule of signs (× and ÷)",
        "aprender.enteros.m.sumar.ej" => "(−5) + 3: from −5 I move 3 to the right → −2.",
        "aprender.enteros.m.sumar.p1" => "Start on the first number on the line.",
        "aprender.enteros.m.sumar.p2" => "If you add, go right; if you subtract, go left.",
        "aprender.enteros.m.sumar.p3" => "Where you land is the answer.",
        "aprender.enteros.m.sumar.tit" => "Adding and subtracting with signs",
        "aprender.enteros.tit" => "Integers",
        "aprender.enteros.uso1" => "Temperature: if the thermometer reads −3 °C, it's 3 degrees below zero.",
        "aprender.enteros.uso2" => "Money: if you owe $200, it's like having −200.",
        "aprender.enteros.uso3" => "Height: sea level is 0; a cave 15 m below the sea is −15.",
        "aprender.estadistica.card" => "Summarizing lots of data into a few numbers that represent them.",
        "aprender.estadistica.historia" => "The word statistics comes from 'state': at first it was used to count a country's population and wealth. Over time it became a tool for all of science to draw conclusions from data, even when there's uncertainty.",
        "aprender.estadistica.intro" => "Statistics helps you understand a set of data (grades, goals, temperatures). With a few numbers —the mean, the median, the mode, the range— you can summarize a lot of information and compare it.",
        "aprender.estadistica.m.grafico.ej" => "If Tuesday's bar reaches 5, there were 5 that day.",
        "aprender.estadistica.m.grafico.p1" => "Each bar represents an amount; its height is the value.",
        "aprender.estadistica.m.grafico.p2" => "Compare the heights to see which is bigger or smaller.",
        "aprender.estadistica.m.grafico.p3" => "The bottom axis says what each bar is.",
        "aprender.estadistica.m.grafico.tit" => "Reading a bar chart",
        "aprender.estadistica.m.mediana.ej" => "2, 5, 9 → ordered, the middle one is 5.",
        "aprender.estadistica.m.mediana.p1" => "Order the values from smallest to largest.",
        "aprender.estadistica.m.mediana.p2" => "The median is the one right in the middle.",
        "aprender.estadistica.m.mediana.p3" => "If there are two in the middle, average them.",
        "aprender.estadistica.m.mediana.tit" => "The median (the middle value)",
        "aprender.estadistica.m.moda.ej" => "3, 3, 5, 7 → the 3 appears twice → the mode is 3.",
        "aprender.estadistica.m.moda.p1" => "Look at which value appears most often.",
        "aprender.estadistica.m.moda.p2" => "That one is the mode.",
        "aprender.estadistica.m.moda.p3" => "There can be more than one, or none if nothing repeats.",
        "aprender.estadistica.m.moda.tit" => "The mode (the most frequent)",
        "aprender.estadistica.m.promedio.ej" => "Grades 6, 8 and 10 → (6 + 8 + 10) ÷ 3 = 8.",
        "aprender.estadistica.m.promedio.p1" => "Add all the values.",
        "aprender.estadistica.m.promedio.p2" => "Divide by how many values there are.",
        "aprender.estadistica.m.promedio.p3" => "It's like sharing everything into equal parts.",
        "aprender.estadistica.m.promedio.tit" => "The average (mean)",
        "aprender.estadistica.m.rango.ej" => "Data from 4 to 10 → range = 10 − 4 = 6.",
        "aprender.estadistica.m.rango.p1" => "Find the largest and the smallest value.",
        "aprender.estadistica.m.rango.p2" => "Subtract the smallest from the largest.",
        "aprender.estadistica.m.rango.p3" => "The range tells how spread out the data is.",
        "aprender.estadistica.m.rango.tit" => "The range (smallest to largest)",
        "aprender.estadistica.tit" => "Statistics",
        "aprender.estadistica.uso1" => "At school: the average of your grades summarizes how your year went.",
        "aprender.estadistica.uso2" => "In sports: the goals-per-game average compares teams.",
        "aprender.estadistica.uso3" => "In weather: the month's average temperature summarizes many days.",
        "aprender.estimacion.card" => "Working things out 'roughly', by rounding, to go fast or double-check.",
        "aprender.estimacion.historia" => "Estimating is probably the oldest use of numbers: long before exact calculations, people worked out 'by eye' how many animals, how much food or how far. It's still one of the most useful everyday math skills.",
        "aprender.estimacion.intro" => "Estimating is working out an approximate result, without looking for the exact number. You round to easy numbers and operate with them. It's useful to go fast, to check if a result makes sense, and for daily life.",
        "aprender.estimacion.m.cantidades.ej" => "If a row has ~5 and there are ~5 rows → ≈ 25.",
        "aprender.estimacion.m.cantidades.p1" => "Look at a small group and see how many there are.",
        "aprender.estimacion.m.cantidades.p2" => "Work out how many groups like that fit in total.",
        "aprender.estimacion.m.cantidades.p3" => "Multiply to estimate the total.",
        "aprender.estimacion.m.cantidades.tit" => "Estimating quantities (without counting)",
        "aprender.estimacion.m.producto_est.ej" => "19 × 21 ≈ 20 × 20 = 400 (the exact one is 399).",
        "aprender.estimacion.m.producto_est.p1" => "Round both factors to round numbers.",
        "aprender.estimacion.m.producto_est.p2" => "Multiply the rounded numbers.",
        "aprender.estimacion.m.producto_est.p3" => "It's good for knowing the order of magnitude.",
        "aprender.estimacion.m.producto_est.tit" => "Estimating a product",
        "aprender.estimacion.m.razonable.ej" => "If 48 + 37 gave you 175, the estimate (90) warns something went wrong.",
        "aprender.estimacion.m.razonable.p1" => "Before or after a calculation, estimate the result.",
        "aprender.estimacion.m.razonable.p2" => "Compare your exact result with the estimate.",
        "aprender.estimacion.m.razonable.p3" => "If they're far apart, check again: there was probably a mistake.",
        "aprender.estimacion.m.razonable.tit" => "Is it reasonable? Checking results",
        "aprender.estimacion.m.redondeo.ej" => "48 rounds to 50; 43 rounds to 40.",
        "aprender.estimacion.m.redondeo.p1" => "Look at the digit after the one you want to round.",
        "aprender.estimacion.m.redondeo.p2" => "If it's 5 or more, round up; if less than 5, round down.",
        "aprender.estimacion.m.redondeo.p3" => "The rest of the digits become zero.",
        "aprender.estimacion.m.redondeo.tit" => "Rounding to the nearest 10 or 100",
        "aprender.estimacion.m.suma_est.ej" => "48 + 37 ≈ 50 + 40 = 90 (the exact one is 85).",
        "aprender.estimacion.m.suma_est.p1" => "Round each number to an easy one.",
        "aprender.estimacion.m.suma_est.p2" => "Add the rounded numbers in your head.",
        "aprender.estimacion.m.suma_est.p3" => "You get the approximate result instantly.",
        "aprender.estimacion.m.suma_est.tit" => "Estimating a sum",
        "aprender.estimacion.tit" => "Estimation",
        "aprender.estimacion.uso1" => "When shopping: you estimate whether you have enough money before reaching the till.",
        "aprender.estimacion.uso2" => "At the supermarket: you round each price to know roughly the total.",
        "aprender.estimacion.uso3" => "With time: you estimate how long it'll take you to get somewhere.",
        "aprender.fracciones.card" => "Parts of a whole: halves, thirds, quarters…",
        "aprender.fracciones.historia" => "Fractions are very old: the Egyptians, over 3500 years ago, wrote almost everything with fractions with a numerator of 1 (like ½, ⅓, ¼). Writing them with a bar and two numbers, as we do today, came from Arab and Indian mathematicians over 1000 years ago.",
        "aprender.fracciones.intro" => "A fraction is a part of a whole. It's written with two numbers: the bottom one (denominator) tells how many equal parts the whole is split into, and the top one (numerator) how many of those parts you take. For example, ¾ is 3 out of 4 parts.",
        "aprender.fracciones.m.comparar.ej" => "½ is more than ⅓: a half shades more than a third.",
        "aprender.fracciones.m.comparar.p1" => "If they have the same denominator, the bigger numerator wins.",
        "aprender.fracciones.m.comparar.p2" => "If it differs, find equivalent fractions with the same denominator.",
        "aprender.fracciones.m.comparar.p3" => "Or compare the drawings: which one shades more.",
        "aprender.fracciones.m.comparar.tit" => "Comparing fractions",
        "aprender.fracciones.m.de_cantidad.ej" => "¾ of 12 → 12 ÷ 4 = 3 → 3 × 3 = 9.",
        "aprender.fracciones.m.de_cantidad.p1" => "Divide the amount by the bottom number (denominator).",
        "aprender.fracciones.m.de_cantidad.p2" => "Multiply the result by the top number (numerator).",
        "aprender.fracciones.m.de_cantidad.p3" => "That is the value of the fraction of that amount.",
        "aprender.fracciones.m.de_cantidad.tit" => "A fraction of an amount",
        "aprender.fracciones.m.equiv.ej" => "½ = 2/4 (I multiplied top and bottom by 2).",
        "aprender.fracciones.m.equiv.p1" => "Two fractions are equivalent if they are worth the same even if written differently.",
        "aprender.fracciones.m.equiv.p2" => "Multiply (or divide) top and bottom by the same number.",
        "aprender.fracciones.m.equiv.p3" => "In the drawing, the shaded part covers the same length.",
        "aprender.fracciones.m.equiv.tit" => "Equivalent fractions",
        "aprender.fracciones.m.leer.ej" => "¾: the whole in 4 parts, I take 3 → three quarters.",
        "aprender.fracciones.m.leer.p1" => "Look at the bottom number: how many equal parts the whole is divided into.",
        "aprender.fracciones.m.leer.p2" => "Look at the top number: how many of those parts are taken.",
        "aprender.fracciones.m.leer.p3" => "Shade that many parts to see it.",
        "aprender.fracciones.m.leer.tit" => "Reading a fraction",
        "aprender.fracciones.m.operar.ej" => "¼ + 2/4 = 3/4 (same denominator, add 1 + 2).",
        "aprender.fracciones.m.operar.p1" => "If they have the same denominator, add or subtract only the top numbers.",
        "aprender.fracciones.m.operar.p2" => "The denominator stays the same.",
        "aprender.fracciones.m.operar.p3" => "If they differ, first find equivalents with the same denominator.",
        "aprender.fracciones.m.operar.tit" => "Adding and subtracting fractions",
        "aprender.fracciones.m.simplificar.ej" => "6/8 → 6 ÷ 2 = 3 and 8 ÷ 2 = 4 → 3/4.",
        "aprender.fracciones.m.simplificar.p1" => "Find a number that divides both the top and the bottom.",
        "aprender.fracciones.m.simplificar.p2" => "Divide both by that number.",
        "aprender.fracciones.m.simplificar.p3" => "Repeat until you can't anymore: the fraction is now simpler.",
        "aprender.fracciones.m.simplificar.tit" => "Simplifying (reducing)",
        "aprender.fracciones.tit" => "Fractions",
        "aprender.fracciones.uso1" => "At the shop: asking for ¼ kilo of something is asking for a fourth of a kilogram.",
        "aprender.fracciones.uso2" => "With time: 'half an hour' is ½ hour, that is 30 minutes.",
        "aprender.fracciones.uso3" => "When sharing: if you split an 8-slice pizza among 4, each one eats 2/8, which is ¼.",
        "aprender.funciones.card" => "A machine that transforms: a number goes in, another comes out.",
        "aprender.funciones.historia" => "The idea of a function took shape over centuries, but it was Leonhard Euler, about 280 years ago, who made popular the f(x) notation we use today. Functions are the heart of mathematical analysis and of almost all modern science.",
        "aprender.funciones.intro" => "A function is a rule that assigns each input number (x) a single output (y). You can think of it as a machine: you put in an x, the function transforms it, and a y comes out. It's written f(x).",
        "aprender.funciones.m.evaluar.ej" => "f(x) = 2x + 1, so f(4) = 2 × 4 + 1 = 9.",
        "aprender.funciones.m.evaluar.p1" => "Evaluating means calculating the output for a given input.",
        "aprender.funciones.m.evaluar.p2" => "Replace x with the number everywhere in the formula.",
        "aprender.funciones.m.evaluar.p3" => "Do the arithmetic to get the result.",
        "aprender.funciones.m.evaluar.tit" => "Evaluating f(x)",
        "aprender.funciones.m.grafico.ej" => "If at x = 3 the point is at height 8, then f(3) = 8.",
        "aprender.funciones.m.grafico.p1" => "The horizontal axis is the input (x); the vertical one, the output (y).",
        "aprender.funciones.m.grafico.p2" => "Each point on the graph is a pair (x, y).",
        "aprender.funciones.m.grafico.p3" => "To read f(3), find x = 3 and look at the height of the point.",
        "aprender.funciones.m.grafico.tit" => "Reading a graph",
        "aprender.funciones.m.lineal.ej" => "f(x) = 2x: for each step to the right, it goes up 2.",
        "aprender.funciones.m.lineal.p1" => "A linear function has the form f(x) = m·x + b.",
        "aprender.funciones.m.lineal.p2" => "Its graph is a straight line; m is the slope (how much it rises) and b where it crosses.",
        "aprender.funciones.m.lineal.p3" => "With two points you can already draw it.",
        "aprender.funciones.m.lineal.tit" => "Linear function (a straight line)",
        "aprender.funciones.m.que_es.ej" => "If f(x) = x + 3, you put in 5 and 8 comes out.",
        "aprender.funciones.m.que_es.p1" => "Think of it as a machine with an input and an output.",
        "aprender.funciones.m.que_es.p2" => "You put in a number (x) and another (y) comes out, following the rule.",
        "aprender.funciones.m.que_es.p3" => "Each input has a single output.",
        "aprender.funciones.m.que_es.tit" => "What a function is (the machine)",
        "aprender.funciones.m.tabla.ej" => "f(x) = 2x + 1 → x: 1, 2, 3 give y: 3, 5, 7.",
        "aprender.funciones.m.tabla.p1" => "Pick several values of x.",
        "aprender.funciones.m.tabla.p2" => "Work out the y for each one with the formula.",
        "aprender.funciones.m.tabla.p3" => "The table gives you the points to draw the function.",
        "aprender.funciones.m.tabla.tit" => "Table of values",
        "aprender.funciones.tit" => "Functions",
        "aprender.funciones.uso1" => "In economics: the total price is a function of the amount you buy.",
        "aprender.funciones.uso2" => "In weather: the temperature is a function of the time of day.",
        "aprender.funciones.uso3" => "On a trip: the distance traveled is a function of time and speed.",
        "aprender.geometria.card" => "Measuring shapes: the edge (perimeter) and the surface (area).",
        "aprender.geometria.historia" => "Geometry was born from the need to measure land: the word comes from the Greek geo (earth) and metria (measure). The Egyptians used it over 4000 years ago to re-mark fields after the Nile floods. The Greek Euclid organized it all in a book about 2300 years ago.",
        "aprender.geometria.intro" => "Geometry studies shapes: how big they are and what form they have. Two key measures are the perimeter (the sum of all sides, the edge) and the area (the surface it covers inside, measured in unit squares).",
        "aprender.geometria.m.area_rect.ej" => "Base 5, height 3 → 5 × 3 = 15 unit squares.",
        "aprender.geometria.m.area_rect.p1" => "Count how many unit squares fit across (the base).",
        "aprender.geometria.m.area_rect.p2" => "Count how many rows there are (the height).",
        "aprender.geometria.m.area_rect.p3" => "Multiply base by height: that is the area.",
        "aprender.geometria.m.area_rect.tit" => "Area of a rectangle: base × height",
        "aprender.geometria.m.area_tri.ej" => "Base 6, height 4 → 6 × 4 = 24 → 24 ÷ 2 = 12.",
        "aprender.geometria.m.area_tri.p1" => "A triangle is half of a rectangle with the same width and height.",
        "aprender.geometria.m.area_tri.p2" => "Work out base × height, the whole rectangle.",
        "aprender.geometria.m.area_tri.p3" => "Divide by 2.",
        "aprender.geometria.m.area_tri.tit" => "Area of a triangle: base × height ÷ 2",
        "aprender.geometria.m.circulo.ej" => "Radius 5: circumference ≈ 31.4; area ≈ 78.5 (with π ≈ 3.14).",
        "aprender.geometria.m.circulo.p1" => "The radius (r) goes from the center to the edge.",
        "aprender.geometria.m.circulo.p2" => "The circumference (the edge) is 2 × π × r.",
        "aprender.geometria.m.circulo.p3" => "The area (the inside) is π × r × r.",
        "aprender.geometria.m.circulo.tit" => "The circle (circumference and area)",
        "aprender.geometria.m.compuesta.ej" => "An L-shape: I split it into two rectangles, measure each and add them.",
        "aprender.geometria.m.compuesta.p1" => "Split the odd shape into rectangles or triangles you know how to measure.",
        "aprender.geometria.m.compuesta.p2" => "Work out the area of each part.",
        "aprender.geometria.m.compuesta.p3" => "Add the areas (or subtract, if it's a hole).",
        "aprender.geometria.m.compuesta.tit" => "Compound shapes: split into simple ones",
        "aprender.geometria.m.perimetro.ej" => "A rectangle of 5 and 3: 5 + 3 + 5 + 3 = 16.",
        "aprender.geometria.m.perimetro.p1" => "Check how long each side of the shape is.",
        "aprender.geometria.m.perimetro.p2" => "Add all the sides, going all the way around.",
        "aprender.geometria.m.perimetro.p3" => "That total is the perimeter, the length of the edge.",
        "aprender.geometria.m.perimetro.tit" => "Perimeter: add all the sides",
        "aprender.geometria.tit" => "Geometry",
        "aprender.geometria.uso1" => "At home: to know how much baseboard to buy for a room, you work out the perimeter.",
        "aprender.geometria.uso2" => "When decorating: to know how much paint or paper fits on a wall, you work out the area.",
        "aprender.geometria.uso3" => "When building: floor plans use perimeters and areas to measure land and rooms.",
        "aprender.historia" => "A bit of history",
        "aprender.hora.card" => "Reading the clock: the hands, the hours and the minutes.",
        "aprender.hora.historia" => "Measuring time is very old: the Egyptians used sundials over 3500 years ago, and water clocks for the night. Dividing the hour into 60 minutes comes from the Babylonians, who counted in 60s. Mechanical clocks with hands appeared about 700 years ago.",
        "aprender.hora.intro" => "Telling time means understanding the clock. On an analog clock there are two hands: the short one shows the hour and the long one the minutes. A full turn is 60 minutes = 1 hour, and the day has 24 hours.",
        "aprender.hora.m.aguja.ej" => "Short hand on 2, long hand on 12 → it's 2 o'clock.",
        "aprender.hora.m.aguja.p1" => "The short hand shows the hour (which number it points to).",
        "aprender.hora.m.aguja.p2" => "The long hand shows the minutes (counting 5 per number).",
        "aprender.hora.m.aguja.p3" => "First read the hour, then the minutes.",
        "aprender.hora.m.aguja.tit" => "The two hands",
        "aprender.hora.m.cuartos.ej" => "Long hand on 3, short just past 3 → quarter past 3 (3:15).",
        "aprender.hora.m.cuartos.p1" => "Each quarter turn is 15 minutes.",
        "aprender.hora.m.cuartos.p2" => "Long hand on 3 → quarter past; on 6 → half past; on 9 → quarter to.",
        "aprender.hora.m.cuartos.p3" => "Count in 5s at each number for the exact minutes.",
        "aprender.hora.m.cuartos.tit" => "Quarter past, half, quarter to",
        "aprender.hora.m.digital.ej" => "15:30 is half past 3 in the afternoon (15 − 12 = 3).",
        "aprender.hora.m.digital.p1" => "A digital clock shows hour:minutes directly (3:15).",
        "aprender.hora.m.digital.p2" => "In 24-hour format, the afternoon keeps counting: 1 p.m. is 13:00.",
        "aprender.hora.m.digital.p3" => "To go from 24-hour to the afternoon, subtract 12.",
        "aprender.hora.m.digital.tit" => "Digital clocks and the 24-hour format",
        "aprender.hora.m.duracion.ej" => "From 3:00 to 5:30, 2 hours and 30 minutes pass.",
        "aprender.hora.m.duracion.p1" => "Subtract the start time from the end time.",
        "aprender.hora.m.duracion.p2" => "Count the hours and the minutes separately.",
        "aprender.hora.m.duracion.p3" => "If the minutes aren't enough, borrow 1 hour (60 min).",
        "aprender.hora.m.duracion.tit" => "How much passed / is left (duration)",
        "aprender.hora.m.en_punto.ej" => "Long hand on 12, short on 3 → 3 o'clock.",
        "aprender.hora.m.en_punto.p1" => "If the long hand is on 12, it's an o'clock time.",
        "aprender.hora.m.en_punto.p2" => "If the long hand is on 6, it's half past (30 minutes).",
        "aprender.hora.m.en_punto.p3" => "The short hand tells you which hour it is.",
        "aprender.hora.m.en_punto.tit" => "O'clock and half past",
        "aprender.hora.tit" => "Telling time",
        "aprender.hora.uso1" => "During the day: reading the time tells you when school or recess starts.",
        "aprender.hora.uso2" => "When traveling: bus or train schedules are read in hours and minutes.",
        "aprender.hora.uso3" => "To organize yourself: setting an alarm or working out how long is left uses the time.",
        "aprender.memoria.card" => "Locking in the results you use all the time to calculate fast from memory.",
        "aprender.memoria.historia" => "Before calculators, everyone did their sums in their head or on paper, and memorizing the tables was a central part of school. Mental math still trains memory and concentration, besides being super practical.",
        "aprender.memoria.intro" => "Many calculations come out faster if you know the results by heart, without having to work them out each time: the times tables, doubles, the pairs that add to 10. The more you have memorized, the easier everything else becomes.",
        "aprender.memoria.m.descomponer.ej" => "8 × 7 = 8 × 5 + 8 × 2 = 40 + 16 = 56.",
        "aprender.memoria.m.descomponer.p1" => "Break the numbers into easy parts.",
        "aprender.memoria.m.descomponer.p2" => "Work out each part from memory.",
        "aprender.memoria.m.descomponer.p3" => "Put the results together.",
        "aprender.memoria.m.descomponer.tit" => "Mental math by breaking apart",
        "aprender.memoria.m.dobles.ej" => "8 + 8 = 16, so 8 + 9 = 17.",
        "aprender.memoria.m.dobles.p1" => "Memorize the doubles: 6 + 6, 7 + 7, 8 + 8…",
        "aprender.memoria.m.dobles.p2" => "Doubles help with many nearby sums.",
        "aprender.memoria.m.dobles.p3" => "For 7 + 8, think 7 + 7 = 14 and add 1 → 15.",
        "aprender.memoria.m.dobles.tit" => "Doubles and halves",
        "aprender.memoria.m.parejas.ej" => "7 + 5 ↔ 12; 6 × 4 ↔ 24; 15 − 8 ↔ 7.",
        "aprender.memoria.m.parejas.p1" => "Practice by matching each calculation to its result (like a memory game).",
        "aprender.memoria.m.parejas.p2" => "Repeating those pairs helps them come out automatically.",
        "aprender.memoria.m.parejas.p3" => "Start with the ones used most.",
        "aprender.memoria.m.parejas.tit" => "Linking an expression to its result",
        "aprender.memoria.m.tablas.ej" => "If you know 6 × 7 = 42, you also know 7 × 6 = 42.",
        "aprender.memoria.m.tablas.p1" => "Learn one table at a time, starting with the easy ones (2, 5, 10).",
        "aprender.memoria.m.tablas.p2" => "Use the fact that a × b = b × a (half of them repeat).",
        "aprender.memoria.m.tablas.p3" => "Review a bit every day: repetition locks it in.",
        "aprender.memoria.m.tablas.tit" => "The times tables",
        "aprender.memoria.tit" => "Memory and mental math",
        "aprender.memoria.uso1" => "In class: knowing the times tables by heart lets you solve much faster.",
        "aprender.memoria.uso2" => "At the shop: working out the total and the change in your head without a calculator.",
        "aprender.memoria.uso3" => "In games: the faster you calculate, the more points you score.",
        "aprender.metodos" => "Ways to solve it",
        "aprender.multiplicacion.card" => "Adding the same number many times, the short way.",
        "aprender.multiplicacion.historia" => "Multiplication was born so people wouldn't have to add over and over. Times tables have been used for over 4000 years: the Babylonians already carved them into clay tablets. The × sign was made popular by the mathematician William Oughtred about 400 years ago.",
        "aprender.multiplicacion.intro" => "Multiplying is a short way of adding the same number several times. Instead of 4 + 4 + 4, you say 3 × 4. The result is called the product, and the sign is × (or ·).",
        "aprender.multiplicacion.m.array.ej" => "3 × 4: 3 rows of 4 dots = 12 dots.",
        "aprender.multiplicacion.m.array.p1" => "Draw as many rows as the first number.",
        "aprender.multiplicacion.m.array.p2" => "In each row put as many dots as the second number.",
        "aprender.multiplicacion.m.array.p3" => "The total number of dots is the answer.",
        "aprender.multiplicacion.m.array.tit" => "Array (rows by columns)",
        "aprender.multiplicacion.m.columna.ej" => "24 × 3: 3 × 4 = 12 (write 2, carry 1); 3 × 2 = 6 + 1 = 7 → 72.",
        "aprender.multiplicacion.m.columna.p1" => "Write one number under the other, lining up the ones.",
        "aprender.multiplicacion.m.columna.p2" => "Multiply each bottom digit by the top ones, carrying whatever goes over 9.",
        "aprender.multiplicacion.m.columna.p3" => "Add the partial results.",
        "aprender.multiplicacion.m.columna.tit" => "Column multiplication",
        "aprender.multiplicacion.m.descomp.ej" => "6 × 13 → 6 × 10 = 60 and 6 × 3 = 18 → 60 + 18 = 78.",
        "aprender.multiplicacion.m.descomp.p1" => "Split the bigger number into tens and ones.",
        "aprender.multiplicacion.m.descomp.p2" => "Multiply each part separately.",
        "aprender.multiplicacion.m.descomp.p3" => "Add the two results.",
        "aprender.multiplicacion.m.descomp.tit" => "Multiplying in parts",
        "aprender.multiplicacion.m.grupos.ej" => "3 × 4: three groups of 4 → 4, 8, 12.",
        "aprender.multiplicacion.m.grupos.p1" => "Make as many groups as the first number says.",
        "aprender.multiplicacion.m.grupos.p2" => "Put the same amount in each group: the second number.",
        "aprender.multiplicacion.m.grupos.p3" => "Count them all together: that is the product.",
        "aprender.multiplicacion.m.grupos.tit" => "Equal groups",
        "aprender.multiplicacion.m.saltos.ej" => "3 × 4: I jump by 3 → 3, 6, 9, 12. It's 12.",
        "aprender.multiplicacion.m.saltos.p1" => "Instead of counting by ones, jump by groups.",
        "aprender.multiplicacion.m.saltos.p2" => "Jump as many times as the other number.",
        "aprender.multiplicacion.m.saltos.p3" => "The number you land on is the product.",
        "aprender.multiplicacion.m.saltos.tit" => "Skip counting (jumping by n)",
        "aprender.multiplicacion.m.tabla.ej" => "Table of 4: 4, 8, 12… so 4 × 3 = 12.",
        "aprender.multiplicacion.m.tabla.p1" => "Learn the table of the number you're multiplying.",
        "aprender.multiplicacion.m.tabla.p2" => "Find the matching result.",
        "aprender.multiplicacion.m.tabla.p3" => "Once you know the table, it comes from memory.",
        "aprender.multiplicacion.m.tabla.tit" => "Using the times table",
        "aprender.multiplicacion.tit" => "Multiplication",
        "aprender.multiplicacion.uso1" => "At the shop: if you buy 3 snacks at $150 each, you multiply to know how much you pay.",
        "aprender.multiplicacion.uso2" => "With time: if you train 30 minutes a day, you multiply by 5 to know your weekly total.",
        "aprender.multiplicacion.uso3" => "In a game: if each level gives you 20 points and you cleared 4, you multiply for the total.",
        "aprender.ordenar.card" => "Deciding which number is bigger or smaller, and putting them in order.",
        "aprender.ordenar.historia" => "The signs < and > (less than and greater than) were invented by the English mathematician Thomas Harriot about 400 years ago. They're easy to remember: the open, bigger side always faces the bigger number, and the point faces the smaller one.",
        "aprender.ordenar.intro" => "Comparing is deciding which of two numbers is bigger, smaller, or if they're equal. Ordering is arranging several from smallest to largest (or the other way). We use the signs < (less than), > (greater than) and = (equal).",
        "aprender.ordenar.m.cifras.ej" => "352 and 348: hundreds tie; 5 > 4 in the tens → 352 > 348.",
        "aprender.ordenar.m.cifras.p1" => "The one with more digits is bigger (325 > 47).",
        "aprender.ordenar.m.cifras.p2" => "If they have the same number of digits, compare from left to right.",
        "aprender.ordenar.m.cifras.p3" => "The first digit that differs decides.",
        "aprender.ordenar.m.cifras.tit" => "Comparing by digits",
        "aprender.ordenar.m.comparar.ej" => "3 < 8 (3 is smaller); 8 > 3 (8 is bigger).",
        "aprender.ordenar.m.comparar.p1" => "Look at the two numbers and decide which is bigger.",
        "aprender.ordenar.m.comparar.p2" => "The sign < or > 'opens' toward the bigger number.",
        "aprender.ordenar.m.comparar.p3" => "If they're equal, you use the = sign.",
        "aprender.ordenar.m.comparar.tit" => "Comparing two numbers (< > =)",
        "aprender.ordenar.m.decimales.ej" => "0.7 and 0.65: whole part equal; 7 tenths > 6 tenths → 0.7 > 0.65.",
        "aprender.ordenar.m.decimales.p1" => "With decimals, first compare the whole part.",
        "aprender.ordenar.m.decimales.p2" => "If it ties, continue with tenths, hundredths…",
        "aprender.ordenar.m.decimales.p3" => "For fractions, it helps to bring them to a common denominator or to a decimal.",
        "aprender.ordenar.m.decimales.tit" => "Comparing decimals and fractions",
        "aprender.ordenar.m.recta.ej" => "On the line, 2 comes before 5 and 5 before 9 → 2 < 5 < 9.",
        "aprender.ordenar.m.recta.p1" => "On the line, numbers grow to the right.",
        "aprender.ordenar.m.recta.p2" => "The one further right is the bigger.",
        "aprender.ordenar.m.recta.p3" => "It's handy for ordering several at a glance.",
        "aprender.ordenar.m.recta.tit" => "Placing on the number line",
        "aprender.ordenar.tit" => "Ordering and comparing",
        "aprender.ordenar.uso1" => "In a race or a game: ordering the scores tells who's winning.",
        "aprender.ordenar.uso2" => "When measuring: comparing heights, weights or distances to know which is more.",
        "aprender.ordenar.uso3" => "With money: comparing prices helps you pick the cheapest.",
        "aprender.porcentaje.card" => "A part out of every 100: it's in prices, discounts and grades.",
        "aprender.porcentaje.historia" => "The idea of counting 'per hundred' comes from ancient Rome, where taxes were charged as a part of every 100. The word 'percent' comes from the Latin per centum, 'for each hundred'. The % sign appeared about 400 years ago, from a distortion of the abbreviation for 'cento'.",
        "aprender.porcentaje.intro" => "A percentage is a way of saying 'how many out of every 100'. 25% means 25 out of every 100. It's like a fraction with denominator 100, and the sign is %.",
        "aprender.porcentaje.m.cuanto_es.ej" => "15 out of 60: 15 ÷ 60 = 0.25 → × 100 = 25%.",
        "aprender.porcentaje.m.cuanto_es.p1" => "When you want to know what % a part is of the total.",
        "aprender.porcentaje.m.cuanto_es.p2" => "Divide the part by the total.",
        "aprender.porcentaje.m.cuanto_es.p3" => "Multiply by 100 to turn it into a percentage.",
        "aprender.porcentaje.m.cuanto_es.tit" => "What percentage it is (the inverse)",
        "aprender.porcentaje.m.descuento.ej" => "20% of $500 = $100. With the discount: 500 − 100 = $400.",
        "aprender.porcentaje.m.descuento.p1" => "Work out the percentage of the price.",
        "aprender.porcentaje.m.descuento.p2" => "For a discount, subtract it from the price; for a surcharge, add it.",
        "aprender.porcentaje.m.descuento.p3" => "That is the final price.",
        "aprender.porcentaje.m.descuento.tit" => "Discounts and surcharges",
        "aprender.porcentaje.m.diez.ej" => "15% of 80: 10% = 8 and 5% = 4 → 8 + 4 = 12.",
        "aprender.porcentaje.m.diez.p1" => "For 10%, move the decimal one place (or divide by 10).",
        "aprender.porcentaje.m.diez.p2" => "5% is half of 10%; 20% is double.",
        "aprender.porcentaje.m.diez.p3" => "Combine those pieces to build the percentage you want.",
        "aprender.porcentaje.m.diez.tit" => "Finding 10% and combining",
        "aprender.porcentaje.m.fraccion.ej" => "25% = 25 out of 100 = ¼ of the total.",
        "aprender.porcentaje.m.fraccion.p1" => "Imagine the total split into 100 equal parts.",
        "aprender.porcentaje.m.fraccion.p2" => "The percentage is how many of those parts you take.",
        "aprender.porcentaje.m.fraccion.p3" => "25% is taking 25 of the 100 parts.",
        "aprender.porcentaje.m.fraccion.tit" => "Thinking of it as parts of 100",
        "aprender.porcentaje.m.regla3.ej" => "15% of 80: 80 × 15 ÷ 100 = 12.",
        "aprender.porcentaje.m.regla3.p1" => "Write that the total is 100%.",
        "aprender.porcentaje.m.regla3.p2" => "Cross-multiply: total × percentage ÷ 100.",
        "aprender.porcentaje.m.regla3.p3" => "The result is the value of the percentage.",
        "aprender.porcentaje.m.regla3.tit" => "Rule of three",
        "aprender.porcentaje.tit" => "Percentage",
        "aprender.porcentaje.uso1" => "On a sale: a 20% discount on something worth $500 saves you $100.",
        "aprender.porcentaje.uso2" => "On your phone: an 80% battery is almost the full charge; at 100% it's full.",
        "aprender.porcentaje.uso3" => "On a test: if you got 9 of 10 right, your score is 90%.",
        "aprender.potencias.card" => "Multiplying a number by itself many times, the short way.",
        "aprender.potencias.historia" => "The idea of powers is old, but writing the exponent up high (like 2³) was made popular by René Descartes about 400 years ago. Before, it was written in words or by repeating the letter. Powers of 10 make astronomy and physics manageable.",
        "aprender.potencias.intro" => "A power is multiplying a number by itself several times. In 2³, the 2 is the base and the 3 is the exponent: it means 2 × 2 × 2 = 8. The square root is the inverse operation: √25 = 5 because 5² = 25.",
        "aprender.potencias.m.cuadrado.ej" => "5² = 5 × 5 = 25.",
        "aprender.potencias.m.cuadrado.p1" => "Squaring is multiplying a number by itself.",
        "aprender.potencias.m.cuadrado.p2" => "It's called 'square' because it's the area of a square with that side.",
        "aprender.potencias.m.cuadrado.p3" => "5² is a square with side 5: 25 unit squares.",
        "aprender.potencias.m.cuadrado.tit" => "Squares (raising to the 2)",
        "aprender.potencias.m.diez.ej" => "10³ = 1000; and 30000 = 3 × 10⁴.",
        "aprender.potencias.m.diez.p1" => "A power of 10 is a 1 followed by as many zeros as the exponent.",
        "aprender.potencias.m.diez.p2" => "They're used to write huge or tiny numbers in a short way.",
        "aprender.potencias.m.diez.p3" => "In scientific notation: a number between 1 and 10, times a power of 10.",
        "aprender.potencias.m.diez.tit" => "Powers of 10 and scientific notation",
        "aprender.potencias.m.que_es.ej" => "2³ = 2 × 2 × 2 = 8.",
        "aprender.potencias.m.que_es.p1" => "The base is the number that repeats.",
        "aprender.potencias.m.que_es.p2" => "The exponent (up high) says how many times it's multiplied.",
        "aprender.potencias.m.que_es.p3" => "Multiply the base by itself that many times.",
        "aprender.potencias.m.que_es.tit" => "What a power is",
        "aprender.potencias.m.raiz.ej" => "√25 = 5, because 5 × 5 = 25.",
        "aprender.potencias.m.raiz.p1" => "The square root asks: what number squared gives this?",
        "aprender.potencias.m.raiz.p2" => "It's undoing a square.",
        "aprender.potencias.m.raiz.p3" => "Find the number that, times itself, gives the one inside.",
        "aprender.potencias.m.raiz.tit" => "The square root (the inverse)",
        "aprender.potencias.m.reglas.ej" => "2³ · 2² = 2⁵ = 32; and 2⁰ = 1.",
        "aprender.potencias.m.reglas.p1" => "To multiply powers with the same base, add the exponents.",
        "aprender.potencias.m.reglas.p2" => "To divide them, subtract the exponents.",
        "aprender.potencias.m.reglas.p3" => "Any number (except 0) raised to 0 gives 1.",
        "aprender.potencias.m.reglas.tit" => "Rules of powers",
        "aprender.potencias.tit" => "Powers and roots",
        "aprender.potencias.uso1" => "In science: very big or very small numbers are written with powers of 10 (3 × 10⁸).",
        "aprender.potencias.uso2" => "In computing: memory is measured in powers of 2 (1 KB = 2¹⁰ bytes).",
        "aprender.potencias.uso3" => "In growth: something that doubles again and again grows like a power.",
        "aprender.practicar" => "Practice in a game",
        "aprender.problemas.card" => "The steps to understand a problem and find the calculation that solves it.",
        "aprender.problemas.historia" => "Teaching how to solve problems step by step became famous with the mathematician George Pólya, who about 80 years ago wrote a book called 'How to Solve It', with four steps still used in schools all over the world.",
        "aprender.problemas.intro" => "A word problem is a story with numbers where you have to find something out. The hard part usually isn't the arithmetic, but understanding what's being asked and choosing which operation to use. With a few ordered steps, almost any problem becomes easy.",
        "aprender.problemas.m.datos.ej" => "Data: 12 stickers, gave away 5. Unknown: how many are left.",
        "aprender.problemas.m.datos.p1" => "Underline the numbers and what each one means.",
        "aprender.problemas.m.datos.p2" => "Separate what you know from what you need to find.",
        "aprender.problemas.m.datos.p3" => "Watch for data that isn't needed: not all of it is used.",
        "aprender.problemas.m.datos.tit" => "2. Find the data",
        "aprender.problemas.m.dibujar.ej" => "I have 12 and one part is 5: the drawing shows the other is 12 − 5 = 7.",
        "aprender.problemas.m.dibujar.p1" => "Draw what the problem says (a simple diagram).",
        "aprender.problemas.m.dibujar.p2" => "Mark what you know and what you're looking for.",
        "aprender.problemas.m.dibujar.p3" => "The drawing makes it clear which operation to use.",
        "aprender.problemas.m.dibujar.tit" => "Draw a picture or diagram",
        "aprender.problemas.m.entender.ej" => "'I had 12 stickers and gave away 5' → they ask how many are left.",
        "aprender.problemas.m.entender.p1" => "Read it all calmly, without rushing to calculate.",
        "aprender.problemas.m.entender.p2" => "Say in your own words what's happening in the story.",
        "aprender.problemas.m.entender.p3" => "Make sure you know exactly what's being asked.",
        "aprender.problemas.m.entender.tit" => "1. Understand the problem",
        "aprender.problemas.m.operacion.ej" => "'Gave away' takes away, so I subtract: 12 − 5 = 7.",
        "aprender.problemas.m.operacion.p1" => "Think about what action the story describes.",
        "aprender.problemas.m.operacion.p2" => "Putting together → add; taking away or comparing → subtract; equal groups → multiply or divide.",
        "aprender.problemas.m.operacion.p3" => "Write the calculation and solve it.",
        "aprender.problemas.m.operacion.tit" => "3. Choose the operation",
        "aprender.problemas.m.verificar.ej" => "7 stickers are left. It makes sense: it's less than 12.",
        "aprender.problemas.m.verificar.p1" => "Re-read the question and check if your number answers it.",
        "aprender.problemas.m.verificar.p2" => "Is the result reasonable? Estimate to double-check.",
        "aprender.problemas.m.verificar.p3" => "Write the answer in words, not just the number.",
        "aprender.problemas.m.verificar.tit" => "4. Check the answer",
        "aprender.problemas.tit" => "Solving word problems",
        "aprender.problemas.uso1" => "At school: most math exercises come as problems to read.",
        "aprender.problemas.uso2" => "At the shop: 'is it enough and how much change do I get?' is a real-life problem.",
        "aprender.problemas.uso3" => "In life: sharing, comparing prices or working out times are everyday problems.",
        "aprender.resta.card" => "Taking away or comparing amounts to find what's left or what's missing.",
        "aprender.resta.historia" => "Subtraction is as old as addition: the peoples who counted with pebbles or marks also took away to share or compare. The − (minus) sign appeared together with + in Europe about 500 years ago, in merchants' books.",
        "aprender.resta.intro" => "Subtracting means taking away, or finding the difference between two amounts. When you take a part out of a total, or want to know how much is missing, you are subtracting. The result is called the difference, and the sign we use is −.",
        "aprender.resta.m.columna.ej" => "43 − 15: 3 − 5 can't be done, borrow 1 → 13 − 5 = 8. Then 3 − 1 = 2. It is 28.",
        "aprender.resta.m.columna.p1" => "Write the bigger number on top and the other below, lining up the ones.",
        "aprender.resta.m.columna.p2" => "Subtract the right column. If the top digit is smaller, borrow 1 ten: add 10 to the ones and take 1 from the tens.",
        "aprender.resta.m.columna.p3" => "Subtract the next column, accounting for what you borrowed.",
        "aprender.resta.m.columna.tit" => "Column subtraction (borrowing)",
        "aprender.resta.m.contar_hasta.ej" => "12 − 8: from 8 I count 9, 10, 11, 12 → I counted 4. It's 4.",
        "aprender.resta.m.contar_hasta.p1" => "Start at the smaller number.",
        "aprender.resta.m.contar_hasta.p2" => "Count forward until you reach the bigger one.",
        "aprender.resta.m.contar_hasta.p3" => "What you counted is the answer.",
        "aprender.resta.m.contar_hasta.tit" => "Counting up (the difference)",
        "aprender.resta.m.descomp.ej" => "43 − 15 → 43 − 10 = 33 → 33 − 5 = 28.",
        "aprender.resta.m.descomp.p1" => "First take away the tens of the second number.",
        "aprender.resta.m.descomp.p2" => "Then take away the ones.",
        "aprender.resta.m.descomp.p3" => "What's left is the difference.",
        "aprender.resta.m.descomp.tit" => "Subtracting in parts (tens, then ones)",
        "aprender.resta.m.mental.ej" => "43 − 19 → 43 − 20 = 23 → since I took 1 too many, I add 1 → 24.",
        "aprender.resta.m.mental.p1" => "Round the number you subtract to the nearest 10.",
        "aprender.resta.m.mental.p2" => "Do the rounded subtraction in your head.",
        "aprender.resta.m.mental.p3" => "Adjust the result by what you rounded.",
        "aprender.resta.m.mental.tit" => "Mental math (round and adjust)",
        "aprender.resta.m.objetos.ej" => "5 sweets and I take 2 away: 3 are left.",
        "aprender.resta.m.objetos.p1" => "Start with the bigger amount, the total.",
        "aprender.resta.m.objetos.p2" => "Take away or cross out as many as the second number says.",
        "aprender.resta.m.objetos.p3" => "Count what's left: that is the answer.",
        "aprender.resta.m.objetos.tit" => "Taking away objects or counting back",
        "aprender.resta.m.recta.ej" => "7 − 3: I stand on 7 and jump 3 back → 6, 5, 4. It is 4.",
        "aprender.resta.m.recta.p1" => "Find the bigger number on the line and stand there.",
        "aprender.resta.m.recta.p2" => "Jump to the left as many places as the second number says.",
        "aprender.resta.m.recta.p3" => "The number you land on is the answer.",
        "aprender.resta.m.recta.tit" => "Jumping back on the number line",
        "aprender.resta.tit" => "Subtraction",
        "aprender.resta.uso1" => "At the shop: if you pay $200 for something that costs $150, you subtract to know the change.",
        "aprender.resta.uso2" => "With time: if the movie lasts 90 minutes and you've watched 35, you subtract to know how much is left.",
        "aprender.resta.uso3" => "In a game: if you had 12 lives and lost 4, you subtract to know how many are left.",
        "aprender.series.card" => "Discovering the rule that a list of numbers or shapes follows.",
        "aprender.series.historia" => "Looking for patterns in numbers is as old as mathematics. A famous sequence is Fibonacci's (1, 1, 2, 3, 5, 8…), described about 800 years ago, where each number is the sum of the two before it. It shows up surprisingly often in nature.",
        "aprender.series.intro" => "A sequence is a list of numbers or shapes that follows a rule. The challenge is to discover that rule to know how it continues. Finding patterns is one of the foundations of mathematical thinking.",
        "aprender.series.m.decrecientes.ej" => "20, 17, 14, 11… subtracts 3 → next is 8.",
        "aprender.series.m.decrecientes.p1" => "Sometimes the sequence doesn't grow: it goes down by the same amount.",
        "aprender.series.m.decrecientes.p2" => "Look at how much is subtracted (or divided) each time.",
        "aprender.series.m.decrecientes.p3" => "Keep going down with that rule.",
        "aprender.series.m.decrecientes.tit" => "Decreasing sequences (subtract or divide)",
        "aprender.series.m.especiales.ej" => "1, 1, 2, 3, 5, 8… → next is 13 (5 + 8).",
        "aprender.series.m.especiales.p1" => "Some sequences have more clever rules.",
        "aprender.series.m.especiales.p2" => "Squares: 1, 4, 9, 16… (1², 2², 3², 4²).",
        "aprender.series.m.especiales.p3" => "Fibonacci: each number is the sum of the two before it.",
        "aprender.series.m.especiales.tit" => "Famous sequences (squares, Fibonacci)",
        "aprender.series.m.figuras.ej" => "🔺🔵🔺🔵… triangle-circle repeats → next is the triangle.",
        "aprender.series.m.figuras.p1" => "Look at what repeats: colors, shapes, amounts.",
        "aprender.series.m.figuras.p2" => "Find the block that repeats (the pattern).",
        "aprender.series.m.figuras.p3" => "Repeat it to know which shape comes next.",
        "aprender.series.m.figuras.tit" => "Patterns with shapes",
        "aprender.series.m.multiplicar.ej" => "2, 4, 8, 16… multiplies by 2 → next is 32.",
        "aprender.series.m.multiplicar.p1" => "Check if each number is the previous one times the same factor.",
        "aprender.series.m.multiplicar.p2" => "If it always multiplies the same, that's the rule.",
        "aprender.series.m.multiplicar.p3" => "These sequences grow much faster than the adding ones.",
        "aprender.series.m.multiplicar.tit" => "Always multiplying by the same",
        "aprender.series.m.sumar_fijo.ej" => "2, 4, 6, 8… adds 2 each time → next is 10.",
        "aprender.series.m.sumar_fijo.p1" => "Look at how much it changes from one number to the next.",
        "aprender.series.m.sumar_fijo.p2" => "If it always adds the same, that's the rule.",
        "aprender.series.m.sumar_fijo.p3" => "Keep adding that number to continue the sequence.",
        "aprender.series.m.sumar_fijo.tit" => "Always adding the same",
        "aprender.series.tit" => "Sequences and patterns",
        "aprender.series.uso1" => "In daily life: the days of the week and the months are sequences that repeat.",
        "aprender.series.uso2" => "In music: rhythm is a pattern that repeats over time.",
        "aprender.series.uso3" => "In nature: petals, spirals and shells follow number patterns.",
        "aprender.sub" => "Understand how each calculation works: what it is for, a bit of history, and several ways to solve it. Pick a topic.",
        "aprender.suma.card" => "Putting amounts together to find the total.",
        "aprender.suma.historia" => "Adding is one of humanity's oldest ideas. Thousands of years ago, shepherds kept one pebble for each sheep so they would not lose count: gathering pebbles was already adding. The + sign we use today started being used in Europe about 500 years ago.",
        "aprender.suma.intro" => "Adding means putting things together. When you put two amounts together and want to know how many there are in total, you are adding. The result is called the sum or total, and the sign we use is +.",
        "aprender.suma.m.columna.ej" => "28 + 15: 8 + 5 = 13, write 3 and carry 1. Then 1 + 2 + 1 = 4. It is 43.",
        "aprender.suma.m.columna.p1" => "Write one number under the other, lining up ones with ones.",
        "aprender.suma.m.columna.p2" => "Add the right-hand column. If the result is more than 9, write the ones digit and carry 1 to the next column.",
        "aprender.suma.m.columna.p3" => "Add the next column without forgetting what you carried.",
        "aprender.suma.m.columna.tit" => "Column addition (carrying)",
        "aprender.suma.m.descomp.ej" => "28 + 15 → (20 + 10) and (8 + 5) → 30 + 13 = 43.",
        "aprender.suma.m.descomp.p1" => "Split each number into tens and ones.",
        "aprender.suma.m.descomp.p2" => "Add the tens on one side and the ones on the other.",
        "aprender.suma.m.descomp.p3" => "Put the two results together to get the total.",
        "aprender.suma.m.descomp.tit" => "Breaking into tens and ones",
        "aprender.suma.m.mental.ej" => "28 + 15: I think 30 + 15 = 45, and since I added 2 extra, I subtract 2 → 43.",
        "aprender.suma.m.mental.p1" => "Round one number to the nearest 10 so the sum is easy.",
        "aprender.suma.m.mental.p2" => "Do the rounded sum in your head.",
        "aprender.suma.m.mental.p3" => "Adjust the result by what you added or removed when rounding.",
        "aprender.suma.m.mental.tit" => "Mental math (round and adjust)",
        "aprender.suma.m.objetos.ej" => "3 apples and 2 apples: 1, 2, 3… 4, 5. That is 5 apples.",
        "aprender.suma.m.objetos.p1" => "Put the two groups together into a single pile.",
        "aprender.suma.m.objetos.p2" => "Count everything from the start, one by one.",
        "aprender.suma.m.objetos.p3" => "The last number you say is the total.",
        "aprender.suma.m.objetos.tit" => "Counting with objects or fingers",
        "aprender.suma.m.recta.ej" => "4 + 3: I stand on 4 and jump 3 places → 5, 6, 7. It is 7.",
        "aprender.suma.m.recta.p1" => "Find the first number on the line and stand there.",
        "aprender.suma.m.recta.p2" => "Jump to the right as many places as the second number says.",
        "aprender.suma.m.recta.p3" => "The number you land on is the answer.",
        "aprender.suma.m.recta.tit" => "Jumping on the number line",
        "aprender.suma.tit" => "Addition",
        "aprender.suma.uso1" => "At the shop: if you buy something for $120 and something else for $80, you add to know how much you pay in total.",
        "aprender.suma.uso2" => "With time: if you read for 25 minutes today and 15 yesterday, you add to know how long you read across both days.",
        "aprender.suma.uso3" => "In a game: if you scored 8 points in one round and 5 in another, you add to know your total score.",
        "aprender.titulo" => "Learn",
        "aprender.trigonometria.card" => "Measuring triangles: relating their sides to their angles.",
        "aprender.trigonometria.historia" => "Trigonometry was born looking at the sky: astronomers in Greece, India and the Arab world developed it over 2000 years ago to measure the position of stars and planets. The words sine and cosine came through translations from Arabic and Sanskrit.",
        "aprender.trigonometria.intro" => "Trigonometry studies triangles, especially right triangles (those with a 90° angle). It relates the length of the sides to the angles, and is used to work out distances and heights that can't be measured directly.",
        "aprender.trigonometria.m.angulos.ej" => "With sin(30°) = 1/2, if the hypotenuse is 10, the opposite is 5.",
        "aprender.trigonometria.m.angulos.p1" => "Some angles have sine and cosine values that are easy to remember.",
        "aprender.trigonometria.m.angulos.p2" => "sin(30°) = 1/2, sin(45°) ≈ 0.71, sin(60°) ≈ 0.87.",
        "aprender.trigonometria.m.angulos.p3" => "They come up all the time in problems.",
        "aprender.trigonometria.m.angulos.tit" => "Special angles (30°, 45°, 60°)",
        "aprender.trigonometria.m.aplicacion.ej" => "Shadow 6 m, angle 45° (tan = 1) → height = 6 m.",
        "aprender.trigonometria.m.aplicacion.p1" => "An object and its shadow form a right triangle with the sun ray.",
        "aprender.trigonometria.m.aplicacion.p2" => "With the sun's angle and the shadow's length, you find the height.",
        "aprender.trigonometria.m.aplicacion.p3" => "height = shadow × tangent of the angle.",
        "aprender.trigonometria.m.aplicacion.tit" => "Real application (height from the shadow)",
        "aprender.trigonometria.m.pitagoras.ej" => "Legs 3 and 4 → 3² + 4² = 9 + 16 = 25 → hypotenuse = √25 = 5.",
        "aprender.trigonometria.m.pitagoras.p1" => "In a right triangle, the two short sides are the legs and the long one is the hypotenuse.",
        "aprender.trigonometria.m.pitagoras.p2" => "The square of the hypotenuse equals the sum of the squares of the legs.",
        "aprender.trigonometria.m.pitagoras.p3" => "With two sides you can find the third.",
        "aprender.trigonometria.m.pitagoras.tit" => "The Pythagorean theorem",
        "aprender.trigonometria.m.razones.ej" => "sin(30°) = 1/2: the opposite is half the hypotenuse.",
        "aprender.trigonometria.m.razones.p1" => "For an angle there's an opposite side, an adjacent one and the hypotenuse.",
        "aprender.trigonometria.m.razones.p2" => "sine = opposite ÷ hypotenuse, cosine = adjacent ÷ hypotenuse, tangent = opposite ÷ adjacent.",
        "aprender.trigonometria.m.razones.p3" => "SOH-CAH-TOA helps you remember which is which.",
        "aprender.trigonometria.m.razones.tit" => "Sine, cosine and tangent (SOH-CAH-TOA)",
        "aprender.trigonometria.m.terna.ej" => "Legs 6 and 8 → it's double 3-4-5 → hypotenuse 10.",
        "aprender.trigonometria.m.terna.p1" => "Some right triangles have whole-number sides that come up a lot.",
        "aprender.trigonometria.m.terna.p2" => "The most famous is 3-4-5 (and its multiples: 6-8-10).",
        "aprender.trigonometria.m.terna.p3" => "If you recognize the triple, you know the third side instantly.",
        "aprender.trigonometria.m.terna.tit" => "Known triples (3-4-5)",
        "aprender.trigonometria.tit" => "Trigonometry",
        "aprender.trigonometria.uso1" => "In construction: to work out the height of a roof or the slope of a ramp.",
        "aprender.trigonometria.uso2" => "With a ladder: knowing the angle and the length, you work out how high it reaches.",
        "aprender.trigonometria.uso3" => "In navigation and maps: to locate points and measure distances.",
        "aprender.truco_link" => "See the related trick",
        "aprender.tu_metodo" => "For your grade",
        "aprender.usos" => "What is it for?",
        "aprender.volumen.card" => "The space a body takes up: how many unit cubes fit inside.",
        "aprender.volumen.historia" => "One of the most famous stories in mathematics is Archimedes and volume: over 2200 years ago, getting into his bathtub, he discovered that a submerged body displaces its own volume of water. He ran out shouting 'Eureka!' ('I found it!').",
        "aprender.volumen.intro" => "Volume is the space a body takes up (a box, a can, a pool). It's measured in unit cubes: how many 1-by-1-by-1 cubes fit inside. The units are cm³, m³ and also litres.",
        "aprender.volumen.m.capacidad.ej" => "A 2-litre bottle is 2000 cm³.",
        "aprender.volumen.m.capacidad.p1" => "Volume is also measured as capacity: litres and millilitres.",
        "aprender.volumen.m.capacidad.p2" => "A cube 10 cm on each side holds 1 litre.",
        "aprender.volumen.m.capacidad.p3" => "1 litre = 1000 cm³ = 1000 ml.",
        "aprender.volumen.m.capacidad.tit" => "Capacity: litres and cm³",
        "aprender.volumen.m.cilindro.ej" => "Radius 2, height 5 → 3.14 × 2 × 2 × 5 ≈ 63 cm³.",
        "aprender.volumen.m.cilindro.p1" => "The base is a circle: its area is π × radius × radius.",
        "aprender.volumen.m.cilindro.p2" => "Multiply that area by the height.",
        "aprender.volumen.m.cilindro.p3" => "Use π ≈ 3.14 (or 3 to estimate).",
        "aprender.volumen.m.cilindro.tit" => "Cylinder: circle area × height",
        "aprender.volumen.m.cubos.ej" => "A box of 3 × 2 × 2 → 6 per layer × 2 layers = 12 cubes.",
        "aprender.volumen.m.cubos.p1" => "Imagine the body filled with 1 × 1 × 1 cubes.",
        "aprender.volumen.m.cubos.p2" => "Count how many cubes are in one layer (length × width).",
        "aprender.volumen.m.cubos.p3" => "Multiply by the number of layers (the height).",
        "aprender.volumen.m.cubos.tit" => "Counting unit cubes",
        "aprender.volumen.m.prisma.ej" => "Base of 3 × 2 = 6, height 4 → 6 × 4 = 24 cm³.",
        "aprender.volumen.m.prisma.p1" => "Work out the area of the base (the bottom face).",
        "aprender.volumen.m.prisma.p2" => "Multiply that area by the height of the body.",
        "aprender.volumen.m.prisma.p3" => "That is the volume of the prism.",
        "aprender.volumen.m.prisma.tit" => "Prism: base area × height",
        "aprender.volumen.tit" => "Volume",
        "aprender.volumen.uso1" => "When moving: the volume of the boxes tells how much fits in the truck.",
        "aprender.volumen.uso2" => "In the kitchen: a juice carton shows its volume in litres or cm³.",
        "aprender.volumen.uso3" => "At home: to fill a pool or a bathtub, its volume matters.",
        "aprender.volver" => "Back to Learn",
