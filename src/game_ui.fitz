// game_ui.fitz — piezas de UI compartidas por las pantallas de fin de ronda de
// todos los juegos (pulido general). Antes cada `*_resumen` armaba su q-done a
// mano; esto agrega, en un solo lugar, las ESTRELLAS por precisión + una línea de
// ALIENTO, para que el cierre de cualquier juego sea más rico y motivador.

from fitz_liveviews import html, flv
from i18n import t, t1

// Insignia de RACHA (aciertos seguidos en la ronda). Vacía si < 2 (no distrae con
// rachas triviales); a partir de 2 muestra 🔥N, y a partir de 5 "arde" (pulso).
fn racha_badge(racha: Int) -> Str {
    if (racha < 2) {
        return ""
    }
    let hot = match racha >= 5 {
        true => " hot",
        false => "",
    }
    return html("""<span class="q-racha{hot}" aria-label="racha {racha}">🔥{racha}</span>""").raw
}

// Barra de progreso de la ronda (cuántos de `limit`). `limit` <= 0 → vacía (los
// juegos por reloj no tienen meta fija).
fn progreso_bar(total: Int, limit: Int) -> Str {
    if (limit <= 0) {
        return ""
    }
    let pct = total * 100 / limit
    let pct2 = match pct > 100 {
        true => 100,
        false => pct,
    }
    return html("""<div class="q-progress" aria-hidden="true"><span class="q-progress-fill" style="width:{pct2}%"></span></div>""").raw
}

// Mensaje de acierto VARIADO: rota entre cuatro frases positivas según `seq` (el
// nº de respuesta), para que el elogio no sea siempre el mismo.
fn correcto_msg(locale: Str, seq: Int) -> Str {
    let v = seq % 4
    if (v == 1) {
        return t(locale, "juego.correcto2")
    }
    if (v == 2) {
        return t(locale, "juego.correcto3")
    }
    if (v == 3) {
        return t(locale, "juego.correcto4")
    }
    return t(locale, "juego.correcto")
}

// Mensaje de error VARIADO y amable: rota entre tres frases que dan aliento (nunca
// regañan) y muestran la respuesta correcta `resp`.
fn incorrecto_msg(locale: Str, seq: Int, resp: Str) -> Str {
    let v = seq % 3
    if (v == 1) {
        return t1(locale, "juego.incorrecto2", resp)
    }
    if (v == 2) {
        return t1(locale, "juego.incorrecto3", resp)
    }
    return t1(locale, "juego.incorrecto", resp)
}

// Estrellas (0..3) según la precisión de la ronda + una frase de aliento acorde.
//   100% → ★★★ ¡Perfecto!   ≥70% → ★★☆ ¡Muy bien!
//   ≥40% → ★☆☆ ¡Vas mejorando!   <40% → ☆☆☆ ¡Seguí practicando!
// Devuelve HTML crudo listo para insertar en el bloque q-done.
fn resumen_estrellas(locale: Str, correct: Int, total: Int) -> Str {
    let pct = match total > 0 {
        true => correct * 100 / total,
        false => 0,
    }
    let llenas = 0
    if (pct >= 40) {
        llenas = 1
    }
    if (pct >= 70) {
        llenas = 2
    }
    if (pct >= 100) {
        llenas = 3
    }
    let estrellas = ""
    let i = 0
    while (i < 3) {
        if (i < llenas) {
            estrellas = estrellas + html("""<span class="star on">★</span>""").raw
        }
        if (i >= llenas) {
            estrellas = estrellas + html("""<span class="star">☆</span>""").raw
        }
        i = i + 1
    }
    let aliento_key = match llenas {
        3 => "aliento.perfecto",
        2 => "aliento.muybien",
        1 => "aliento.mejorando",
        _ => "aliento.seguir",
    }
    let aliento = flv(t(locale, aliento_key))
    // Ronda perfecta (★★★): las estrellas brillan + lluvia de confetti.
    let extra = match llenas == 3 {
        true => " perfect",
        false => "",
    }
    let confetti = match llenas == 3 {
        true => confetti_html(),
        false => "",
    }
    return html("""{confetti}<div class="mh-estrellas{extra}" role="img" aria-label="{correct}/{total}">{estrellas}</div>
<p class="mh-aliento">{aliento}</p>""").raw
}

// Lluvia de confetti (CSS puro) para la ronda perfecta. 12 piezas; cada `.cf<i>`
// tiene su posición/color/retardo en brand.fitz. `aria-hidden` (decorativo).
fn confetti_html() -> Str {
    let piezas = ""
    let i = 0
    while (i < 12) {
        piezas = piezas + html("""<span class="cf cf{i}"></span>""").raw
        i = i + 1
    }
    return html("""<div class="mh-confetti" aria-hidden="true">{piezas}</div>""").raw
}
