// cookies.fitz — MÓDULO AISLADO.
//
// Fitz v0.47.0 no tiene API de cookies (docs/guide.md:11436 lo pone fuera
// del MVP). Pero la cookie es el ÚNICO mecanismo viable acá: el browser no
// manda `Authorization` ni en una navegación normal ni en el handshake del
// WebSocket — sí manda cookies, solo.
//
// Este es el módulo más delicado de los siete aislados: un parser de cookies
// mal escrito es un agujero de seguridad. Por eso vive en UN solo lugar,
// auditable, en vez de repetido por toda la app.
//
// Migra a `@cookie` + `Response.cookies` cuando exista.
// Ver docs/norte-mathelp.md · FITZ-05.

// Lee una cookie del header `Cookie` entrante. Devuelve "" si no está.
//
// OJO — por qué devuelve Str y no Str?:
// El codegen de Fitz v0.47.0 rompe cuando una función declara `-> Str?` y
// hace `return null` o `return <valor>` adentro. Emite `return ()` en vez de
// `return None`, y el valor sin envolver en `Some(...)`. `fitz check` y
// `fitz run` lo aceptan; `fitz build` falla con E0308.
// (El mismo bug afecta a `flv_cookie` dentro de fitz-liveviews.)
// Repro y detalle en docs/BUG-fitz-option-codegen.md.
//
// El centinela "" evita el bug por completo, y para una cookie es
// indistinguible de ausente.
fn read_cookie(header: Str?, name: Str) -> Str {
    let raw = match header {
        null => "",
        h => h,
    }
    if (raw == "") {
        return ""
    }
    for parte in raw.split(";") {
        let kv = parte.trim().split("=")
        if (kv.len() >= 2) {
            if (kv[0] == name) {
                return kv[1]
            }
        }
    }
    return ""
}

fn read_cookie_or(header: Str?, name: Str, fallback: Str) -> Str {
    let v = read_cookie(header, name)
    if (v == "") {
        return fallback
    }
    return v
}

// Arma el valor de un header `Set-Cookie`.
//
// `http_only: true` para la sesión (JS no la puede leer → no se filtra por
// XSS). `false` solo para cosas no sensibles como el idioma.
// SameSite=Lax corta CSRF en navegaciones cross-site sin romper el flujo
// normal de links.
fn set_cookie(name: Str, value: Str, max_age: Int, http_only: Bool) -> Str {
    let base = name + "=" + value + "; Path=/; SameSite=Lax; Max-Age={max_age}"
    if (http_only) {
        return base + "; HttpOnly"
    }
    return base
}

// Cookie de sesión: HttpOnly, 24 h.
fn set_session_cookie(name: Str, token: Str) -> Str {
    return set_cookie(name, token, 86400, true)
}

// Cookie de idioma: legible por JS (no es sensible), 1 año.
fn set_lang_cookie(name: Str, locale: Str) -> Str {
    return set_cookie(name, locale, 31536000, false)
}

// Borrar una cookie = setearla vencida.
fn clear_cookie(name: Str) -> Str {
    return name + "=; Path=/; Max-Age=0; HttpOnly"
}
