// auth.fitz — registro, login y logout de la cuenta de familia.
//
// **Sin JavaScript.** El login es un `<form method="POST">` nativo: el
// browser manda `application/x-www-form-urlencoded` y Fitz lo deserializa
// al `type` del handler igual que un body JSON.
//
// **Sesión stateless con JWT + cookie HttpOnly.** No hay tabla de sesiones:
// la cookie `mathelp_session` lleva un JWT firmado con `jwt_secret()`. Los
// claims son `Map<Str, Str>` (limitación del MVP de jwt.encode), así que
// guardamos `email` (único en el schema) y, cuando se elige perfil, `pid`.
// Resolver la familia por email cada request es un lookup por el índice
// UNIQUE de la columna — barato y sin estado en el server.
//
// **Control explícito, no `@auth_provider`.** El provider built-in falla
// con 401 JSON; nosotros queremos redirect 303 a /login. Por eso leemos la
// cookie a mano con `@cookie(...)` + `jwt.decode`. Ver read_session().

from fitz_liveviews import Html, html, flv
from config import db_url, jwt_secret, session_cookie_name, default_locale
from i18n import t, locale_from_cookie
from layout import page_landing, responder_html
from models import Family, Profile
from emails import notify_admin_signup, send_welcome, send_milestone, es_hito
from ratelimit import ip_de, registrar_y_chequear
from referral_db import record_referral

// --- Sesión: emitir y leer ------------------------------------------------

// Emite el JWT de la familia. `pid` vacío = todavía no eligió perfil. `adm` = "1"
// cuando la sesión pasó el PIN de adulto (zona familia/control), "0" cuando juega.
// `tea` = "1" cuando la cuenta es de un maestro (se decide al login/registro, así
// el home no consulta la DB en cada carga — ver es_teacher_token).
fn mint_session(email: Str, pid: Str, adm: Str, tea: Str) -> Str {
    let claims = { "email": email, "pid": pid, "adm": adm, "tea": tea }
    return jwt.encode(claims, jwt_secret())
}

// Resuelve la familia desde la cookie de sesión. Err si falta o es inválida
// — el handler protegido traduce ese Err en un 303 a /login.
async fn read_session(session: Str?) -> Result<Family> {
    let token = match session {
        null => return Err("sin sesión"),
        s => s,
    }
    let claims = jwt.decode(token, jwt_secret())?
    let email: Str = match claims.get("email") {
        Ok(v) => v,
        Err(_) => return Err("token sin claim email"),
    }
    let conn = db.connect(db_url()).await?
    return Family.where(fn(f) => f.email == email).first(conn).await
}

// Perfil activo guardado en el token (Str vacío si no hay). No toca la DB.
fn pid_from_token(session: Str?) -> Str {
    let token = match session {
        null => return "",
        s => s,
    }
    let claims = match jwt.decode(token, jwt_secret()) {
        Ok(c) => c,
        Err(_) => return "",
    }
    // jwt.decode devuelve Map<Str, __FitzValue>; claims.get(...) da Result<Any>.
    // El codegen coacciona el arm Ok (__FitzValue → Str) porque el arm Err fija
    // el LUB en Str. Sin pid (perfil no elegido) es un caso válido → "".
    return match claims.get("pid") {
        Ok(v) => v,
        Err(_) => "",
    }
}

// ¿La sesión pasó el PIN de adulto? Claim "adm" == "1". Tokens viejos (sin el
// claim) devuelven "0" → no admin, deben pasar por /familia/pin. No toca la DB.
fn adm_from_token(session: Str?) -> Str {
    let token = match session {
        null => return "0",
        s => s,
    }
    let claims = match jwt.decode(token, jwt_secret()) {
        Ok(c) => c,
        Err(_) => return "0",
    }
    return match claims.get("adm") {
        Ok(v) => v,
        Err(_) => "0",
    }
}

// Gate de la zona de control familiar. Un handler de control corta con este check
// y, si es false, redirige a /familia/pin.
fn es_admin(session: Str?) -> Bool {
    return adm_from_token(session) == "1"
}

// ¿La sesión es de un maestro? Claim "tea" == "1". No toca la DB (a diferencia de
// es_teacher, que consulta account_type). Se setea al login/registro. Tokens viejos
// (sin el claim) devuelven "0" → un maestro con token previo re-loguea una vez.
fn tea_from_token(session: Str?) -> Str {
    let token = match session {
        null => return "0",
        s => s,
    }
    let claims = match jwt.decode(token, jwt_secret()) {
        Ok(c) => c,
        Err(_) => return "0",
    }
    return match claims.get("tea") {
        Ok(v) => v,
        Err(_) => "0",
    }
}

// Gate de maestro para el hot path (home): lee el claim, sin DB. Los handlers del
// panel usan es_teacher (DB, autoritativo) para no lockear tokens viejos.
fn es_teacher_token(session: Str?) -> Bool {
    return tea_from_token(session) == "1"
}

// Response de redirect que setea (o pisa) la cookie de sesión HttpOnly.
// secure:false por ahora — MatHelp corre en la red de casa sin HTTPS; con
// secure:true el browser no mandaría la cookie sobre http. Deuda: activar
// secure detrás de un proxy TLS en producción (junto con JWT_SECRET real).
fn redirect_con_sesion(destino: Str, token: Str) -> Response {
    return Response {
        status: 303,
        content_type: "text/html; charset=utf-8",
        cookies: [
            Cookie {
                name: session_cookie_name(),
                value: token,
                path: "/",
                http_only: true,
                same_site: "Lax",
                max_age: 604800,
            },
        ],
        headers: { "Location": destino },
        body: "",
    }
}

// Igual que redirect_con_sesion pero además setea las cookies de PREFERENCIAS del
// perfil (F9 pulido): al elegir un perfil, su tema de color + accesibilidad (alto
// contraste, tamaño de fuente) se aplican en todas las páginas.
fn redirect_con_sesion_prefs(destino: Str, token: Str, theme: Str, contrast: Str, font: Str) -> Response {
    return Response {
        status: 303,
        content_type: "text/html; charset=utf-8",
        cookies: [
            Cookie {
                name: session_cookie_name(),
                value: token,
                path: "/",
                http_only: true,
                same_site: "Lax",
                max_age: 604800,
            },
            Cookie {
                name: "mathelp_theme",
                value: theme,
                path: "/",
                same_site: "Lax",
                max_age: 31536000,
            },
            Cookie {
                name: "mathelp_contrast",
                value: contrast,
                path: "/",
                same_site: "Lax",
                max_age: 31536000,
            },
            Cookie {
                name: "mathelp_font",
                value: font,
                path: "/",
                same_site: "Lax",
                max_age: 31536000,
            },
        ],
        headers: { "Location": destino },
        body: "",
    }
}

// --- DB: crear y autenticar familia --------------------------------------

async fn crear_familia(email: Str, display_name: Str, password: Str, locale: Str) -> Result<Family> {
    let conn = db.connect(db_url()).await?
    // Email único: mensaje amigable en vez del UNIQUE violation crudo.
    match Family.where(fn(f) => f.email == email).first(conn).await {
        Ok(_) => return Err("email ya registrado"),
        Err(_) => 0,
    }
    let ph = hash.password(password)
    return Family.insert(conn, Family {
        id: 0,
        email: email,
        password_hash: ph,
        display_name: display_name,
        locale: locale,
        created_at: "",
    }).await
}

async fn autenticar(email: Str, password: Str) -> Result<Family> {
    let conn = db.connect(db_url()).await?
    let fam: Family = match Family.where(fn(f) => f.email == email).first(conn).await {
        Ok(f) => f,
        Err(_) => return Err("credenciales inválidas"),
    }
    // hash.verify devuelve Bool; hash malformado → false (nunca panic).
    if (not hash.verify(password, fam.password_hash)) {
        return Err("credenciales inválidas")
    }
    return Ok(fam)
}

// --- Acceso propio por perfil (Opción B) ---------------------------------
//
// Un perfil puede tener LOGIN INDEPENDIENTE: el chico entra a SU perfil desde su
// dispositivo con el email de la familia + su propia contraseña, sin que el jefe
// entre antes. El jefe lo habilita por perfil desde la Zona Familia; el chico
// crea su contraseña la primera vez en /activar (con un código de un solo uso).
//
// Las 3 columnas van por SQL crudo + ALTER lazy (NO en el @table Profile), igual
// que admin_pin: así los SELECT del ORM sobre profiles no fallan en una base que
// todavía no tiene las columnas.
//   login_enabled   BOOLEAN  el jefe habilitó el acceso propio
//   login_hash      TEXT     contraseña del chico (Argon2). '' = todavía sin crear
//   activation_code TEXT     código de un solo uso para el primer acceso. '' = ya activó

// Resultado de un login/activación de perfil: lo justo para mintear + aplicar prefs.
type PerfilAuth {
    pid: Str = ""
    theme: Str = "default"
    contrast: Str = "normal"
    font_size: Str = "normal"
}

// Crea las columnas de login por perfil si faltan (base ya existente). Idempotente.
async fn asegurar_login_cols() -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let _ = conn.exec("ALTER TABLE profiles ADD COLUMN IF NOT EXISTS login_enabled BOOLEAN NOT NULL DEFAULT false", []).await
    let _ = conn.exec("ALTER TABLE profiles ADD COLUMN IF NOT EXISTS login_hash TEXT NOT NULL DEFAULT ''", []).await
    return conn.exec("ALTER TABLE profiles ADD COLUMN IF NOT EXISTS activation_code TEXT NOT NULL DEFAULT ''", []).await
}

// ¿El password matchea algún perfil con acceso propio de esta familia? El login
// primero prueba la cuenta (jefe); si falla, cae acá. Recorre los perfiles con
// login habilitado y contraseña creada, y verifica el Argon2 de cada uno.
async fn autenticar_perfil(email: Str, password: Str) -> Result<PerfilAuth> {
    let _ = asegurar_login_cols().await
    let conn = db.connect(db_url()).await?
    let fam: Family = match Family.where(fn(f) => f.email == email).first(conn).await {
        Ok(f) => f,
        Err(_) => return Err("credenciales inválidas"),
    }
    let rows = conn.query("SELECT id, login_hash, theme, contrast, font_size FROM profiles WHERE family_id = $1 AND login_enabled = true AND login_hash <> ''", [fam.id]).await?
    for r in rows {
        let h = match r.get_str("login_hash") {
            Ok(v) => v,
            Err(_) => "",
        }
        if (h != "" and hash.verify(password, h)) {
            let pid = match r.get_int("id") {
                Ok(n) => n,
                Err(_) => 0,
            }
            let theme = match r.get_str("theme") {
                Ok(v) => v,
                Err(_) => "default",
            }
            let contrast = match r.get_str("contrast") {
                Ok(v) => v,
                Err(_) => "normal",
            }
            let fs = match r.get_str("font_size") {
                Ok(v) => v,
                Err(_) => "normal",
            }
            return Ok(PerfilAuth { pid: "{pid}", theme: theme, contrast: contrast, font_size: fs })
        }
    }
    return Err("credenciales inválidas")
}

// Primer acceso del chico: valida email + código, guarda su contraseña (hash) y
// consume el código. Devuelve el perfil para mintear la sesión y entrar directo.
async fn activar_perfil(email: Str, codigo: Str, password: Str) -> Result<PerfilAuth> {
    let _ = asegurar_login_cols().await
    let conn = db.connect(db_url()).await?
    let fam: Family = match Family.where(fn(f) => f.email == email).first(conn).await {
        Ok(f) => f,
        Err(_) => return Err("no coincide"),
    }
    let rows = conn.query("SELECT id, theme, contrast, font_size FROM profiles WHERE family_id = $1 AND login_enabled = true AND activation_code = $2 AND activation_code <> ''", [fam.id, codigo]).await?
    if (rows.len() == 0) {
        return Err("código inválido")
    }
    let pid = match rows[0].get_int("id") {
        Ok(n) => n,
        Err(_) => return Err("código inválido"),
    }
    let ph = hash.password(password)
    let _ = conn.exec("UPDATE profiles SET login_hash = $2, activation_code = '' WHERE id = $1", [pid, ph]).await
    let theme = match rows[0].get_str("theme") {
        Ok(v) => v,
        Err(_) => "default",
    }
    let contrast = match rows[0].get_str("contrast") {
        Ok(v) => v,
        Err(_) => "normal",
    }
    let fs = match rows[0].get_str("font_size") {
        Ok(v) => v,
        Err(_) => "normal",
    }
    return Ok(PerfilAuth { pid: "{pid}", theme: theme, contrast: contrast, font_size: fs })
}

// --- PINs hasheados (migración lazy) -----------------------------------------
//
// profiles.pin (PIN por-perfil) y families.admin_pin (PIN de adulto) arrancaron
// en TEXTO PLANO. Ahora se guardan hasheados (Argon2). La migración es LAZY: al
// validar, si el valor guardado no empieza con "$" (texto plano de una cuenta
// vieja), se compara directo y el caller lo re-guarda hasheado. Los PINs nuevos
// nacen hasheados. Un hash Argon2 (PHC) siempre empieza con "$argon2...".

// Prepara un PIN para guardarlo: hasheado si no está vacío; "" (sin PIN) tal cual.
fn hash_pin(pin: Str) -> Str {
    if (pin == "") {
        return ""
    }
    return hash.password(pin)
}

// ¿El PIN ingresado matchea el guardado? Acepta guardado hasheado (empieza con
// "$") o en texto plano (cuenta vieja sin migrar). NO migra: el caller re-guarda
// hasheado si el guardado venía en texto plano (mirando `.starts_with("$")`).
fn pin_verifica(guardado: Str, ingresado: Str) -> Bool {
    if (guardado.starts_with("$")) {
        return hash.verify(ingresado, guardado)
    }
    return guardado == ingresado
}

// --- account_type (rol de la cuenta: individual / family / teacher) ------------
//
// Solo se consulta para "¿es maestro?"; individual vs familia se sigue derivando
// del admin_pin (sin tocar esa lógica). Columna lazy (patrón admin_pin), NO en el
// @table Family, para no romper el SELECT del ORM en read_session en una base que
// todavía no tiene la columna.

async fn asegurar_account_type() -> Result<Int> {
    let conn = db.connect(db_url()).await?
    return conn.exec("ALTER TABLE families ADD COLUMN IF NOT EXISTS account_type TEXT NOT NULL DEFAULT 'family'", []).await
}

// Setea el rol de la cuenta ("individual" | "family" | "teacher").
async fn set_account_type(email: Str, tipo: Str) -> Result<Int> {
    let _ = asegurar_account_type().await
    let conn = db.connect(db_url()).await?
    return conn.exec("UPDATE families SET account_type = $2 WHERE email = $1", [email, tipo]).await
}

// ¿La cuenta es de un maestro? Best-effort (columna lazy: si no existe → false).
// NO corre asegurar_account_type: la columna la crean la migración 0025 (base nueva)
// y set_account_type (registro). Si aún no existe, la query falla → false (seguro).
// Se llama solo en login/registro y en los gates del panel, no en el home (claim).
async fn es_teacher(email: Str) -> Bool {
    let conn = match db.connect(db_url()).await {
        Ok(c) => c,
        Err(_) => { return false },
    }
    let rows = match conn.query("SELECT account_type FROM families WHERE email = $1", [email]).await {
        Ok(r) => r,
        Err(_) => { return false },
    }
    if (rows.len() == 0) {
        return false
    }
    return match rows[0].get_str("account_type") {
        Ok(v) => v == "teacher",
        Err(_) => false,
    }
}

// --- Forms HTML ----------------------------------------------------------

fn form_login(locale: Str, email: Str, hay_error: Bool) -> Html {
    let err = match hay_error {
        true => html("""<div class="mh-error">{flv(t(locale, "login.error"))}</div>""").raw,
        false => "",
    }
    let email_esc = flv(email)
    return html("""<div class="mh-card">
<h2>{flv(t(locale, "login.titulo"))}</h2>
{err}
<form method="POST" action="/login">
<div class="mh-field">
<label class="mh-label" for="email">{flv(t(locale, "login.email"))}</label>
<input class="mh-input" id="email" name="email" type="email" value="{email_esc}" autocomplete="email" inputmode="email" required />
</div>
<div class="mh-field">
<label class="mh-label" for="password">{flv(t(locale, "login.password"))}</label>
<input class="mh-input" id="password" name="password" type="password" autocomplete="current-password" required />
</div>
<button class="mh-btn" type="submit">{flv(t(locale, "login.submit"))}</button>
</form>
<a class="mh-link" href="/recuperar">{flv(t(locale, "recuperar.link"))}</a>
<a class="mh-link" href="/aula"><span aria-hidden="true">🏫</span> {flv(t(locale, "aula.entrar_link"))}</a>
<a class="mh-link" href="/activar">{flv(t(locale, "login.activar"))}</a>
<a class="mh-link" href="/registro">{flv(t(locale, "login.crear_cuenta"))}</a>
</div>""")
}

