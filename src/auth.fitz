</form>
<a class="mh-link" href="/login">{flv(t(locale, "activar.ya"))}</a>
</div>""")
}

// --- Rate limiting (anti fuerza bruta) -----------------------------------

// Middleware Pre para /login y /registro: solo cuenta los POST (los intentos
// reales); los GET (ver el form) pasan. Fail-open ante error de DB. Vive acá
// (mismo módulo que login_post/registro_post) para no cruzar el `return <status>`
// entre módulos. Los helpers de DB están en ratelimit.fitz.
async fn rate_limit_mw(req: Request) -> Null {
    if (req.method != "POST") {
        return null
    }
    let ip = ip_de(req)
    let bloqueado = match registrar_y_chequear(ip, req.path).await {
        Ok(b) => b,
        Err(_) => false,
    }
    if (bloqueado) {
        return 429 {"error": t(default_locale(), "ratelimit.error")}
    }
    return null
}

// --- Handlers ------------------------------------------------------------

type LoginForm {
    email: Str = ""
    password: Str = ""
}

type RegistroForm {
    // `familia` captura el nombre que se tipeó en el registro. Para una cuenta
    // individual es el nombre de la persona (se usa como su perfil); para una
    // cuenta familiar es el nombre inicial de la familia (renombrable luego en
    // la Zona Familia). El name del input sigue siendo "familia" por
    // compatibilidad — el label visible cambia a "Tu nombre".
    familia: Str = ""
    email: Str = ""
    password: Str = ""
    // Qué botón del registro se apretó: "jugar" (individual → a jugar directo)
    // o "familia" (→ configurar la Zona Familia y crear perfiles). Los dos
    // <button> comparten name="accion" con distinto value; el browser manda el
    // del que se clickeó. Vacío/desconocido = "jugar" (el camino sin fricción).
    accion: Str = ""
}

type ActivarForm {
    email: Str = ""
    codigo: Str = ""
    password: Str = ""
    password2: Str = ""
}

@cookie(name="mathelp_lang", into="lang")
@get("/login")
fn login_get(lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    return responder_html(page_landing(locale, t(locale, "login.titulo") + " — MatHelp", form_login(locale, "", false), html("")))
}

@middleware(rate_limit_mw)
@cookie(name="mathelp_lang", into="lang")
@post("/login")
async fn login_post(lang: Str?, creds: LoginForm) -> Response {
    let locale = locale_from_cookie(lang)
    match autenticar(creds.email, creds.password).await {
        Ok(fam) => {
            // Maestro → su panel (no juega, no elige perfil). Jefe/individual →
            // al selector (o auto-salto si es cuenta individual). El resultado va
            // también al claim "tea" para que el home no vuelva a consultar la DB.
            let teacher = es_teacher(fam.email).await
            let tea = match teacher {
                true => "1",
                false => "0",
            }
            let token = mint_session(fam.email, "", "0", tea)
            let destino = match teacher {
                true => "/maestro",
                false => "/perfiles",
            }
            return redirect_con_sesion(destino, token)
        }
        Err(_) => {
            // No es el jefe: ¿es un perfil con acceso propio? Entra directo a SU menú.
            match autenticar_perfil(creds.email, creds.password).await {
                Ok(pa) => {
                    let token = mint_session(creds.email, pa.pid, "0", "0")
                    return redirect_con_sesion_prefs("/", token, pa.theme, pa.contrast, pa.font_size)
                }
                Err(_) => {
                    let cuerpo = form_login(locale, creds.email, true)
                    return responder_html(page_landing(locale, t(locale, "login.titulo") + " — MatHelp", cuerpo, html("")))
                }
            }
        }
    }
}

@cookie(name="mathelp_lang", into="lang")
@get("/registro")
fn registro_get(lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    return responder_html(page_landing(locale, t(locale, "registro.titulo") + " — MatHelp", form_registro(locale, "", "", ""), html("")))
}

// Emails post-registro (aviso al dueño + bienvenida). Best-effort: los helpers
// atrapan sus propios errores y con el guard de mailer devuelven al instante si
// no hay email configurado, así que no demoran el alta de forma perceptible.
// `@background` autoriza el `spawn(signup_emails(fam))` fire-and-forget de
// `registro_post` (los errores de runtime de la task se loguean — FITZ-27).
@background
async fn signup_emails(fam: Family, tipo: Str) -> Null {
    let _admin = notify_admin_signup(fam).await
    let _welcome = send_welcome(fam, tipo).await
    let _hito = chequear_hito().await
    return null
}

// Cuenta el total de familias y, si es un hito (10/25/50/cada 100), avisa al
// dueño. Best-effort: cualquier error se traga (no debe afectar el alta).
async fn chequear_hito() -> Result<Bool> {
    let conn = db.connect(db_url()).await?
    let rows = conn.query("SELECT count(*)::int AS n FROM families", []).await?
    let n = match rows.len() > 0 {
        true => rows[0].get_int("n")?,
        false => 0,
    }
    if (es_hito(n)) {
        return send_milestone(n).await
    }
    return Ok(false)
}

@middleware(rate_limit_mw)
@cookie(name="mathelp_lang", into="lang")
@cookie(name="mathelp_ref", into="refc")
@post("/registro")
async fn registro_post(lang: Str?, refc: Str?, input: RegistroForm) -> Response {
    let locale = locale_from_cookie(lang)
    let titulo = t(locale, "registro.titulo") + " — MatHelp"

    if (input.email == "" or input.familia == "" or input.password == "") {
        let cuerpo = form_registro(locale, input.email, input.familia, "registro.error_campos")
        return responder_html(page_landing(locale, titulo, cuerpo, html("")))
    }
    if (input.password.len() < 8) {
        let cuerpo = form_registro(locale, input.email, input.familia, "registro.error_password")
        return responder_html(page_landing(locale, titulo, cuerpo, html("")))
    }

    match crear_familia(input.email, input.familia, input.password, locale).await {
        Ok(fam) => {
            // Referral: si vino por un link /r/<code> (cookie mathelp_ref), guarda
            // referred_by. Best-effort — no debe afectar el alta.
            let ref_code = match refc {
                null => "",
                s => s,
            }
            let _r = record_referral(fam.id, ref_code).await
            // Tres caminos según el botón que se apretó:
            //   "familia" → Zona Familia (PIN de adulto + un perfil por hijo).
            //   "maestro" → panel del maestro (grados + alumnos). Sin PIN: entra
            //               con email+contraseña y gestiona directo.
            //   default   → "empezar a jugar": /comenzar (perfil individual, sin
            //               PIN ni selector — la cuenta individual no da vueltas).
            let tipo = match input.accion {
                "familia" => "family",
                "maestro" => "teacher",
                _ => "individual",
            }
            // Emails de bienvenida fire-and-forget (con el copy según el tipo): no
            // bloquean el alta con la latencia de Resend. Los errores de runtime de
            // la task se loguean (FITZ-27 cerrado en fitz v0.61.0).
            spawn(signup_emails(fam, tipo))
            let _ = set_account_type(fam.email, tipo).await
            let destino = match input.accion {
                "familia" => "/familia/pin",
                "maestro" => "/maestro",
                _ => "/comenzar",
            }
            let tea = match input.accion {
                "maestro" => "1",
                _ => "0",
            }
            let token = mint_session(fam.email, "", "0", tea)
            return redirect_con_sesion(destino, token)
        }
        Err(_) => {
            let cuerpo = form_registro(locale, input.email, input.familia, "registro.error_email")
            return responder_html(page_landing(locale, titulo, cuerpo, html("")))
        }
    }
}

// /activar (GET) → pantalla de activación del acceso propio (primer login del chico).
@cookie(name="mathelp_lang", into="lang")
@get("/activar")
fn activar_get(lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    return responder_html(page_landing(locale, t(locale, "activar.titulo") + " — MatHelp", form_activar(locale, "", ""), html("")))
}

// /activar (POST) → valida email + código, guarda la contraseña del chico y entra
// directo a su perfil. Rate-limited (fuerza bruta del código de 6 dígitos).
@middleware(rate_limit_mw)
@cookie(name="mathelp_lang", into="lang")
@post("/activar")
async fn activar_post(lang: Str?, input: ActivarForm) -> Response {
    let locale = locale_from_cookie(lang)
    let titulo = t(locale, "activar.titulo") + " — MatHelp"
    if (input.email == "" or input.codigo == "" or input.password == "") {
        return responder_html(page_landing(locale, titulo, form_activar(locale, input.email, "activar.error"), html("")))
    }
    if (input.password.len() < 6) {
        return responder_html(page_landing(locale, titulo, form_activar(locale, input.email, "activar.error_password"), html("")))
    }
    if (input.password != input.password2) {
        return responder_html(page_landing(locale, titulo, form_activar(locale, input.email, "activar.error_password2"), html("")))
    }
    match activar_perfil(input.email, input.codigo, input.password).await {
        Ok(pa) => {
            let token = mint_session(input.email, pa.pid, "0", "0")
            return redirect_con_sesion_prefs("/", token, pa.theme, pa.contrast, pa.font_size)
        }
        Err(_) => return responder_html(page_landing(locale, titulo, form_activar(locale, input.email, "activar.error"), html(""))),
    }
}

// Cierra la sesión pisando la cookie con max_age 0 (expira ya).
@post("/logout")
fn logout_post() -> Response {
    return Response {
        status: 303,
        content_type: "text/html; charset=utf-8",
        cookies: [
            Cookie {
                name: session_cookie_name(),
                value: "",
                path: "/",
                http_only: true,
                same_site: "Lax",
                max_age: 0,
            },
        ],
        headers: { "Location": "/login" },
        body: "",
    }
}
