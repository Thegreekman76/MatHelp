<h2>{flv(t(locale, "registro.titulo"))}</h2>
{err}
<form method="POST" action="/registro">
<div class="mh-field">
<label class="mh-label" for="familia">{flv(t(locale, "registro.tu_nombre"))}</label>
<input class="mh-input" id="familia" name="familia" type="text" value="{familia_esc}" placeholder="{nombre_ph}" autocomplete="name" required />
