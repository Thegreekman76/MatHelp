// auth.fitz — registro, login y logout de la cuenta de familia.
//
// **Sin JavaScript.** El login es un `<form method="POST">` nativo: el
// browser manda `application/x-www-form-urlencoded` y Fitz lo deserializa
// al `type` del handler igual que un body JSON.
//
// **Sesión stateless con JWT + cookie HttpOnly.** No hay tabla de sesiones:
// la cookie `mathelp_session` lleva un JWT firmado con `jwt_secret()`. Los
// claims son `Map<Str, Str>` (limitación del MVP de jwt.encode), así que
// guardamos `email` (único en el schema) y, cuando se elige perfil, `pid`.
// Resolver la familia por email cada request es un lookup por el índice
// UNIQUE de la columna — barato y sin estado en el server.
//
// **Control explícito, no `@auth_provider`.** El provider built-in falla
// con 401 JSON; nosotros queremos redirect 303 a /login. Por eso leemos la
// cookie a mano con `@cookie(...)` + `jwt.decode`. Ver read_session().

from fitz_liveviews import Html, html, flv
from config import db_url, jwt_secret, session_cookie_name, default_locale
from i18n import t, locale_from_cookie
from layout import page_landing, responder_html
from models import Family
from emails import notify_admin_signup, send_welcome
from ratelimit import ip_de, registrar_y_chequear

// --- Sesión: emitir y leer ------------------------------------------------

// Emite el JWT de la familia. `pid` vacío = todavía no eligió perfil. `adm` = "1"
// cuando la sesión pasó el PIN de adulto (zona familia/control), "0" cuando juega.
fn mint_session(email: Str, pid: Str, adm: Str) -> Str {
    let claims = { "email": email, "pid": pid, "adm": adm }
    return jwt.encode(claims, jwt_secret())
}

// Resuelve la familia desde la cookie de sesión. Err si falta o es inválida
// — el handler protegido traduce ese Err en un 303 a /login.
async fn read_session(session: Str?) -> Result<Family> {
    let token = match session {
        null => return Err("sin sesión"),
        s => s,
    }
    let claims = jwt.decode(token, jwt_secret())?
    let email: Str = match claims.get("email") {
        Ok(v) => v,
        Err(_) => return Err("token sin claim email"),
    }
    let conn = db.connect(db_url()).await?
    return Family.where(fn(f) => f.email == email).first(conn).await
}

// Perfil activo guardado en el token (Str vacío si no hay). No toca la DB.
fn pid_from_token(session: Str?) -> Str {
    let token = match session {
        null => return "",
        s => s,
    }
    let claims = match jwt.decode(token, jwt_secret()) {
        Ok(c) => c,
        Err(_) => return "",
    }
    // jwt.decode devuelve Map<Str, __FitzValue>; claims.get(...) da Result<Any>.
    // El codegen coacciona el arm Ok (__FitzValue → Str) porque el arm Err fija
    // el LUB en Str. Sin pid (perfil no elegido) es un caso válido → "".
    return match claims.get("pid") {
        Ok(v) => v,
        Err(_) => "",
    }
}

// ¿La sesión pasó el PIN de adulto? Claim "adm" == "1". Tokens viejos (sin el
// claim) devuelven "0" → no admin, deben pasar por /familia/pin. No toca la DB.
fn adm_from_token(session: Str?) -> Str {
    let token = match session {
        null => return "0",
        s => s,
    }
    let claims = match jwt.decode(token, jwt_secret()) {
        Ok(c) => c,
        Err(_) => return "0",
    }
    return match claims.get("adm") {
        Ok(v) => v,
        Err(_) => "0",
    }
}

// Gate de la zona de control familiar. Un handler de control corta con este check
// y, si es false, redirige a /familia/pin.
fn es_admin(session: Str?) -> Bool {
    return adm_from_token(session) == "1"
}

// Response de redirect que setea (o pisa) la cookie de sesión HttpOnly.
// secure:false por ahora — MatHelp corre en la red de casa sin HTTPS; con
// secure:true el browser no mandaría la cookie sobre http. Deuda: activar
// secure detrás de un proxy TLS en producción (junto con JWT_SECRET real).
fn redirect_con_sesion(destino: Str, token: Str) -> Response {
    return Response {
        status: 303,
        content_type: "text/html; charset=utf-8",
        cookies: [
            Cookie {
                name: session_cookie_name(),
                value: token,
                path: "/",
                http_only: true,
                same_site: "Lax",
                max_age: 604800,
            },
        ],
        headers: { "Location": destino },
        body: "",
    }
}

// Igual que redirect_con_sesion pero además setea las cookies de PREFERENCIAS del
// perfil (F9 pulido): al elegir un perfil, su tema de color + accesibilidad (alto
// contraste, tamaño de fuente) se aplican en todas las páginas.
fn redirect_con_sesion_prefs(destino: Str, token: Str, theme: Str, contrast: Str, font: Str) -> Response {
    return Response {
        status: 303,
        content_type: "text/html; charset=utf-8",
        cookies: [
            Cookie {
                name: session_cookie_name(),
                value: token,
                path: "/",
                http_only: true,
                same_site: "Lax",
                max_age: 604800,
            },
            Cookie {
                name: "mathelp_theme",
                value: theme,
                path: "/",
                same_site: "Lax",
                max_age: 31536000,
            },
            Cookie {
                name: "mathelp_contrast",
                value: contrast,
                path: "/",
                same_site: "Lax",
                max_age: 31536000,
            },
            Cookie {
                name: "mathelp_font",
                value: font,
                path: "/",
                same_site: "Lax",
                max_age: 31536000,
            },
        ],
        headers: { "Location": destino },
        body: "",
    }
}

// --- DB: crear y autenticar familia --------------------------------------

async fn crear_familia(email: Str, display_name: Str, password: Str, locale: Str) -> Result<Family> {
    let conn = db.connect(db_url()).await?
    // Email único: mensaje amigable en vez del UNIQUE violation crudo.
    match Family.where(fn(f) => f.email == email).first(conn).await {
        Ok(_) => return Err("email ya registrado"),
        Err(_) => 0,
    }
    let ph = hash.password(password)
    return Family.insert(conn, Family {
        id: 0,
        email: email,
        password_hash: ph,
        display_name: display_name,
        locale: locale,
        created_at: "",
    }).await
}

async fn autenticar(email: Str, password: Str) -> Result<Family> {
    let conn = db.connect(db_url()).await?
    let fam: Family = match Family.where(fn(f) => f.email == email).first(conn).await {
        Ok(f) => f,
        Err(_) => return Err("credenciales inválidas"),
    }
    // hash.verify devuelve Bool; hash malformado → false (nunca panic).
    if (not hash.verify(password, fam.password_hash)) {
        return Err("credenciales inválidas")
    }
    return Ok(fam)
}

// --- Forms HTML ----------------------------------------------------------

fn form_login(locale: Str, email: Str, hay_error: Bool) -> Html {
    let err = match hay_error {
        true => html("""<div class="mh-error">{flv(t(locale, "login.error"))}</div>""").raw,
        false => "",
    }
    let email_esc = flv(email)
    return html("""<div class="mh-card">
<h2>{flv(t(locale, "login.titulo"))}</h2>
{err}
<form method="POST" action="/login">
<div class="mh-field">
<label class="mh-label" for="email">{flv(t(locale, "login.email"))}</label>
<input class="mh-input" id="email" name="email" type="email" value="{email_esc}" autocomplete="email" inputmode="email" required />
</div>
<div class="mh-field">
<label class="mh-label" for="password">{flv(t(locale, "login.password"))}</label>
<input class="mh-input" id="password" name="password" type="password" autocomplete="current-password" required />
</div>
<button class="mh-btn" type="submit">{flv(t(locale, "login.submit"))}</button>
</form>
<a class="mh-link" href="/recuperar">{flv(t(locale, "recuperar.link"))}</a>
<a class="mh-link" href="/registro">{flv(t(locale, "login.crear_cuenta"))}</a>
</div>""")
}

// error_key: clave i18n del error, o "" si no hay error.
fn form_registro(locale: Str, email: Str, familia: Str, error_key: Str) -> Html {
    let err = match error_key == "" {
        true => "",
        false => html("""<div class="mh-error">{flv(t(locale, error_key))}</div>""").raw,
    }
    let email_esc = flv(email)
    let familia_esc = flv(familia)
    let fam_ph = flv(t(locale, "registro.familia_ph"))
    return html("""<div class="mh-card">
<h2>{flv(t(locale, "registro.titulo"))}</h2>
{err}
<form method="POST" action="/registro">
<div class="mh-field">
<label class="mh-label" for="familia">{flv(t(locale, "registro.familia"))}</label>
<input class="mh-input" id="familia" name="familia" type="text" value="{familia_esc}" placeholder="{fam_ph}" autocomplete="name" required />
</div>
<div class="mh-field">
<label class="mh-label" for="email">{flv(t(locale, "login.email"))}</label>
<input class="mh-input" id="email" name="email" type="email" value="{email_esc}" autocomplete="email" inputmode="email" required />
</div>
<div class="mh-field">
<label class="mh-label" for="password">{flv(t(locale, "login.password"))}</label>
<input class="mh-input" id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />
<span class="mh-hint">{flv(t(locale, "registro.password_hint"))}</span>
</div>
<button class="mh-btn" type="submit">{flv(t(locale, "registro.submit"))}</button>
</form>
<a class="mh-link" href="/login">{flv(t(locale, "registro.ya_tengo"))}</a>
</div>""")
}

// --- Rate limiting (anti fuerza bruta) -----------------------------------

// Middleware Pre para /login y /registro: solo cuenta los POST (los intentos
// reales); los GET (ver el form) pasan. Fail-open ante error de DB. Vive acá
// (mismo módulo que login_post/registro_post) para no cruzar el `return <status>`
// entre módulos. Los helpers de DB están en ratelimit.fitz.
async fn rate_limit_mw(req: Request) -> Null {
    if (req.method != "POST") {
        return null
    }
    let ip = ip_de(req)
    let bloqueado = match registrar_y_chequear(ip, req.path).await {
        Ok(b) => b,
        Err(_) => false,
    }
    if (bloqueado) {
        return 429 {"error": t(default_locale(), "ratelimit.error")}
    }
    return null
}

// --- Handlers ------------------------------------------------------------

type LoginForm {
    email: Str = ""
    password: Str = ""
}

type RegistroForm {
    familia: Str = ""
    email: Str = ""
    password: Str = ""
}

@cookie(name="mathelp_lang", into="lang")
@get("/login")
fn login_get(lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    return responder_html(page_landing(locale, t(locale, "login.titulo") + " — MatHelp", form_login(locale, "", false), html("")))
}

@middleware(rate_limit_mw)
@cookie(name="mathelp_lang", into="lang")
@post("/login")
async fn login_post(lang: Str?, creds: LoginForm) -> Response {
    let locale = locale_from_cookie(lang)
    match autenticar(creds.email, creds.password).await {
        Ok(fam) => {
            let token = mint_session(fam.email, "", "0")
            return redirect_con_sesion("/perfiles", token)
        }
        Err(_) => {
            let cuerpo = form_login(locale, creds.email, true)
            return responder_html(page_landing(locale, t(locale, "login.titulo") + " — MatHelp", cuerpo, html("")))
        }
    }
}

@cookie(name="mathelp_lang", into="lang")
@get("/registro")
fn registro_get(lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    return responder_html(page_landing(locale, t(locale, "registro.titulo") + " — MatHelp", form_registro(locale, "", "", ""), html("")))
}

// Emails post-registro (aviso al dueño + bienvenida). Best-effort: los helpers
// atrapan sus propios errores y con el guard de mailer devuelven al instante si
// no hay email configurado, así que no demoran el alta de forma perceptible.
async fn signup_emails(fam: Family) -> Null {
    let _admin = notify_admin_signup(fam).await
    let _welcome = send_welcome(fam).await
    return null
}

@middleware(rate_limit_mw)
@cookie(name="mathelp_lang", into="lang")
@post("/registro")
async fn registro_post(lang: Str?, input: RegistroForm) -> Response {
    let locale = locale_from_cookie(lang)
    let titulo = t(locale, "registro.titulo") + " — MatHelp"

    if (input.email == "" or input.familia == "" or input.password == "") {
        let cuerpo = form_registro(locale, input.email, input.familia, "registro.error_campos")
        return responder_html(page_landing(locale, titulo, cuerpo, html("")))
    }
    if (input.password.len() < 8) {
        let cuerpo = form_registro(locale, input.email, input.familia, "registro.error_password")
        return responder_html(page_landing(locale, titulo, cuerpo, html("")))
    }

    match crear_familia(input.email, input.familia, input.password, locale).await {
        Ok(fam) => {
            // WORKAROUND FITZ-27 (fitz/docs/norte-mathelp.md): idealmente
            // `spawn(signup_emails(fam))` para no bloquear el alta, pero el spawn
            // desde un handler @post traga en silencio los errores de runtime de la
            // task. Hasta que FITZ-27 se cierre, va inline con .await (best-effort,
            // rápido por el guard de mailer). Revertir a spawn cuando se resuelva.
            let _e = signup_emails(fam).await
            let token = mint_session(fam.email, "", "0")
            return redirect_con_sesion("/perfiles", token)
        }
        Err(_) => {
            let cuerpo = form_registro(locale, input.email, input.familia, "registro.error_email")
            return responder_html(page_landing(locale, titulo, cuerpo, html("")))
        }
    }
}

// Cierra la sesión pisando la cookie con max_age 0 (expira ya).
@post("/logout")
fn logout_post() -> Response {
    return Response {
        status: 303,
        content_type: "text/html; charset=utf-8",
        cookies: [
            Cookie {
                name: session_cookie_name(),
                value: "",
                path: "/",
                http_only: true,
                same_site: "Lax",
                max_age: 0,
            },
        ],
        headers: { "Location": "/login" },
        body: "",
    }
}
