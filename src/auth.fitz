</div>
<div class="mh-field">
<label class="mh-label" for="email">{flv(t(locale, "login.email"))}</label>
<input class="mh-input" id="email" name="email" type="email" value="{email_esc}" autocomplete="email" inputmode="email" required />
</div>
<div class="mh-field">
<label class="mh-label" for="password">{flv(t(locale, "login.password"))}</label>
<input class="mh-input" id="password" name="password" type="password" autocomplete="new-password" minlength="8" required />
<span class="mh-hint">{flv(t(locale, "registro.password_hint"))}</span>
</div>
<button class="mh-btn" type="submit" name="accion" value="jugar">{flv(t(locale, "registro.accion_jugar"))}</button>
<button class="mh-btn sec" type="submit" name="accion" value="familia">{flv(t(locale, "registro.accion_familia"))}</button>
<button class="mh-btn sec" type="submit" name="accion" value="maestro">{flv(t(locale, "registro.accion_maestro"))}</button>
<span class="mh-hint" style="margin-top:.6rem;display:block">{flv(t(locale, "registro.accion_hint"))}</span>
</form>
<p class="mh-hint" style="margin-top:.6rem">{flv(t(locale, "registro.acepto"))} <a href="/terminos">{flv(t(locale, "legal.terms.titulo"))}</a> {flv(t(locale, "registro.y"))} <a href="/privacidad">{flv(t(locale, "legal.priv.titulo"))}</a>.</p>
<a class="mh-link" href="/login">{flv(t(locale, "registro.ya_tengo"))}</a>
</div>""")
}

