// layout.fitz — shell del documento (F0, páginas estáticas).
//
// Escribimos el documento completo acá porque las páginas de F0 son estáticas.
// `live_layout_with(opts, ...)` de liveviews (v0.50) es para páginas LIVE:
// inyecta el runtime WebSocket y pide `ws_path`/`root_id`. Cuando el juego (F2)
// tenga páginas interactivas, se evalúa componer `live_layout_with` para esas.
//
// Todo el CSS va en el <head>, NUNCA dentro del root diffeado: el parser del
// diff rechaza <style> ahí adentro y cae en silencio a reemplazo completo del
// HTML — la app se pone lenta y las transiciones se cortan, sin error que lo
// delate. (Trampa vigente de liveviews; ver CLAUDE.md.)

from fitz_liveviews import Html, html, flv, html_response
from brand import logo_lockup, footer, brand_css
from i18n import t, lang_corto, locale_alterno
from config import app_name

// Documento completo, mobile-first.
//
// `live_js` es el <script> del runtime de LiveViews cuando la página es
// interactiva; en las páginas estáticas va vacío. Siempre FUERA del root.
fn page(locale: Str, titulo: Str, body: Html, live_js: Html) -> Html {
    return page_con_barra(locale, titulo, body, live_js, topbar(locale))
}

// Igual que page() pero con el header público (logo + Entrar / Crear cuenta +
// idioma). Lo usa solo la landing (home_publica), que sólo ven los visitantes
// sin sesión. Así no hay que tocar los 62 call sites de page().
fn page_landing(locale: Str, titulo: Str, body: Html, live_js: Html) -> Html {
    return page_con_barra(locale, titulo, body, live_js, topbar_publico(locale))
}

fn page_con_barra(locale: Str, titulo: Str, body: Html, live_js: Html, barra: Html) -> Html {
    let lang = lang_corto(locale)
    let css = brand_css()
    let head_titulo = flv(titulo)
    let desc = flv(t(locale, "app.description"))
    let top = barra.raw
    let pie = footer(locale).raw
    let salir = salir_modal(locale).raw
    let js = live_js.raw
    let skip = flv(t(locale, "a11y.saltar"))
    return html("""<!doctype html>
<html lang="{lang}">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="description" content="{desc}" />
<meta name="theme-color" content="#0E7A63" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0E181E" media="(prefers-color-scheme: dark)" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="MatHelp" />
<meta name="format-detection" content="telephone=no" />
<title>{head_titulo}</title>
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<script>(function()\{try\{var d=document.documentElement,c=document.cookie;function g(k)\{var m=c.match(new RegExp(k+'=([^;]+)'));return m?m[1]:null;\}var t=g('mathelp_theme');if(t)d.setAttribute('data-theme',t);var k=g('mathelp_contrast');if(k)d.setAttribute('data-contrast',k);var f=g('mathelp_font');if(f)d.setAttribute('data-font',f);\}catch(e)\{\}\})();</script>
<style>{css}</style>
</head>
<body>
<a class="mh-skip" href="#main">{skip}</a>
{top}
<main id="main" tabindex="-1">
{body.raw}
</main>
{pie}
{salir}
{js}
<script src="/sound.js" defer></script>
</body>
</html>""")
}

// Barra superior: logo a la izquierda, selector de idioma a la derecha.
fn topbar(locale: Str) -> Html {
    let marca = logo_lockup(30, locale).raw
    let es_actual = match locale == "es-AR" {
        true => "true",
        false => "false",
    }
    let en_actual = match locale == "en" {
        true => "true",
        false => "false",
    }
    let son_lbl = flv(t(locale, "a11y.sonido"))
    let salir_lbl = flv(t(locale, "salir.boton"))
    let cambiar_lbl = flv(t(locale, "home.cambiar_jugador"))
    let cerrar_lbl = flv(t(locale, "nav.cerrar_sesion"))
    return html("""<header class="mh-topbar">
<a class="mh-topbar-home" href="/" aria-label="{flv(t(locale, "nav.inicio"))}">{marca}</a>
<div class="mh-controls">
<a class="mh-icon-btn mh-account-ctrl" href="/perfiles" aria-label="{cambiar_lbl}" title="{cambiar_lbl}"><span aria-hidden="true">🔄</span></a>
<form class="mh-account-ctrl mh-logout-form" method="POST" action="/logout">
<button type="submit" class="mh-icon-btn" aria-label="{cerrar_lbl}" title="{cerrar_lbl}"><span aria-hidden="true">⏻</span></button>
</form>
<button id="mh-salir-btn" type="button" class="mh-salir-btn" hidden aria-label="{salir_lbl}" title="{salir_lbl}"><span aria-hidden="true">✕</span> {salir_lbl}</button>
<button id="mh-sound-btn" type="button" class="mh-sound-btn" aria-pressed="true" aria-label="{son_lbl}" title="{son_lbl}"><span class="mh-sound-ico" aria-hidden="true">🔊</span></button>
<nav class="mh-langs" aria-label="{flv(t(locale, "idioma.cambiar"))}">
<a class="mh-lang" href="/lang/es-AR" aria-current="{es_actual}" hreflang="es">ES</a>
<a class="mh-lang" href="/lang/en" aria-current="{en_actual}" hreflang="en">EN</a>
</nav>
</div>
</header>""")
}

// Barra pública para la landing: logo + Entrar / Crear cuenta + idioma. Sin los
// botones de sonido/salir (son del juego, no de la home de venta). La usa
// page_landing(), que sólo ven los visitantes sin sesión.
fn topbar_publico(locale: Str) -> Html {
    let marca = logo_lockup(30, locale).raw
    let es_actual = match locale == "es-AR" {
        true => "true",
        false => "false",
    }
    let en_actual = match locale == "en" {
        true => "true",
        false => "false",
    }
    let entrar = flv(t(locale, "login.submit"))
    let crear = flv(t(locale, "login.crear_cuenta"))
    return html("""<header class="mh-topbar mh-topbar-pub">
<a class="mh-topbar-home" href="/" aria-label="{flv(t(locale, "nav.inicio"))}">{marca}</a>
<div class="mh-controls">
<a class="mh-auth-entrar" href="/login">{entrar}</a>
<a class="mh-btn mh-auth-cta" href="/registro">{crear}</a>
<nav class="mh-langs" aria-label="{flv(t(locale, "idioma.cambiar"))}">
<a class="mh-lang" href="/lang/es-AR" aria-current="{es_actual}" hreflang="es">ES</a>
<a class="mh-lang" href="/lang/en" aria-current="{en_actual}" hreflang="en">EN</a>
</nav>
</div>
</header>""")
}

// Modal de "salir de la partida" — overlay ESTÁTICO en el shell (fuera del
// <main>/LiveComponent, así el re-render por WebSocket no lo toca). Oculto por
// default; sound.js lo muestra cuando el usuario toca la home (u otro link que
// sale) o el botón "Salir" de la topbar DURANTE una partida. Reemplaza el
// window.confirm() del navegador por un modal con el look de la app.
fn salir_modal(locale: Str) -> Html {
    let titulo = flv(t(locale, "salir.titulo"))
    let mensaje = flv(t(locale, "salir.mensaje"))
    let seguir = flv(t(locale, "salir.seguir"))
    let confirmar = flv(t(locale, "salir.confirmar"))
    return html("""<div id="mh-salir-modal" class="mh-modal-overlay" hidden>
<div class="mh-modal" role="dialog" aria-modal="true" aria-labelledby="mh-salir-titulo">
<h2 id="mh-salir-titulo" class="mh-modal-titulo">{titulo}</h2>
<p class="mh-modal-texto">{mensaje}</p>
<div class="mh-modal-acciones">
<button type="button" class="mh-btn" data-mh-salir-seguir>{seguir}</button>
<a class="mh-btn sec mh-salir-ir" href="/">{confirmar}</a>
</div>
</div>
</div>""")
}

fn responder_html(h: Html) -> Response {
    return html_response(h)
}

// Redirect 303 sin tocar cookies. Para "sin sesión → /login" y navegación
// post-form. (El redirect que ADEMÁS setea la cookie de sesión vive en
// auth.fitz como redirect_con_sesion.)
fn redirect_a(destino: Str) -> Response {
    return Response {
        status: 303,
        content_type: "text/html; charset=utf-8",
        headers: { "Location": destino },
        body: "",
    }
}
