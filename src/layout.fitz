// layout.fitz — shell del documento (F0, páginas estáticas).
//
// Escribimos el documento completo acá porque las páginas de F0 son estáticas.
// `live_layout_with(opts, ...)` de liveviews (v0.50) es para páginas LIVE:
// inyecta el runtime WebSocket y pide `ws_path`/`root_id`. Cuando el juego (F2)
// tenga páginas interactivas, se evalúa componer `live_layout_with` para esas.
//
// Todo el CSS va en el <head>, NUNCA dentro del root diffeado: el parser del
// diff rechaza <style> ahí adentro y cae en silencio a reemplazo completo del
// HTML — la app se pone lenta y las transiciones se cortan, sin error que lo
// delate. (Trampa vigente de liveviews; ver CLAUDE.md.)

from fitz_liveviews import Html, html, flv, html_response
from brand import logo_lockup, footer, brand_css
from i18n import t, lang_corto, locale_alterno
from config import app_name

// Documento completo, mobile-first.
//
// `live_js` es el <script> del runtime de LiveViews cuando la página es
// interactiva; en las páginas estáticas va vacío. Siempre FUERA del root.
fn page(locale: Str, titulo: Str, body: Html, live_js: Html) -> Html {
    let lang = lang_corto(locale)
    let css = brand_css()
    let head_titulo = flv(titulo)
    let desc = flv(t(locale, "app.description"))
    let top = topbar(locale).raw
    let pie = footer(locale).raw
    let js = live_js.raw
    let skip = flv(t(locale, "a11y.saltar"))
    return html("""<!doctype html>
<html lang="{lang}">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="description" content="{desc}" />
<meta name="theme-color" content="#0E7A63" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0E181E" media="(prefers-color-scheme: dark)" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
<meta name="apple-mobile-web-app-title" content="MatHelp" />
<meta name="format-detection" content="telephone=no" />
<title>{head_titulo}</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="manifest" href="/manifest.webmanifest" />
<script>(function()\{try\{var d=document.documentElement,c=document.cookie;function g(k)\{var m=c.match(new RegExp(k+'=([^;]+)'));return m?m[1]:null;\}var t=g('mathelp_theme');if(t)d.setAttribute('data-theme',t);var k=g('mathelp_contrast');if(k)d.setAttribute('data-contrast',k);var f=g('mathelp_font');if(f)d.setAttribute('data-font',f);\}catch(e)\{\}\})();</script>
<style>{css}</style>
</head>
<body>
<a class="mh-skip" href="#main">{skip}</a>
{top}
<main id="main" tabindex="-1">
{body.raw}
</main>
{pie}
{js}
<script src="/sound.js" defer></script>
</body>
</html>""")
}

// Barra superior: logo a la izquierda, selector de idioma a la derecha.
fn topbar(locale: Str) -> Html {
    let marca = logo_lockup(30, locale).raw
    let es_actual = match locale == "es-AR" {
        true => "true",
        false => "false",
    }
    let en_actual = match locale == "en" {
        true => "true",
        false => "false",
    }
    let son_lbl = flv(t(locale, "a11y.sonido"))
    return html("""<header class="mh-topbar">
<a class="mh-topbar-home" href="/" aria-label="{flv(t(locale, "nav.inicio"))}">{marca}</a>
<div class="mh-controls">
<button id="mh-sound-btn" type="button" class="mh-sound-btn" aria-pressed="true" aria-label="{son_lbl}" title="{son_lbl}"><span class="mh-sound-ico" aria-hidden="true">🔊</span></button>
<nav class="mh-langs" aria-label="{flv(t(locale, "idioma.cambiar"))}">
<a class="mh-lang" href="/lang/es-AR" aria-current="{es_actual}" hreflang="es">ES</a>
<a class="mh-lang" href="/lang/en" aria-current="{en_actual}" hreflang="en">EN</a>
</nav>
</div>
</header>""")
}

fn responder_html(h: Html) -> Response {
    return html_response(h)
}

// Redirect 303 sin tocar cookies. Para "sin sesión → /login" y navegación
// post-form. (El redirect que ADEMÁS setea la cookie de sesión vive en
// auth.fitz como redirect_con_sesion.)
fn redirect_a(destino: Str) -> Response {
    return Response {
        status: 303,
        content_type: "text/html; charset=utf-8",
        headers: { "Location": destino },
        body: "",
    }
}
