// kiosco_view.fitz — el render de "El kiosco".
//
// Situación con contexto (§6.6): comprás un producto, pagás con un billete y
// tipeás el VUELTO en el teclado numérico propio. El problema se deriva de
// (seed, idx, grade) con gen_kiosco; el server re-deriva y valida given ==
// it.change. Todo texto por t() (incluido el nombre del producto — el contexto
// se localiza, §4); toda plata por fmt_money.

from fitz_liveviews import Html, html, flv
from gen_kiosco import gen_kiosco
from keypad_view import keypad_html
from i18n import t, t1
from fmt import fmt_int, fmt_money

fn kiosco_screen(seed: Int, idx: Int, grade: Int, locale: Str, correct: Int, total: Int, limit: Int, phase: Str, feedback: Str, last_answer: Int, entrada: Int) -> Html {
    if (phase == "done") {
        return kiosco_resumen(locale, correct, total)
    }
    let it = gen_kiosco(seed, idx, grade)
    let compras = flv(t1(locale, "kiosco.compras", t(locale, "kiosco.{it.item}")))
    let cuesta = flv(t1(locale, "kiosco.cuesta", fmt_money(locale, it.price)))
    let pagas = flv(t1(locale, "kiosco.pagas", fmt_money(locale, it.paid)))
    let pregunta = flv(t(locale, "kiosco.vuelto"))
    // El vuelto tipeado, formateado como plata (o "$ ?" si está vacío).
    let slot = match entrada > 0 {
        true => html("""<span class="cg-slot filled">{flv(fmt_money(locale, entrada))}</span>""").raw,
        false => html("""<span class="cg-slot">$ ?</span>""").raw,
    }
    let banner = kiosco_feedback(locale, feedback, last_answer)
    let hecho = flv(fmt_int(locale, total))
    let de_lbl = flv(t(locale, "juego.de"))
    let de_total = flv(fmt_int(locale, limit))
    let vas_lbl = flv(t(locale, "juego.aciertos"))
    let co = flv(fmt_int(locale, correct))
    let teclado = keypad_html(locale, entrada, idx)
    return html("""<div class="q-hud">
<div class="q-mode">🏪 {hecho} {de_lbl} {de_total}</div>
<div class="q-score">{vas_lbl}<span class="q-snum">{co}</span></div>
</div>
<div class="ki-enun">
<p class="ki-linea">{compras}</p>
<p class="ki-linea">{cuesta} · {pagas}</p>
<p class="ki-preg">{pregunta}</p>
</div>
<div class="q-prompt ki-slot">{slot}</div>
<div class="q-fbwrap">{banner}</div>
{teclado}""")
}

fn kiosco_feedback(locale: Str, feedback: Str, last_answer: Int) -> Str {
    if (feedback == "ok") {
        return html("""<div class="q-fb ok" role="status">{flv(t(locale, "juego.correcto"))}</div>""").raw
    }
    if (feedback == "bad") {
        let resp = fmt_money(locale, last_answer)
        return html("""<div class="q-fb bad" role="status">{flv(t1(locale, "juego.incorrecto", resp))}</div>""").raw
    }
    return ""
}

fn kiosco_resumen(locale: Str, correct: Int, total: Int) -> Html {
    let co = flv(fmt_int(locale, correct))
    let to = flv(fmt_int(locale, total))
    let de = flv(t(locale, "juego.de"))
    return html("""<div class="q-done">
<div class="q-medal">🧉</div>
<h2>{flv(t(locale, "juego.resumen"))}</h2>
<div class="q-stat"><span class="q-big">{co} {de} {to}</span><span class="q-lbl">{flv(t(locale, "juego.aciertos"))}</span></div>
<div class="q-actions">
<a class="mh-btn" href="/kiosco">{flv(t(locale, "juego.de_nuevo"))}</a>
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>
</div>
</div>""")
}
