// kiosco_view.fitz — el render de "Problemas" (situaciones de la vida real).
//
// (Nombre interno histórico "kiosco".) Muestra un problema con historia
// (localizado) y el chico tipea la respuesta en el teclado numérico. El problema
// se deriva de (seed, idx, grade) con gen_kiosco; el server re-deriva y valida
// given == it.answer. Todo texto por t()/t3()/t4() (incluido el producto — el
// contexto se localiza, §4); la plata por fmt_money, las cuentas por fmt_int.

from fitz_liveviews import Html, html, flv
from game_ui import resumen_estrellas, correcto_msg, racha_badge, progreso_bar, incorrecto_msg, mejor_racha_html
from gen_kiosco import gen_kiosco, KioscoItem
from keypad_view import keypad_html
from i18n import t, t1, t2, t3, t4
from fmt import fmt_int, fmt_money

// Arma el enunciado localizado según el tipo de problema.

fn kiosco_enunciado(locale: Str, it: KioscoItem) -> Str {
    let prod = t(locale, "kiosco.{it.item}")
    if (it.kind == "total") {
        return t3(locale, "kiosco.p_total", fmt_int(locale, it.a), prod, fmt_money(locale, it.b))
    }
    if (it.kind == "suma") {
        return t3(locale, "kiosco.p_suma", fmt_money(locale, it.a), fmt_money(locale, it.b), fmt_money(locale, it.c))
    }
    if (it.kind == "vuelto") {
        return t3(locale, "kiosco.p_vuelto", prod, fmt_money(locale, it.a), fmt_money(locale, it.b))
    }
    if (it.kind == "falta") {
        return t3(locale, "kiosco.p_falta", prod, fmt_money(locale, it.a), fmt_money(locale, it.b))
    }
    if (it.kind == "comparar") {
        return t3(locale, "kiosco.p_comparar", prod, fmt_money(locale, it.a), fmt_money(locale, it.b))
    }
    if (it.kind == "reparto") {
        return t3(locale, "kiosco.p_reparto", fmt_int(locale, it.a), prod, fmt_int(locale, it.b))
    }
    if (it.kind == "cuantos") {
        return t3(locale, "kiosco.p_cuantos", fmt_money(locale, it.a), prod, fmt_money(locale, it.b))
    }
    if (it.kind == "descuento") {
        return t3(locale, "kiosco.p_descuento", prod, fmt_money(locale, it.a), fmt_int(locale, it.b))
    }
    if (it.kind == "ahorro") {
        return t2(locale, "kiosco.p_ahorro", fmt_int(locale, it.a), fmt_money(locale, it.b))
    }
    if (it.kind == "edad") {
        return t2(locale, "kiosco.p_edad", fmt_int(locale, it.a), fmt_int(locale, it.b))
    }
    if (it.kind == "cuadras") {
        return t1(locale, "kiosco.p_cuadras", fmt_int(locale, it.a))
    }
    if (it.kind == "unitario") {
        return t2(locale, "kiosco.p_unitario", fmt_int(locale, it.b), fmt_money(locale, it.a))
    }
    if (it.kind == "promedio") {
        return t3(locale, "kiosco.p_promedio", fmt_money(locale, it.a), fmt_money(locale, it.b), fmt_money(locale, it.c))
    }
    if (it.kind == "porcentaje") {
        return t2(locale, "kiosco.p_porcentaje", fmt_int(locale, it.b), fmt_money(locale, it.a))
    }
    if (it.kind == "oferta") {
        return t4(locale, "kiosco.p_oferta", fmt_int(locale, it.a), prod, fmt_money(locale, it.b), fmt_money(locale, it.c))
    }
    // combo: {0}=cantidad, {1}=producto, {2}=precio A, {3}=precio B
    return t4(locale, "kiosco.p_combo", fmt_int(locale, it.a), prod, fmt_money(locale, it.b), fmt_money(locale, it.c))
}

fn kiosco_screen(seed: Int, idx: Int, grade: Int, locale: Str, correct: Int, total: Int, limit: Int, phase: Str, feedback: Str, last_answer: Int, last_money: Bool, entrada: Int, racha: Int, racha_max: Int) -> Html {
    if (phase == "done") {
        return kiosco_resumen(locale, correct, total, racha_max)
    }
    let it = gen_kiosco(seed, idx, grade)
    let enun = flv(kiosco_enunciado(locale, it))
    // La respuesta tipeada: plata (con $) o cuenta (número pelado) según el tipo.
    let vacio = match it.money {
        true => "$ ?",
        false => "?",
    }
    let tipeado = match it.money {
        true => fmt_money(locale, entrada),
        false => fmt_int(locale, entrada),
    }
    let slot = match entrada > 0 {
        true => html("""<span class="cg-slot filled">{flv(tipeado)}</span>""").raw,
        false => html("""<span class="cg-slot">{flv(vacio)}</span>""").raw,
    }
    let banner = kiosco_feedback(locale, feedback, last_answer, last_money, total)
    let hecho = flv(fmt_int(locale, total))
    let de_lbl = flv(t(locale, "juego.de"))
    let de_total = flv(fmt_int(locale, limit))
    let vas_lbl = flv(t(locale, "juego.aciertos"))
    let co = flv(fmt_int(locale, correct))
    let teclado = keypad_html(locale, entrada, idx, entrada > 0, false)
    let rachab = racha_badge(racha)
    let progb = progreso_bar(total, limit)
    return html("""<div class="q-hud">
<div class="q-mode">🧮 {hecho} {de_lbl} {de_total}</div>
<div class="q-score">{vas_lbl}<span class="q-snum">{co}</span>{rachab}</div>
</div>
{progb}
<div class="ki-enun">
<p class="ki-preg">{enun}</p>
</div>
<div class="q-prompt ki-slot">{slot}</div>
<div class="q-fbwrap">{banner}</div>
{teclado}""")
}

fn kiosco_feedback(locale: Str, feedback: Str, last_answer: Int, last_money: Bool, seq: Int) -> Str {
    if (feedback == "ok") {
        return html("""<div class="q-fb ok" role="status" data-fb-seq="{seq}">{flv(correcto_msg(locale, seq))}</div>""").raw
    }
    if (feedback == "bad") {
        let resp = match last_money {
            true => fmt_money(locale, last_answer),
            false => fmt_int(locale, last_answer),
        }
        return html("""<div class="q-fb bad" role="status" data-fb-seq="{seq}">{flv(incorrecto_msg(locale, seq, resp))}</div>""").raw
    }
    return ""
}

fn kiosco_resumen(locale: Str, correct: Int, total: Int, racha_max: Int) -> Html {
    let co = flv(fmt_int(locale, correct))
    let to = flv(fmt_int(locale, total))
    let de = flv(t(locale, "juego.de"))
    let estrellas = resumen_estrellas(locale, correct, total)
    let mejor = mejor_racha_html(locale, racha_max)
    return html("""<div class="q-done">
<div class="q-medal">🧉</div>
<h2>{flv(t(locale, "juego.resumen"))}</h2>
<div class="q-stat"><span class="q-big">{co} {de} {to}</span><span class="q-lbl">{flv(t(locale, "juego.aciertos"))}</span></div>
{estrellas}
{mejor}
<div class="q-actions">
<a class="mh-btn" href="/problemas">{flv(t(locale, "juego.de_nuevo"))}</a>
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>
</div>
</div>""")
}
