// live_vol.fitz — "Volumen" en vivo: página, socket y persistencia.
//
// Ronda fija de N items, SIN reloj (modelo del Desafío del día): termina cuando el
// componente marca phase="done". Persiste cada respuesta (Attempt + mastery bajo la
// skill "vol"). El server re-deriva el mismo item y compara given == it.answer.

from fitz_liveviews import Html, html, LiveFrame, component_with, dispatch_component_events, flv_frame, component_state, flv_evict, live_embed
from config import db_url
from records import leer_record, guardar_record
from i18n import t, locale_from_cookie
from layout import page, responder_html, redirect_a
from models import GameSession, Attempt
from engine import desafio_n
from mastery import actualizar_mastery
from streaks import registrar_y_premiar
from gen_vol import gen_vol
from live_game import resolver_contexto, pget_int
from Volumen import volumen

async fn crear_sesion_vol(profile_id: Int, seed: Int, grade: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let sess = GameSession.insert(conn, GameSession {
        profile_id: profile_id,
        mode: "vol",               // CHECK sessions_mode_valido (0014_vol.sql)
        topic_code: "vol",
        level: grade,
        seed: seed,
    }).await?
    return Ok(sess.id)
}

async fn persistir_vol(sess_id: Int, profile_id: Int, seed: Int, idx: Int, grade: Int, given: Int) -> Result<Int> {
    let it = gen_vol(seed, idx, grade)
    let acierto = given == it.answer
    let prompt = "{it.kind} {it.a}x{it.b}x{it.c}"
    let conn = db.connect(db_url()).await?
    let row = Attempt.insert(conn, Attempt {
        session_id: sess_id,
        profile_id: profile_id,
        skill_code: "vol",
        idx: idx,
        prompt: prompt,
        expected: "{it.answer}",
        given: "{given}",
        correct: acierto,
        ms: 0,
        difficulty: it.difficulty,
    }).await?
    let _ = actualizar_mastery(profile_id, "vol", it.difficulty, acierto, 0).await
    return Ok(row.id)
}

async fn cerrar_vol(sess_id: Int, total: Int, correct: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let _ = GameSession.where(fn(s) => s.id == sess_id).update(conn, {
        "total": total,
        "correct": correct,
    }).await?
    return Ok(1)
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/volumen")
async fn vol_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    let inicial = component_with("volumen", "ssr", volumen {
        seed: 1,
        grade: ctx.grade,
        locale: locale,
        limit: desafio_n(),
    })
    let embed = live_embed("/live/volumen", "volumen-app", inicial)
    let titulo = t(locale, "juego.volumen") + " — MatHelp"
    return responder_html(page(locale, titulo, embed, html("")))
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@ws("/live/volumen")
async fn vol_socket(ws: WsConn<LiveFrame>, session: Str?, lang: Str?) {
    let locale = locale_from_cookie(lang)
    let ctx = resolver_contexto(session).await?
    let cid = Uuid.v4().to_str()
    let seed = rand.int(1, 2000000000)
    let sess_id = crear_sesion_vol(ctx.profile_id, seed, ctx.grade).await?
    let record_prev = leer_record(ctx.profile_id, "volumen").await
    let _ = component_with("volumen", cid, volumen {
        record_prev: record_prev,
        seed: seed,
        grade: ctx.grade,
        locale: locale,
        limit: desafio_n(),
    }).raw
    ws.send(flv_frame("volumen", cid))?
    let next_idx = 0
    let finalizado = false
    loop {
        let frame = match ws.recv() {
            Ok(f) => f,
            Err(_) => { break },
        }
        let ev = frame.event
        let _ = dispatch_component_events(frame)
        if (ev == "answer") {
            let ei = pget_int(frame.payload, "ei", -1)
            let given = pget_int(frame.payload, "v", -1)
            let toco = pget_int(frame.payload, "touched", 0)
            if (ei == next_idx and toco == 1) {
                let _ = persistir_vol(sess_id, ctx.profile_id, seed, ei, ctx.grade, given).await
                let _ = registrar_y_premiar(ctx.profile_id, ctx.daily_goal).await
                next_idx = next_idx + 1
            }
        }
        match ws.send(flv_frame("volumen", cid)) {
            Ok(_) => 0,
            Err(_) => { break },
        }
        let st: volumen = component_state("volumen", cid)
        if (st.phase == "done") {
            if (not finalizado) {
                let _ = guardar_record(ctx.profile_id, "volumen", st.racha_max).await
                let _ = cerrar_vol(sess_id, st.total, st.correct).await
                finalizado = true
            }
        }
    }
    let _ = flv_evict("volumen", cid)
}
