// live_game.fitz — el contrarreloj en vivo: la página, el socket, el reloj y la
// persistencia.
//
// Arquitectura (combina dos patrones probados de liveviews):
//   - Estado del juego en el COMPONENT STORE (como el clock): un cronómetro
//     server-pushed necesita re-renderizar el componente por su cuenta, así que
//     el estado vive keyed por el instance_id del socket, no en locales del loop.
//   - Persistencia en el LOOP del `@ws` (como el Admin ABM): los `event` del
//     `.fitzv` son mutaciones puras; la DB la escribe el loop, que lee el estado
//     con `component_state(...)` y el contexto del payload del frame.
//
// Flujo:
//   1. GET /jugar   → auth + perfil → paint SSR del primer ejercicio + live_embed.
//   2. WS /live/quiz → auth + perfil → cid propio → INSERT de la partida →
//      sembrar el componente → primer frame → spawn del reloj → loop.
//   3. Cada `answer` del loop persiste un `attempt`. El reloj, al llegar a 0,
//      cierra la partida (UPDATE de totales) y termina.

from fitz_liveviews import Html, html, flv, LiveFrame, component_with, dispatch_component_events, dispatch_to, flv_frame, component_state, flv_evict, live_embed
from config import db_url
from i18n import t, locale_from_cookie
from fmt import fmt_int
from layout import page, responder_html, redirect_a
from auth import read_session, pid_from_token
from perfiles import perfil_de_familia
from models import GameSession, Attempt
from engine import duracion_default, desafio_n, a_int
from mastery import actualizar_mastery, leer_snapshot, MasterySnapshot
from streaks import registrar_y_premiar
from gen_arith import gen_mix, gen_for, op_symbol
from Quiz import quiz

// --- contexto de juego -------------------------------------------------------

// Lo que el juego necesita del jugador. La partida guarda el grade como `level`
// (el esquema no tiene columna grade): con seed + índice + grade se reconstruye
// el ejercicio, así que el grade tiene que persistir para poder "rejugar" (F5).
type GameCtx {
    profile_id: Int = 0
    grade: Int = 4
    daily_goal: Int = 10          // meta de ejercicios/día (racha diaria, F3)
}

// Resuelve sesión → perfil. Err lleva el destino del redirect (zona protegida).
async fn resolver_contexto(session: Str?) -> Result<GameCtx> {
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return Err("/login"),
    }
    let pid_str = pid_from_token(session)
    if (pid_str == "") {
        return Err("/perfiles")
    }
    let pid = a_int(pid_str)
    let perfil = match perfil_de_familia(fam.id, pid).await {
        Ok(p) => p,
        Err(_) => return Err("/perfiles"),
    }
    return Ok(GameCtx { profile_id: perfil.id, grade: perfil.grade, daily_goal: perfil.daily_goal })
}

// Estado para reanudar un desafío sin terminar (F6). Se reconstruye desde la
// sesión abierta (seed + grade) y sus attempts (idx/total/correct/score): con
// eso el componente arranca donde el chico lo dejó, sin re-mostrar lo respondido.
type ResumeState {
    sess_id: Int = 0
    seed: Int = 0
    grade: Int = 4
    next_idx: Int = 0
    total: Int = 0
    correct: Int = 0
    score: Int = 0
}

// --- persistencia ------------------------------------------------------------

// Abre la partida al conectar el socket. Devuelve el id para colgar los attempts.
async fn crear_sesion(profile_id: Int, seed: Int, grade: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    // Housekeeping (F6): cerrá cualquier contrarreloj abandonado (socket caído sin
    // terminar). El sprint no se reanuda; marcarlo `ended` deja la base limpia y
    // evita que el panel del padre cuente partidas fantasma.
    let _ = conn.exec("UPDATE sessions SET ended_at = now() WHERE profile_id = $1 AND mode = 'quiz' AND ended_at IS NULL", [profile_id]).await
    let sess = GameSession.insert(conn, GameSession {
        profile_id: profile_id,
        mode: "quiz",
        topic_code: "mix",
        level: grade,          // el esquema no tiene columna grade: la guardamos acá
        seed: seed,
    }).await?
    return Ok(sess.id)
}

// Persiste una respuesta apenas ocurre. Re-deriva el ejercicio con la MISMA
// selección adaptativa que el componente (gen_for "adaptive" + el snapshot de
// mastery congelado al abrir la partida) — determinista, así el server no confía
// en el cliente para el enunciado ni la respuesta correcta, y el ejercicio
// re-derivado coincide bit-a-bit con el que vio el chico.
async fn persistir_respuesta(sess_id: Int, profile_id: Int, seed: Int, idx: Int, grade: Int, given: Int, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Result<Int> {
    let ex = gen_for("adaptive", "mix", 2, seed, idx, grade, r_add, r_sub, r_mul, r_div)
    let acierto = given == ex.answer
    let prompt = "{ex.a} {op_symbol(ex.op)} {ex.b}"
    let conn = db.connect(db_url()).await?
    let row = Attempt.insert(conn, Attempt {
        session_id: sess_id,
        profile_id: profile_id,
        skill_code: ex.skill_code,
        idx: idx,
        prompt: prompt,
        expected: "{ex.answer}",
        given: "{given}",
        correct: acierto,
        ms: 0,                 // F2 no mide el ms por respuesta (deuda menor)
        difficulty: ex.difficulty,
    }).await?
    // Motor adaptativo (F3): actualizá el rating de la destreza con esta
    // respuesta. Best-effort — si falla, la partida sigue (el attempt ya quedó).
    let _ = actualizar_mastery(profile_id, ex.skill_code, ex.difficulty, acierto, 0).await
    return Ok(row.id)
}

// Cierra la partida con el resumen. Se llama UNA vez, desde el reloj, al agotarse
// el tiempo.
async fn finalizar_sesion(sess_id: Int, total: Int, correct: Int, score: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let dur = duracion_default() * 1000
    // `ended_at = now()` cierra el ciclo de vida de la partida (F6): una sesión
    // con `ended_at` no nula ya no es reanudable ni cuenta como abierta.
    let _ = conn.exec("UPDATE sessions SET total = $1, correct = $2, score = $3, duration_ms = $4, ended_at = now() WHERE id = $5", [total, correct, score, dur, sess_id]).await?
    return Ok(1)
}

// --- payload helpers (no exportados por la lib de liveviews) -----------------

fn pget_int(p: Map<Str, Str>, k: Str, dflt: Int) -> Int {
    let s = match p.get(k) {
        Ok(v) => v,
        Err(_) => "",
    }
    return match s.to_int() {
        Ok(n) => n,
        Err(_) => dflt,
    }
}

// --- página ------------------------------------------------------------------

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/jugar")
async fn jugar_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    // Paint SSR: instancia placeholder "ssr" (el socket abre su cid propio con
    // un seed nuevo). Un pestañeo hasta que el socket toma el control.
    let inicial = component_with("quiz", "ssr", quiz {
        seed: 1,
        grade: ctx.grade,
        locale: locale,
        mode: "adaptive",
    })
    let embed = live_embed("/live/quiz", "quiz-app", inicial)
    let titulo = t(locale, "juego.contrarreloj") + " — MatHelp"
    return responder_html(page(locale, titulo, embed, html("")))
}

// --- socket ------------------------------------------------------------------

// Las guardas (auth, DB, primer frame) propagan con `?`: un fallo temprano
// cierra el socket limpio (el @get /jugar ya hizo el redirect real; esto es el
// borde raro de "la sesión venció entre cargar la página y abrir el socket").
// El loop de eventos sale por `break` al cerrarse el socket, así el `flv_evict`
// de limpieza es alcanzable — el codegen cierra el handler con `Ok(())` (fitz
// v0.58, FITZ-19: un `@ws` con `?` ya no tiene que terminar en un loop divergente).
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@ws("/live/quiz")
async fn quiz_socket(ws: WsConn<LiveFrame>, session: Str?, lang: Str?) {
    let locale = locale_from_cookie(lang)
    let ctx = resolver_contexto(session).await?
    let cid = Uuid.v4().to_str()
    let seed = rand.int(1, 2000000000)
    let sess_id = crear_sesion(ctx.profile_id, seed, ctx.grade).await?
    // Snapshot de mastery, congelado al abrir la partida: alimenta la selección
    // adaptativa (§7). Best-effort — sin fila / error de DB → defaults (800, a
    // ciegas). El componente y persistir_respuesta usan ESTE mismo snapshot, así
    // el ejercicio mostrado y el corregido coinciden dentro de la sesión.
    let snap = match leer_snapshot(ctx.profile_id).await {
        Ok(s) => s,
        Err(_) => MasterySnapshot { },
    }
    // Sembrar el componente con el estado de ESTA partida (modo adaptativo +
    // snapshot) y mandar el primer frame (el ejercicio idx 0 del seed).
    let _ = component_with("quiz", cid, quiz {
        seed: seed,
        grade: ctx.grade,
        locale: locale,
        time_left: duracion_default(),
        mode: "adaptive",
        r_add: snap.r_add,
        r_sub: snap.r_sub,
        r_mul: snap.r_mul,
        r_div: snap.r_div,
    }).raw
    ws.send(flv_frame("quiz", cid))?
    // Cronómetro server-pushed: 1 tick/seg. Cierra la partida al llegar a 0.
    spawn(timer(ws, cid, sess_id))
    // Loop de eventos + persistencia. `next_idx` descarta taps repetidos o viejos
    // (solo persiste el ejercicio esperado). Sale por `break` cuando el socket se
    // cierra (recv o send fallan).
    let next_idx = 0
    loop {
        let frame = match ws.recv() {
            Ok(f) => f,
            Err(_) => { break },
        }
        let ev = frame.event
        let _ = dispatch_component_events(frame)
        if (ev == "answer") {
            let ei = pget_int(frame.payload, "ei", -1)
            if (ei == next_idx) {
                let given = pget_int(frame.payload, "v", -1)
                let _ = persistir_respuesta(sess_id, ctx.profile_id, seed, ei, ctx.grade, given, snap.r_add, snap.r_sub, snap.r_mul, snap.r_div).await
                // Racha diaria + medallas (F3): suma a la racha del día y otorga
                // "primer_mate"/"racha7" cuando corresponde.
                let _ = registrar_y_premiar(ctx.profile_id, ctx.daily_goal).await
                next_idx = next_idx + 1
            }
        }
        match ws.send(flv_frame("quiz", cid)) {
            Ok(_) => 0,
            Err(_) => { break },
        }
    }
    // El socket se cerró: liberamos el estado del store (la partida ya está en la
    // base). Reconnect-replay es F6 ("reanudar partida").
    let _ = flv_evict("quiz", cid)
}

// Reloj de la partida. Cada segundo dispara `tick` sobre el componente y empuja
// el re-render. `ws.send(...)?` es también la limpieza: si la pestaña se cierra,
// el send falla y el `?` termina la task (no hay leak). Al terminar el tiempo,
// cierra la partida con el resumen y corta.
@background
async fn timer(ws: WsConn<LiveFrame>, cid: Str, sess_id: Int) -> Result<Null> {
    loop {
        let _ = sleep(1000).await
        let _ = dispatch_to("quiz", cid, "tick", { })
        ws.send(flv_frame("quiz", cid))?
        let st: quiz = component_state("quiz", cid)
        if (st.phase == "done") {
            let _ = finalizar_sesion(sess_id, st.total, st.correct, st.score).await
            break
        }
    }
    return Ok(null)
}

// --- práctica libre (F3): sin reloj ni puntaje -------------------------------
//
// Reusa el MISMO Quiz.fitzv, seedeado con mode="practice" + el tema y la banda
// elegidos en el flujo /practica. Diferencias con el contrarreloj: NO spawnea
// el reloj (partida abierta), persiste GameSession.mode="practica", y deriva los
// ejercicios con gen_for("practice", topic, band, ...). La config viaja por la
// cookie mathelp_practice="op:band" — misma vía que la sesión y el locale: el
// @ws no acepta path params (el handshake es HTTP, la cookie sí llega).

// Config elegida en el flujo de práctica (op ∈ add|sub|mul|div|mix, band ∈ 1|2|3).
type PracticeCfg {
    topic: Str = "mix"
    band: Int = 2
}

fn clamp_band(b: Int) -> Int {
    if (b < 1) {
        return 1
    }
    if (b > 3) {
        return 3
    }
    return b
}

// Parsea la cookie "op:band". Ausente/incompleta → mix/medio (el GET redirige a
// /practica si falta, así el WS solo ve configs razonables).
fn parse_practice(raw: Str?) -> PracticeCfg {
    let s = match raw {
        null => "",
        v => v,
    }
    let parts = s.split(":")
    if (parts.len() < 2) {
        return PracticeCfg { topic: "mix", band: 2 }
    }
    let band = match parts[1].to_int() {
        Ok(n) => clamp_band(n),
        Err(_) => 2,
    }
    return PracticeCfg { topic: parts[0], band: band }
}

// ¿La cookie trae una config completa? (el GET redirige a /practica si no.)
fn practice_lista(raw: Str?) -> Bool {
    let s = match raw {
        null => "",
        v => v,
    }
    return s.split(":").len() >= 2
}

// Abre la sesión de práctica. mode="practica" (CHECK del SQL, en español, ≠ el
// "practice" interno del componente); topic_code guarda el tema para el reporte
// del padre (F5).
async fn crear_sesion_practica(profile_id: Int, seed: Int, grade: Int, topic: Str) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let sess = GameSession.insert(conn, GameSession {
        profile_id: profile_id,
        mode: "practica",
        topic_code: topic,
        level: grade,
        seed: seed,
    }).await?
    return Ok(sess.id)
}

// Persiste una respuesta de práctica. Re-deriva el ejercicio con gen_for (el
// mismo generador que corrige en el componente), así el server no confía en el
// cliente para el enunciado ni la respuesta.
async fn persistir_practica(sess_id: Int, profile_id: Int, topic: Str, band: Int, seed: Int, idx: Int, grade: Int, given: Int) -> Result<Int> {
    // Práctica NO es adaptativa: ratings a 800 (gen_for los ignora en "practice").
    let ex = gen_for("practice", topic, band, seed, idx, grade, 800.0, 800.0, 800.0, 800.0)
    let acierto = given == ex.answer
    let prompt = "{ex.a} {op_symbol(ex.op)} {ex.b}"
    let conn = db.connect(db_url()).await?
    let row = Attempt.insert(conn, Attempt {
        session_id: sess_id,
        profile_id: profile_id,
        skill_code: ex.skill_code,
        idx: idx,
        prompt: prompt,
        expected: "{ex.answer}",
        given: "{given}",
        correct: acierto,
        ms: 0,
        difficulty: ex.difficulty,
    }).await?
    // Motor adaptativo (F3): la práctica también entrena el rating de la
    // destreza (aunque no tenga reloj ni puntaje).
    let _ = actualizar_mastery(profile_id, ex.skill_code, ex.difficulty, acierto, 0).await
    return Ok(row.id)
}

// Cierra la sesión de práctica al desconectar el socket: la partida es abierta
// (no hay reloj que la termine), así que el conteo final se guarda acá para el
// panel del padre.
async fn cerrar_practica(sess_id: Int, total: Int, correct: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    // Cierra la sesión (F6): la práctica no se reanuda hoy (la banda de dificultad
    // no se persiste), así que marcarla `ended` al desconectar deja el ciclo limpio.
    let _ = conn.exec("UPDATE sessions SET total = $1, correct = $2, ended_at = now() WHERE id = $3", [total, correct, sess_id]).await?
    return Ok(1)
}

// Página de práctica. Vive en /jugar/practica (no /practica/jugar) para no
// colisionar con /practica/{op} del picker de temas.
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@cookie(name="mathelp_practice", into="practice")
@get("/jugar/practica")
async fn practica_get(session: Str?, lang: Str?, practice: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    // Sin config elegida → volvé a elegir tema.
    if (not practice_lista(practice)) {
        return redirect_a("/practica")
    }
    let cfg = parse_practice(practice)
    let inicial = component_with("quiz", "ssr", quiz {
        seed: 1,
        grade: ctx.grade,
        locale: locale,
        topic: cfg.topic,
        band: cfg.band,
        mode: "practice",
    })
    let embed = live_embed("/live/practica", "quiz-app", inicial)
    let titulo = t(locale, "home.practica_libre") + " — MatHelp"
    return responder_html(page(locale, titulo, embed, html("")))
}

// Socket de práctica: seedea el componente en modo práctica, sin spawn del reloj.
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@cookie(name="mathelp_practice", into="practice")
@ws("/live/practica")
async fn practica_socket(ws: WsConn<LiveFrame>, session: Str?, lang: Str?, practice: Str?) {
    let locale = locale_from_cookie(lang)
    let ctx = resolver_contexto(session).await?
    let cfg = parse_practice(practice)
    let cid = Uuid.v4().to_str()
    let seed = rand.int(1, 2000000000)
    let sess_id = crear_sesion_practica(ctx.profile_id, seed, ctx.grade, cfg.topic).await?
    let _ = component_with("quiz", cid, quiz {
        seed: seed,
        grade: ctx.grade,
        locale: locale,
        topic: cfg.topic,
        band: cfg.band,
        mode: "practice",
    }).raw
    ws.send(flv_frame("quiz", cid))?
    // Sin reloj: partida abierta. El loop persiste cada respuesta esperada.
    let next_idx = 0
    loop {
        let frame = match ws.recv() {
            Ok(f) => f,
            Err(_) => { break },
        }
        let ev = frame.event
        let _ = dispatch_component_events(frame)
        if (ev == "answer") {
            let ei = pget_int(frame.payload, "ei", -1)
            if (ei == next_idx) {
                let given = pget_int(frame.payload, "v", -1)
                let _ = persistir_practica(sess_id, ctx.profile_id, cfg.topic, cfg.band, seed, ei, ctx.grade, given).await
                // La práctica también cuenta para la racha diaria (§6).
                let _ = registrar_y_premiar(ctx.profile_id, ctx.daily_goal).await
                next_idx = next_idx + 1
            }
        }
        match ws.send(flv_frame("quiz", cid)) {
            Ok(_) => 0,
            Err(_) => { break },
        }
    }
    // Socket cerrado: guardá el conteo final y liberá el estado del store.
    let st: quiz = component_state("quiz", cid)
    let _ = cerrar_practica(sess_id, st.total, st.correct).await
    let _ = flv_evict("quiz", cid)
}

// --- Desafío del día (F3): 10 del mix adaptativo, sin reloj ------------------
//
// Mismo motor adaptativo que el contrarreloj (gen_for "desafio" == "adaptive":
// misma selección 70/20/10 por rating), pero SIN cronómetro: termina al
// completar N ejercicios (el componente marca phase="done" cuando total >=
// limit). Cada respuesta alimenta la racha diaria (§11: "alimenta la racha").

// --- reanudar (F6): el desafío es el modo reanudable ------------------------
//
// El desafío es N ejercicios sin reloj: la reanudación es limpia (mismo seed,
// se sigue en el índice donde iba). El contrarreloj es un sprint (no se
// reanuda) y la práctica no persiste su banda (reanudarla es follow-up).

// Busca el desafío sin terminar del perfil (el más reciente). Err = ninguno
// abierto. El progreso sale de los `attempts`: next_idx = respuestas dadas;
// el score se recompone con la MISMA fórmula que `puntos` (10 + dif*2 por
// acierto), sin re-derivar ejercicios.
async fn buscar_desafio_abierto(profile_id: Int) -> Result<ResumeState> {
    let conn = db.connect(db_url()).await?
    let srows = conn.query("SELECT id, seed, level FROM sessions WHERE profile_id = $1 AND mode = 'desafio' AND ended_at IS NULL ORDER BY id DESC LIMIT 1", [profile_id]).await?
    if (len(srows) == 0) {
        return Err("sin desafío abierto")
    }
    let sid = srows[0].get_int("id")?
    let seed = srows[0].get_int("seed")?
    let grade = srows[0].get_int("level")?
    let arows = conn.query("SELECT COUNT(*)::int AS n, COALESCE(SUM(CASE WHEN correct THEN 1 ELSE 0 END), 0)::int AS c, COALESCE(SUM(CASE WHEN correct THEN 10 + difficulty * 2 ELSE 0 END), 0)::int AS sc FROM attempts WHERE session_id = $1", [sid]).await?
    let n = arows[0].get_int("n")?
    let c = arows[0].get_int("c")?
    let sc = arows[0].get_int("sc")?
    return Ok(ResumeState {
        sess_id: sid,
        seed: seed,
        grade: grade,
        next_idx: n,
        total: n,
        correct: c,
        score: sc,
    })
}

// Marca como cerrados todos los desafíos abiertos del perfil (el botón
// "Empezar de nuevo" y el borde raro de una sesión abierta ya completa).
async fn abandonar_desafios_abiertos(profile_id: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let _ = conn.exec("UPDATE sessions SET ended_at = now() WHERE profile_id = $1 AND mode = 'desafio' AND ended_at IS NULL", [profile_id]).await?
    return Ok(1)
}

// Reusa el desafío abierto si lo hay (reanudar); si no, crea uno nuevo con el
// seed dado. Una sesión abierta ya completa (idx >= N, borde raro) se abandona
// y se arranca fresca.
async fn obtener_o_crear_sesion_desafio(profile_id: Int, seed_nuevo: Int, grade: Int) -> Result<ResumeState> {
    match buscar_desafio_abierto(profile_id).await {
        Ok(rs) => {
            if (rs.next_idx < desafio_n()) {
                return Ok(rs)
            }
            let _ = abandonar_desafios_abiertos(profile_id).await
        }
        Err(_) => 0,
    }
    let conn = db.connect(db_url()).await?
    let sess = GameSession.insert(conn, GameSession {
        profile_id: profile_id,
        mode: "desafio",
        topic_code: "mix",
        level: grade,
        seed: seed_nuevo,
    }).await?
    return Ok(ResumeState {
        sess_id: sess.id,
        seed: seed_nuevo,
        grade: grade,
        next_idx: 0,
        total: 0,
        correct: 0,
        score: 0,
    })
}

// Cierra el desafío con el resumen. Sin duration_ms (no hay reloj). `ended_at`
// cierra el ciclo de vida (F6): ya no es reanudable.
async fn finalizar_desafio(sess_id: Int, total: Int, correct: Int, score: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let _ = conn.exec("UPDATE sessions SET total = $1, correct = $2, score = $3, ended_at = now() WHERE id = $4", [total, correct, score, sess_id]).await?
    return Ok(1)
}

// Pantalla de reanudar (F6): el desafío quedó a medias. Dos caminos —
// continuar donde iba, o empezar uno nuevo (abandona el anterior).
fn pantalla_reanudar_desafio(locale: Str, rs: ResumeState) -> Response {
    let hechos = flv(fmt_int(locale, rs.next_idx))
    let total = flv(fmt_int(locale, desafio_n()))
    let de = flv(t(locale, "juego.de"))
    let body = html("""<div class="mh-card mh-reanudar">
<h2><span aria-hidden="true">🎯</span> {flv(t(locale, "juego.sin_terminar"))}</h2>
<p class="mh-reanudar-prog" aria-live="polite">{hechos} {de} {total}</p>
<a class="mh-btn" href="/desafio/seguir">{flv(t(locale, "juego.reanudar"))}</a>
<form method="POST" action="/desafio/nuevo">
<button class="mh-btn sec" type="submit">{flv(t(locale, "juego.empezar_nuevo"))}</button>
</form>
</div>""")
    let titulo = t(locale, "home.desafio_dia") + " — MatHelp"
    return responder_html(page(locale, titulo, body, html("")))
}

// El juego de desafío en sí (embed live). Compartido por /desafio (fresco) y
// /desafio/seguir (reanudar): el @ws reusa o crea la sesión según corresponda.
fn pantalla_desafio_juego(locale: Str, grade: Int) -> Response {
    let inicial = component_with("quiz", "ssr", quiz {
        seed: 1,
        grade: grade,
        locale: locale,
        mode: "desafio",
        limit: desafio_n(),
    })
    let embed = live_embed("/live/desafio", "quiz-app", inicial)
    let titulo = t(locale, "home.desafio_dia") + " — MatHelp"
    return responder_html(page(locale, titulo, embed, html("")))
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/desafio")
async fn desafio_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    // ¿Hay un desafío sin terminar? Ofrecé reanudarlo (F6). Solo con progreso
    // real (0 < idx < N): una sesión vacía o ya completa arranca directo el
    // juego (el @ws la reusa o crea una nueva).
    match buscar_desafio_abierto(ctx.profile_id).await {
        Ok(rs) => {
            if (rs.next_idx > 0) {
                if (rs.next_idx < desafio_n()) {
                    return pantalla_reanudar_desafio(locale, rs)
                }
            }
        }
        Err(_) => 0,
    }
    return pantalla_desafio_juego(locale, ctx.grade)
}

// Reanudar: entra directo al juego saltando la pantalla de reanudar. El @ws
// /live/desafio detecta el desafío abierto y lo continúa desde su índice.
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/desafio/seguir")
async fn desafio_seguir_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    return pantalla_desafio_juego(locale, ctx.grade)
}

// Empezar de nuevo: abandona el desafío abierto y vuelve a /desafio, que ahora
// (sin sesión abierta) arranca uno fresco. PRG: POST → 303 → GET.
@cookie(name="mathelp_session", into="session")
@post("/desafio/nuevo")
async fn desafio_nuevo_post(session: Str?) -> Response {
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    let _ = abandonar_desafios_abiertos(ctx.profile_id).await
    return redirect_a("/desafio")
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@ws("/live/desafio")
async fn desafio_socket(ws: WsConn<LiveFrame>, session: Str?, lang: Str?) {
    let locale = locale_from_cookie(lang)
    let ctx = resolver_contexto(session).await?
    let cid = Uuid.v4().to_str()
    let seed_nuevo = rand.int(1, 2000000000)
    // Reanudar (F6): si hay un desafío abierto, `rs` trae su seed + el índice y
    // los contadores reconstruidos de los attempts; si no, es una partida fresca.
    let rs = obtener_o_crear_sesion_desafio(ctx.profile_id, seed_nuevo, ctx.grade).await?
    let sess_id = rs.sess_id
    let seed = rs.seed
    let snap = match leer_snapshot(ctx.profile_id).await {
        Ok(s) => s,
        Err(_) => MasterySnapshot { },
    }
    // Sembrá el componente en el punto reanudado: idx/total/correct/score salen
    // de la DB, así el chico ve "vas 4 de 10" y sigue sin re-responder lo hecho.
    let _ = component_with("quiz", cid, quiz {
        seed: seed,
        grade: ctx.grade,
        locale: locale,
        mode: "desafio",
        limit: desafio_n(),
        idx: rs.next_idx,
        total: rs.total,
        correct: rs.correct,
        score: rs.score,
        r_add: snap.r_add,
        r_sub: snap.r_sub,
        r_mul: snap.r_mul,
        r_div: snap.r_div,
    }).raw
    ws.send(flv_frame("quiz", cid))?
    // Sin reloj: termina cuando el componente marca phase="done" (total >=
    // limit). Finalizamos UNA vez y dejamos el socket abierto en el resumen.
    let next_idx = rs.next_idx
    let finalizado = false
    loop {
        let frame = match ws.recv() {
            Ok(f) => f,
            Err(_) => { break },
        }
        let ev = frame.event
        let _ = dispatch_component_events(frame)
        if (ev == "answer") {
            let ei = pget_int(frame.payload, "ei", -1)
            if (ei == next_idx) {
                let given = pget_int(frame.payload, "v", -1)
                let _ = persistir_respuesta(sess_id, ctx.profile_id, seed, ei, ctx.grade, given, snap.r_add, snap.r_sub, snap.r_mul, snap.r_div).await
                let _ = registrar_y_premiar(ctx.profile_id, ctx.daily_goal).await
                next_idx = next_idx + 1
            }
        }
        match ws.send(flv_frame("quiz", cid)) {
            Ok(_) => 0,
            Err(_) => { break },
        }
        let st: quiz = component_state("quiz", cid)
        if (st.phase == "done") {
            if (not finalizado) {
                let _ = finalizar_desafio(sess_id, st.total, st.correct, st.score).await
                finalizado = true
            }
        }
    }
    let _ = flv_evict("quiz", cid)
}
