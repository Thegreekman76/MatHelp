// Kiosco.fitzv — "El kiosco", como LiveComponent SSR.
//
// Situación con contexto (dinero): comprás, pagás con un billete y tipeás el
// vuelto en el teclado numérico propio (mismo teclado que Completá el hueco).
// Ronda fija de N sin reloj. El problema se deriva de (seed, idx, grade) con
// gen_kiosco; la persistencia (Attempt + mastery `dec.dinero` + racha) la hace
// el @ws re-derivando el mismo problema. Alimenta el progreso igual que el resto.
//
// Tres eventos: digito(), borrar(), answer() — igual que Completá el hueco.

from gen_kiosco import gen_kiosco
from keypad import kp_append, kp_borrar
from engine import a_int
from kiosco_view import kiosco_screen, expl_kiosco

component kiosco {
  state {
    seed: Int = 0
    idx: Int = 0
    grade: Int = 4
    locale: Str = "es-AR"
    correct: Int = 0
    total: Int = 0
    racha: Int = 0
    racha_max: Int = 0
    record_prev: Int = 999999
    phase: Str = "playing"         // "playing" | "done"
    feedback: Str = ""             // "" | "ok" | "bad"
    last_answer: Int = 0           // la respuesta correcta del problema recién fallado
    last_money: Bool = false       // ¿esa respuesta era plata? (formato del feedback)
    last_expl: Str = ""            // la cuenta que resuelve el problema recién fallado ("" si no aplica)
    entrada: Int = 0               // la respuesta tipeada (0 = vacío)
    limit: Int = 10                // problemas por ronda
  }

  event digito() {
    if (phase == "playing") {
      if (payload.has("d")) {
        entrada = kp_append(entrada, a_int(payload["d"]), 99999)
      }
    }
  }

  event borrar() {
    if (phase == "playing") {
      entrada = kp_borrar(entrada)
    }
  }

  event answer() {
    if (phase == "playing") {
      if (payload.has("v")) {
        if (payload.has("ei")) {
          let ei = a_int(payload["ei"])
          if (ei == idx) {
            let given = a_int(payload["v"])
            if (given > 0) {
              let it = gen_kiosco(seed, idx, grade)
              let acierto = given == it.answer
              total = total + 1
              if (acierto) {
                correct = correct + 1
                feedback = "ok"
                racha = racha + 1
                if (racha > racha_max) {
                  racha_max = racha
                }
              }
              if (not acierto) {
                feedback = "bad"
                racha = 0
                last_answer = it.answer
                last_money = it.money
                last_expl = expl_kiosco(locale, it)
              }
              entrada = 0
              idx = idx + 1
              if (total >= limit) {
                phase = "done"
              }
            }
          }
        }
      }
    }
  }

  <template>
    <div id="kiosco-app" class="mh-quiz">
      {kiosco_screen(seed, idx, grade, locale, correct, total, limit, phase, feedback, last_answer, last_money, last_expl, entrada, racha, racha_max, record_prev).raw}
    </div>
  </template>
}
