// live_escalera.fitz — "Escalera de tablas" en vivo: página, socket y persistencia.
//
// Sin reloj (modelo Desafío/Completá): el socket no spawnea timer; la partida
// termina cuando el componente marca phase="done" (llegaste a la cima). Reusa el
// motor (gen_escalera, adaptativo sobre el rating de mul) + persistencia por
// respuesta → alimenta mastery/racha igual que el contrarreloj. El server
// re-deriva el ejercicio y compara given == ex.answer.

from fitz_liveviews import Html, html, LiveFrame, component_with, dispatch_component_events, flv_frame, component_state, flv_evict, live_embed
from config import db_url
from i18n import t, locale_from_cookie
from layout import page, responder_html, redirect_a
from models import GameSession, Attempt
from mastery import actualizar_mastery, leer_snapshot, MasterySnapshot
from streaks import registrar_y_premiar
from gen_arith import gen_escalera, op_symbol
from live_game import resolver_contexto, pget_int
from Escalera import escalera

async fn crear_sesion_escalera(profile_id: Int, seed: Int, grade: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let sess = GameSession.insert(conn, GameSession {
        profile_id: profile_id,
        mode: "escalera",          // CHECK sessions_mode_valido (0001_init.sql)
        topic_code: "mult.tabla",
        level: grade,
        seed: seed,
    }).await?
    return Ok(sess.id)
}

async fn persistir_escalera(sess_id: Int, profile_id: Int, seed: Int, idx: Int, grade: Int, given: Int, r_mul: Float) -> Result<Int> {
    let ex = gen_escalera(seed, idx, grade, r_mul)
    let acierto = given == ex.answer
    let prompt = "{ex.a} {op_symbol(ex.op)} {ex.b}"
    let conn = db.connect(db_url()).await?
    let row = Attempt.insert(conn, Attempt {
        session_id: sess_id,
        profile_id: profile_id,
        skill_code: ex.skill_code,
        idx: idx,
        prompt: prompt,
        expected: "{ex.answer}",
        given: "{given}",
        correct: acierto,
        ms: 0,
        difficulty: ex.difficulty,
    }).await?
    let _ = actualizar_mastery(profile_id, ex.skill_code, ex.difficulty, acierto, 0).await
    return Ok(row.id)
}

async fn cerrar_escalera(sess_id: Int, total: Int, correct: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let _ = GameSession.where(fn(s) => s.id == sess_id).update(conn, {
        "total": total,
        "correct": correct,
    }).await?
    return Ok(1)
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/escalera")
async fn escalera_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    let inicial = component_with("escalera", "ssr", escalera {
        seed: 1,
        grade: ctx.grade,
        locale: locale,
    })
    let embed = live_embed("/live/escalera", "escalera-app", inicial)
    let titulo = t(locale, "juego.escalera") + " — MatHelp"
    return responder_html(page(locale, titulo, embed, html("")))
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@ws("/live/escalera")
async fn escalera_socket(ws: WsConn<LiveFrame>, session: Str?, lang: Str?) {
    let locale = locale_from_cookie(lang)
    let ctx = resolver_contexto(session).await?
    let cid = Uuid.v4().to_str()
    let seed = rand.int(1, 2000000000)
    let sess_id = crear_sesion_escalera(ctx.profile_id, seed, ctx.grade).await?
    let snap = match leer_snapshot(ctx.profile_id).await {
        Ok(s) => s,
        Err(_) => MasterySnapshot { },
    }
    let _ = component_with("escalera", cid, escalera {
        seed: seed,
        grade: ctx.grade,
        locale: locale,
        r_mul: snap.r_mul,
    }).raw
    ws.send(flv_frame("escalera", cid))?
    let next_idx = 0
    let finalizado = false
    loop {
        let frame = match ws.recv() {
            Ok(f) => f,
            Err(_) => { break },
        }
        let ev = frame.event
        let _ = dispatch_component_events(frame)
        if (ev == "answer") {
            let ei = pget_int(frame.payload, "ei", -1)
            if (ei == next_idx) {
                let given = pget_int(frame.payload, "v", -1)
                let _ = persistir_escalera(sess_id, ctx.profile_id, seed, ei, ctx.grade, given, snap.r_mul).await
                let _ = registrar_y_premiar(ctx.profile_id, ctx.daily_goal).await
                next_idx = next_idx + 1
            }
        }
        match ws.send(flv_frame("escalera", cid)) {
            Ok(_) => 0,
            Err(_) => { break },
        }
        let st: escalera = component_state("escalera", cid)
        if (st.phase == "done") {
            if (not finalizado) {
                let _ = cerrar_escalera(sess_id, st.total, st.correct).await
                finalizado = true
            }
        }
    }
    let _ = flv_evict("escalera", cid)
}
