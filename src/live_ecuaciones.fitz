// live_ecuaciones.fitz — el juego "Ecuaciones" en vivo (F7.2). Página, socket y
// persistencia. Teclado con ± (el chico tipea la solución x). Ronda fija de N,
// sin reloj, NO adaptativo (gen_ecuacion no usa ratings). La sesión se guarda con
// mode "numpad" (juego de teclado numérico; ya está en el CHECK del 0001).

from fitz_liveviews import Html, html, LiveFrame, component_with, dispatch_component_events, flv_frame, component_state, flv_evict, live_embed
from config import db_url
from records import leer_record, guardar_record
from i18n import t, locale_from_cookie
from layout import page, responder_html, redirect_a
from live_game import resolver_contexto, pget_int
from models import GameSession, Attempt
from engine import desafio_n
from mastery import actualizar_mastery, leer_rating
from streaks import registrar_y_premiar
from gen_arith import gen_ecuacion, ecuacion_correcta, grado_efectivo
from ecuacion_view import prompt_ecuacion
from Ecuaciones import ecuaciones

async fn crear_sesion_ecuaciones(profile_id: Int, seed: Int, grade: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let sess = GameSession.insert(conn, GameSession {
        profile_id: profile_id,
        mode: "numpad",
        topic_code: "ec",
        level: grade,
        seed: seed,
    }).await?
    return Ok(sess.id)
}

// Re-deriva el ejercicio (gen_ecuacion) y corrige con ecuacion_correcta — el
// server no confía en el cliente. Prompt canónico para el panel del padre.
async fn persistir_ecuacion(sess_id: Int, profile_id: Int, seed: Int, idx: Int, grade: Int, given: Int) -> Result<Int> {
    let ex = gen_ecuacion(seed, idx, grade)
    let acierto = ecuacion_correcta(given, ex.answer, ex.op)
    let prompt = prompt_ecuacion("es-AR", ex.a, ex.b, ex.a2, ex.b2, ex.answer, ex.answer2, ex.op)
    let conn = db.connect(db_url()).await?
    let row = Attempt.insert(conn, Attempt {
        session_id: sess_id,
        profile_id: profile_id,
        skill_code: ex.skill_code,
        idx: idx,
        prompt: prompt,
        expected: "{ex.answer}",
        given: "{given}",
        correct: acierto,
        ms: 0,
        difficulty: ex.difficulty,
    }).await?
    let _ = actualizar_mastery(profile_id, ex.skill_code, ex.difficulty, acierto, 0).await
    return Ok(row.id)
}

async fn finalizar_ecuaciones(sess_id: Int, total: Int, correct: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let _ = conn.exec("UPDATE sessions SET total = $1, correct = $2, ended_at = now() WHERE id = $3", [total, correct, sess_id]).await?
    return Ok(1)
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/ecuaciones")
async fn ecuaciones_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    let inicial = component_with("ecuaciones", "ssr", ecuaciones {
        seed: 1,
        grade: ctx.grade,
        locale: locale,
        limit: desafio_n(),
    })
    let embed = live_embed("/live/ecuaciones", "ecuaciones-app", inicial)
    let titulo = t(locale, "juego.ecuaciones") + " — MatHelp"
    return responder_html(page(locale, titulo, embed, html("")))
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@ws("/live/ecuaciones")
async fn ecuaciones_socket(ws: WsConn<LiveFrame>, session: Str?, lang: Str?) {
    let locale = locale_from_cookie(lang)
    let ctx = resolver_contexto(session).await?
    // F8 Fase C: el arranque se nudgea por el rating de mastery del juego (destreza
    // ancla "ec.lineal"). Un chico que domina las lineales arranca más arriba; uno
    // que arranca a ciegas (800) juega a su grado real. Congelado por sesión.
    let rating = match leer_rating(ctx.profile_id, "ec.lineal").await {
        Ok(r) => r,
        Err(_) => 800.0,
    }
    let eff = grado_efectivo(ctx.grade, rating)
    let cid = Uuid.v4().to_str()
    let seed = rand.int(1, 2000000000)
    let sess_id = crear_sesion_ecuaciones(ctx.profile_id, seed, ctx.grade).await?
    let record_prev = leer_record(ctx.profile_id, "ecuaciones").await
    let _ = component_with("ecuaciones", cid, ecuaciones {
        record_prev: record_prev,
        seed: seed,
        grade: eff,
        locale: locale,
        limit: desafio_n(),
    }).raw
    ws.send(flv_frame("ecuaciones", cid))?
    let next_idx = 0
    let finalizado = false
    loop {
        let frame = match ws.recv() {
            Ok(f) => f,
            Err(_) => { break },
        }
        let ev = frame.event
        let _ = dispatch_component_events(frame)
        if (ev == "answer") {
            let ei = pget_int(frame.payload, "ei", -1)
            let given = pget_int(frame.payload, "v", -1)
            let toco = pget_int(frame.payload, "touched", 0)
            if (ei == next_idx and toco == 1) {
                let _ = persistir_ecuacion(sess_id, ctx.profile_id, seed, ei, eff, given).await
                let _ = registrar_y_premiar(ctx.profile_id, ctx.daily_goal).await
                next_idx = next_idx + 1
            }
        }
        match ws.send(flv_frame("ecuaciones", cid)) {
            Ok(_) => 0,
            Err(_) => { break },
        }
        let st: ecuaciones = component_state("ecuaciones", cid)
        if (st.phase == "done") {
            if (not finalizado) {
                let _ = finalizar_ecuaciones(sess_id, st.total, st.correct).await
                let _ = guardar_record(ctx.profile_id, "ecuaciones", st.racha_max).await
                finalizado = true
            }
        }
    }
    let _ = flv_evict("ecuaciones", cid)
}
