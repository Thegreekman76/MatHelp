// brand.fitz — identidad de MatHelp: logo, footer y tokens de estilo.
//
// El logo va SVG inline y no como archivo: Fitz no sirve estáticos, y de
// paso nos ahorra un request. El mismo SVG se reusa en /favicon.svg desde
// assets.fitz.
//
// El isotipo es un mate con bombilla y adentro un "+" que se lee como signo
// de suma y como cruz de ayuda: Mat(emática) + Help. El mate se comparte,
// la matemática también.

from fitz_liveviews import Html, html, flv
from config import repo_fitz, repo_liveviews, app_name
from i18n import t

// --- Logo ----------------------------------------------------------------

// Isotipo solo. `size` en px. Sin <style> adentro: iría dentro del root
// diffeado y el parser del diff lo degrada en silencio (FLV-02).
fn logo_mark(size: Int) -> Html {
    return html("""<svg width="{size}" height="{size}" viewBox="0 0 120 120" role="img" aria-label="MatHelp" focusable="false">
<defs>
<linearGradient id="mh-gourd" x1=".2" y1="0" x2=".8" y2="1"><stop offset="0" stop-color="#34BE99"/><stop offset="1" stop-color="#0B6B57"/></linearGradient>
<linearGradient id="mh-metal" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFE7A6"/><stop offset=".5" stop-color="#F2B705"/><stop offset="1" stop-color="#C98A06"/></linearGradient>
</defs>
<g stroke-linecap="round">
<path d="M103 16 L66 40" stroke="url(#mh-metal)" stroke-width="8" fill="none"/>
<circle cx="104" cy="15" r="6.5" fill="url(#mh-metal)"/>
<circle cx="104" cy="15" r="2.3" fill="#8A5A08"/>
</g>
<path d="M47 44V33c0-3.6 5.8-6.5 13-6.5s13 2.9 13 6.5v11c14 6 23 18 23 32 0 19-16 32-36 32S24 95 24 76c0-14 9-26 23-32z" fill="url(#mh-gourd)"/>
<path d="M60 26.5c7.2 0 13 2.9 13 6.5v11c14 6 23 18 23 32 0 19-16 32-36 32" fill="#00352B" opacity=".13"/>
<ellipse cx="60" cy="32" rx="16.5" ry="6.2" fill="url(#mh-metal)"/>
<ellipse cx="60" cy="31.2" rx="11.5" ry="3.9" fill="#173A1F"/>
<g fill="#FFF7EC"><rect x="41.5" y="72.5" width="37" height="11.5" rx="5.75"/><rect x="54.25" y="59.75" width="11.5" height="37" rx="5.75"/></g>
</svg>""")
}

// Logo + palabra. Para el header y la pantalla de inicio.
fn logo_lockup(size: Int, locale: Str) -> Html {
    let marca = logo_mark(size).raw
    return html("""<span class="mh-lockup">{marca}<span class="mh-word"><span class="mh-w1">Mat</span><span class="mh-w2">Help</span></span></span>""")
}

// SVG suelto, para servirlo como /favicon.svg
fn logo_svg_raw() -> Str {
    return logo_mark(120).raw
}

// --- Footer --------------------------------------------------------------

// Va en TODAS las pantallas, respetando el safe-area del celular.
fn footer(locale: Str) -> Html {
    let hecho = flv(t(locale, "footer.hecho_con"))
    let y = flv(t(locale, "footer.y"))
    return html("""<footer class="mh-footer">
{hecho} <a href="{repo_fitz()}" target="_blank" rel="noopener">Fitz</a> {y} <a href="{repo_liveviews()}" target="_blank" rel="noopener">Fitz LiveViews</a>
<span class="mh-dot">·</span> MatHelp
</footer>""")
}

// --- Estilos -------------------------------------------------------------

// Mobile-first de verdad: se diseña a 360 px y la PC es "lo mismo, centrado
// y con más aire". Área táctil mínima 56 px; los botones de respuesta 72.
// Nada depende de :hover. Feedback en :active para que sea instantáneo y no
// espere el round-trip del WebSocket.
//
// OJO: las llaves literales de CSS van escapadas \{ \} dentro de un string
// de Fitz, porque {..} es interpolación.
fn brand_css() -> Str {
    return """
:root \{
  --mh-naranja:#E8552F; --mh-naranja-claro:#FF7A52;
  --mh-verde:#0E7A63; --mh-verde-claro:#2FB08F; --mh-verde-suave:#E6F6F1;
  --mh-amarillo:#F2B705; --mh-celeste:#6EC1E4;
  --mh-tinta:#12212B; --mh-crema:#FFF7EC; --mh-fondo:#F7F4EE;
  --mh-borde:#E3DED3; --mh-suave:#5A6B72; --mh-panel:#FFFFFF;
  --mh-tap:56px; --mh-radio:16px;
  --mh-safe-b: env(safe-area-inset-bottom, 0px);
\}
@media (prefers-color-scheme: dark) \{
  :root \{
    --mh-fondo:#0E181E; --mh-panel:#152229; --mh-borde:#25353E;
    --mh-tinta:#EAF2F4; --mh-suave:#93A6AE; --mh-crema:#152229;
    --mh-naranja:#FF7A52; --mh-verde-suave:#123A31;
  \}
\}
* \{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; \}
html,body \{ margin:0; padding:0; \}
body \{
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  background:var(--mh-fondo); color:var(--mh-tinta);
  min-height:100dvh; display:flex; flex-direction:column;
  font-size:16px; line-height:1.45;
  overscroll-behavior-y:contain;
\}
main \{ flex:1; width:100%; max-width:560px; margin:0 auto; padding:16px 16px 0; \}
@media (min-width:900px) \{ main \{ max-width:720px; padding-top:32px; \} \}

.mh-topbar \{
  display:flex; align-items:center; gap:10px;
  padding:10px 14px; padding-top:calc(10px + env(safe-area-inset-top,0px));
  background:var(--mh-verde); color:#fff; position:sticky; top:0; z-index:10;
\}
.mh-topbar .mh-word \{ color:#fff; \}
.mh-topbar .mh-w2 \{ color:#FFD9CC; \}

.mh-lockup \{ display:inline-flex; align-items:center; gap:9px; \}
.mh-word \{ font-weight:800; letter-spacing:-.02em; font-size:1.25rem; line-height:1; \}
.mh-w1 \{ color:var(--mh-tinta); \}
.mh-w2 \{ color:var(--mh-naranja); \}

.mh-hero \{ text-align:center; padding:18px 0 6px; \}
.mh-hero .mh-word \{ font-size:clamp(2rem,9vw,2.8rem); \}
.mh-tagline \{ color:var(--mh-suave); font-size:.9rem; font-weight:600; margin-top:6px; \}

.mh-card \{
  background:var(--mh-panel); border:1px solid var(--mh-borde);
  border-radius:var(--mh-radio); padding:16px; margin:14px 0;
\}
.mh-card h2 \{ font-size:.72rem; letter-spacing:.12em; text-transform:uppercase;
  color:var(--mh-suave); margin:0 0 12px; font-weight:700; \}

.mh-btn \{
  display:flex; align-items:center; justify-content:center; gap:8px;
  width:100%; min-height:var(--mh-tap); padding:14px 18px;
  border:0; border-radius:var(--mh-radio); font-size:1.05rem; font-weight:800;
  background:var(--mh-verde); color:#fff; text-decoration:none;
  cursor:pointer; transition:transform .06s ease;
\}
.mh-btn:active \{ transform:scale(.97); \}
.mh-btn.sec \{ background:var(--mh-panel); color:var(--mh-tinta); border:2px solid var(--mh-borde); \}
.mh-btn.acc \{ background:var(--mh-naranja); \}
.mh-btn + .mh-btn \{ margin-top:10px; \}

.mh-opts \{ display:grid; grid-template-columns:1fr 1fr; gap:10px; \}
.mh-opt \{
  min-height:72px; font-size:1.5rem; font-weight:800;
  background:var(--mh-panel); border:2px solid var(--mh-borde);
  border-radius:var(--mh-radio); color:var(--mh-tinta); cursor:pointer;
\}
.mh-opt:active \{ transform:scale(.97); \}

.mh-langs \{ display:flex; gap:8px; margin-left:auto; \}
.mh-lang \{
  min-height:36px; display:inline-flex; align-items:center; padding:0 12px;
  border-radius:999px; font-size:.8rem; font-weight:700; text-decoration:none;
  background:rgba(255,255,255,.16); color:#fff;
\}
.mh-lang[aria-current="true"] \{ background:#fff; color:var(--mh-verde); \}

.mh-estado \{ display:flex; align-items:center; gap:8px; font-size:.85rem; color:var(--mh-suave); \}
.mh-pill \{ display:inline-block; width:9px; height:9px; border-radius:999px; background:var(--mh-verde-claro); \}
.mh-pill.err \{ background:var(--mh-naranja); \}

.mh-footer \{
  text-align:center; font-size:.72rem; color:var(--mh-suave);
  padding:18px 16px calc(18px + var(--mh-safe-b));
  margin-top:22px; border-top:1px solid var(--mh-borde);
\}
.mh-footer a \{ color:var(--mh-naranja); text-decoration:none; font-weight:700; \}
.mh-dot \{ opacity:.5; margin:0 4px; \}

/* --- Formularios (F1: auth y perfiles) --- */
.mh-field \{ margin:0 0 14px; \}
.mh-label \{
  display:block; font-size:.82rem; font-weight:700; color:var(--mh-suave);
  margin:0 0 6px; letter-spacing:.01em;
\}
.mh-input, .mh-select \{
  width:100%; min-height:var(--mh-tap); padding:12px 14px;
  font-size:1.05rem; color:var(--mh-tinta);
  background:var(--mh-fondo); border:2px solid var(--mh-borde);
  border-radius:12px; appearance:none;
\}
.mh-input:focus, .mh-select:focus \{
  outline:none; border-color:var(--mh-verde-claro);
  box-shadow:0 0 0 3px var(--mh-verde-suave);
\}
.mh-input::placeholder \{ color:var(--mh-suave); opacity:.65; \}
.mh-hint \{ display:block; font-size:.76rem; color:var(--mh-suave); margin:6px 0 0; \}

.mh-error \{
  display:flex; align-items:center; gap:8px; margin:0 0 14px; padding:11px 14px;
  font-size:.9rem; font-weight:600; color:#fff;
  background:var(--mh-naranja); border-radius:12px;
\}

.mh-link \{
  display:inline-block; margin-top:4px; text-align:center; width:100%;
  color:var(--mh-verde); font-weight:700; font-size:.92rem; text-decoration:none;
\}
.mh-link:active \{ opacity:.7; \}

/* Grilla de perfiles: botones grandes, pulgar-friendly. */
.mh-profiles \{ display:grid; grid-template-columns:1fr 1fr; gap:12px; \}
.mh-profile \{
  display:flex; flex-direction:column; align-items:center; gap:8px;
  min-height:120px; justify-content:center; padding:16px 10px;
  background:var(--mh-panel); border:2px solid var(--mh-borde);
  border-radius:var(--mh-radio); color:var(--mh-tinta); text-decoration:none;
  font-weight:800; cursor:pointer; transition:transform .06s ease;
\}
.mh-profile:active \{ transform:scale(.97); \}
.mh-profile .mh-av \{
  width:52px; height:52px; border-radius:999px; display:grid; place-items:center;
  background:var(--mh-verde-suave); color:var(--mh-verde); font-size:1.5rem;
\}
.mh-profile .mh-pgrado \{ font-size:.74rem; font-weight:700; color:var(--mh-suave); \}
.mh-profile.add \{ border-style:dashed; color:var(--mh-verde); \}
.mh-profile.add .mh-av \{ background:transparent; border:2px dashed var(--mh-borde); \}

@media (prefers-reduced-motion:reduce) \{ * \{ transition:none !important; \} \}
"""
}
