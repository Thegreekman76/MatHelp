// brand.fitz — identidad de MatHelp: logo, footer y tokens de estilo.
//
// El logo va SVG inline y no como archivo: Fitz no sirve estáticos, y de
// paso nos ahorra un request. El mismo SVG se reusa en /favicon.svg desde
// assets.fitz.
//
// El isotipo es un mate con bombilla y adentro un "+" que se lee como signo
// de suma y como cruz de ayuda: Mat(emática) + Help. El mate se comparte,
// la matemática también.

from fitz_liveviews import Html, html, flv
from config import repo_fitz, repo_liveviews, app_name
from i18n import t

// --- Logo ----------------------------------------------------------------

// Isotipo solo. `size` en px. Sin <style> adentro: iría dentro del root
// diffeado y el parser del diff lo degrada en silencio (FLV-02).
fn logo_mark(size: Int) -> Html {
    return html("""<svg width="{size}" height="{size}" viewBox="0 0 120 120" role="img" aria-label="MatHelp" focusable="false">
<defs>
<linearGradient id="mh-gourd" x1=".2" y1="0" x2=".8" y2="1"><stop offset="0" stop-color="#34BE99"/><stop offset="1" stop-color="#0B6B57"/></linearGradient>
<linearGradient id="mh-metal" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FFE7A6"/><stop offset=".5" stop-color="#F2B705"/><stop offset="1" stop-color="#C98A06"/></linearGradient>
</defs>
<g stroke-linecap="round">
<path d="M103 16 L66 40" stroke="url(#mh-metal)" stroke-width="8" fill="none"/>
<circle cx="104" cy="15" r="6.5" fill="url(#mh-metal)"/>
<circle cx="104" cy="15" r="2.3" fill="#8A5A08"/>
</g>
<path d="M47 44V33c0-3.6 5.8-6.5 13-6.5s13 2.9 13 6.5v11c14 6 23 18 23 32 0 19-16 32-36 32S24 95 24 76c0-14 9-26 23-32z" fill="url(#mh-gourd)"/>
<path d="M60 26.5c7.2 0 13 2.9 13 6.5v11c14 6 23 18 23 32 0 19-16 32-36 32" fill="#00352B" opacity=".13"/>
<ellipse cx="60" cy="32" rx="16.5" ry="6.2" fill="url(#mh-metal)"/>
<ellipse cx="60" cy="31.2" rx="11.5" ry="3.9" fill="#173A1F"/>
<g fill="#FFF7EC"><rect x="41.5" y="72.5" width="37" height="11.5" rx="5.75"/><rect x="54.25" y="59.75" width="11.5" height="37" rx="5.75"/></g>
</svg>""")
}

// Logo + palabra. Para el header y la pantalla de inicio.
fn logo_lockup(size: Int, locale: Str) -> Html {
    let marca = logo_mark(size).raw
    return html("""<span class="mh-lockup">{marca}<span class="mh-word"><span class="mh-w1">Mat</span><span class="mh-w2">Help</span></span></span>""")
}

// SVG suelto, para servirlo como /favicon.svg
fn logo_svg_raw() -> Str {
    return logo_mark(120).raw
}

// --- Footer --------------------------------------------------------------

// Va en TODAS las pantallas, respetando el safe-area del celular.
fn footer(locale: Str) -> Html {
    let hecho = flv(t(locale, "footer.hecho_con"))
    let y = flv(t(locale, "footer.y"))
    return html("""<footer class="mh-footer">
{hecho} <a href="{repo_fitz()}" target="_blank" rel="noopener">Fitz</a> {y} <a href="{repo_liveviews()}" target="_blank" rel="noopener">Fitz LiveViews</a>
<span class="mh-dot">·</span> MatHelp
</footer>""")
}

// --- Estilos -------------------------------------------------------------

// Mobile-first de verdad: se diseña a 360 px y la PC es "lo mismo, centrado
// y con más aire". Área táctil mínima 56 px; los botones de respuesta 72.
// Nada depende de :hover. Feedback en :active para que sea instantáneo y no
// espere el round-trip del WebSocket.
//
// OJO: las llaves literales de CSS van escapadas \{ \} dentro de un string
// de Fitz, porque {..} es interpolación.
fn brand_css() -> Str {
    return """
:root \{
  --mh-naranja:#E8552F; --mh-naranja-claro:#FF7A52;
  --mh-verde:#0E7A63; --mh-verde-claro:#2FB08F; --mh-verde-suave:#E6F6F1;
  --mh-amarillo:#F2B705; --mh-celeste:#6EC1E4;
  --mh-tinta:#12212B; --mh-crema:#FFF7EC; --mh-fondo:#F7F4EE;
  --mh-borde:#E3DED3; --mh-suave:#5A6B72; --mh-panel:#FFFFFF;
  --mh-tap:56px; --mh-radio:16px;
  --mh-safe-b: env(safe-area-inset-bottom, 0px);
\}
@media (prefers-color-scheme: dark) \{
  :root \{
    --mh-fondo:#0E181E; --mh-panel:#152229; --mh-borde:#25353E;
    --mh-tinta:#EAF2F4; --mh-suave:#93A6AE; --mh-crema:#152229;
    --mh-naranja:#FF7A52; --mh-verde-suave:#123A31;
  \}
\}
* \{ box-sizing:border-box; -webkit-tap-highlight-color:transparent; \}
html,body \{ margin:0; padding:0; \}
body \{
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  background:var(--mh-fondo); color:var(--mh-tinta);
  min-height:100dvh; display:flex; flex-direction:column;
  font-size:16px; line-height:1.45;
  overscroll-behavior-y:contain;
\}
main \{ flex:1; width:100%; max-width:560px; margin:0 auto; padding:16px 16px 0; \}
@media (min-width:900px) \{ main \{ max-width:720px; padding-top:32px; \} \}

.mh-topbar \{
  display:flex; align-items:center; gap:10px;
  padding:10px 14px; padding-top:calc(10px + env(safe-area-inset-top,0px));
  background:var(--mh-verde); color:#fff; position:sticky; top:0; z-index:10;
\}
.mh-topbar .mh-word \{ color:#fff; \}
.mh-topbar .mh-w2 \{ color:#FFD9CC; \}

.mh-lockup \{ display:inline-flex; align-items:center; gap:9px; \}
.mh-word \{ font-weight:800; letter-spacing:-.02em; font-size:1.25rem; line-height:1; \}
.mh-w1 \{ color:var(--mh-tinta); \}
.mh-w2 \{ color:var(--mh-naranja); \}

.mh-hero \{ text-align:center; padding:18px 0 6px; \}
.mh-hero .mh-word \{ font-size:clamp(2rem,9vw,2.8rem); \}
.mh-tagline \{ color:var(--mh-suave); font-size:.9rem; font-weight:600; margin-top:6px; \}

.mh-card \{
  background:var(--mh-panel); border:1px solid var(--mh-borde);
  border-radius:var(--mh-radio); padding:16px; margin:14px 0;
\}
.mh-card h2 \{ font-size:.72rem; letter-spacing:.12em; text-transform:uppercase;
  color:var(--mh-suave); margin:0 0 12px; font-weight:700; \}

.mh-btn \{
  display:flex; align-items:center; justify-content:center; gap:8px;
  width:100%; min-height:var(--mh-tap); padding:14px 18px;
  border:0; border-radius:var(--mh-radio); font-size:1.05rem; font-weight:800;
  background:var(--mh-verde); color:#fff; text-decoration:none;
  cursor:pointer; transition:transform .06s ease;
\}
.mh-btn:active \{ transform:scale(.97); \}
.mh-btn.sec \{ background:var(--mh-panel); color:var(--mh-tinta); border:2px solid var(--mh-borde); \}
.mh-btn.acc \{ background:var(--mh-naranja); \}
.mh-btn + .mh-btn \{ margin-top:10px; \}

.mh-opts \{ display:grid; grid-template-columns:1fr 1fr; gap:10px; \}
.mh-opt \{
  min-height:72px; font-size:1.5rem; font-weight:800;
  background:var(--mh-panel); border:2px solid var(--mh-borde);
  border-radius:var(--mh-radio); color:var(--mh-tinta); cursor:pointer;
\}
.mh-opt:active \{ transform:scale(.97); \}

.mh-controls \{ display:flex; align-items:center; gap:8px; margin-left:auto; \}
.mh-sound-btn \{
  min-height:36px; min-width:36px; display:inline-flex; align-items:center;
  justify-content:center; padding:0 10px; border:0; border-radius:999px;
  cursor:pointer; font-size:1rem; line-height:1;
  background:rgba(255,255,255,.16); color:#fff;
\}
.mh-sound-btn:active \{ transform:scale(.94); \}
.mh-langs \{ display:flex; gap:8px; \}
.mh-lang \{
  min-height:36px; display:inline-flex; align-items:center; padding:0 12px;
  border-radius:999px; font-size:.8rem; font-weight:700; text-decoration:none;
  background:rgba(255,255,255,.16); color:#fff;
\}
.mh-lang[aria-current="true"] \{ background:#fff; color:var(--mh-verde); \}

.mh-estado \{ display:flex; align-items:center; gap:8px; font-size:.85rem; color:var(--mh-suave); \}
.mh-pill \{ display:inline-block; width:9px; height:9px; border-radius:999px; background:var(--mh-verde-claro); \}
.mh-pill.err \{ background:var(--mh-naranja); \}

.mh-footer \{
  text-align:center; font-size:.72rem; color:var(--mh-suave);
  padding:18px 16px calc(18px + var(--mh-safe-b));
  margin-top:22px; border-top:1px solid var(--mh-borde);
\}
.mh-footer a \{ color:var(--mh-naranja); text-decoration:none; font-weight:700; \}
.mh-dot \{ opacity:.5; margin:0 4px; \}

/* --- Formularios (F1: auth y perfiles) --- */
.mh-field \{ margin:0 0 14px; \}
.mh-label \{
  display:block; font-size:.82rem; font-weight:700; color:var(--mh-suave);
  margin:0 0 6px; letter-spacing:.01em;
\}
.mh-input, .mh-select \{
  width:100%; min-height:var(--mh-tap); padding:12px 14px;
  font-size:1.05rem; color:var(--mh-tinta);
  background:var(--mh-fondo); border:2px solid var(--mh-borde);
  border-radius:12px; appearance:none;
\}
.mh-input:focus, .mh-select:focus \{
  outline:none; border-color:var(--mh-verde-claro);
  box-shadow:0 0 0 3px var(--mh-verde-suave);
\}
/* Foco visible para teclado y switch-access (F6.2). El anillo usa --mh-tinta,
   que se invierte por tema (casi-negro en claro, casi-blanco en oscuro), así
   contrasta con cualquier fondo o color de botón. Solo :focus-visible, para no
   mostrarlo al tocar/click (donde el :active ya da feedback). */
:focus-visible \{ outline:3px solid var(--mh-tinta); outline-offset:2px; \}
.mh-input:focus-visible, .mh-select:focus-visible \{
  outline:3px solid var(--mh-tinta); outline-offset:2px;
\}
/* Skip-link: primer tab de la página, salta al contenido. Oculto hasta enfocar. */
.mh-skip \{
  position:absolute; left:12px; top:-72px; z-index:200;
  background:var(--mh-verde); color:#fff; padding:12px 18px;
  border-radius:var(--mh-radio); font-weight:700; text-decoration:none;
  transition:top .15s ease;
\}
.mh-skip:focus \{ top:12px; \}
main:focus \{ outline:none; \}
.mh-input::placeholder \{ color:var(--mh-suave); opacity:.65; \}
.mh-hint \{ display:block; font-size:.76rem; color:var(--mh-suave); margin:6px 0 0; \}

.mh-error \{
  display:flex; align-items:center; gap:8px; margin:0 0 14px; padding:11px 14px;
  font-size:.9rem; font-weight:600; color:#fff;
  background:var(--mh-naranja); border-radius:12px;
\}

.mh-link \{
  display:inline-block; margin-top:4px; text-align:center; width:100%;
  color:var(--mh-verde); font-weight:700; font-size:.92rem; text-decoration:none;
\}
.mh-link:active \{ opacity:.7; \}

/* Grilla de perfiles: botones grandes, pulgar-friendly. */
.mh-profiles \{ display:grid; grid-template-columns:1fr 1fr; gap:12px; \}
.mh-profile \{
  display:flex; flex-direction:column; align-items:center; gap:8px;
  min-height:120px; justify-content:center; padding:16px 10px;
  background:var(--mh-panel); border:2px solid var(--mh-borde);
  border-radius:var(--mh-radio); color:var(--mh-tinta); text-decoration:none;
  font-weight:800; cursor:pointer; transition:transform .06s ease;
\}
.mh-profile:active \{ transform:scale(.97); \}
.mh-profile .mh-av \{
  width:52px; height:52px; border-radius:999px; display:grid; place-items:center;
  background:var(--mh-verde-suave); color:var(--mh-verde); font-size:1.5rem;
\}
.mh-profile .mh-pgrado \{ font-size:.74rem; font-weight:700; color:var(--mh-suave); \}
.mh-profile.add \{ border-style:dashed; color:var(--mh-verde); \}
.mh-profile.add .mh-av \{ background:transparent; border:2px dashed var(--mh-borde); \}

/* --- Contrarreloj (F2) --- */
.mh-quiz \{ display:flex; flex-direction:column; gap:16px; padding:8px 0 calc(16px + var(--mh-safe-b)); \}
.q-hud \{ display:flex; align-items:center; justify-content:space-between; gap:12px; \}
.q-timer \{
  display:inline-flex; align-items:baseline; gap:3px;
  background:var(--mh-verde-suave); color:var(--mh-verde);
  padding:8px 16px; border-radius:999px; font-weight:900;
\}
.q-tnum \{ font-size:1.6rem; font-variant-numeric:tabular-nums; \}
.q-unit \{ font-size:.8rem; font-weight:800; opacity:.8; \}
.q-score \{ display:inline-flex; align-items:baseline; gap:6px; font-size:.78rem; font-weight:800;
  text-transform:uppercase; letter-spacing:.1em; color:var(--mh-suave); \}
.q-snum \{ font-size:1.4rem; font-weight:900; color:var(--mh-tinta); letter-spacing:0; \}
.q-prompt \{
  text-align:center; font-size:clamp(2.6rem, 14vw, 4rem); font-weight:900;
  color:var(--mh-tinta); letter-spacing:.02em; font-variant-numeric:tabular-nums;
  padding:12px 0; line-height:1.1;
\}
.q-options \{ display:grid; grid-template-columns:1fr 1fr; gap:12px; \}
.q-opt \{
  min-height:76px; font-size:1.7rem; font-weight:900; font-variant-numeric:tabular-nums;
  background:var(--mh-panel); border:2px solid var(--mh-borde);
  border-radius:var(--mh-radio); color:var(--mh-tinta); cursor:pointer;
  transition:transform .06s ease, border-color .06s ease;
\}
.q-opt:active \{ transform:scale(.96); border-color:var(--mh-verde); \}
.q-fbwrap \{ min-height:52px; \}
.q-fb \{ text-align:center; padding:12px 16px; border-radius:var(--mh-radio); font-weight:800; font-size:1.05rem; \}
.q-fb.ok \{ background:var(--mh-verde-suave); color:var(--mh-verde); \}
.q-fb.bad \{ background:rgba(232,85,47,.14); color:var(--mh-naranja); \}
.q-done \{
  display:flex; flex-direction:column; align-items:center; gap:14px; text-align:center;
  background:var(--mh-panel); border:1px solid var(--mh-borde);
  border-radius:var(--mh-radio); padding:24px 16px calc(24px + var(--mh-safe-b));
  animation:done-in .45s cubic-bezier(.2,.7,.3,1) both;
\}
@keyframes done-in \{ from \{ opacity:0; transform:translateY(14px) scale(.98) \} to \{ opacity:1; transform:translateY(0) scale(1) \} \}
.q-medal \{ font-size:3.4rem; line-height:1; \}
.q-done h2 \{ font-size:.72rem; letter-spacing:.12em; text-transform:uppercase; color:var(--mh-suave); margin:0; font-weight:700; \}
.q-stat \{ display:flex; flex-direction:column; gap:2px; \}
.q-big \{ font-size:2.2rem; font-weight:900; color:var(--mh-tinta); font-variant-numeric:tabular-nums; \}
.q-lbl \{ font-size:.74rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--mh-suave); \}
.q-actions \{ width:100%; margin-top:6px; \}
.q-mode \{
  display:inline-flex; align-items:center; padding:8px 16px; border-radius:999px;
  font-weight:900; font-size:.8rem; text-transform:uppercase; letter-spacing:.08em;
  background:var(--mh-verde-suave); color:var(--mh-verde);
\}

/* --- Menú de juego + práctica (F3): grilla data-driven --- */
.mh-juegos \{ display:grid; grid-template-columns:1fr 1fr; gap:12px; \}
.mh-juego \{
  display:flex; flex-direction:column; align-items:center; gap:6px; text-align:center;
  min-height:120px; justify-content:center; padding:16px 10px;
  background:var(--mh-panel); border:2px solid var(--mh-borde);
  border-radius:var(--mh-radio); color:var(--mh-tinta); text-decoration:none;
  font-weight:800; cursor:pointer; transition:transform .06s ease;
\}
.mh-juego:active \{ transform:scale(.97); \}
.mh-jicon \{ font-size:2rem; line-height:1; \}
.mh-jname \{ font-size:1rem; \}
.mh-jsub \{ font-size:.72rem; font-weight:700; color:var(--mh-suave); \}
.mh-juego.lock, .mh-juego.soon \{ opacity:.55; cursor:default; \}
.mh-juego.lock:active, .mh-juego.soon:active \{ transform:none; \}

/* --- Verdadero o Falso (F4): dos botones gigantes --- */
.vf-options \{ display:grid; grid-template-columns:1fr 1fr; gap:12px; \}
.vf-opt \{
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:6px;
  min-height:104px; font-size:1.5rem; font-weight:900;
  border:2px solid var(--mh-borde); border-radius:var(--mh-radio);
  color:var(--mh-tinta); cursor:pointer;
  transition:transform .06s ease, border-color .06s ease;
\}
.vf-opt span \{ font-size:2.2rem; line-height:1; \}
.vf-opt:active \{ transform:scale(.96); \}
.vf-opt.yes \{ background:var(--mh-verde-suave); border-color:var(--mh-verde); color:var(--mh-verde); \}
.vf-opt.no \{ background:rgba(232,85,47,.12); border-color:var(--mh-naranja); color:var(--mh-naranja); \}

/* --- Completá el hueco (F4): teclado numérico propio --- */
.cg-eq \{ display:flex; align-items:center; justify-content:center; gap:.25em; flex-wrap:wrap; \}
.ec-sist \{ display:block; white-space:pre-line; text-align:center; line-height:1.5; font-size:1.3rem; \}
.fin-problema \{ text-align:center; line-height:1.45; font-size:1.15rem; font-weight:700; margin:.4rem auto 1rem; max-width:22em; color:var(--tinta); \}
/* --- Trigonometría (F7.4): figura del triángulo rectángulo --- */
.q-figura \{ display:flex; justify-content:center; margin:.3rem 0 .6rem; \}
.tg-svg \{ width:min(78vw, 250px); height:auto; \}
.tg-tri \{ fill:var(--mh-verde-suave); stroke:var(--mh-tinta); stroke-width:2.5; stroke-linejoin:round; \}
.tg-right \{ fill:none; stroke:var(--mh-tinta); stroke-width:2; \}
.tg-lbl \{ fill:var(--mh-tinta); font-size:16px; font-weight:800; text-anchor:middle; \}
.tg-arc \{ fill:none; stroke:var(--mh-naranja); stroke-width:2.5; \}
.tg-ang \{ fill:var(--mh-naranja); font-size:14px; font-weight:800; text-anchor:middle; \}
.trig-pregunta \{ font-size:1.05rem; font-weight:800; text-align:center; \}
/* --- Funciones (F7.5): fórmula + gráfico de la familia --- */
.fx-svg \{ width:min(70vw, 220px); height:auto; \}
.fx-axis \{ stroke:var(--mh-borde); stroke-width:1.5; \}
.fx-curve \{ fill:none; stroke:var(--mh-naranja); stroke-width:3; stroke-linecap:round; \}
.fx-formula \{ font-size:1.3rem; font-weight:800; text-align:center; \}
.fx-formula sup \{ font-size:.7em; vertical-align:super; \}
.fx-pregunta \{ font-size:1.05rem; font-weight:700; text-align:center; \}
.cg-slot \{
  display:inline-flex; align-items:center; justify-content:center; min-width:1.6em;
  padding:0 .15em; border-bottom:4px solid var(--mh-borde); color:var(--mh-suave);
\}
.cg-slot.filled \{ color:var(--mh-verde); border-bottom-color:var(--mh-verde); \}
.kp \{ display:grid; grid-template-columns:repeat(3, 1fr); gap:10px; \}
.kp-key \{
  min-height:64px; font-size:1.5rem; font-weight:900; font-variant-numeric:tabular-nums;
  background:var(--mh-panel); border:2px solid var(--mh-borde);
  border-radius:var(--mh-radio); color:var(--mh-tinta); cursor:pointer;
  transition:transform .06s ease, border-color .06s ease;
\}
.kp-key:active \{ transform:scale(.95); border-color:var(--mh-verde); \}
.kp-key.aux \{ color:var(--mh-naranja); \}
.kp-key.ok \{ background:var(--mh-verde); color:#fff; border-color:var(--mh-verde); font-size:1.1rem; \}
.kp-key.full \{ grid-column:1 / -1; \}

/* --- Escalera de tablas (F4) --- */
.esc-hud \{ display:flex; align-items:center; gap:14px; \}
.esc-ladder \{ display:flex; flex-direction:column-reverse; gap:4px; flex:0 0 auto; \}
.esc-ladder .rung \{
  width:56px; height:12px; border-radius:6px;
  background:var(--mh-panel); border:2px solid var(--mh-borde);
\}
.esc-ladder .rung.on \{ background:var(--mh-verde); border-color:var(--mh-verde); \}
.esc-info \{ display:flex; align-items:center; gap:8px; \}
.esc-emoji \{ font-size:2rem; line-height:1; \}
.esc-num \{ font-size:1rem; font-weight:900; color:var(--mh-tinta); \}

/* --- El kiosco (F4): enunciado con contexto --- */
.ki-enun \{
  background:var(--mh-panel); border:1px solid var(--mh-borde);
  border-radius:var(--mh-radio); padding:14px 16px; text-align:center;
\}
.ki-linea \{ margin:.15rem 0; font-size:1.05rem; color:var(--mh-tinta); \}
.ki-preg \{ margin:.4rem 0 0; font-size:1.15rem; font-weight:900; color:var(--mh-verde); \}
.ki-slot \{ font-size:clamp(2rem, 11vw, 3rem); padding:6px 0; \}

/* --- Fracciones a la vista (F4) --- */
.frac-bar \{ display:flex; gap:4px; padding:8px 0; \}
.fseg \{
  flex:1; height:68px; border-radius:8px;
  background:var(--mh-panel); border:2px solid var(--mh-borde);
\}
.fseg.on \{ background:var(--mh-verde); border-color:var(--mh-verde); \}
.frac-preg \{ text-align:center; font-size:1.15rem; font-weight:800; color:var(--mh-tinta); margin:.3rem 0 .1rem; \}
.series-preg \{ text-align:center; font-size:1.1rem; font-weight:800; color:var(--mh-tinta); margin:.3rem 0 .1rem; \}
.series-eq \{ font-size:1.55rem; font-weight:800; letter-spacing:.03em; \}
.hora-preg \{ text-align:center; font-size:1.1rem; font-weight:800; color:var(--mh-tinta); margin:.3rem 0 .2rem; \}
.hora-clock-wrap \{ display:flex; justify-content:center; margin:.2rem 0 .5rem; \}
.rl-clock \{ width:min(62vw, 220px); height:auto; \}
.rl-face \{ fill:var(--mh-panel); stroke:var(--mh-borde); stroke-width:3; \}
.rl-tick \{ stroke:var(--mh-suave); stroke-width:2.5; stroke-linecap:round; \}
.rl-num \{ fill:var(--mh-tinta); font-size:15px; font-weight:800; text-anchor:middle; dominant-baseline:central; \}
.rl-hour \{ stroke:var(--mh-tinta); stroke-width:6; stroke-linecap:round; \}
.rl-min \{ stroke:var(--mh-naranja); stroke-width:4; stroke-linecap:round; \}
.rl-center \{ fill:var(--mh-tinta); \}
.hora-opts .hora-opt \{ font-size:1.35rem; font-weight:800; letter-spacing:.02em; \}
.geo-preg \{ text-align:center; font-size:1.1rem; font-weight:800; color:var(--mh-tinta); margin:.3rem 0 .1rem; \}
.geo-fig \{ display:flex; justify-content:center; margin:.1rem 0 .3rem; \}
.geo-clock \{ width:min(64vw, 240px); height:auto; \}
.geo-shape \{ fill:var(--mh-celeste); fill-opacity:.35; stroke:var(--mh-tinta); stroke-width:2.5; stroke-linejoin:round; \}
.geo-right \{ fill:none; stroke:var(--mh-tinta); stroke-width:1.5; \}
.geo-lbl \{ fill:var(--mh-tinta); font-size:14px; font-weight:800; text-anchor:middle; dominant-baseline:central; \}
.geo-lbl.sm \{ font-size:11px; fill:var(--mh-naranja); \}
.mem-preg \{ text-align:center; font-size:1.05rem; font-weight:800; color:var(--mh-tinta); margin:.3rem 0 .3rem; \}
.mem-grid \{ display:grid; grid-template-columns:repeat(4, 1fr); gap:.5rem; margin:.2rem 0 .4rem; \}
.mem-card \{ min-height:58px; display:flex; align-items:center; justify-content:center; padding:.3rem; font-size:1.15rem; font-weight:800; font-family:inherit; color:var(--mh-tinta); background:var(--mh-panel); border:2px solid var(--mh-borde); border-radius:var(--mh-radio); cursor:pointer; touch-action:manipulation; -webkit-tap-highlight-color:transparent; \}
.mem-card.sel \{ border-color:var(--mh-naranja); background:var(--mh-amarillo); transform:scale(1.05); \}
.mem-card.done \{ opacity:.45; color:#fff; background:var(--mh-verde); border-color:var(--mh-verde); pointer-events:none; animation:fb-pop .3s ease-out; \}
@media (max-width:360px) \{ .mem-card \{ min-height:50px; font-size:1rem; \} \}
.frac-opts .q-opt \{ min-height:88px; \}
.frac \{ display:inline-flex; flex-direction:column; align-items:center; line-height:1; \}
.frac .fnum \{ padding-bottom:3px; \}
.frac .fden \{ border-top:3px solid currentColor; padding-top:3px; \}

@media (min-width:560px) \{ .mh-quiz \{ max-width:520px; margin:0 auto; \} \}

/* --- Pulido general: micro-animaciones + estrellas del resumen --- */
@keyframes fb-pop \{ 0% \{ transform:scale(.85); opacity:.4 \} 60% \{ transform:scale(1.03) \} 100% \{ transform:scale(1); opacity:1 \} \}
@keyframes fb-shake \{ 0%,100% \{ transform:translateX(0) \} 20% \{ transform:translateX(-6px) \} 40% \{ transform:translateX(6px) \} 60% \{ transform:translateX(-4px) \} 80% \{ transform:translateX(4px) \} \}
@keyframes medal-pop \{ 0% \{ transform:scale(0) rotate(-12deg) \} 70% \{ transform:scale(1.15) rotate(5deg) \} 100% \{ transform:scale(1) rotate(0) \} \}
@keyframes slot-in \{ from \{ transform:scale(.7) \} to \{ transform:scale(1) \} \}
@keyframes star-in \{ from \{ transform:scale(0) rotate(-40deg); opacity:0 \} to \{ transform:scale(1) rotate(0); opacity:1 \} \}
.q-fb.ok \{ animation:fb-pop .3s ease-out; \}
.q-fb.bad \{ animation:fb-shake .4s ease; \}
.q-medal \{ animation:medal-pop .5s cubic-bezier(.2,.7,.3,1.4); \}
.cg-slot.filled \{ animation:slot-in .14s ease-out; \}
.mh-estrellas \{ display:flex; justify-content:center; gap:.3em; font-size:2.3rem; line-height:1; margin:.1rem 0 .2rem; \}
.mh-estrellas .star \{ color:var(--mh-borde); \}
.mh-estrellas .star.on \{ color:var(--mh-amarillo); animation:star-in .4s ease-out both; \}
.mh-estrellas .star.on:nth-child(2) \{ animation-delay:.13s; \}
.mh-estrellas .star.on:nth-child(3) \{ animation-delay:.26s; \}
@keyframes star-glow \{ 0%,100% \{ transform:scale(1); filter:none \} 50% \{ transform:scale(1.12); filter:drop-shadow(0 0 6px var(--mh-amarillo)) \} \}
.mh-estrellas.perfect .star.on \{ animation:star-in .4s ease-out both, star-glow 1.3s ease-in-out .5s infinite; \}
.q-racha \{ margin-left:.45em; font-size:.85em; font-weight:800; color:var(--mh-naranja); white-space:nowrap; animation:fb-pop .3s ease-out; \}
.q-racha.hot \{ animation:fb-pop .3s ease-out, star-glow 1s ease-in-out infinite; \}
.q-progress \{ height:6px; background:var(--mh-borde); border-radius:99px; overflow:hidden; margin:.1rem 0 .6rem; \}
.q-progress-fill \{ display:block; height:100%; background:var(--mh-verde); border-radius:99px; transition:width .3s ease; \}
.q-done \{ position:relative; \}
.mh-confetti \{ position:absolute; left:0; right:0; top:0; height:100%; overflow:hidden; pointer-events:none; \}
.mh-confetti .cf \{ position:absolute; top:-14px; width:9px; height:14px; border-radius:2px; opacity:0; animation:confetti-fall 1.5s ease-in forwards; \}
@keyframes confetti-fall \{ 0% \{ transform:translateY(-14px) rotate(0); opacity:1 \} 100% \{ transform:translateY(300px) rotate(400deg); opacity:0 \} \}
.mh-confetti .cf0 \{ left:6%; background:var(--mh-naranja); animation-delay:0s \}
.mh-confetti .cf1 \{ left:15%; background:var(--mh-verde); animation-delay:.12s \}
.mh-confetti .cf2 \{ left:24%; background:var(--mh-amarillo); animation-delay:.05s \}
.mh-confetti .cf3 \{ left:33%; background:var(--mh-celeste); animation-delay:.2s \}
.mh-confetti .cf4 \{ left:42%; background:var(--mh-naranja); animation-delay:.32s \}
.mh-confetti .cf5 \{ left:50%; background:var(--mh-verde); animation-delay:.08s \}
.mh-confetti .cf6 \{ left:58%; background:var(--mh-amarillo); animation-delay:.24s \}
.mh-confetti .cf7 \{ left:67%; background:var(--mh-celeste); animation-delay:.14s \}
.mh-confetti .cf8 \{ left:76%; background:var(--mh-naranja); animation-delay:.28s \}
.mh-confetti .cf9 \{ left:85%; background:var(--mh-verde); animation-delay:.02s \}
.mh-confetti .cf10 \{ left:92%; background:var(--mh-amarillo); animation-delay:.36s \}
.mh-confetti .cf11 \{ left:48%; background:var(--mh-celeste); animation-delay:.44s \}
.mh-aliento \{ text-align:center; font-weight:800; font-size:1.1rem; color:var(--mh-tinta); margin:.1rem 0 .4rem; \}
.mh-mejor-racha \{ text-align:center; font-weight:800; font-size:.95rem; color:var(--mh-naranja); margin:0 0 .5rem; animation:slot-in .4s ease-out both; \}
.mh-record \{ text-align:center; font-weight:900; font-size:1.05rem; color:var(--mh-amarillo); margin:0 0 .5rem; animation:medal-pop .5s ease-out both; \}
@media (prefers-reduced-motion:reduce) \{ * \{ transition:none !important; animation:none !important; \} \}
"""
}
