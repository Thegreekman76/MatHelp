// main.fitz — punto de entrada de MatHelp.
//
// F1: auth y perfiles. La home ahora es consciente de la sesión, las rutas
// de juego están protegidas, y los módulos auth/perfiles enganchan sus
// handlers @get/@post al router vía import (W16).
// El juego en sí llega en F2 (ver docs/PLAN.md).

from fitz_liveviews import Html, html, flv, html_response, flv_register
from config import db_url, app_name, lang_cookie_name, default_locale
from i18n import t, locale_from_cookie, es_locale_valido, nombre_locale
from brand import logo_lockup
from layout import page, responder_html, redirect_a
from auth import read_session, pid_from_token
import perfiles
import assets
import live_game
// El juego vive en live_game.fitz (@get /jugar + @ws /live/quiz). Importar los
// símbolos del componente acá es lo que dispara el auto-registro del LiveComponent
// (el compilador pre-escanea los imports directos del entry y emite el
// flv_register("quiz", ...) al arrancar — §9.bb del core).
from Quiz import quiz, quiz_render, quiz_answer, quiz_tick

// --- Home ----------------------------------------------------------------

// La home decide según la sesión:
//   - sin sesión válida  → home pública (entrar / crear cuenta)
//   - sesión sin perfil  → 303 a /perfiles (elegí quién juega)
//   - sesión con perfil  → home de juego
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/")
async fn home(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    match read_session(session).await {
        Ok(_) => {
            if (pid_from_token(session) == "") {
                return redirect_a("/perfiles")
            }
            return home_jugar(locale)
        }
        Err(_) => return home_publica(locale).await,
    }
}

// Home sin sesión: hero + entrar / crear cuenta + estado de la base.
async fn home_publica(locale: Str) -> Response {
    let marca = logo_lockup(56, locale).raw
    let tagline = flv(t(locale, "app.tagline"))
    let db = estado_db(locale).await.raw

    let body = html("""<div class="mh-hero">
{marca}
<div class="mh-tagline">{tagline}</div>
</div>

<div class="mh-card">
<a class="mh-btn" href="/login">{flv(t(locale, "login.submit"))}</a>
<a class="mh-btn sec" href="/registro">{flv(t(locale, "login.crear_cuenta"))}</a>
</div>

<div class="mh-card">
<h2>{flv(t(locale, "estado.titulo"))}</h2>
{db}
</div>""")

    return responder_html(page(locale, "MatHelp — " + t(locale, "app.tagline"), body, html("")))
}

// Home con perfil elegido: los accesos al juego. (El juego real llega en F2.)
fn home_jugar(locale: Str) -> Response {
    let marca = logo_lockup(56, locale).raw
    let tagline = flv(t(locale, "app.tagline"))

    let body = html("""<div class="mh-hero">
{marca}
<div class="mh-tagline">{tagline}</div>
</div>

<div class="mh-card">
<h2>{flv(t(locale, "nav.jugar"))}</h2>
<a class="mh-btn" href="/jugar">{flv(t(locale, "home.empezar"))}</a>
<a class="mh-btn sec" href="/desafio">{flv(t(locale, "home.desafio_dia"))}</a>
<a class="mh-btn sec" href="/practica">{flv(t(locale, "home.practica_libre"))}</a>
</div>

<div class="mh-card">
<a class="mh-btn sec" href="/perfiles">{flv(t(locale, "perfiles.titulo"))}</a>
<form method="POST" action="/logout">
<button class="mh-btn sec" type="submit">{flv(t(locale, "nav.salir"))}</button>
</form>
</div>""")

    return responder_html(page(locale, "MatHelp — " + t(locale, "app.tagline"), body, html("")))
}

// Chequeo real de Postgres, para que `docker compose up` diga la verdad.
async fn estado_db(locale: Str) -> Html {
    match db.connect(db_url()).await {
        Ok(conn) => {
            let _ = conn.close().await
            return html("""<p class="mh-estado"><span class="mh-pill"></span>{flv(t(locale, "estado.db_ok"))}</p>""")
        }
        Err(e) => {
            return html("""<p class="mh-estado"><span class="mh-pill err"></span>{flv(t(locale, "estado.db_error"))}</p>""")
        }
    }
}

// --- Cambio de idioma ----------------------------------------------------

// Setea la cookie y vuelve a donde estabas. Sin JavaScript.
@header(name="referer")
@get("/lang/{code}")
fn set_lang(code: Str, referer: Str?) -> Response {
    let loc = match es_locale_valido(code) {
        true => code,
        false => default_locale(),
    }
    let volver: Str = match referer {
        null => "/",
        r => r,
    }
    return Response {
        status: 303,
        content_type: "text/html; charset=utf-8",
        cookies: [
            Cookie {
                name: lang_cookie_name(),
                value: loc,
                path: "/",
                same_site: "Lax",
                max_age: 31536000,
            },
        ],
        headers: { "Location": volver },
        body: "",
    }
}

// --- Rutas de juego (protegidas: exigen sesión + perfil elegido) ---------

// /jugar (contrarreloj en vivo) lo sirve live_game.fitz.

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/desafio")
async fn desafio(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    match guard_juego(session).await {
        Ok(destino) => match destino == "" {
            true => return proximamente(locale, t(locale, "home.desafio_dia"), "F3"),
            false => return redirect_a(destino),
        },
        Err(_) => return redirect_a("/login"),
    }
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/practica")
async fn practica(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    match guard_juego(session).await {
        Ok(destino) => match destino == "" {
            true => return proximamente(locale, t(locale, "home.practica_libre"), "F3"),
            false => return redirect_a(destino),
        },
        Err(_) => return redirect_a("/login"),
    }
}

// Guard de las rutas de juego. Devuelve:
//   Ok("")          → sesión + perfil OK, seguí
//   Ok("/perfiles") → hay sesión pero falta elegir perfil
//   Err(...)        → sin sesión (el handler redirige a /login)
async fn guard_juego(session: Str?) -> Result<Str> {
    let _ = read_session(session).await?
    if (pid_from_token(session) == "") {
        return Ok("/perfiles")
    }
    return Ok("")
}

fn proximamente(locale: Str, titulo: Str, fase: Str) -> Response {
    let t_esc = flv(titulo)
    let body = html("""<div class="mh-card">
<h2>{fase}</h2>
<p style="font-size:1.35rem;font-weight:800;margin:.2rem 0 1rem">{t_esc}</p>
<p style="color:var(--mh-suave);margin:0 0 1.2rem">Esta pantalla llega en la fase {fase}.</p>
<a class="mh-btn sec" href="/">←</a>
</div>""")
    return responder_html(page(locale, titulo + " — MatHelp", body, html("")))
}

// --- Arranque ------------------------------------------------------------

// Fitz no auto-carga .env: explícito antes que mágico.
match load_env(".env") {
    Ok(_) => print("[mathelp] .env cargado"),
    Err(_) => print("[mathelp] sin .env — usando variables de entorno"),
}

// 0.0.0.0 es obligatorio: sin eso el -p de Docker no rutea nada al container.
// static_dir sirve public/ (el manifest); las rutas @get ganan sobre estáticos,
// así /favicon.svg sigue siendo el route generado por logo_svg_raw().
@server(3000, "0.0.0.0", static_dir="public", static_prefix="/")
fn main() => 0
