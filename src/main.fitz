// --- Home ----------------------------------------------------------------

// La home decide según la sesión:
//   - sin sesión válida  → home pública (entrar / crear cuenta)
//   - sesión sin perfil  → 303 a /perfiles (elegí quién juega)
//   - sesión con perfil  → home de juego
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/")
async fn home(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    match read_session(session).await {
        Ok(_) => {
            if (pid_from_token(session) == "") {
                return redirect_a("/perfiles")
            }
            let pid = a_int(pid_from_token(session))
            let saludo = saludo_html(locale, pid).await
            let resumen = resumen_hoy_html(locale, pid).await
            let intro = home_intro_html(locale, pid).await
            let repaso = repaso_html(locale, pid).await
            return home_jugar(locale, saludo, resumen, intro, repaso)
        }
        Err(_) => return home_publica(locale).await,
    }
}

// Home sin sesión: hero + entrar / crear cuenta + estado de la base.
async fn home_publica(locale: Str) -> Response {
    let marca = logo_lockup(56, locale).raw
    let tagline = flv(t(locale, "app.tagline"))
    let db = estado_db(locale).await.raw

    let body = html("""<div class="mh-hero">
{marca}
<div class="mh-tagline">{tagline}</div>
</div>

<div class="mh-card">
<a class="mh-btn" href="/login">{flv(t(locale, "login.submit"))}</a>
<a class="mh-btn sec" href="/registro">{flv(t(locale, "login.crear_cuenta"))}</a>
</div>

<div class="mh-card">
<h2>{flv(t(locale, "estado.titulo"))}</h2>
{db}
</div>""")

    return responder_html(page(locale, "MatHelp — " + t(locale, "app.tagline"), body, html("")))
}

// Home de juego: el menú shallow de §6.5. Cinco accesos de un tap (la
// navegación profunda grado→nivel→juego es anti-patrón para 6–12): Jugar ya
// (contrarreloj, F2), Desafío del día y Mi progreso (llegan con el motor
// adaptativo, F3), Elegir juego (grilla por grado) y Práctica libre (tema →
// dificultad). El grado sale del perfil y el nivel es adaptativo: acá no se
// elige ninguno de los dos (salvo en Práctica libre).
fn home_jugar(locale: Str, saludo: Html, resumen: Html, ultimo: Html, repaso: Html) -> Response {
    let marca = logo_lockup(56, locale).raw
    let tagline = flv(t(locale, "app.tagline"))

    let body = html("""<div class="mh-hero">
{marca}
<div class="mh-tagline">{tagline}</div>
{saludo.raw}
</div>
{resumen.raw}

<div class="mh-card">
<h2>{flv(t(locale, "nav.jugar"))}</h2>
{ultimo.raw}
{repaso.raw}
<a class="mh-btn" href="/jugar"><span aria-hidden="true">▶️</span>{flv(t(locale, "home.jugar_ya"))}</a>
<a class="mh-btn sec" href="/desafio"><span aria-hidden="true">🎯</span>{flv(t(locale, "home.desafio_dia"))}</a>
<a class="mh-btn sec" href="/juegos"><span aria-hidden="true">🎮</span>{flv(t(locale, "home.elegir_juego"))}</a>
<a class="mh-btn sec" href="/practica"><span aria-hidden="true">📚</span>{flv(t(locale, "home.practica_libre"))}</a>
<a class="mh-btn sec" href="/progreso"><span aria-hidden="true">🏅</span>{flv(t(locale, "nav.progreso"))}</a>
</div>

<div class="mh-card">
<a class="mh-btn sec" href="/panel"><span aria-hidden="true">📊</span>{flv(t(locale, "nav.panel"))}</a>
<a class="mh-btn sec" href="/avatar"><span aria-hidden="true">🙂</span>{flv(t(locale, "avatar.titulo"))}</a>
<a class="mh-btn sec" href="/tema"><span aria-hidden="true">🎨</span>{flv(t(locale, "tema_color.titulo"))}</a>
<a class="mh-btn sec" href="/perfiles">{flv(t(locale, "perfiles.titulo"))}</a>
<form method="POST" action="/logout">
<button class="mh-btn sec" type="submit">{flv(t(locale, "nav.salir"))}</button>
</form>
</div>""")

    return responder_html(page(locale, "MatHelp — " + t(locale, "app.tagline"), body, html("")))
}

// --- "Seguir con..." (último juego) — acceso rápido en el home (F9 pulido) -----
// El topic_code de la sesión más reciente identifica el juego (cada juego usa uno
// distinto; los que comparten "mix" caen al contrarreloj, el principal).
fn topic_a_code(topic: Str) -> Str {
    return match topic {
        "patron" => "series",
        "reloj" => "hora",
        "geo" => "geometria",
        "memoria" => "memoria",
        "ordenar" => "ordenar",
        "estimar" => "estimar",
        "pct" => "porcentaje",
        "vol" => "volumen",
        "historia" => "historia",
        "enteros" => "enteros",
        "ec" => "ecuaciones",
        "mult.tabla" => "escalera",
        "fin" => "finanzas",
        "frac.parte" => "fracciones",
        "func" => "funciones",
        "problemas" => "kiosco",
        "pot" => "potencias",
        "trig" => "trigonometria",
        "mix" => "contrarreloj",
        _ => "",
    }
}

fn topic_a_route(topic: Str) -> Str {
    return match topic {
        "patron" => "/series",
        "reloj" => "/hora",
        "geo" => "/geometria",
        "memoria" => "/memoria",
        "ordenar" => "/ordenar",
        "estimar" => "/estimar",
        "pct" => "/porcentaje",
        "vol" => "/volumen",
        "historia" => "/historia",
        "enteros" => "/enteros",
        "ec" => "/ecuaciones",
        "mult.tabla" => "/escalera",
        "fin" => "/finanzas",
        "frac.parte" => "/fracciones",
        "func" => "/funciones",
        "problemas" => "/problemas",
        "pot" => "/potencias",
        "trig" => "/trigonometria",
        "mix" => "/jugar",
        _ => "",
    }
}

// Intro del home de juego: si el chico NUNCA jugó, un cartel de bienvenida
// (onboarding del primer uso); si ya jugó, el botón "Seguir con <juego>" (último
// juego, por el topic_code de la sesión más reciente). Best-effort: ante error de
// DB devuelve vacío (no puede tumbar el home).
async fn home_intro_html(locale: Str, pid: Int) -> Html {
    let vacio = html("""<div class="mh-onboard">
<span class="mh-onboard-ico" aria-hidden="true">👋</span>
<p class="mh-onboard-hola">{flv(t(locale, "onboard.hola"))}</p>
<p class="mh-onboard-tip">{flv(t(locale, "onboard.tip"))}</p>
</div>""")
    let conn = match db.connect(db_url()).await {
        Ok(c) => c,
        Err(_) => { return html("") },
    }
    let rows = match conn.query("SELECT topic_code FROM sessions WHERE profile_id = $1 ORDER BY started_at DESC LIMIT 1", [pid]).await {
        Ok(r) => r,
        Err(_) => { return html("") },
    }
    if (rows.len() == 0) {
        return vacio
    }
    let topic = match rows[0].get_str("topic_code") {
        Ok(t) => t,
        Err(_) => { return html("") },
    }
    let code = topic_a_code(topic)
    if (code == "") {
        return html("")
    }
    let route = topic_a_route(topic)
    let nombre = t(locale, "juego.{code}")
    let seguir = flv(t1(locale, "home.seguir", nombre))
    return html("""<a class="mh-btn mh-seguir" href="{route}"><span aria-hidden="true">↩️</span>{seguir}</a>""")
}

// Mini-resumen del día en el home: "🔥 N días de racha · ✏️ hoy M". Vacío si el
// chico no jugó nunca (racha 0 y 0 hoy) o si falla la DB (best-effort).
async fn resumen_hoy_html(locale: Str, pid: Int) -> Html {
    let conn = match db.connect(db_url()).await {
        Ok(c) => c,
        Err(_) => { return html("") },
    }
    let rows = match conn.query("SELECT exercises FROM streaks WHERE profile_id = $1 AND day = CURRENT_DATE", [pid]).await {
        Ok(r) => r,
        Err(_) => { return html("") },
    }
    let hoy_ej = 0
    if (rows.len() > 0) {
        hoy_ej = match rows[0].get_int("exercises") {
            Ok(n) => n,
            Err(_) => 0,
        }
    }
    let racha = match racha_actual(pid).await {
        Ok(n) => n,
        Err(_) => 0,
    }
    if (racha == 0 and hoy_ej == 0) {
        return html("")
    }
    let chip_racha = flv(t1(locale, "resumen.dias", "{racha}"))
    let chip_hoy = flv(t1(locale, "resumen.hoy", "{hoy_ej}"))
    return html("""<div class="mh-resumen">
<span class="mh-chip">🔥 {chip_racha}</span>
<span class="mh-chip">✏️ {chip_hoy}</span>
</div>""")
}

// Saludo del home con el avatar del perfil ("🧉 ¡Hola, Ada!"). Best-effort.
async fn saludo_html(locale: Str, pid: Int) -> Html {
    let conn = match db.connect(db_url()).await {
        Ok(c) => c,
        Err(_) => { return html("") },
    }
    let rows = match conn.query("SELECT name, avatar FROM profiles WHERE id = $1", [pid]).await {
        Ok(r) => r,
        Err(_) => { return html("") },
    }
    if (rows.len() == 0) {
        return html("")
    }
    let nombre = match rows[0].get_str("name") {
        Ok(n) => n,
        Err(_) => "",
    }
    let av = match rows[0].get_str("avatar") {
        Ok(a) => a,
        Err(_) => "mate",
    }
    if (nombre == "") {
        return html("")
    }
    let em = flv(avatar_emoji(av))
    let hola = flv(t1(locale, "home.hola", nombre))
    return html("""<a class="mh-saludo" href="/avatar"><span class="mh-saludo-av">{em}</span><span>{hola}</span></a>""")
}

// CTA "Repasá lo que te cuesta": detecta la destreza con menor rating (con al
// menos 3 intentos, para que sea significativa) y linkea al juego que la
// entrena. Best-effort → vacío si no hay datos o falla la DB.
async fn repaso_html(locale: Str, pid: Int) -> Html {
    let conn = match db.connect(db_url()).await {
        Ok(c) => c,
        Err(_) => { return html("") },
    }
    let rows = match conn.query("SELECT skill_code FROM mastery WHERE profile_id = $1 AND seen >= 3 ORDER BY rating ASC LIMIT 1", [pid]).await {
        Ok(r) => r,
        Err(_) => { return html("") },
    }
    if (rows.len() == 0) {
        return html("")
    }
    let sc = match rows[0].get_str("skill_code") {
        Ok(s) => s,
        Err(_) => { return html("") },
    }
    let ruta = skill_a_route(sc)
    if (ruta == "") {
        return html("")
    }
    let icon = flv(skill_icon(sc))
    let cta = flv(t1(locale, "repaso.cta", t(locale, skill_label_key(sc))))
    return html("""<a class="mh-btn sec mh-repaso" href="{ruta}"><span aria-hidden="true">🎯</span> {icon} {cta}</a>""")
}

// Chequeo real de Postgres, para que `docker compose up` diga la verdad.
async fn estado_db(locale: Str) -> Html {
    match db.connect(db_url()).await {
        Ok(conn) => {
            let _ = conn.close().await
            return html("""<p class="mh-estado"><span class="mh-pill"></span>{flv(t(locale, "estado.db_ok"))}</p>""")
        }
        Err(e) => {
            return html("""<p class="mh-estado"><span class="mh-pill err"></span>{flv(t(locale, "estado.db_error"))}</p>""")
        }
    }
}

// --- Cambio de idioma ----------------------------------------------------

// Setea la cookie y vuelve a donde estabas. Sin JavaScript.
@header(name="referer")
@get("/lang/{code}")
fn set_lang(code: Str, referer: Str?) -> Response {
    let loc = match es_locale_valido(code) {
        true => code,
        false => default_locale(),
    }
    let volver: Str = match referer {
        null => "/",
        r => r,
    }
    return Response {
        status: 303,
        content_type: "text/html; charset=utf-8",
        cookies: [
            Cookie {
                name: lang_cookie_name(),
                value: loc,
                path: "/",
                same_site: "Lax",
                max_age: 31536000,
            },
        ],
        headers: { "Location": volver },
        body: "",
    }
}

// --- Rutas de juego (protegidas: exigen sesión + perfil elegido) ---------

// Todas las rutas de juego las sirven sus módulos (importados arriba, lo que
// engancha sus @get/@ws al router):
//   /jugar + /live/quiz (contrarreloj), /desafio + /live/desafio (Desafío del
//   día), /jugar/practica + /live/practica (práctica) → live_game.fitz
//   /juegos, /practica (tema → dificultad) → menu.fitz
//   /progreso (Mi progreso) → progreso.fitz
// Con F3 completa, ya no quedan placeholders "próximamente".

// --- Arranque ------------------------------------------------------------

// Fitz no auto-carga .env: explícito antes que mágico.
match load_env(".env") {
    Ok(_) => print("[mathelp] .env cargado"),
    Err(_) => print("[mathelp] sin .env — usando variables de entorno"),
}

// 0.0.0.0 es obligatorio: sin eso el -p de Docker no rutea nada al container.
// static_dir sirve public/ (el manifest); las rutas @get ganan sobre estáticos,
// así /favicon.svg sigue siendo el route generado por logo_svg_raw().
@server(3000, "0.0.0.0", static_dir="public", static_prefix="/")
fn main() => 0
