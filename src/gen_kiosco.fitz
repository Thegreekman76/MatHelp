// gen_kiosco.fitz — generador del juego "Problemas" (situaciones de la vida real).
//
// (Nombre interno histórico "kiosco".) Problemas VARIADOS de la vida real (§6.6),
// muchos tipos, agrupados en pools por NIVEL (dificultad). El nivel sale de
// (grade, idx) — piso del grado + rampa por idx (F8) — y dentro del pool el tipo
// se elige al azar (más variedad). Diez tipos, todos con respuesta entera positiva:
//   N1: total (N a $X → ×) · suma (3 precios → +)
//   N2: vuelto (pagás con billete → −) · falta (cuánto falta → −) · comparar (diferencia)
//   N3: reparto (entre N → ÷) · cuantos (con $ cuántos entran → ÷)
//   N4: descuento (P% off → % aplicado)
//   N5: oferta (N·X y vuelto) · combo (N·A + B)
//
// DE-DUP por sesión: dentro de una ronda ningún problema se repite (misma firma
// kind+números). `gen_kiosco` reconstruye los problemas 0..idx con un salt que se
// bumpea ante una colisión — determinista, el server re-deriva idéntico. El
// contexto se localiza (kiosco.p_* + kiosco.<item>). El RandGen `g` es local (FITZ-01).

from gen_arith import sub_seed, nivel_por_idx, imax

// Un problema de la vida real. `kind` decide cómo se arma el enunciado y qué
// significan a/b/c. `answer` es siempre entera positiva; `money` distingue si es
// plata (para el formato del slot) o una cuenta.
type KioscoItem {
    kind: Str = "vuelto"
    item: Str = ""
    a: Int = 0
    b: Int = 0
    c: Int = 0
    answer: Int = 0
    money: Bool = false
    skill: Str = "dec.dinero"
    difficulty: Int = 1
}

fn kiosco_max(grade: Int) -> Int {
    if (grade <= 3) {
        return 500
    }
    if (grade <= 5) {
        return 2000
    }
    return 5000
}

// El billete con que pagás: el más chico ESTRICTAMENTE mayor al monto.
fn kiosco_paid(monto: Int) -> Int {
    let billetes = [100, 200, 500, 1000, 2000, 5000, 10000]
    for bb in billetes {
        if (bb > monto) {
            return bb
        }
    }
    return monto + 100
}

fn kiosco_items() -> List<Str> {
    return ["alfajor", "chicle", "agua", "galletitas", "caramelo", "chocolate", "jugo", "turron"]
}

// Piso de dificultad por grado. Primaria (1-7) queda como estaba (N1 para ≤5,
// N2 para 6-7). Secundaria (8-13) NUNCA baja de N4 y el piso trepa por año, así
// un 6° de secundaria (13) jamás ve un problema de nivel primario.
fn nivel_piso_kiosco(grade: Int) -> Int {
    if (grade <= 5) {
        return 1
    }
    if (grade <= 7) {
        return 2
    }
    if (grade <= 9) {
        return 4
    }
    if (grade <= 11) {
        return 5
    }
    return 6
}

// Techo de dificultad por grado. Primaria como estaba (topa en N5 para 7°);
// secundaria escala hasta N9 (fracciones, %, tasas, ecuaciones), con techo
// distinto por año — un 1° de secundaria (8) llega a N6 y un 6° (13) a N9.
fn nivel_techo_kiosco(grade: Int) -> Int {
    if (grade <= 4) {
        return 2
    }
    if (grade <= 5) {
        return 3
    }
    if (grade <= 6) {
        return 4
    }
    if (grade <= 7) {
        return 5
    }
    if (grade <= 8) {
        return 6
    }
    if (grade <= 10) {
        return 7
    }
    if (grade <= 12) {
        return 8
    }
    return 9
}

// Pool de tipos por nivel (dificultad creciente). N1-N5 primaria (kiosco, ahorro,
// edades, distancias, %, 2 pasos); N6-N9 secundaria con conceptos de la franja:
// fracciones y regla de tres, IVA y tasas (velocidad/rendimiento), ecuaciones e
// interés, multi-paso y descuentos compuestos. Contextos adultos (sueldo, nafta,
// cuotas). Dentro del pool el tipo se elige al azar (variedad).
fn tipos_de_nivel(nivel: Int) -> List<Str> {
    if (nivel == 1) {
        return ["total", "suma", "ahorro", "edad", "cuadras"]
    }
    if (nivel == 2) {
        return ["vuelto", "falta", "comparar"]
    }
    if (nivel == 3) {
        return ["reparto", "cuantos", "unitario"]
    }
    if (nivel == 4) {
        return ["descuento", "promedio", "porcentaje"]
    }
    if (nivel == 5) {
        return ["oferta", "combo"]
    }
    if (nivel == 6) {
        return ["fraccion", "regla3"]
    }
    if (nivel == 7) {
        return ["iva", "velocidad", "rendimiento"]
    }
    if (nivel == 8) {
        return ["ecuacion", "interes", "trabajo"]
    }
    return ["desc_compuesto", "evento"]
}

// Magnitud de la plata en los problemas de secundaria: sube por grado (múltiplos
// de 100, así IVA/interés/descuento compuesto dan entero). Sólo se llama con
// grade >= 8 (los tipos N6-N9 son de secundaria); defensivo para grade < 8.
fn esc_kiosco(grade: Int) -> Int {
    if (grade <= 8) {
        return 100
    }
    if (grade <= 10) {
        return 200
    }
    if (grade <= 12) {
        return 500
    }
    return 1000
}

fn contiene_str_local(xs: List<Str>, t: Str) -> Bool {
    for x in xs {
        if (x == t) {
            return true
        }
    }
    return false
}

fn firma_kiosco(k: KioscoItem) -> Str {
    return "{k.kind}|{k.a}|{k.b}|{k.c}"
}

// Genera el problema `idx` crudo (sin de-dup), con un `salt` que perturba el RNG
// para re-tirar ante colisiones.
fn gen_kiosco_raw(seed: Int, idx: Int, grade: Int, salt: Int) -> KioscoItem {
    let g = rand.seeded(sub_seed(seed, idx) + salt * 104729)
    let items = kiosco_items()
    let it = items[g.int(0, items.len() - 1)]
    let max = kiosco_max(grade)
    let nivel = nivel_por_idx(nivel_piso_kiosco(grade), nivel_techo_kiosco(grade), idx)
    let pool = tipos_de_nivel(nivel)
    let kind = pool[g.int(0, pool.len() - 1)]
    let a = 0
    let b = 0
    let c = 0
    let answer = 0
    let money = true
    let skill = "dec.dinero"
    if (kind == "total") {
        // N unidades a $X (multiplicación).
        let n = g.int(2, 6)
        let precio = g.int(1, 6) * 50
        a = n
        b = precio
        answer = n * precio
        skill = "mul.tabla"
    }
    if (kind == "suma") {
        // Tres precios distintos → total (adición).
        a = g.int(1, 6) * 50
        b = g.int(1, 6) * 50
        c = g.int(1, 6) * 50
        answer = a + b + c
        skill = "add"
    }
    if (kind == "vuelto") {
        // Precio $X, pagás con el billete siguiente (resta con dinero).
        let precio = g.int(1, max / 50) * 50
        let paga = kiosco_paid(precio)
        a = precio
        b = paga
        answer = paga - precio
        skill = "dec.dinero"
    }
    if (kind == "falta") {
        // Querés algo de $X, tenés $Y < X → cuánto falta.
        let precio = g.int(4, 20) * 50
        let faltan = g.int(1, precio / 50 - 1) * 50
        a = precio
        b = precio - faltan       // lo que tenés
        answer = faltan           // = a − b
        skill = "dec.dinero"
    }
    if (kind == "comparar") {
        // Mismo producto a dos precios → diferencia.
        let menor = g.int(2, 16) * 50
        let dif = g.int(1, 8) * 50
        a = menor + dif           // el más caro
        b = menor
        answer = dif              // = a − b
        skill = "sub"
    }
    if (kind == "reparto") {
        // T unidades entre N amigos (división exacta).
        let cada = g.int(2, 12)
        let n = g.int(2, 6)
        a = n * cada
        b = n
        answer = cada
        money = false
        skill = "div.exacta"
    }
    if (kind == "cuantos") {
        // Con $P, cada uno $X → cuántos entran (división exacta).
        let precio = g.int(2, 10) * 50
        let k = g.int(2, 8)
        a = k * precio
        b = precio
        answer = k
        money = false
        skill = "div.exacta"
    }
    if (kind == "descuento") {
        // Precio $X con P% de descuento → cuánto pagás.
        let precio = g.int(1, imax(max / 100, 2)) * 100
        let pcts = [10, 20, 25, 50]
        let p = pcts[g.int(0, 3)]
        a = precio
        b = p
        answer = precio - precio * p / 100
        skill = "dec.dinero"
    }
    if (kind == "oferta") {
        // N unidades a $X, pagás con billete → vuelto (2 pasos).
        let n = g.int(2, 4)
        let precio = g.int(2, 10) * 50
        let subtotal = n * precio
        let billete = kiosco_paid(subtotal)
        a = n
        b = precio
        c = billete
        answer = billete - subtotal
        skill = "dec.dinero"
    }
    if (kind == "combo") {
        // N unidades de $A y otra cosa de $B → cuánto gastás (2 pasos).
        let n = g.int(2, 4)
        let precioA = g.int(2, 8) * 50
        let precioB = g.int(2, 8) * 50
        a = n
        b = precioA
        c = precioB
        answer = n * precioA + precioB
        skill = "mul.tabla"
    }
    if (kind == "ahorro") {
        // Ahorrás $X por semana → cuánto en N semanas (multiplicación).
        let semanas = g.int(2, 8)
        let porsemana = g.int(1, 10) * 50
        a = semanas
        b = porsemana
        answer = semanas * porsemana
        skill = "mul.tabla"
    }
    if (kind == "edad") {
        // Tu edad + la diferencia del hermano (adición, sin dinero).
        let edad = g.int(6, 12)
        let dif = g.int(1, 8)
        a = edad
        b = dif
        answer = edad + dif
        money = false
        skill = "add"
    }
    if (kind == "cuadras") {
        // Ida y vuelta a la escuela: 2 × cuadras (sin dinero).
        let cuadras = g.int(3, 15)
        a = cuadras
        answer = 2 * cuadras
        money = false
        skill = "mul.tabla"
    }
    if (kind == "unitario") {
        // N cosas cuestan $T en total → cuánto cuesta cada una (división exacta).
        let n = g.int(2, 6)
        let cada = g.int(2, 10) * 50
        a = n * cada       // total
        b = n
        answer = cada
        skill = "div.exacta"
    }
    if (kind == "promedio") {
        // El promedio de tres ventas (suma / 3, exacto por construcción).
        let avg = g.int(2, 12) * 50
        let d = g.int(1, avg / 50 - 1) * 50
        a = avg - d
        b = avg
        c = avg + d
        answer = avg          // = (a + b + c) / 3
        skill = "div.exacta"
    }
    if (kind == "porcentaje") {
        // El P% de $X (porcentaje simple, exacto).
        let x = g.int(1, imax(max / 100, 2)) * 100
        let pcts = [10, 20, 25, 50]
        let p = pcts[g.int(0, 3)]
        a = x
        b = p
        answer = x * p / 100
        skill = "dec.dinero"
    }
    // --- N6: fracciones + proporción -----------------------------------------
    if (kind == "fraccion") {
        // {b}/{c} de un monto ${a}: a = parte·c (múltiplo de c) → respuesta entera.
        let dens = [2, 3, 4, 5]
        let den = dens[g.int(0, 3)]
        let num = g.int(1, den - 1)
        let parte = g.int(3, 12) * esc_kiosco(grade)
        a = parte * den
        b = num
        c = den
        answer = parte * num
        skill = "div.exacta"
    }
    if (kind == "regla3") {
        // {a} litros cuestan ${b}; ¿cuánto {c} litros? b = a·unit → unitario entero.
        let unit = g.int(2, 9) * (esc_kiosco(grade) / 10)
        let n = g.int(2, 6)
        let m = g.int(2, 8)
        a = n
        b = n * unit
        c = m
        answer = m * unit
        skill = "div.exacta"
    }
    // --- N7: porcentajes reales + tasas --------------------------------------
    if (kind == "iva") {
        // Precio ${a} sin IVA + 21%. a múltiplo de 100 → 21% entero.
        let x = g.int(2, 20) * esc_kiosco(grade)
        a = x
        answer = x + x * 21 / 100
        skill = "dec.dinero"
    }
    if (kind == "velocidad") {
        // {a} km en {b} h → km/h. a = v·b (cuenta, sin dinero).
        let h = g.int(2, 6)
        let v = g.int(40, 120)
        a = v * h
        b = h
        answer = v
        money = false
        skill = "div.exacta"
    }
    if (kind == "rendimiento") {
        // {a} litros cada {b} km; ¿litros para {c} km? c múltiplo de b.
        let litros = g.int(4, 12)
        let cada = g.int(1, 4) * 100
        let veces = g.int(2, 8)
        a = litros
        b = cada
        c = veces * cada
        answer = litros * veces
        money = false
        skill = "div.exacta"
    }
    // --- N8: multi-paso + ecuaciones -----------------------------------------
    if (kind == "ecuacion") {
        // x·{a} + {b} = {c} → x. Sin dinero (un número).
        let coef = g.int(2, 6)
        let x = g.int(3, 25)
        let suma = g.int(1, 30)
        a = coef
        b = suma
        c = coef * x + suma
        answer = x
        money = false
        skill = "sub"
    }
    if (kind == "interes") {
        // ${a} al {b}% mensual simple, {c} meses. a múltiplo de 100 → entero.
        let cap = g.int(2, 20) * esc_kiosco(grade)
        let tasas = [5, 10]
        let tasa = tasas[g.int(0, 1)]
        let meses = g.int(2, 6)
        a = cap
        b = tasa
        c = meses
        answer = cap * tasa * meses / 100
        skill = "mul.tabla"
    }
    if (kind == "trabajo") {
        // Ganás ${a}/hora, {b} h/día, {c} días (multi-paso).
        let porhora = g.int(3, 12) * (esc_kiosco(grade) / 10)
        let horas = g.int(4, 9)
        let dias = g.int(3, 6)
        a = porhora
        b = horas
        c = dias
        answer = porhora * horas * dias
        skill = "mul.tabla"
    }
    // --- N9: los más duros ---------------------------------------------------
    if (kind == "desc_compuesto") {
        // ${a} con {b}% off y después {c}% off. pcts ∈ {10,20,50}, a múltiplo de
        // 100 → (100-b)(100-c)/100 entero → respuesta entera.
        let x = g.int(2, 20) * esc_kiosco(grade)
        let pcts = [10, 20, 50]
        let p1 = pcts[g.int(0, 2)]
        let p2 = pcts[g.int(0, 2)]
        a = x
        b = p1
        c = p2
        answer = x * (100 - p1) * (100 - p2) / 10000
        skill = "dec.dinero"
    }
    if (kind == "evento") {
        // {a} personas × ${b} por persona + costo fijo ${c} (multi-paso).
        let n = g.int(5, 30)
        let porpersona = g.int(3, 12) * (esc_kiosco(grade) / 10)
        let fijo = g.int(2, 10) * esc_kiosco(grade)
        a = n
        b = porpersona
        c = fijo
        answer = n * porpersona + fijo
        skill = "mul.tabla"
    }
    return KioscoItem {
        kind: kind,
        item: it,
        a: a,
        b: b,
        c: c,
        answer: answer,
        money: money,
        skill: skill,
        difficulty: nivel,
    }
}

// Genera el problema `idx` con de-dup por sesión: reconstruye 0..idx y bumpea el
// salt si una firma ya salió, así en la ronda no se repite ningún problema.
fn gen_kiosco(seed: Int, idx: Int, grade: Int) -> KioscoItem {
    let seen: List<Str> = []
    let result = gen_kiosco_raw(seed, 0, grade, 0)
    let j = 0
    while (j <= idx) {
        let salt = 0
        let cand = gen_kiosco_raw(seed, j, grade, salt)
        while (contiene_str_local(seen, firma_kiosco(cand)) and salt < 40) {
            salt = salt + 1
            cand = gen_kiosco_raw(seed, j, grade, salt)
        }
        seen.push(firma_kiosco(cand))
        result = cand
        j = j + 1
    }
    return result
}
