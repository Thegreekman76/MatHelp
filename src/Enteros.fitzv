// Enteros.fitzv — "Operaciones con signo" como LiveComponent SSR.
//
// Muestra una cuenta con enteros + una recta numérica y el chico TIPEA el resultado
// (que puede ser NEGATIVO → teclado con la tecla ±). Ronda fija de N, sin reloj. El
// item se deriva de (seed, idx, grade) — el server re-deriva el mismo y compara
// given == it.answer.
//
// Cuatro eventos: digito()/borrar()/signo()/answer(). La persistencia (Attempt +
// mastery + racha) la hace el loop del @ws en live_enteros.fitz.

from gen_enteros import gen_enteros
from keypad import kp_append, kp_borrar, kp_signo
from engine import a_int
from enteros_view import enteros_screen, explicar_enteros

component enteros {
  state {
    seed: Int = 0
    idx: Int = 0
    grade: Int = 7
    locale: Str = "es-AR"
    correct: Int = 0
    total: Int = 0
    racha: Int = 0
    racha_max: Int = 0
    record_prev: Int = 999999
    phase: Str = "playing"         // "playing" | "done"
    feedback: Str = ""             // "" | "ok" | "bad"
    last_answer: Int = 0           // la respuesta correcta del item recién fallado
    last_expl: Str = ""            // la cuenta con signos del item recién fallado
    entrada: Int = 0               // lo tipeado (puede ser negativo)
    touched: Bool = false          // ¿tipeó algo? (distingue vacío de 0 tipeado)
    limit: Int = 10                // items por ronda
  }

  event digito() {
    if (phase == "playing") {
      if (payload.has("d")) {
        entrada = kp_append(entrada, a_int(payload["d"]), 99999)
        touched = true
      }
    }
  }

  event borrar() {
    if (phase == "playing") {
      entrada = kp_borrar(entrada)
    }
  }

  // Tecla ±: invierte el signo de lo tipeado.
  event signo() {
    if (phase == "playing") {
      entrada = kp_signo(entrada)
      touched = true
    }
  }

  event answer() {
    if (phase == "playing") {
      if (payload.has("v")) {
        if (payload.has("ei")) {
          let ei = a_int(payload["ei"])
          if (ei == idx) {
            let given = a_int(payload["v"])
            if (touched) {
              let it = gen_enteros(seed, idx, grade)
              let acierto = given == it.answer
              total = total + 1
              if (acierto) {
                correct = correct + 1
                feedback = "ok"
                racha = racha + 1
                if (racha > racha_max) {
                  racha_max = racha
                }
              }
              if (not acierto) {
                feedback = "bad"
                racha = 0
                last_answer = it.answer
                last_expl = explicar_enteros(locale, it)
              }
              entrada = 0
              touched = false
              idx = idx + 1
              if (total >= limit) {
                phase = "done"
              }
            }
          }
        }
      }
    }
  }

  <template>
    <div id="enteros-app" class="mh-quiz">
      {enteros_screen(seed, idx, grade, locale, correct, total, limit, phase, feedback, last_answer, last_expl, entrada, touched, racha, racha_max, record_prev).raw}
    </div>
  </template>
}
