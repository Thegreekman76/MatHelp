// Completa.fitzv — "Completá el hueco", como LiveComponent SSR.
//
// Mismo esqueleto que los otros juegos (estado primitivo en el component store,
// ejercicio derivado de (seed, idx) con el motor adaptativo), pero con teclado
// numérico propio: el chico TIPEA el operando oculto en vez de elegir una opción.
// Ronda fija de N ejercicios (sin reloj — tipear a las apuradas es feo, §8).
//
// Tres eventos:
//   - digito(): agrega un dígito a `entrada` (data-flv-value-d).
//   - borrar(): quita el último dígito.
//   - answer(): el chico tocó "Listo" (enter). El payload trae la entrada actual
//     (v) y el índice (ei). Corrige contra ex.b, actualiza, resetea y avanza.
//
// La persistencia (Attempt + mastery + racha) la hace el loop del @ws en
// live_completa.fitz, que re-deriva el mismo ejercicio y compara given == ex.b.

from gen_arith import gen_for
from keypad import kp_append, kp_borrar
from engine import a_int
from completa_view import completa_screen

component completa {
  state {
    seed: Int = 0
    idx: Int = 0
    grade: Int = 4
    locale: Str = "es-AR"
    correct: Int = 0
    total: Int = 0
    phase: Str = "playing"         // "playing" | "done"
    feedback: Str = ""             // "" | "ok" | "bad"
    last_answer: Int = 0           // la respuesta correcta (ex.b) del ejercicio recién fallado
    entrada: Int = 0               // lo tipeado en el teclado (0 = vacío)
    mode: Str = "adaptive"         // motor adaptativo (como el contrarreloj)
    r_add: Float = 800.0
    r_sub: Float = 800.0
    r_mul: Float = 800.0
    r_div: Float = 800.0
    limit: Int = 10                // ejercicios por ronda
  }

  event digito() {
    if (phase == "playing") {
      if (payload.has("d")) {
        entrada = kp_append(entrada, a_int(payload["d"]), 99999)
      }
    }
  }

  event borrar() {
    if (phase == "playing") {
      entrada = kp_borrar(entrada)
    }
  }

  event answer() {
    if (phase == "playing") {
      if (payload.has("v")) {
        if (payload.has("ei")) {
          let ei = a_int(payload["ei"])
          if (ei == idx) {
            let given = a_int(payload["v"])
            // Enter vacío (nada tipeado): no cuenta, no avanza.
            if (given > 0) {
              let ex = gen_for(mode, "mix", 2, seed, idx, grade, r_add, r_sub, r_mul, r_div)
              let acierto = given == ex.b
              total = total + 1
              if (acierto) {
                correct = correct + 1
                feedback = "ok"
              }
              if (not acierto) {
                feedback = "bad"
                last_answer = ex.b
              }
              entrada = 0
              idx = idx + 1
              if (total >= limit) {
                phase = "done"
              }
            }
          }
        }
      }
    }
  }

  <template>
    <div id="completa-app" class="mh-quiz">
      {completa_screen(seed, idx, grade, locale, correct, total, limit, phase, feedback, last_answer, entrada, mode, r_add, r_sub, r_mul, r_div).raw}
    </div>
  </template>
}
