// Fracciones.fitzv — "Fracciones a la vista", como LiveComponent SSR.
//
// Muestra una barra pintada y el chico elige la fracción (opción múltiple). A
// diferencia de los otros juegos, la respuesta es un STRING ("n/d"), no un Int:
// el payload trae la fracción elegida (v) y se compara con it.correct. Ronda fija
// de N sin reloj. La persistencia (Attempt + mastery `frac.parte` + racha) la hace
// el @ws re-derivando la misma fracción. Alimenta el progreso igual que el resto.
//
// Un evento: answer(). Payload: v = "n/d" (fracción elegida), ei = índice.

from gen_frac import gen_frac
from engine import a_int
from frac_view import frac_screen

component fracciones {
  state {
    seed: Int = 0
    idx: Int = 0
    grade: Int = 4
    locale: Str = "es-AR"
    correct: Int = 0
    total: Int = 0
    phase: Str = "playing"         // "playing" | "done"
    feedback: Str = ""             // "" | "ok" | "bad"
    last_answer: Str = ""          // la fracción correcta del ejercicio recién fallado
    limit: Int = 10                // ejercicios por ronda
  }

  event answer() {
    if (phase == "playing") {
      if (payload.has("v")) {
        if (payload.has("ei")) {
          let ei = a_int(payload["ei"])
          if (ei == idx) {
            let elegida = payload["v"]
            let it = gen_frac(seed, idx, grade)
            let acierto = elegida == it.correct
            total = total + 1
            if (acierto) {
              correct = correct + 1
              feedback = "ok"
            }
            if (not acierto) {
              feedback = "bad"
              last_answer = it.correct
            }
            idx = idx + 1
            if (total >= limit) {
              phase = "done"
            }
          }
        }
      }
    }
  }

  <template>
    <div id="fracciones-app" class="mh-quiz">
      {frac_screen(seed, idx, grade, locale, correct, total, limit, phase, feedback, last_answer).raw}
    </div>
  </template>
}
