// Finanzas.fitzv — el juego "Finanzas" (F7.3), como LiveComponent SSR.
//
// Diferencial de la modalidad comercial: problemas con historia (interés
// simple/compuesto, porcentaje, descuento), respuesta en pesos por teclado. La
// plata es positiva, así que el teclado va SIN ± (no hay evento signo). Ronda
// fija de N, sin reloj, no adaptativo (gen_finanzas no usa ratings). La
// persistencia la hace el loop del @ws en live_finanzas.fitz.
//
// Tres eventos: digito / borrar / answer.

from gen_arith import gen_finanzas
from keypad import kp_append, kp_borrar
from engine import a_int
from finanzas_view import finanzas_screen

component finanzas {
  state {
    seed: Int = 0
    idx: Int = 0
    grade: Int = 11
    locale: Str = "es-AR"
    correct: Int = 0
    total: Int = 0
    phase: Str = "playing"         // "playing" | "done"
    feedback: Str = ""             // "" | "ok" | "bad"
    last_answer: Int = 0           // la respuesta (en pesos) del ejercicio recién fallado
    entrada: Int = 0               // lo tipeado
    touched: Bool = false          // ¿tipeó algo? (la respuesta puede ser cualquier monto)
    limit: Int = 10                // ejercicios por ronda
  }

  event digito() {
    if (phase == "playing") {
      if (payload.has("d")) {
        entrada = kp_append(entrada, a_int(payload["d"]), 99999)
        touched = true
      }
    }
  }

  event borrar() {
    if (phase == "playing") {
      entrada = kp_borrar(entrada)
    }
  }

  event answer() {
    if (phase == "playing") {
      if (payload.has("v")) {
        if (payload.has("ei")) {
          let ei = a_int(payload["ei"])
          if (ei == idx) {
            let given = a_int(payload["v"])
            if (touched) {
              let ex = gen_finanzas(seed, idx, grade)
              let acierto = given == ex.answer
              total = total + 1
              if (acierto) {
                correct = correct + 1
                feedback = "ok"
              }
              if (not acierto) {
                feedback = "bad"
                last_answer = ex.answer
              }
              entrada = 0
              touched = false
              idx = idx + 1
              if (total >= limit) {
                phase = "done"
              }
            }
          }
        }
      }
    }
  }

  <template>
    <div id="finanzas-app" class="mh-quiz">
      {finanzas_screen(seed, idx, grade, locale, correct, total, limit, phase, feedback, last_answer, entrada, touched).raw}
    </div>
  </template>
}
