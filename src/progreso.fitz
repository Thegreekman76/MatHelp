// progreso.fitz — "Mi progreso" (F3): mate-progreso + medallas + racha diaria.
//
// Página de lectura (sin socket): lee el mastery del perfil (rating por
// destreza), las medallas y la racha, y las muestra. La barra de cada destreza
// es el "mate que se llena" (§6): el % sale de progreso_pct(rating). Todo texto
// por t(), todo número por fmt_int (reglas del proyecto).
//
// Lecturas por SQL crudo (mastery/awards) — consistente con mastery.fitz; el
// ORM se reservaría para F5. La racha la calcula streaks.racha_actual.

from fitz_liveviews import Html, html, flv, h_join
from config import db_url
from i18n import t, t1, t2, locale_from_cookie
from layout import page, responder_html, redirect_a
from fmt import fmt_int
from engine import progreso_pct
from streaks import racha_actual
from live_game import resolver_contexto

// --- etiquetas ---------------------------------------------------------------

// skill_code → clave i18n del nombre (reusa las de "tema.*"). Familias de
// secundaria con prefijo (ec.*, fin.*, func.*, pot.*, trig.*) → etiqueta del juego.
fn skill_label_key(sc: Str) -> Str {
    if (sc.starts_with("ec.") or sc == "sist.2x2") {
        return "tema.ecuaciones"
    }
    if (sc.starts_with("fin.")) {
        return "tema.finanzas"
    }
    if (sc.starts_with("func.")) {
        return "tema.funciones"
    }
    if (sc.starts_with("pot.") or sc.starts_with("raiz.")) {
        return "tema.potencias"
    }
    if (sc.starts_with("trig.")) {
        return "tema.trigonometria"
    }
    if (sc.starts_with("pct")) {
        return "tema.porcentaje"
    }
    return match sc {
        "add" => "tema.suma",
        "sub" => "tema.resta",
        "mul.tabla" => "tema.multiplicacion",
        "div.exacta" => "tema.division",
        "dec.dinero" => "tema.decimales",
        "frac.parte" => "tema.fracciones",
        "patron" => "tema.series",
        "reloj" => "tema.hora",
        "geo" => "tema.geometria",
        "memoria" => "tema.memoria",
        "ordenar" => "tema.ordenar",
        "estimar" => "tema.estimar",
        "vol" => "tema.volumen",
        "historia" => "tema.historia",
        "enteros" => "tema.enteros",
        "estadistica" => "tema.estadistica",
        _ => "tema.mezcla",
    }
}

fn skill_icon(sc: Str) -> Str {
    if (sc.starts_with("ec.") or sc == "sist.2x2") {
        return "🟰"
    }
    if (sc.starts_with("fin.")) {
        return "💰"
    }
    if (sc.starts_with("func.")) {
        return "📈"
    }
    if (sc.starts_with("pot.") or sc.starts_with("raiz.")) {
        return "🔷"
    }
    if (sc.starts_with("trig.")) {
        return "🔺"
    }
    if (sc.starts_with("pct")) {
        return "％"
    }
    return match sc {
        "add" => "➕",
        "sub" => "➖",
        "mul.tabla" => "✖️",
        "div.exacta" => "➗",
        "dec.dinero" => "💵",
        "frac.parte" => "🍕",
        "patron" => "🧩",
        "reloj" => "🕐",
        "geo" => "📐",
        "memoria" => "🃏",
        "ordenar" => "📊",
        "estimar" => "🎯",
        "vol" => "📦",
        "historia" => "📖",
        "enteros" => "±",
        "estadistica" => "📉",
        _ => "🎲",
    }
}

// Destreza → un juego que la entrena (para el CTA "Repasá lo que te cuesta").
fn skill_a_route(sc: Str) -> Str {
    if (sc.starts_with("ec.") or sc == "sist.2x2") {
        return "/ecuaciones"
    }
    if (sc.starts_with("fin.")) {
        return "/finanzas"
    }
    if (sc.starts_with("func.")) {
        return "/funciones"
    }
    if (sc.starts_with("pot.") or sc.starts_with("raiz.")) {
        return "/potencias"
    }
    if (sc.starts_with("trig.")) {
        return "/trigonometria"
    }
    if (sc.starts_with("pct")) {
        return "/porcentaje"
    }
    return match sc {
        "add" => "/jugar",
        "sub" => "/jugar",
        "mul.tabla" => "/escalera",
        "div.exacta" => "/jugar",
        "dec.dinero" => "/problemas",
        "frac.parte" => "/fracciones",
        "patron" => "/series",
        "reloj" => "/hora",
        "geo" => "/geometria",
        "memoria" => "/memoria",
        "ordenar" => "/ordenar",
        "estimar" => "/estimar",
        "vol" => "/volumen",
        "historia" => "/historia",
        "enteros" => "/enteros",
        "estadistica" => "/estadistica",
        _ => "/jugar",
    }
}

// Destreza aritmética → el "op" de práctica libre (add/sub/mul/div), para el
// repaso dirigido: si tu punto flojo es una de las 4 operaciones, te llevamos a
// una práctica enfocada SOLO en esa. "" si no es aritmética (→ va al juego).
fn skill_a_practica_op(sc: Str) -> Str {
    return match sc {
        "add" => "add",
        "sub" => "sub",
        "mul.tabla" => "mul",
        "div.exacta" => "div",
        _ => "",
    }
}

// game_code (de profile_game_stats) → clave i18n del nombre del juego.
fn record_label_key(code: Str) -> Str {
    return match code {
        "trig" => "juego.trigonometria",
        "desafio" => "home.desafio_dia",
        _ => "juego.{code}",
    }
}

fn award_emoji(code: Str) -> Str {
    return match code {
        "primer_mate" => "🧉",
        "racha7" => "🔥",
        "racha30" => "🌟",
        "maestro" => "🎓",
        "explorador" => "🧭",
        _ => "🏅",
    }
}

fn award_label_key(code: Str) -> Str {
    return match code {
        "primer_mate" => "award.primer_mate",
        "racha7" => "award.racha7",
        "racha30" => "award.racha30",
        "maestro" => "award.maestro",
        "explorador" => "award.explorador",
        _ => "award.generico",
    }
}

// Pista de cómo se consigue cada medalla (se muestra en las bloqueadas).
fn award_hint_key(code: Str) -> Str {
    return match code {
        "primer_mate" => "award.hint.primer_mate",
        "racha7" => "award.hint.racha7",
        "racha30" => "award.hint.racha30",
        "maestro" => "award.hint.maestro",
        "explorador" => "award.hint.explorador",
        _ => "award.hint.generico",
    }
}

// Catálogo completo de medallas, en orden de dificultad (para la galería).
fn award_codes() -> List<Str> {
    return ["primer_mate", "racha7", "racha30", "maestro", "explorador"]
}

fn tiene_medalla(ganadas: List<Str>, code: Str) -> Bool {
    for g in ganadas {
        if (g == code) {
            return true
        }
    }
    return false
}

// --- render ------------------------------------------------------------------

// Una barra "mate que se llena" por destreza: nombre + % + aciertos.
fn barra_destreza(locale: Str, sc: Str, rating: Float, seen: Int, hits: Int) -> Html {
    let nombre = flv(t(locale, skill_label_key(sc)))
    let icon = flv(skill_icon(sc))
    let pct = progreso_pct(rating)
    let pct_txt = flv(fmt_int(locale, pct))
    let hits_f = flv(fmt_int(locale, hits))
    let de = flv(t(locale, "juego.de"))
    let seen_f = flv(fmt_int(locale, seen))
    return html("""<div style="margin:.9rem 0">
<div style="display:flex;justify-content:space-between;align-items:center;font-weight:700;margin-bottom:.35rem">
<span>{icon} {nombre}</span><span style="color:var(--mh-suave)">{pct_txt}%</span>
</div>
<div style="background:var(--mh-borde,#e2e8f0);border-radius:99px;height:16px;overflow:hidden">
<div style="width:{pct}%;height:100%;background:var(--mh-acento,#0E7A63);border-radius:99px;transition:width .3s"></div>
</div>
<div style="font-size:.85rem;color:var(--mh-suave);margin-top:.3rem">{hits_f} {de} {seen_f}</div>
</div>""")
}

fn medalla(locale: Str, code: Str, ganada: Bool) -> Html {
    let em = flv(award_emoji(code))
    let nombre = flv(t(locale, award_label_key(code)))
    if (ganada) {
        return html("""<div class="mh-medalla ganada">
<div class="mh-medalla-em">{em}</div>
<div class="mh-medalla-nom">{nombre}</div>
</div>""")
    }
    let hint = flv(t(locale, award_hint_key(code)))
    return html("""<div class="mh-medalla bloq">
<div class="mh-medalla-em">🔒</div>
<div class="mh-medalla-nom">{nombre}</div>
<div class="mh-medalla-hint">{hint}</div>
</div>""")
}

// Una fila de "Mis récords": nombre del juego + mejor racha histórica.
fn fila_record(locale: Str, code: Str, best: Int) -> Html {
    let nombre = flv(t(locale, record_label_key(code)))
    let n = flv(fmt_int(locale, best))
    return html("""<div class="mh-record-row"><span>🏆 {nombre}</span><span class="mh-record-n">🔥 {n}</span></div>""")
}

// Arma el cuerpo de la página con los datos ya leídos. Propaga errores de DB
// con `?`; el handler los traduce a una pantalla de error amable.
async fn render_progreso(profile_id: Int, locale: Str) -> Result<Html> {
    let conn = db.connect(db_url()).await?
    let mrows = conn.query("SELECT skill_code, rating, seen, hits FROM mastery WHERE profile_id = $1 ORDER BY skill_code", [profile_id]).await?
    let arows = conn.query("SELECT code FROM awards WHERE profile_id = $1 ORDER BY earned_at", [profile_id]).await?
    let rrows = conn.query("SELECT game_code, best_streak FROM profile_game_stats WHERE profile_id = $1 AND best_streak > 0 ORDER BY best_streak DESC, game_code", [profile_id]).await?
    let racha = racha_actual(profile_id).await?

    // Racha diaria arriba de todo.
    let racha_html = match racha > 0 {
        true => html("""<div class="mh-card" style="text-align:center">
<div style="font-size:2.6rem;line-height:1">🔥</div>
<div style="font-size:1.5rem;font-weight:800">{flv(fmt_int(locale, racha))}</div>
<div style="color:var(--mh-suave)">{flv(t(locale, "progreso.racha_dias"))}</div>
</div>""").raw,
        false => html("""<div class="mh-card" style="text-align:center">
<div style="font-size:2.6rem;line-height:1">🌱</div>
<div style="color:var(--mh-suave)">{flv(t(locale, "progreso.racha_cero"))}</div>
</div>""").raw,
    }

    // Sin ninguna destreza jugada → estado vacío amable.
    if (mrows.len() == 0) {
        let vacio = html("""{racha_html}
<div class="mh-card" style="text-align:center">
<p style="color:var(--mh-suave);margin:.4rem 0 1.2rem">{flv(t(locale, "progreso.sin_datos"))}</p>
<a class="mh-btn" href="/jugar">{flv(t(locale, "home.jugar_ya"))}</a>
</div>
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>""")
        return Ok(vacio)
    }

    let barras: List<Html> = []
    for r in mrows {
        let sc = r.get_str("skill_code")?
        let rating = r.get_float("rating")?
        let seen = r.get_int("seen")?
        let hits = r.get_int("hits")?
        barras.push(barra_destreza(locale, sc, rating, seen, hits))
    }
    let barras_html = match barras.len() > 0 {
        true => h_join(barras),
        false => html("""<p style="text-align:center;color:var(--mh-suave)">{flv(t(locale, "progreso.sin_temas"))}</p>""").raw,
    }

    // Galería de medallas: TODAS las conocidas, las ganadas a color y las que
    // faltan en gris con la pista de cómo conseguirlas.
    let ganadas: List<Str> = []
    for r in arows {
        ganadas.push(r.get_str("code")?)
    }
    let medallas: List<Html> = []
    for code in award_codes() {
        medallas.push(medalla(locale, code, tiene_medalla(ganadas, code)))
    }
    let medallas_grid = h_join(medallas)
    let n_ganadas = flv(fmt_int(locale, ganadas.len()))
    let n_total = flv(fmt_int(locale, award_codes().len()))
    let conteo = flv(t2(locale, "progreso.medallas_conteo", n_ganadas, n_total))

    // Mis récords: mejor racha por juego (solo si tiene alguno > 0).
    let records: List<Html> = []
    for r in rrows {
        records.push(fila_record(locale, r.get_str("game_code")?, r.get_int("best_streak")?))
    }
    let records_card = match records.len() > 0 {
        true => html("""<div class="mh-card">
<h2>{flv(t(locale, "progreso.records"))}</h2>
<div class="mh-records">
{h_join(records)}
</div>
</div>""").raw,
        false => "",
    }

    let body = html("""{racha_html}
<div class="mh-card">
<h2>{flv(t(locale, "progreso.destrezas"))}</h2>
{barras_html}
</div>
<div class="mh-card">
<h2>{flv(t(locale, "progreso.medallas"))}</h2>
<p style="text-align:center;color:var(--mh-suave);margin:.1rem 0 .8rem">{conteo}</p>
<div class="mh-medallas">
{medallas_grid}
</div>
</div>
{records_card}
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>""")
    return Ok(body)
}

@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/progreso")
async fn progreso_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let ctx = match resolver_contexto(session).await {
        Ok(c) => c,
        Err(destino) => return redirect_a(destino),
    }
    let titulo = t(locale, "nav.progreso") + " — MatHelp"
    match render_progreso(ctx.profile_id, locale).await {
        Ok(body) => return responder_html(page(locale, titulo, body, html(""))),
        Err(_) => {
            let err = html("""<div class="mh-card" style="text-align:center">
<p style="color:var(--mh-suave)">{flv(t(locale, "estado.db_error"))}</p>
<a class="mh-btn sec" href="/">{flv(t(locale, "perfiles.volver"))}</a>
</div>""")
            return responder_html(page(locale, titulo, err, html("")))
        }
    }
}
