// maestro.fitz — modo MAESTRO: panel de grados y alumnos.
//
// Un maestro (families.account_type = 'teacher') arma GRADOS (Grupo) con alumnos
// (Profile con grupo_id → grupos.id). Se loguea con email+contraseña (sin PIN de
// adulto: no hay chico en su sesión, los alumnos entran con SU login) y gestiona
// directo. NO juega (admin puro, sin perfil de aprendiz).
//
// Fase 1: rol + schema + panel esqueleto. Fase 2 (acá): CRUD de grados. Los
// alumnos + invitaciones llegan en Fase 3, el login del alumno en Fase 4, el
// panel/reporte por grado en Fase 5.

from fitz_liveviews import Html, html, flv, h_join
from config import db_url
from i18n import t, t1, locale_from_cookie
from layout import page, responder_html, redirect_a
from auth import read_session, es_teacher, asegurar_login_cols
from models import Grupo
from engine import modalidad_valida
from perfiles import opciones_grado, opciones_grado_sel, opciones_modalidad_sel, crear_perfil

// --- DB: schema lazy (grupos + profiles.grupo_id) ------------------------------
// La migración 0025 los crea en initdb (base nueva). Para la base ya existente,
// se crean lazy acá (idempotente), como admin_pin / login_*.
async fn asegurar_grupos() -> Result<Int> {
    let conn = db.connect(db_url()).await?
    let _ = conn.exec("CREATE TABLE IF NOT EXISTS grupos (id BIGSERIAL PRIMARY KEY, owner_id BIGINT NOT NULL REFERENCES families(id) ON DELETE CASCADE, colegio TEXT NOT NULL DEFAULT '', turno TEXT NOT NULL DEFAULT '', nombre TEXT NOT NULL DEFAULT '', grade INT NOT NULL DEFAULT 1, modalidad TEXT NOT NULL DEFAULT 'comun', codigo TEXT NOT NULL DEFAULT '', created_at TIMESTAMPTZ NOT NULL DEFAULT NOW())", []).await
    let _ = conn.exec("CREATE INDEX IF NOT EXISTS idx_grupos_owner ON grupos(owner_id)", []).await
    let _ = conn.exec("CREATE INDEX IF NOT EXISTS idx_grupos_codigo ON grupos(codigo)", []).await
    let _ = conn.exec("ALTER TABLE profiles ADD COLUMN IF NOT EXISTS grupo_id BIGINT REFERENCES grupos(id) ON DELETE SET NULL", []).await
    return conn.exec("CREATE INDEX IF NOT EXISTS idx_profiles_grupo ON profiles(grupo_id)", []).await
}

// --- DB: CRUD de grados --------------------------------------------------------

// Código del grado (6 dígitos) que los alumnos usan para entrar (Fase 4).
fn gen_codigo_grado() -> Str {
    return "{rand.int(100000, 999999)}"
}

// Genera un código de grado que no colisione con otro existente (reintenta).
async fn gen_codigo_unico(conn: DbConn) -> Result<Str> {
    for _n in 0..8 {
        let c = gen_codigo_grado()
        let rows = conn.query("SELECT 1 AS x FROM grupos WHERE codigo = $1 LIMIT 1", [c]).await?
        if (rows.len() == 0) {
            return Ok(c)
        }
    }
    return Ok(gen_codigo_grado())
}

async fn crear_grupo(owner_id: Int, colegio: Str, turno: Str, nombre: Str, grade: Int, modalidad: Str) -> Result<Grupo> {
    let _ = asegurar_grupos().await
    let conn = db.connect(db_url()).await?
    let codigo = gen_codigo_unico(conn).await?
    return Grupo.insert(conn, Grupo {
        id: 0,
        owner_id: owner_id,
        colegio: colegio,
        turno: turno,
        nombre: nombre,
        grade: grade,
        modalidad: modalidad_valida(modalidad),
        codigo: codigo,
        created_at: "",
    }).await
}

// Grados de un maestro, ordenados por colegio (agrupa visualmente el listado).
async fn grupos_de(owner_id: Int) -> Result<List<Grupo>> {
    let _ = asegurar_grupos().await
    let conn = db.connect(db_url()).await?
    return Grupo.where(fn(g) => g.owner_id == owner_id).order_by(fn(g) => g.colegio).all(conn).await
}

// Un grado validando que sea de ESTE maestro (owner_id = defensa).
async fn grupo_de_maestro(owner_id: Int, gid: Int) -> Result<Grupo> {
    let _ = asegurar_grupos().await
    let conn = db.connect(db_url()).await?
    return Grupo.where(fn(g) => g.id == gid and g.owner_id == owner_id).first(conn).await
}

async fn actualizar_grupo(owner_id: Int, gid: Int, colegio: Str, turno: Str, nombre: Str, grade: Int, modalidad: Str) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    return conn.exec("UPDATE grupos SET colegio=$3, turno=$4, nombre=$5, grade=$6, modalidad=$7 WHERE id=$1 AND owner_id=$2", [gid, owner_id, colegio, turno, nombre, grade, modalidad_valida(modalidad)]).await
}

// Elimina un grado. Los alumnos quedan con grupo_id NULL (ON DELETE SET NULL).
async fn eliminar_grupo(owner_id: Int, gid: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    return conn.exec("DELETE FROM grupos WHERE id=$1 AND owner_id=$2", [gid, owner_id]).await
}

// --- DB: alumnos de un grado ---------------------------------------------------
// Un alumno es un Profile: family_id = la cuenta del maestro, grupo_id = su grado,
// login_enabled = true (acceso propio, se activa con activation_code — Opción B).
// Reusa todo el progreso/login por profile_id.

type AlumnoRow {
    id: Int = 0
    nombre: Str = ""
    activo: Bool = false      // ya creó su contraseña (login_hash != '')
    codigo: Str = ""          // código de activación pendiente ("" si ya activó)
}

async fn crear_alumno(owner_id: Int, grupo_id: Int, nombre: Str, grade: Int, modalidad: Str, locale: Str) -> Result<Int> {
    let _ = asegurar_grupos().await
    let _ = asegurar_login_cols().await
    // Profile base (reusa crear_perfil: sin PIN de perfil — el alumno usa login propio).
    let p = crear_perfil(owner_id, nombre, grade, modalidad, "", locale).await?
    // Asignarlo al grado + habilitar acceso propio con un código de activación.
    let conn = db.connect(db_url()).await?
    let codigo = gen_codigo_grado()
    let _ = conn.exec("UPDATE profiles SET grupo_id=$2, login_enabled=true, activation_code=$3, login_hash='' WHERE id=$1", [p.id, grupo_id, codigo]).await
    return Ok(p.id)
}

// Alumnos de un grado (SQL crudo: grupo_id/login_* no están en el @table Profile).
async fn alumnos_de_grupo(grupo_id: Int) -> List<AlumnoRow> {
    let _ = asegurar_grupos().await
    let _ = asegurar_login_cols().await
    let conn = match db.connect(db_url()).await {
        Ok(c) => c,
        Err(_) => { return [] },
    }
    let rows = match conn.query("SELECT id, name, (login_hash <> '') AS activo, activation_code FROM profiles WHERE grupo_id = $1 ORDER BY name", [grupo_id]).await {
        Ok(r) => r,
        Err(_) => { return [] },
    }
    let out: List<AlumnoRow> = []
    for r in rows {
        let id = match r.get_int("id") {
            Ok(n) => n,
            Err(_) => 0,
        }
        let nombre = match r.get_str("name") {
            Ok(v) => v,
            Err(_) => "",
        }
        let activo = match r.get_bool("activo") {
            Ok(v) => v,
            Err(_) => false,
        }
        let codigo = match r.get_str("activation_code") {
            Ok(v) => v,
            Err(_) => "",
        }
        out.push(AlumnoRow { id: id, nombre: nombre, activo: activo, codigo: codigo })
    }
    return out
}

// ¿El alumno (pid) pertenece a un grado de ESTE maestro? Defensa antes de borrar.
async fn alumno_es_del_maestro(owner_id: Int, pid: Int) -> Bool {
    let conn = match db.connect(db_url()).await {
        Ok(c) => c,
        Err(_) => { return false },
    }
    let rows = match conn.query("SELECT 1 AS x FROM profiles p JOIN grupos g ON p.grupo_id = g.id WHERE p.id = $1 AND g.owner_id = $2 LIMIT 1", [pid, owner_id]).await {
        Ok(r) => r,
        Err(_) => { return false },
    }
    return rows.len() > 0
}

async fn eliminar_alumno(pid: Int) -> Result<Int> {
    let conn = db.connect(db_url()).await?
    return conn.exec("DELETE FROM profiles WHERE id = $1", [pid]).await
}

// Crea N alumnos de una lista de nombres (uno por línea, pegada de una planilla).
// Trim + ignora líneas vacías; maneja CRLF (el \r queda al final y trim lo saca).
// Devuelve cuántos creó.
async fn importar_alumnos(owner_id: Int, grupo_id: Int, texto: Str, grade: Int, modalidad: Str, locale: Str) -> Int {
    let lineas = texto.split("\n")
    let creados = 0
    for l in lineas {
        let nombre = l.trim()
        if (nombre != "") {
            let _ = crear_alumno(owner_id, grupo_id, nombre, grade, modalidad, locale).await
            creados = creados + 1
        }
    }
    return creados
}

// --- Render --------------------------------------------------------------------

// Una fila del listado de grados: nombre + colegio/turno + código + editar.
fn fila_grado(locale: Str, g: Grupo) -> Html {
    let nom = flv(g.nombre)
    let col = flv(g.colegio)
    let tur = flv(g.turno)
    let cod = flv(g.codigo)
    let ed = flv(t(locale, "perfiles.editar"))
    let abrir = flv(t(locale, "grado.abrir"))
    let sep = match g.turno == "" {
        true => "",
        false => " · ",
    }
    return html("""<div class="mh-fam-row">
<span class="mh-fam-nom">{nom}</span>
<span style="color:var(--mh-suave);font-size:.85rem">{col}{sep}{tur} · <code>{cod}</code></span>
<span class="mh-fam-acc"><a class="mh-link" href="/maestro/grado/{g.id}">📂 {abrir}</a> <a class="mh-link" href="/maestro/grado/{g.id}/editar">✏️ {ed}</a></span>
</div>""")
}

fn render_maestro(locale: Str, nombre: Str, grupos: List<Grupo>) -> Html {
    let saludo = flv(t1(locale, "maestro.saludo", nombre))
    let contenido = match grupos.len() == 0 {
        true => html("""<h3>{flv(t(locale, "maestro.sin_grados_titulo"))}</h3>
<p style="color:var(--mh-suave);margin:.2rem 0 1rem">{flv(t(locale, "maestro.sin_grados_texto"))}</p>""").raw,
        false => h_join(grupos.map(fn(g) => fila_grado(locale, g))),
    }
    return html("""<div class="mh-card">
<h2><span aria-hidden="true">👩‍🏫</span> {flv(t(locale, "maestro.titulo"))}</h2>
<p style="font-size:1.1rem;font-weight:800;margin:.2rem 0 0">{saludo}</p>
</div>

<div class="mh-card">
<h2>{flv(t(locale, "maestro.grados_titulo"))}</h2>
{contenido}
<a class="mh-btn sec" href="/maestro/grado/nuevo" style="margin-top:1rem">➕ {flv(t(locale, "maestro.crear_grado"))}</a>
</div>

<form method="POST" action="/logout">
<button class="mh-btn sec" type="submit"><span aria-hidden="true">🚪</span> {flv(t(locale, "nav.salir"))}</button>
</form>""")
}

// Una fila del listado de alumnos de un grado: nombre + estado (acceso activo o
// código de invitación pendiente) + quitar.
fn fila_alumno(locale: Str, a: AlumnoRow, gid: Int) -> Html {
    let nom = flv(a.nombre)
    let estado = match a.activo {
        true => flv(t(locale, "grado.alumno_activo")),
        false => flv(t1(locale, "grado.alumno_codigo", a.codigo)),
    }
    return html("""<div class="mh-fam-row">
<span class="mh-fam-nom">{nom}</span>
<span style="color:var(--mh-suave);font-size:.85rem">{estado}</span>
<span class="mh-fam-acc">
<form method="POST" action="/maestro/alumno/eliminar" style="display:inline">
<input type="hidden" name="pid" value="{a.id}" />
<input type="hidden" name="gid" value="{gid}" />
<button class="mh-link" type="submit" style="background:none;border:0;cursor:pointer;color:var(--mh-verde);padding:0">🗑️ {flv(t(locale, "grado.alumno_quitar"))}</button>
</form>
</span>
</div>""")
}

// Detalle de un grado: datos + código del grado + lista de alumnos + agregar.
fn render_grado(locale: Str, g: Grupo, alumnos: List<AlumnoRow>) -> Html {
    let nom = flv(g.nombre)
    let col = flv(g.colegio)
    let tur = flv(g.turno)
    let cod = flv(g.codigo)
    let sep = match g.turno == "" {
        true => "",
        false => " · ",
    }
    let lista = match alumnos.len() == 0 {
        true => html("""<p style="color:var(--mh-suave)">{flv(t(locale, "grado.sin_alumnos_grado"))}</p>""").raw,
        false => h_join(alumnos.map(fn(a) => fila_alumno(locale, a, g.id))),
    }
    let nom_ph = flv(t(locale, "grado.alumno_nombre_ph"))
    return html("""<div class="mh-card">
<h2>{nom}</h2>
<p style="color:var(--mh-suave);margin:.2rem 0 .6rem">{col}{sep}{tur}</p>
<p style="margin:0 0 1rem"><b>{flv(t(locale, "grado.codigo_grado_label"))}</b> <code style="font-size:1.2rem">{cod}</code></p>
<a class="mh-link" href="/maestro/grado/{g.id}/editar">✏️ {flv(t(locale, "perfiles.editar"))}</a>
</div>

<div class="mh-card">
<h2>{flv(t(locale, "grado.alumnos_titulo"))}</h2>
{lista}
<a class="mh-link" href="/maestro/grado/{g.id}/codigos">🗂️ {flv(t(locale, "grado.ver_codigos"))}</a>
<form method="POST" action="/maestro/alumno/agregar" style="margin-top:1rem">
<input type="hidden" name="gid" value="{g.id}" />
<div class="mh-field">
<label class="mh-label" for="nombre">{flv(t(locale, "grado.alumno_nombre"))}</label>
<input class="mh-input" id="nombre" name="nombre" type="text" placeholder="{nom_ph}" autocomplete="off" required />
</div>
<button class="mh-btn sec" type="submit">➕ {flv(t(locale, "grado.agregar_alumno"))}</button>
</form>
</div>

<div class="mh-card">
<h2>{flv(t(locale, "grado.importar_titulo"))}</h2>
<p style="color:var(--mh-suave);margin:.2rem 0 .6rem">{flv(t(locale, "grado.importar_hint"))}</p>
<form method="POST" action="/maestro/alumno/importar">
<input type="hidden" name="gid" value="{g.id}" />
<div class="mh-field">
<textarea class="mh-input" name="lista" rows="6" style="resize:vertical;font-family:inherit"></textarea>
</div>
<button class="mh-btn sec" type="submit">📋 {flv(t(locale, "grado.importar_btn"))}</button>
</form>
</div>

<a class="mh-link" href="/maestro">{flv(t(locale, "maestro.volver_panel"))}</a>""")
}

// Hoja de códigos de acceso del grado (imprimible): un renglón por alumno con su
// código de invitación (o "ya activó"). El maestro la imprime (Ctrl+P) y reparte.
fn fila_codigo(locale: Str, a: AlumnoRow) -> Html {
    let nom = flv(a.nombre)
    let val = match a.activo {
        true => flv(t(locale, "codigos.activo")),
        false => flv(a.codigo),
    }
    return html("""<div class="mh-fam-row"><span class="mh-fam-nom">{nom}</span><span style="font-size:1.2rem;font-weight:800"><code>{val}</code></span></div>""")
}

fn render_codigos(locale: Str, g: Grupo, alumnos: List<AlumnoRow>) -> Html {
    let filas = match alumnos.len() == 0 {
        true => html("""<p style="color:var(--mh-suave)">{flv(t(locale, "grado.sin_alumnos_grado"))}</p>""").raw,
        false => h_join(alumnos.map(fn(a) => fila_codigo(locale, a))),
    }
    return html("""<div class="mh-card">
<h2>🗂️ {flv(t(locale, "codigos.titulo"))} — {flv(g.nombre)}</h2>
<p style="color:var(--mh-suave);margin:.2rem 0 .6rem">{flv(t(locale, "codigos.intro"))}</p>
<p style="margin:0 0 1rem"><b>{flv(t1(locale, "codigos.codigo_grado", g.codigo))}</b></p>
{filas}
</div>
<a class="mh-link" href="/maestro/grado/{g.id}">{flv(t(locale, "codigos.volver_grado"))}</a>""")
}

// Form de crear/editar un grado. `es_editar` decide acción, pre-selección y el
// botón de eliminar. Para "nuevo", `g` es un Grupo con defaults.
fn form_grado(locale: Str, g: Grupo, es_editar: Bool, error_key: Str) -> Html {
    let err = match error_key == "" {
        true => "",
        false => html("""<div class="mh-error">{flv(t(locale, error_key))}</div>""").raw,
    }
    let titulo = match es_editar {
        true => flv(t(locale, "maestro.grado_editar")),
        false => flv(t(locale, "maestro.grado_nuevo")),
    }
    let action = match es_editar {
        true => "/maestro/grado/editar",
        false => "/maestro/grado/nuevo",
    }
    let gid_hidden = match es_editar {
        true => html("""<input type="hidden" name="gid" value="{g.id}" />""").raw,
        false => "",
    }
    let opciones = match es_editar {
        true => opciones_grado_sel(locale, g.grade),
        false => opciones_grado(locale),
    }
    let mod_ops = opciones_modalidad_sel(locale, g.modalidad)
    let col = flv(g.colegio)
    let tur = flv(g.turno)
    let nom = flv(g.nombre)
    let col_ph = flv(t(locale, "grado.colegio_ph"))
    let tur_ph = flv(t(locale, "grado.turno_ph"))
    let nom_ph = flv(t(locale, "grado.nombre_ph"))
    let eliminar = match es_editar {
        true => html("""<form method="POST" action="/maestro/grado/eliminar" style="margin-top:.6rem">
<input type="hidden" name="gid" value="{g.id}" />
<button class="mh-btn sec" type="submit"><span aria-hidden="true">🗑️</span> {flv(t(locale, "grado.eliminar"))}</button>
</form>""").raw,
        false => "",
    }
    return html("""<div class="mh-card">
<h2>{titulo}</h2>
{err}
<form method="POST" action="{action}">
{gid_hidden}
<div class="mh-field">
<label class="mh-label" for="colegio">{flv(t(locale, "grado.colegio"))}</label>
<input class="mh-input" id="colegio" name="colegio" type="text" value="{col}" placeholder="{col_ph}" autocomplete="off" />
</div>
<div class="mh-field">
<label class="mh-label" for="turno">{flv(t(locale, "grado.turno"))}</label>
<input class="mh-input" id="turno" name="turno" type="text" value="{tur}" placeholder="{tur_ph}" autocomplete="off" />
</div>
<div class="mh-field">
<label class="mh-label" for="nombre">{flv(t(locale, "grado.nombre"))}</label>
<input class="mh-input" id="nombre" name="nombre" type="text" value="{nom}" placeholder="{nom_ph}" autocomplete="off" required />
</div>
<div class="mh-field">
<label class="mh-label" for="grado">{flv(t(locale, "perfiles.grado"))}</label>
<select class="mh-select" id="grado" name="grado">
{opciones}
</select>
</div>
<div class="mh-field">
<label class="mh-label" for="modalidad">{flv(t(locale, "perfiles.modalidad"))}</label>
<select class="mh-select" id="modalidad" name="modalidad">
{mod_ops}
</select>
<span class="mh-hint">{flv(t(locale, "perfiles.modalidad_hint"))}</span>
</div>
<button class="mh-btn" type="submit">{flv(t(locale, "grado.crear"))}</button>
</form>
{eliminar}
<a class="mh-link" href="/maestro">{flv(t(locale, "maestro.volver_panel"))}</a>
</div>""")
}

// --- Tipos de form -------------------------------------------------------------

type GradoForm {
    gid: Str = ""
    colegio: Str = ""
    turno: Str = ""
    nombre: Str = ""
    grado: Str = ""
    modalidad: Str = "comun"
}

type AlumnoForm {
    gid: Str = ""
    nombre: Str = ""
}

type AlumnoDelForm {
    pid: Str = ""
    gid: Str = ""
}

type ImportForm {
    gid: Str = ""
    lista: Str = ""
}

// --- Handlers ------------------------------------------------------------------

// /maestro → panel del maestro: saludo + listado de grados + crear. Requiere
// sesión + cuenta de maestro (si no, a /).
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/maestro")
async fn maestro_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return redirect_a("/login"),
    }
    if (not es_teacher(fam.email).await) {
        return redirect_a("/")
    }
    let grupos: List<Grupo> = match grupos_de(fam.id).await {
        Ok(gs) => gs,
        Err(_) => [],
    }
    let titulo = t(locale, "maestro.titulo") + " — MatHelp"
    return responder_html(page(locale, titulo, render_maestro(locale, fam.display_name, grupos), html("")))
}

// /maestro/grado/nuevo (GET) → form de crear grado.
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/maestro/grado/nuevo")
async fn grado_nuevo_get(session: Str?, lang: Str?) -> Response {
    let locale = locale_from_cookie(lang)
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return redirect_a("/login"),
    }
    if (not es_teacher(fam.email).await) {
        return redirect_a("/")
    }
    return responder_html(page(locale, t(locale, "maestro.grado_nuevo") + " — MatHelp", form_grado(locale, Grupo {}, false, ""), html("")))
}

// /maestro/grado/nuevo (POST) → crea el grado y vuelve al panel.
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@post("/maestro/grado/nuevo")
async fn grado_nuevo_post(session: Str?, lang: Str?, form: GradoForm) -> Response {
    let locale = locale_from_cookie(lang)
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return redirect_a("/login"),
    }
    if (not es_teacher(fam.email).await) {
        return redirect_a("/")
    }
    let titulo = t(locale, "maestro.grado_nuevo") + " — MatHelp"
    if (form.nombre == "") {
        let g = Grupo { colegio: form.colegio, turno: form.turno, nombre: form.nombre, modalidad: form.modalidad }
        return responder_html(page(locale, titulo, form_grado(locale, g, false, "grado.error_nombre"), html("")))
    }
    let grado: Int = match form.grado.to_int() {
        Ok(n) => n,
        Err(_) => 1,
    }
    let _ = crear_grupo(fam.id, form.colegio, form.turno, form.nombre, grado, form.modalidad).await
    return redirect_a("/maestro")
}

// /maestro/grado/{id}/editar (GET) → form de editar grado.
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/maestro/grado/{id}/editar")
async fn grado_editar_get(session: Str?, lang: Str?, id: Int) -> Response {
    let locale = locale_from_cookie(lang)
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return redirect_a("/login"),
    }
    if (not es_teacher(fam.email).await) {
        return redirect_a("/")
    }
    let g = match grupo_de_maestro(fam.id, id).await {
        Ok(gr) => gr,
        Err(_) => return redirect_a("/maestro"),
    }
    return responder_html(page(locale, t(locale, "maestro.grado_editar") + " — MatHelp", form_grado(locale, g, true, ""), html("")))
}

// /maestro/grado/editar (POST) → guarda los cambios del grado.
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@post("/maestro/grado/editar")
async fn grado_editar_post(session: Str?, lang: Str?, form: GradoForm) -> Response {
    let locale = locale_from_cookie(lang)
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return redirect_a("/login"),
    }
    if (not es_teacher(fam.email).await) {
        return redirect_a("/")
    }
    let gid: Int = match form.gid.to_int() {
        Ok(n) => n,
        Err(_) => return redirect_a("/maestro"),
    }
    let g = match grupo_de_maestro(fam.id, gid).await {
        Ok(gr) => gr,
        Err(_) => return redirect_a("/maestro"),
    }
    if (form.nombre == "") {
        return responder_html(page(locale, t(locale, "maestro.grado_editar") + " — MatHelp", form_grado(locale, g, true, "grado.error_nombre"), html("")))
    }
    let grado: Int = match form.grado.to_int() {
        Ok(n) => n,
        Err(_) => 1,
    }
    let _ = actualizar_grupo(fam.id, gid, form.colegio, form.turno, form.nombre, grado, form.modalidad).await
    return redirect_a("/maestro")
}

// /maestro/grado/eliminar (POST) → elimina el grado (alumnos quedan sin grado).
@cookie(name="mathelp_session", into="session")
@post("/maestro/grado/eliminar")
async fn grado_eliminar_post(session: Str?, form: GradoForm) -> Response {
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return redirect_a("/login"),
    }
    if (not es_teacher(fam.email).await) {
        return redirect_a("/")
    }
    let gid: Int = match form.gid.to_int() {
        Ok(n) => n,
        Err(_) => return redirect_a("/maestro"),
    }
    let _ = eliminar_grupo(fam.id, gid).await
    return redirect_a("/maestro")
}

// /maestro/grado/{id} → detalle del grado: datos + código + alumnos + agregar.
@cookie(name="mathelp_session", into="session")
@cookie(name="mathelp_lang", into="lang")
@get("/maestro/grado/{id}")
async fn grado_detalle(session: Str?, lang: Str?, id: Int) -> Response {
    let locale = locale_from_cookie(lang)
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return redirect_a("/login"),
    }
    if (not es_teacher(fam.email).await) {
        return redirect_a("/")
    }
    let g = match grupo_de_maestro(fam.id, id).await {
        Ok(gr) => gr,
        Err(_) => return redirect_a("/maestro"),
    }
    let alumnos = alumnos_de_grupo(id).await
    return responder_html(page(locale, g.nombre + " — MatHelp", render_grado(locale, g, alumnos), html("")))
}

// /maestro/alumno/agregar (POST) → agrega un alumno a un grado (con código de
// invitación). Vuelve al detalle del grado.
@cookie(name="mathelp_session", into="session")
@post("/maestro/alumno/agregar")
async fn alumno_add(session: Str?, form: AlumnoForm) -> Response {
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return redirect_a("/login"),
    }
    if (not es_teacher(fam.email).await) {
        return redirect_a("/")
    }
    let gid: Int = match form.gid.to_int() {
        Ok(n) => n,
        Err(_) => return redirect_a("/maestro"),
    }
    let g = match grupo_de_maestro(fam.id, gid).await {
        Ok(gr) => gr,
        Err(_) => return redirect_a("/maestro"),
    }
    if (form.nombre != "") {
        let _ = crear_alumno(fam.id, gid, form.nombre, g.grade, g.modalidad, fam.locale).await
    }
    return redirect_a("/maestro/grado/{gid}")
}

// /maestro/alumno/eliminar (POST) → quita un alumno (defensa: debe pertenecer a un
// grado de este maestro). Vuelve al detalle del grado (gid del form).
@cookie(name="mathelp_session", into="session")
@post("/maestro/alumno/eliminar")
async fn alumno_del(session: Str?, form: AlumnoDelForm) -> Response {
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return redirect_a("/login"),
    }
    if (not es_teacher(fam.email).await) {
        return redirect_a("/")
    }
    let pid: Int = match form.pid.to_int() {
        Ok(n) => n,
        Err(_) => return redirect_a("/maestro"),
    }
    if (not alumno_es_del_maestro(fam.id, pid).await) {
        return redirect_a("/maestro")
    }
    let _ = eliminar_alumno(pid).await
    return redirect_a("/maestro/grado/{form.gid}")
}

// /maestro/alumno/importar (POST) → crea varios alumnos de la lista pegada
// (uno por línea). Vuelve al detalle del grado.
@cookie(name="mathelp_session", into="session")
@post("/maestro/alumno/importar")
async fn alumno_importar(session: Str?, form: ImportForm) -> Response {
    let fam = match read_session(session).await {
        Ok(f) => f,
        Err(_) => return redirect_a("/login"),
    }
    if (not es_teacher(fam.email).await) {
        return redirect_a("/")
    }
    let gid: Int = match form.gid.to_int() {
        Ok(n) => n,
        Err(_) => return redirect_a("/maestro"),
    }
    let g = match grupo_de_maestro(fam.id, gid).await {
        Ok(gr) => gr,
        Err(_) => return redirect_a("/maestro"),
    }
    let _ = importar_alumnos(fam.id, gid, form.lista, g.grade, g.modalidad, fam.locale).await
    return redirect_a("/maestro/grado/{gid}")
}

