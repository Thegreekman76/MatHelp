// Estimar.fitzv — "Estimación" como LiveComponent SSR.
//
// Redondear (exacto) o estimar el resultado de una cuenta grande (se acepta un
// rango: |given − answer| ≤ tol). El chico TIPEA la respuesta en un teclado
// numérico (sin ±). Ronda fija de N, sin reloj. El item se deriva de (seed, idx,
// grade) — el server re-deriva el mismo y compara con la misma tolerancia.
//
// Tres eventos: digito()/borrar()/answer(). La persistencia (Attempt + mastery +
// racha) la hace el loop del @ws en live_estimar.fitz.

from gen_estimar import gen_estimar
from keypad import kp_append, kp_borrar
from engine import a_int
from estimar_view import estimar_screen

component estimar {
  state {
    seed: Int = 0
    idx: Int = 0
    grade: Int = 3
    locale: Str = "es-AR"
    correct: Int = 0
    total: Int = 0
    racha: Int = 0
    racha_max: Int = 0
    record_prev: Int = 999999
    phase: Str = "playing"         // "playing" | "done"
    feedback: Str = ""             // "" | "ok" | "bad"
    last_answer: Int = 0           // la respuesta correcta del item recién fallado
    entrada: Int = 0               // lo tipeado
    touched: Bool = false          // ¿tipeó algo?
    limit: Int = 10                // items por ronda
  }

  event digito() {
    if (phase == "playing") {
      if (payload.has("d")) {
        entrada = kp_append(entrada, a_int(payload["d"]), 999999)
        touched = true
      }
    }
  }

  event borrar() {
    if (phase == "playing") {
      entrada = kp_borrar(entrada)
    }
  }

  event answer() {
    if (phase == "playing") {
      if (payload.has("v")) {
        if (payload.has("ei")) {
          let ei = a_int(payload["ei"])
          if (ei == idx) {
            let given = a_int(payload["v"])
            if (touched) {
              let it = gen_estimar(seed, idx, grade)
              // |given − answer| ≤ tol  (tol=0 en redondeo → exacto)
              let dif = given - it.answer
              if (dif < 0) {
                dif = 0 - dif
              }
              let acierto = dif <= it.tol
              total = total + 1
              if (acierto) {
                correct = correct + 1
                feedback = "ok"
                racha = racha + 1
                if (racha > racha_max) {
                  racha_max = racha
                }
              }
              if (not acierto) {
                feedback = "bad"
                racha = 0
                last_answer = it.answer
              }
              entrada = 0
              touched = false
              idx = idx + 1
              if (total >= limit) {
                phase = "done"
              }
            }
          }
        }
      }
    }
  }

  <template>
    <div id="estimar-app" class="mh-quiz">
      {estimar_screen(seed, idx, grade, locale, correct, total, limit, phase, feedback, last_answer, entrada, touched, racha, racha_max, record_prev).raw}
    </div>
  </template>
}
