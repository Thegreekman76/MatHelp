// models.fitz — los @table del dominio.
//
// F1 modela SOLO las dos tablas de auth: `Family` (la cuenta que
// administra el padre/madre) y `Profile` (cada hijo/a). Las otras cinco
// tablas del esquema (sessions, attempts, mastery, awards, streaks) se
// agregan cuando F2/F3 las usen — modelar de más es superficie de bug del
// codegen ORM sin ganancia.
//
// **Sin relaciones ORM (@has_many/@belongs_to) todavía.** F1 consulta con
// `.where(fn(p) => p.family_id == fid)`, no con navigation methods ni
// `.preload()`. Los campos crudos (`family_id: Int`) alcanzan. El CASCADE
// real ya está en `migrations/0001_init.sql` (REFERENCES ... ON DELETE
// CASCADE) — el @belongs_to solo afecta el codegen del ORM de Fitz, no el
// esquema. Las relaciones se suman cuando F5 (panel del padre) las pida.
//
// **El esquema hoy lo crea Postgres** (docker-entrypoint-initdb.d con
// 0001_init.sql), no `fitz db migrate` — por eso estos @table deben
// matchear exactamente las columnas de esa migración. Deuda declarada en
// docs/PLAN.md: F1 todavía no cierra el paso a `fitz db diff`.

// La cuenta de la familia: la que administra el padre o la madre.
@table("families")
type Family {
    @primary id: Int = 0
    email: Str = ""
    // @hidden: no se serializa a JSON ni se acepta como body del cliente;
    // sí persiste. Lo populamos con hash.password(...) en el registro y lo
    // leemos con hash.verify(...) en el login.
    @hidden password_hash: Str = ""
    display_name: Str = ""
    locale: Str = "es-AR"
    // @db_default: el ORM lo omite del INSERT y Postgres lo llena (NOW()).
    @db_default created_at: Str = ""
}

// Un perfil por hijo/a.
@table("profiles")
type Profile {
    @primary id: Int = 0
    family_id: Int = 0
    name: Str = ""
    avatar: Str = "mate"          // clave de avatar SVG inline
    birth_year: Int = 0           // la edad se deriva: nunca queda vieja
    grade: Int = 0                // 1..7 primaria; 8..13 = 1°..6° secundaria (F7)
    modalidad: Str = "comun"      // F7: "comun" | "bachiller" | "comercial" | "industrial"
                                  // solo aplica en el Ciclo Orientado (grade 11..13)
    locale: Str = "es-AR"
    // @hidden: el PIN nunca viaja al cliente. Opcional, 4 dígitos, para que
    // los hermanos no se metan en el perfil del otro.
    @hidden pin: Str = ""
    daily_goal: Int = 10          // ejercicios/día
    theme: Str = "default"        // tema de color del perfil (F9 pulido)
    @db_default created_at: Str = ""
}

// --- F2: partida y respuestas -----------------------------------------------
//
// Una partida (`GameSession`) se abre al conectar el socket y se cierra cuando
// se agota el reloj: guardamos el `seed`, así con seed + índice se reconstruye
// la partida entera (el panel del padre podrá "rejugarla" en F5). Cada respuesta
// (`Attempt`) se persiste APENAS ocurre — la memoria del componente es caché
// descartable, la base es la fuente de verdad (docs/PLAN.md §1.2 ⑦). Columnas
// espejadas 1:1 con migrations/0001_init.sql (sessions / attempts).

@table("sessions")
type GameSession {
    @primary id: Int = 0
    profile_id: Int = 0
    mode: Str = ""                // "quiz" para el contrarreloj (CHECK en el SQL)
    topic_code: Str = ""
    level: Int = 1
    seed: Int = 0                 // reconstruye la partida entera
    @db_default started_at: Str = ""
    ended_at: Str? = null         // nullable; F2 no lo setea (deuda menor)
    total: Int = 0
    correct: Int = 0
    score: Int = 0
    duration_ms: Int = 0
}

// --- F3: motor adaptativo ---------------------------------------------------
//
// `mastery` es lo que mueve el motor: un rating Elo-lite por (perfil, destreza).
// Columnas espejadas 1:1 con migrations/0001_init.sql (UNIQUE (profile_id,
// skill_code)). El upsert por respuesta y las lecturas del progreso NO usan el
// ORM: van por SQL crudo (conn.exec ... ON CONFLICT / conn.query) en
// mastery.fitz — el ORM de Fitz no tiene upsert nativo, y ON CONFLICT en un
// solo statement es atómico y race-safe (docs/db-orm.md). Este @table queda
// como documentación del esquema y para lecturas ORM futuras (F5).
@table("mastery")
type Mastery {
    @primary id: Int = 0
    profile_id: Int = 0
    skill_code: Str = ""              // "add" | "sub" | "mul.tabla" | "div.exacta"
    rating: Float = 800.0             // Elo-lite del chico en esa destreza
    seen: Int = 0
    hits: Int = 0
    streak: Int = 0                   // aciertos SEGUIDOS (repaso espaciado)
    avg_ms: Int = 0
    last_seen_at: Str? = null
    due_at: Str? = null               // cuándo toca repasar (NOW() + N días)
}

@table("attempts")
type Attempt {
    @primary id: Int = 0
    session_id: Int = 0
    profile_id: Int = 0
    skill_code: Str = ""          // "add" | "sub" | "mul.tabla" | "div.exacta"
    idx: Int = 0                  // índice dentro del seed (reproduce el ejercicio)
    prompt: Str = ""              // texto canónico "7 × 8", para el reporte del padre
    expected: Str = ""
    given: Str = ""
    correct: Bool = false
    ms: Int = 0
    difficulty: Int = 1
    @db_default created_at: Str = ""
}

// Racha diaria: una fila por (perfil, día). Se incrementa `exercises` con cada
// respuesta; `goal_met` se marca cuando llega a la meta del perfil (daily_goal).
// La racha "de N días seguidos" se calcula caminando estas filas hacia atrás
// (streaks.fitz). `day` como Str (Postgres DATE ↔ 'YYYY-MM-DD') — el I/O es SQL
// crudo, este @table documenta el esquema (UNIQUE (profile_id, day)).
@table("streaks")
type Streak {
    @primary id: Int = 0
    profile_id: Int = 0
    day: Str = ""
    exercises: Int = 0
    goal_met: Bool = false
}

// Medallas por dominio real (no por tiempo de pantalla): "primer_mate",
// "racha7", etc. Se otorgan con INSERT ... ON CONFLICT DO NOTHING (idempotente,
// UNIQUE (profile_id, code)). `earned_at` lo llena Postgres (NOW()).
@table("awards")
type Award {
    @primary id: Int = 0
    profile_id: Int = 0
    code: Str = ""
    @db_default earned_at: Str = ""
}
