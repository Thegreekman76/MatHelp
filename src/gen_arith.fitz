// gen_arith.fitz — generadores deterministas de las cuatro operaciones.
//
// El corazón de F2. Cada ejercicio es reproducible desde (seed, idx): un
// generador propio `rand.seeded(sub_seed(seed, idx))` produce SIEMPRE el mismo
// ejercicio para el mismo par, en `fitz run` y en `fitz build`. Guardando el
// seed de la partida + el índice de la respuesta, el panel del padre (F5) puede
// "rejugar" exactamente lo que vio el chico — no hace falta guardar cada
// enunciado, alcanzan dos enteros (docs/PLAN.md §1.2 ①).
//
// **Números crudos, formateo aparte.** El Exercise lleva los operandos y las
// opciones como `Int`; el formateo por locale (num.format) lo hace la capa de
// render. Por eso acá no hay una sola llamada a `num.*`.
//
// **El RandGen no cruza límites de función.** El módulo nativo `rand` (FITZ-01)
// tipa `rand.seeded()` como `Any`: `RandGen` no es un tipo nombrable, así que
// no se puede anotar un parámetro `g: RandGen` (el checker no lo conoce) ni
// dejarlo sin anotar (el codegen no lo infiere → `fitz build` falla). Por eso
// TODAS las tiradas (`g.int` / `g.shuffle`) viven dentro de `gen` / `gen_mix`,
// con `g` como var local; los helpers son puros (operan sobre enteros ya
// tirados). Ver la ficha FITZ-01 en el backlog del core (extensión de la
// limitación "el receptor de un RandGen debe ser una var local").

// Un ejercicio de opción múltiple: `a op b = answer`, con 4 opciones (la
// correcta + 3 distractores), barajadas de forma determinista.
type Exercise {
    a: Int = 0
    b: Int = 0
    op: Str = ""              // "add" | "sub" | "mul" | "div"
    answer: Int = 0
    options: List<Int> = []   // 4 valores distintos, uno es `answer`
    skill_code: Str = ""      // "add" | "sub" | "mul.tabla" | "div.exacta"
    difficulty: Int = 1       // 1..5, para el motor adaptativo (F3)
}

// --- Semilla por ejercicio ---------------------------------------------------

// Deriva un seed propio para el ejercicio `idx` de la partida `seed`. Como
// `rand.seeded` pasa el número por SplitMix64 (buena avalancha), aun sub-seeds
// vecinos decorrelacionan bien. 7919 es primo; con idx acotado (una partida son
// decenas de respuestas) no hay overflow de i64.
fn sub_seed(seed: Int, idx: Int) -> Int {
    return seed + idx * 7919
}

// --- Rangos y metadatos por grado (puros) ------------------------------------

// Operando máximo para suma/resta según el grado (1º..7º primaria).
fn add_max(grade: Int) -> Int {
    if (grade <= 1) {
        return 10
    }
    if (grade == 2) {
        return 20
    }
    if (grade == 3) {
        return 100
    }
    if (grade <= 5) {
        return 500
    }
    return 1000
}

// Factor máximo para multiplicación/división (tablas). Grado 3 cierra las tablas
// hasta 10; de 4º en adelante llega a 12.
fn mul_max(grade: Int) -> Int {
    if (grade <= 2) {
        return 5
    }
    if (grade == 3) {
        return 10
    }
    return 12
}

// Dificultad 1..5 a partir de la operación + el grado. Aproximada; el motor
// adaptativo de F3 la afina.
fn difficulty_for(op: Str, grade: Int) -> Int {
    let base = match op {
        "add" => 1,
        "sub" => 2,
        "mul" => 3,
        "div" => 4,
        _ => 1,
    }
    let d = base + grade / 3
    if (d < 1) {
        return 1
    }
    if (d > 5) {
        return 5
    }
    return d
}

// Operaciones disponibles por grado. 1º solo suma/resta; 2º suma la
// multiplicación fácil; 3º en adelante, las cuatro.
fn ops_for_grade(grade: Int) -> List<Str> {
    if (grade <= 1) {
        return ["add", "sub"]
    }
    if (grade == 2) {
        return ["add", "sub", "mul"]
    }
    return ["add", "sub", "mul", "div"]
}

// Símbolo visible de la operación. Universal en ambos locales (÷ y × se usan
// igual en es-AR y en); el "−" es el menos tipográfico (U+2212).
fn op_symbol(op: Str) -> Str {
    return match op {
        "add" => "+",
        "sub" => "−",
        "mul" => "×",
        "div" => "÷",
        _ => "?",
    }
}

fn imax(x: Int, y: Int) -> Int {
    if (x >= y) {
        return x
    }
    return y
}

fn imin(x: Int, y: Int) -> Int {
    if (x >= y) {
        return y
    }
    return x
}

fn iclamp(x: Int, lo: Int, hi: Int) -> Int {
    return imin(imax(x, lo), hi)
}

// El skill code lleva la operación adentro; `op` es el corto para el símbolo.
fn skill_a_op(skill: Str) -> Str {
    return match skill {
        "add" => "add",
        "sub" => "sub",
        "mul.tabla" => "mul",
        "div.exacta" => "div",
        _ => "add",
    }
}

// --- Distractores (puros, sin RandGen) ---------------------------------------

// Pool de candidatos a opción incorrecta. Los offsets son un conjunto fijo de
// valores distintos: como `answer` es fijo, `answer + o` con offsets distintos
// da valores distintos, así que el pool filtrado (>= 0, != answer) es
// automáticamente sin repetidos. Los 5 offsets positivos garantizan >= 3
// candidatos aun si todos los negativos se filtran (answer chico). El barajado y
// el recorte a 3 los hace el generador (con su `g` local).
fn candidatos(answer: Int) -> List<Int> {
    let offsets = [1, 2, 3, 5, 10, -1, -2, -3, -5, -10]
    let out: List<Int> = []
    for o in offsets {
        let v = answer + o
        if (v >= 0 and v != answer) {
            out.push(v)
        }
    }
    return out
}

// Primeros 3 elementos de una lista (ya barajada).
fn take3(xs: List<Int>) -> List<Int> {
    let out: List<Int> = []
    for x in xs {
        if (out.len() < 3) {
            out.push(x)
        }
    }
    return out
}

// --- API pública -------------------------------------------------------------

// Genera un ejercicio de una operación fija. Reproducible desde (seed, idx).
// Todo el uso del RandGen `g` vive acá (local): operandos con `g.int`, opciones
// con `g.shuffle` — nunca se pasa `g` a otra función.
fn gen(op: Str, seed: Int, idx: Int, grade: Int) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    let a = 0
    let b = 0
    let answer = 0
    let skill = "add"
    if (op == "sub") {
        let hi = add_max(grade)
        let x = g.int(1, hi)
        let y = g.int(1, hi)
        a = imax(x, y)
        b = imin(x, y)
        answer = a - b
        skill = "sub"
    }
    if (op == "mul") {
        let hi = mul_max(grade)
        a = g.int(2, hi)
        b = g.int(2, hi)
        answer = a * b
        skill = "mul.tabla"
    }
    if (op == "div") {
        let hi = mul_max(grade)
        let d = g.int(2, hi)      // divisor
        let q = g.int(2, hi)      // cociente (la respuesta)
        a = d * q                 // dividendo
        b = d
        answer = q
        skill = "div.exacta"
    }
    // "add" es el caso por defecto (op == "add" o cualquier valor no reconocido:
    // el juego solo pasa las cuatro operaciones válidas).
    if (skill == "add") {
        let hi = add_max(grade)
        a = g.int(1, hi)
        b = g.int(1, hi)
        answer = a + b
    }
    // Opciones: correcta + 3 distractores, barajadas con el mismo g.
    let cands = candidatos(answer)
    let distractors = take3(g.shuffle(cands))
    let raw = [answer]
    for dd in distractors {
        raw.push(dd)
    }
    let options = g.shuffle(raw)
    let opc = skill_a_op(skill)
    return Exercise {
        a: a,
        b: b,
        op: opc,
        answer: answer,
        options: options,
        skill_code: skill,
        difficulty: difficulty_for(opc, grade),
    }
}

// Genera un ejercicio mezclando las operaciones apropiadas al grado. Elige la
// operación con un generador propio (determinista desde el seed) y delega en
// `gen`. (seed, idx, grade) devuelve siempre el mismo ejercicio.
fn gen_mix(seed: Int, idx: Int, grade: Int) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    let ops = ops_for_grade(grade)
    let oi = g.int(0, ops.len() - 1)
    let op = ops[oi]
    return gen(op, seed, idx, grade)
}

// --- Práctica libre (F3): topic fijo + banda de dificultad -------------------

// Grado efectivo según la banda de dificultad de Práctica libre
// (1=fácil, 2=medio, 3=difícil). La banda desplaza el rango del generador un
// grado abajo/arriba, con clamp 1..7. Banda 2 (medio) = el grado del perfil.
fn grade_for_band(grade: Int, band: Int) -> Int {
    let g = grade + band - 2
    if (g < 1) {
        return 1
    }
    if (g > 7) {
        return 7
    }
    return g
}

// Generador UNIFICADO: lo usan tanto el render (quiz_view) como el scoring
// (Quiz.fitzv). Que sea uno solo es la garantía de que el ejercicio mostrado y
// el corregido coinciden. Los `r_*` son el snapshot de mastery (ratings por
// operación); solo el modo adaptativo los usa.
//   - modo "adaptive" (contrarreloj / desafío): selección 70/20/10 por rating.
//   - modo "practice": tema fijo ("add"|"sub"|"mul"|"div"|"mix") con banda.
//   - modo "timed": gen_mix al grado del perfil — bit-a-bit como antes (paridad
//     del juego previo a F3; lo mantiene por si se quiere un contrarreloj no
//     adaptativo, y para los tests de paridad de generadores).
fn gen_for(mode: Str, topic: Str, band: Int, seed: Int, idx: Int, grade: Int, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Exercise {
    if (mode == "adaptive" or mode == "desafio") {
        // El contrarreloj (adaptive) y el Desafío del día (desafio) comparten la
        // selección 70/20/10 por rating; difieren en el corte (reloj vs N fijo).
        return gen_adaptive(seed, idx, grade, r_add, r_sub, r_mul, r_div)
    }
    if (mode == "practice") {
        let eg = grade_for_band(grade, band)
        if (topic == "mix") {
            return gen_mix(seed, idx, eg)
        }
        return gen(topic, seed, idx, eg)
    }
    return gen_mix(seed, idx, grade)
}

// --- Selección adaptativa (F3, §7) -------------------------------------------
//
// El motor sirve el próximo ejercicio según el rating Elo-lite del chico en cada
// operación (el "snapshot" de mastery, congelado al abrir la partida). Regla
// 70/20/10: 70% en la zona de desarrollo próximo (una operación al azar, a su
// grado efectivo), 20% repaso (la operación MÁS floja — la que más necesita
// práctica), 10% desafío (una operación al azar, un grado más difícil).
// Determinista desde (seed, idx, snapshot): render, scoring y persistencia
// derivan el MISMO ejercicio. Reproducible dentro de la sesión; entre sesiones
// el snapshot evoluciona → la dificultad se acomoda al chico.

// Grado efectivo del generador según el rating de una destreza. El rating
// arranca en 800 al grado del perfil; a medida que sube, corre el grado hacia
// arriba (rangos más grandes) y hacia abajo si baja — la dificultad SIGUE al
// rating (§11). 800→sin cambio, 1000→+1, 1200→+2, 600→−1. Clamp del corrimiento
// a ±3 y del grado final a 1..7 (primaria).
fn grado_efectivo(grado_perfil: Int, rating: Float) -> Int {
    let delta = round((rating - 800.0) / 200.0)
    let d = iclamp(delta, -3, 3)
    return iclamp(grado_perfil + d, 1, 7)
}

// Rating de una operación en el snapshot (por nombre corto "add"/"sub"/"mul"/"div").
fn rating_op(op: Str, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Float {
    return match op {
        "add" => r_add,
        "sub" => r_sub,
        "mul" => r_mul,
        "div" => r_div,
        _ => r_add,
    }
}

// La operación con MENOR rating entre las disponibles (la que más necesita
// repaso). Empates → la primera en `ops` (determinista). El repaso "real" por
// due_at vencido vive en la capa de DB (Desafío/selección de sesión, F3); acá,
// dentro del contrarreloj, la más floja es la mejor proxy sin timestamps.
fn op_mas_floja(ops: List<Str>, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Str {
    let mejor = ops[0]
    let mejor_r = rating_op(mejor, r_add, r_sub, r_mul, r_div)
    for op in ops {
        let r = rating_op(op, r_add, r_sub, r_mul, r_div)
        if (r < mejor_r) {
            mejor = op
            mejor_r = r
        }
    }
    return mejor
}

// Genera el próximo ejercicio adaptativo. `r_*` son los ratings por operación
// (800 si el chico nunca la vio). Determinista desde (seed, idx): el mismo
// (seed, idx, ratings) da SIEMPRE el mismo ejercicio.
fn gen_adaptive(seed: Int, idx: Int, grade: Int, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    let ops = ops_for_grade(grade)
    let roll = g.int(0, 99)
    let op = "add"
    let eff = grade
    if (roll < 70) {
        // 70% zona de desarrollo próximo: una op al azar, a su grado efectivo.
        let oi = g.int(0, ops.len() - 1)
        op = ops[oi]
        eff = grado_efectivo(grade, rating_op(op, r_add, r_sub, r_mul, r_div))
    }
    if (roll >= 70 and roll < 90) {
        // 20% repaso: la op más floja, a su grado efectivo.
        op = op_mas_floja(ops, r_add, r_sub, r_mul, r_div)
        eff = grado_efectivo(grade, rating_op(op, r_add, r_sub, r_mul, r_div))
    }
    if (roll >= 90) {
        // 10% desafío: una op al azar, un grado más difícil.
        let oi = g.int(0, ops.len() - 1)
        op = ops[oi]
        eff = iclamp(grado_efectivo(grade, rating_op(op, r_add, r_sub, r_mul, r_div)) + 1, 1, 7)
    }
    // gen re-seedea con el MISMO sub_seed → operandos deterministas para `eff`.
    return gen(op, seed, idx, eff)
}

// Temas de práctica disponibles según el grado: las operaciones del grado más
// "mix" (mezcla). `ops_for_grade` devuelve un literal fresco, así que el push no
// alias-ea la lista de nadie.
fn temas_practica(grade: Int) -> List<Str> {
    let out = ops_for_grade(grade)
    out.push("mix")
    return out
}

// ¿El tema `topic` es válido para el grado? (guarda de las rutas de práctica.)
fn tema_valido(topic: Str, grade: Int) -> Bool {
    for tp in temas_practica(grade) {
        if (tp == topic) {
            return true
        }
    }
    return false
}
