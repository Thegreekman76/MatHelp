// gen_arith.fitz — generadores deterministas de las cuatro operaciones.
//
// El corazón de F2. Cada ejercicio es reproducible desde (seed, idx): un
// generador propio `rand.seeded(sub_seed(seed, idx))` produce SIEMPRE el mismo
// ejercicio para el mismo par, en `fitz run` y en `fitz build`. Guardando el
// seed de la partida + el índice de la respuesta, el panel del padre (F5) puede
// "rejugar" exactamente lo que vio el chico — no hace falta guardar cada
// enunciado, alcanzan dos enteros (docs/PLAN.md §1.2 ①).
//
// **Números crudos, formateo aparte.** El Exercise lleva los operandos y las
// opciones como `Int`; el formateo por locale (num.format) lo hace la capa de
// render. Por eso acá no hay una sola llamada a `num.*`.
//
// **El RandGen no cruza límites de función.** El módulo nativo `rand` (FITZ-01)
// tipa `rand.seeded()` como `Any`: `RandGen` no es un tipo nombrable, así que
// no se puede anotar un parámetro `g: RandGen` (el checker no lo conoce) ni
// dejarlo sin anotar (el codegen no lo infiere → `fitz build` falla). Por eso
// TODAS las tiradas (`g.int` / `g.shuffle`) viven dentro de `gen` / `gen_mix`,
// con `g` como var local; los helpers son puros (operan sobre enteros ya
// tirados). Ver la ficha FITZ-01 en el backlog del core (extensión de la
// limitación "el receptor de un RandGen debe ser una var local").

// Un ejercicio de opción múltiple: `a op b = answer`, con 4 opciones (la
// correcta + 3 distractores), barajadas de forma determinista.
type Exercise {
    a: Int = 0
    b: Int = 0
    op: Str = ""              // "add" | "sub" | "mul" | "div" | "pot"/"raiz"/"scinot" | "eclin"/"eccuad"/"ecsist"
    answer: Int = 0
    options: List<Int> = []   // 4 valores distintos, uno es `answer` (vacío en juegos de teclado)
    skill_code: Str = ""      // "add" | "sub" | "mul.tabla" | "div.exacta" | ...
    difficulty: Int = 1       // 1..5, para el motor adaptativo (F3)
    // Sistemas 2×2 (F7.2.b): la 1ª ecuación usa a/b (a·x + b·y = c1); la 2ª usa
    // a2/b2 (a2·x + b2·y = c2). answer = x, answer2 = y. Las constantes c1/c2 se
    // derivan (c1 = a·x + b·y). En el resto de los ejercicios quedan en 0.
    a2: Int = 0
    b2: Int = 0
    answer2: Int = 0
}

// --- Semilla por ejercicio ---------------------------------------------------

// Deriva un seed propio para el ejercicio `idx` de la partida `seed`. Como
// `rand.seeded` pasa el número por SplitMix64 (buena avalancha), aun sub-seeds
// vecinos decorrelacionan bien. 7919 es primo; con idx acotado (una partida son
// decenas de respuestas) no hay overflow de i64.
fn sub_seed(seed: Int, idx: Int) -> Int {
    return seed + idx * 7919
}

// --- Rangos y metadatos por grado (puros) ------------------------------------

// Operando máximo (magnitud) para suma/resta según el grado. Primaria 1º..7º
// (positivos); secundaria 8º..13º (= 1º..6º), donde el generador con signo lo
// usa como magnitud: el operando cae en [-add_max, add_max]. En secundaria el
// desafío nuevo es el SIGNO, no la magnitud gigante, así que los rangos crecen
// moderado.
fn add_max(grade: Int) -> Int {
    if (grade <= 1) {
        return 10
    }
    if (grade == 2) {
        return 20
    }
    if (grade == 3) {
        return 100
    }
    if (grade <= 5) {
        return 500
    }
    if (grade <= 7) {
        return 1000            // 6º-7º primaria
    }
    if (grade <= 9) {
        return 200             // 1º-2º secundaria (enteros con signo)
    }
    if (grade <= 11) {
        return 500             // 3º-4º secundaria
    }
    return 999                 // 5º-6º secundaria
}

// Factor máximo (magnitud) para multiplicación/división (tablas). Grado 3 cierra
// las tablas hasta 10; 4º-7º llega a 12; secundaria escala por tramo de años
// (con signo), así la Escalera y la división NO son idénticas de 8º a 13º.
fn mul_max(grade: Int) -> Int {
    if (grade <= 2) {
        return 5
    }
    if (grade == 3) {
        return 10
    }
    if (grade <= 7) {
        return 12
    }
    if (grade <= 9) {
        return 15               // 1º-2º secundaria
    }
    if (grade <= 11) {
        return 20               // 3º-4º secundaria
    }
    return 25                   // 5º-6º secundaria
}

// Dificultad 1..5 a partir de la operación + el grado. Aproximada; el motor
// adaptativo de F3 la afina.
fn difficulty_for(op: Str, grade: Int) -> Int {
    let base = match op {
        "add" => 1,
        "sub" => 2,
        "mul" => 3,
        "div" => 4,
        _ => 1,
    }
    let d = base + grade / 3
    if (d < 1) {
        return 1
    }
    if (d > 5) {
        return 5
    }
    return d
}

// Operaciones disponibles por grado. 1º solo suma/resta; 2º suma la
// multiplicación fácil; 3º en adelante, las cuatro.
fn ops_for_grade(grade: Int) -> List<Str> {
    if (grade <= 1) {
        return ["add", "sub"]
    }
    if (grade == 2) {
        return ["add", "sub", "mul"]
    }
    return ["add", "sub", "mul", "div"]
}

// Símbolo visible de la operación. Universal en ambos locales (÷ y × se usan
// igual en es-AR y en); el "−" es el menos tipográfico (U+2212).
fn op_symbol(op: Str) -> Str {
    return match op {
        "add" => "+",
        "sub" => "−",
        "mul" => "×",
        "div" => "÷",
        _ => "?",
    }
}

fn imax(x: Int, y: Int) -> Int {
    if (x >= y) {
        return x
    }
    return y
}

fn imin(x: Int, y: Int) -> Int {
    if (x >= y) {
        return y
    }
    return x
}

fn iclamp(x: Int, lo: Int, hi: Int) -> Int {
    return imin(imax(x, lo), hi)
}

fn iabs(x: Int) -> Int {
    if (x < 0) {
        return 0 - x
    }
    return x
}

// --- F8: niveles y progresión graduada ---------------------------------------
//
// El ejercicio `idx` de la ronda arranca en el PISO del grado y sube un nivel cada
// PASO ejercicios, sin pasar el TECHO del grado. Determinista desde (piso, techo,
// idx) → el server re-deriva el mismo nivel para persistir (paridad run↔build por
// construcción). El `piso`/`techo` por juego los dan las tablas `nivel_piso_*` /
// `nivel_techo_*` (cotas del currículum: un grado bajo queda capado, uno alto
// arranca más arriba). El `nivel` (1..5) setea además Exercise.difficulty, así el
// Elo/puntaje reflejan la dificultad real.
fn nivel_por_idx(piso: Int, techo: Int, idx: Int) -> Int {
    return iclamp(piso + idx / 3, piso, techo)
}

// Grado para juegos de TECLADO ("Completá el hueco"): la respuesta se tipea con
// dígitos, así que no puede ser negativa. Un perfil de secundaria juega estos
// juegos en versión positiva (clamp a primaria, ≤7) — los enteros con signo
// llegan por los juegos de opción múltiple. El teclado con ± queda para F7.1.b.
fn grade_teclado(grade: Int) -> Int {
    return imin(grade, 7)
}

// Potencia entera base^exp (exp >= 0), pura. Con base negativa el signo sigue la
// paridad del exponente: (-3)^2 = 9, (-2)^3 = -8 (la regla del signo, F7.1.b).
fn ipow(base: Int, exp: Int) -> Int {
    let r = 1
    let i = 0
    while (i < exp) {
        r = r * base
        i = i + 1
    }
    return r
}

// El skill code lleva la operación adentro; `op` es el corto para el símbolo.
fn skill_a_op(skill: Str) -> Str {
    return match skill {
        "add" => "add",
        "sub" => "sub",
        "mul.tabla" => "mul",
        "div.exacta" => "div",
        _ => "add",
    }
}

// --- Distractores (puros, sin RandGen) ---------------------------------------

// Pool de candidatos a opción incorrecta. Los offsets son un conjunto fijo de
// valores distintos: como `answer` es fijo, `answer + o` con offsets distintos
// da valores distintos, así que el pool filtrado (>= 0, != answer) es
// automáticamente sin repetidos. Los 5 offsets positivos garantizan >= 3
// candidatos aun si todos los negativos se filtran (answer chico). El barajado y
// el recorte a 3 los hace el generador (con su `g` local).
fn candidatos(answer: Int) -> List<Int> {
    let offsets = [1, 2, 3, 5, 10, -1, -2, -3, -5, -10]
    let out: List<Int> = []
    for o in offsets {
        let v = answer + o
        if (v >= 0 and v != answer) {
            out.push(v)
        }
    }
    return out
}

// Distractores para enteros con signo (F7): igual que `candidatos` pero SIN el
// filtro `>= 0` — la respuesta puede ser negativa, y un distractor negativo es
// legítimo (y didáctico: el error típico del signo). Los 10 offsets distintos
// dan siempre >= 3 candidatos distintos de la respuesta.
fn candidatos_signed(answer: Int) -> List<Int> {
    let offsets = [1, 2, 3, 5, 10, -1, -2, -3, -5, -10]
    let out: List<Int> = []
    for o in offsets {
        let v = answer + o
        if (v != answer) {
            out.push(v)
        }
    }
    return out
}

// Distractores para notación científica (F7.1.c): un ±offset no sirve — la
// respuesta (m × 10^k) es enorme, así que los distractores son los ERRORES
// típicos: un orden de magnitud arriba/abajo, y la mantisa ±1. Con m ∈ [2..9] y
// k >= 2 los cuatro son distintos y != answer.
fn candidatos_scinot(m: Int, k: Int) -> List<Int> {
    let p = ipow(10, k)
    let out: List<Int> = []
    out.push(m * ipow(10, k + 1))   // un orden más
    out.push(m * ipow(10, k - 1))   // un orden menos
    out.push((m + 1) * p)           // mantisa +1
    out.push((m - 1) * p)           // mantisa -1
    return out
}

// Primeros 3 elementos de una lista (ya barajada).
fn take3(xs: List<Int>) -> List<Int> {
    let out: List<Int> = []
    for x in xs {
        if (out.len() < 3) {
            out.push(x)
        }
    }
    return out
}

// --- API pública -------------------------------------------------------------

// Genera un ejercicio de una operación fija. Reproducible desde (seed, idx).
// Todo el uso del RandGen `g` vive acá (local): operandos con `g.int`, opciones
// con `g.shuffle` — nunca se pasa `g` a otra función.
fn gen(op: Str, seed: Int, idx: Int, grade: Int) -> Exercise {
    // Secundaria (grade >= 8): enteros con signo. Se aparta en gen_sec para que
    // el camino de primaria quede BIT-A-BIT idéntico (paridad de los generadores).
    if (grade >= 8) {
        return gen_sec(op, seed, idx, grade)
    }
    let g = rand.seeded(sub_seed(seed, idx))
    let a = 0
    let b = 0
    let answer = 0
    let skill = "add"
    if (op == "sub") {
        let hi = add_max(grade)
        let x = g.int(1, hi)
        let y = g.int(1, hi)
        a = imax(x, y)
        b = imin(x, y)
        answer = a - b
        skill = "sub"
    }
    if (op == "mul") {
        let hi = mul_max(grade)
        a = g.int(2, hi)
        b = g.int(2, hi)
        answer = a * b
        skill = "mul.tabla"
    }
    if (op == "div") {
        let hi = mul_max(grade)
        let d = g.int(2, hi)      // divisor
        let q = g.int(2, hi)      // cociente (la respuesta)
        a = d * q                 // dividendo
        b = d
        answer = q
        skill = "div.exacta"
    }
    // "add" es el caso por defecto (op == "add" o cualquier valor no reconocido:
    // el juego solo pasa las cuatro operaciones válidas).
    if (skill == "add") {
        let hi = add_max(grade)
        a = g.int(1, hi)
        b = g.int(1, hi)
        answer = a + b
    }
    // Opciones: correcta + 3 distractores, barajadas con el mismo g.
    let cands = candidatos(answer)
    let distractors = take3(g.shuffle(cands))
    let raw = [answer]
    for dd in distractors {
        raw.push(dd)
    }
    let options = g.shuffle(raw)
    let opc = skill_a_op(skill)
    return Exercise {
        a: a,
        b: b,
        op: opc,
        answer: answer,
        options: options,
        skill_code: skill,
        difficulty: difficulty_for(opc, grade),
    }
}

// Enteros con signo (F7, secundaria grade >= 8). Las cuatro operaciones con
// operandos en [-hi, hi]: la resta NO fuerza a >= b (los resultados negativos
// son el punto), la multiplicación y la división llevan el signo, y la división
// es exacta (cociente entero, divisor con signo para variedad). Los distractores
// permiten negativos (candidatos_signed). El RandGen `g` es local (FITZ-01), y
// el render parentiza los negativos vía fmt_operando.
fn gen_sec(op: Str, seed: Int, idx: Int, grade: Int) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    let a = 0
    let b = 0
    let answer = 0
    let skill = "add"
    if (op == "sub") {
        let hi = add_max(grade)
        a = g.int(0 - hi, hi)
        b = g.int(0 - hi, hi)
        answer = a - b
        skill = "sub"
    }
    if (op == "mul") {
        let hi = mul_max(grade)
        a = g.int(0 - hi, hi)
        b = g.int(0 - hi, hi)
        answer = a * b
        skill = "mul.tabla"
    }
    if (op == "div") {
        let hi = mul_max(grade)
        let d = g.int(2, hi)          // magnitud del divisor
        let q = g.int(0 - hi, hi)     // cociente (la respuesta), con signo
        if (q == 0) {
            q = 1                     // no trivializar (0 ÷ d = 0)
        }
        if (g.int(0, 1) == 1) {
            d = 0 - d                 // divisor con signo
        }
        a = d * q                     // dividendo
        b = d
        answer = q
        skill = "div.exacta"
    }
    if (skill == "add") {
        let hi = add_max(grade)
        a = g.int(0 - hi, hi)
        b = g.int(0 - hi, hi)
        answer = a + b
    }
    let cands = candidatos_signed(answer)
    let distractors = take3(g.shuffle(cands))
    let raw = [answer]
    for dd in distractors {
        raw.push(dd)
    }
    let options = g.shuffle(raw)
    let opc = skill_a_op(skill)
    return Exercise {
        a: a,
        b: b,
        op: opc,
        answer: answer,
        options: options,
        skill_code: skill,
        difficulty: difficulty_for(opc, grade),
    }
}

// Potencias y raíces (F7.1.b + F8 niveles). El sub-tipo lo elige el NIVEL (no un
// dado): a mayor nivel, más complejidad. N1 cuadrados chicos · N2 potencias base
// 2..9 con signo · N3 raíces exactas · N4 notación científica · N5 potencias base
// grande. El signo de la potencia sigue la paridad del exponente; la raíz es exacta
// (radicando r^n). El render (prompt_potencia) formatea √ / ∛ / a^b. Opciones =
// respuesta + 3 distractores. El RandGen `g` es local (FITZ-01).
fn nivel_piso_potencia(grade: Int) -> Int {
    if (grade <= 9) {
        return 1
    }
    return 2
}

fn nivel_techo_potencia(grade: Int) -> Int {
    if (grade <= 8) {
        return 2
    }
    if (grade <= 9) {
        return 3
    }
    if (grade <= 10) {
        return 4
    }
    return 5
}

fn gen_potencia(seed: Int, idx: Int, grade: Int) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    let nivel = nivel_por_idx(nivel_piso_potencia(grade), nivel_techo_potencia(grade), idx)
    let a = 0
    let b = 0
    let answer = 0
    let op = "pot"
    let skill = "pot.entera"
    if (nivel == 1) {
        // Cuadrado chico: base 2..5, positiva.
        let base = g.int(2, 5)
        a = base
        b = 2
        answer = ipow(base, 2)
        op = "pot"
        skill = "pot.entera"
    }
    if (nivel == 2) {
        // Potencia base 2..9, exp 2..3, signo aleatorio.
        let base = g.int(2, 9)
        let exp = g.int(2, 3)
        if (g.int(0, 1) == 1) {
            base = 0 - base
        }
        a = base
        b = exp
        answer = ipow(base, exp)
        op = "pot"
        skill = "pot.entera"
    }
    if (nivel == 3) {
        // Raíz exacta (cuadrada/cúbica).
        let r = g.int(2, 12)
        let n = g.int(2, 3)
        a = ipow(r, n)
        b = n
        answer = r
        op = "raiz"
        skill = "raiz.enesima"
    }
    if (nivel == 4) {
        // Notación científica: m × 10^k. Mantisa 2..9, exponente 2..5.
        let m = g.int(2, 9)
        let k = g.int(2, 5)
        a = m
        b = k
        answer = m * ipow(10, k)
        op = "scinot"
        skill = "pot.notacion"
    }
    if (nivel == 5) {
        // Potencia grande: base 2..12, exp 2..3, signo.
        let base = g.int(2, 12)
        let exp = g.int(2, 3)
        if (g.int(0, 1) == 1) {
            base = 0 - base
        }
        a = base
        b = exp
        answer = ipow(base, exp)
        op = "pot"
        skill = "pot.entera"
    }
    // Distractores: por orden de magnitud para notación científica (un ±offset
    // sería indistinguible en números enormes), por ±offset para potencia/raíz.
    let cands = candidatos_signed(answer)
    if (op == "scinot") {
        cands = candidatos_scinot(a, b)
    }
    let distractors = take3(g.shuffle(cands))
    let raw = [answer]
    for dd in distractors {
        raw.push(dd)
    }
    let options = g.shuffle(raw)
    return Exercise {
        a: a,
        b: b,
        op: op,
        answer: answer,
        options: options,
        skill_code: skill,
        difficulty: nivel,
    }
}

// Ecuaciones (F7.2 + F8 niveles). Respuesta ÚNICA tipeada (teclado con ±). El
// sub-tipo lo elige el NIVEL: N1 lineal x positivo · N2 lineal x con signo, coef
// mayores · N3 cuadrática x²=k (x chico) · N4 cuadrática x²=k (x mayor) · N5 sistema
// 2×2. Sin `options` (no es opción múltiple). El render lo arma prompt_ecuacion.
fn nivel_piso_ecuacion(grade: Int) -> Int {
    if (grade <= 9) {
        return 1
    }
    if (grade <= 11) {
        return 2
    }
    return 3
}

fn nivel_techo_ecuacion(grade: Int) -> Int {
    if (grade <= 8) {
        return 2
    }
    if (grade <= 9) {
        return 3
    }
    if (grade <= 10) {
        return 4
    }
    return 5
}

fn gen_ecuacion(seed: Int, idx: Int, grade: Int) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    let nivel = nivel_por_idx(nivel_piso_ecuacion(grade), nivel_techo_ecuacion(grade), idx)
    let a = 0
    let b = 0
    let answer = 0
    let a2 = 0
    let b2 = 0
    let answer2 = 0
    let op = "eclin"
    let skill = "ec.lineal"
    if (nivel == 1) {
        // Lineal fácil: x positivo, coef y término chicos.
        let x = g.int(1, 9)
        let coef = g.int(2, 5)
        let cte = g.int(0, 12)
        a = coef
        b = cte
        answer = x
        op = "eclin"
        skill = "ec.lineal"
    }
    if (nivel == 2) {
        // Lineal con signo, coeficientes mayores.
        let x = g.int(0 - 12, 12)
        let coef = g.int(2, 9)
        let cte = g.int(0 - 15, 15)
        a = coef
        b = cte
        answer = x
        op = "eclin"
        skill = "ec.lineal"
    }
    if (nivel == 3) {
        // Cuadrática x² = k, x chico.
        let x = g.int(2, 8)
        answer = x
        op = "eccuad"
        skill = "ec.cuadratica"
    }
    if (nivel == 4) {
        // Cuadrática x² = k, x mayor (raíz mental más difícil).
        let x = g.int(9, 15)
        answer = x
        op = "eccuad"
        skill = "ec.cuadratica"
    }
    if (nivel == 5) {
        // Sistema 2×2 con solución entera (x, y). Coeficientes 1..4, det != 0
        // (solución única): si a1·b2 == a2·b1, se sube b2 (det pasa a valer a1 ≥ 1).
        let x = g.int(0 - 6, 6)
        let y = g.int(0 - 6, 6)
        let a1 = g.int(1, 4)
        let b1 = g.int(1, 4)
        let a2c = g.int(1, 4)
        let b2c = g.int(1, 4)
        if (a1 * b2c == a2c * b1) {
            b2c = b2c + 1
        }
        a = a1
        b = b1
        answer = x
        a2 = a2c
        b2 = b2c
        answer2 = y
        op = "ecsist"
        skill = "sist.2x2"
    }
    let vacio: List<Int> = []
    return Exercise {
        a: a,
        b: b,
        op: op,
        answer: answer,
        options: vacio,
        skill_code: skill,
        difficulty: nivel,
        a2: a2,
        b2: b2,
        answer2: answer2,
    }
}

// ¿La respuesta tipeada resuelve la ecuación? Para la cuadrática valen las DOS
// raíces (±x); para el 1er grado, sólo x.
fn ecuacion_correcta(given: Int, answer: Int, op: Str) -> Bool {
    if (op == "eccuad") {
        return given == answer or given == 0 - answer
    }
    return given == answer
}

// Finanzas (F7.3, juego "Finanzas" — diferencial de la modalidad comercial).
// Respuesta ÚNICA en pesos enteros (por teclado, sin ±: la plata es positiva).
// Los rangos se eligen para que la respuesta SIEMPRE sea entera:
//   - interés simple (op "finsimple"): I = C·i·t/100, C múltiplo de 1000.
//     a=C, b=i(%), a2=t(años), answer=I.
//   - interés compuesto (op "fincomp"): M = C·(1+i/100)^t, C múltiplo de 1000,
//     i ∈ {10,20,50}, t ∈ {2,3} → M entero. a=C, b=i, a2=t, answer=M.
//   - porcentaje (op "finpct"): answer = N·P/100, N múltiplo de 100. a=N, b=P.
//   - descuento (op "findesc"): precio final = N − N·P/100, N múltiplo de 100,
//     P múltiplo de 5. a=N, b=P, answer=precio final.
// F8 niveles: el sub-tipo lo elige el NIVEL, de menor a mayor complejidad
// conceptual: N1 porcentaje · N2 descuento · N3 interés simple · N4 interés
// compuesto · N5 punto de equilibrio.
fn nivel_piso_finanzas(grade: Int) -> Int {
    if (grade <= 12) {
        return 1
    }
    return 2
}

fn nivel_techo_finanzas(grade: Int) -> Int {
    if (grade <= 11) {
        return 3
    }
    if (grade <= 12) {
        return 4
    }
    return 5
}

fn gen_finanzas(seed: Int, idx: Int, grade: Int) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    let nivel = nivel_por_idx(nivel_piso_finanzas(grade), nivel_techo_finanzas(grade), idx)
    let a = 0
    let b = 0
    let a2 = 0
    let answer = 0
    let op = "finpct"
    let skill = "pct.basico"
    if (nivel == 1) {
        // Porcentaje: answer = N·P/100, N múltiplo de 100.
        let base = 100 * g.int(1, 90)
        let pcts = [5, 10, 15, 20, 25, 50, 75]
        let p = pcts[g.int(0, 6)]
        a = base
        b = p
        answer = base * p / 100
        op = "finpct"
        skill = "pct.basico"
    }
    if (nivel == 2) {
        // Descuento: precio final = N − N·P/100, N múltiplo de 100, P múltiplo de 5.
        let base = 100 * g.int(1, 90)
        let p = 5 * g.int(1, 10)
        a = base
        b = p
        answer = base - (base * p / 100)
        op = "findesc"
        skill = "fin.descuento"
    }
    if (nivel == 3) {
        // Interés simple: I = C·i·t/100, C múltiplo de 1000.
        let cap = 1000 * g.int(1, 15)
        let tasas = [5, 10, 15, 20]
        let i = tasas[g.int(0, 3)]
        let t = g.int(1, 4)
        a = cap
        b = i
        a2 = t
        answer = cap * i * t / 100
        op = "finsimple"
        skill = "fin.interes_simple"
    }
    if (nivel == 4) {
        // Interés compuesto: M = C·(1+i/100)^t, i ∈ {10,20,50}, t ∈ {2,3}.
        let cap = 1000 * g.int(1, 10)
        let tasas = [10, 20, 50]
        let i = tasas[g.int(0, 2)]
        let t = g.int(2, 3)
        a = cap
        b = i
        a2 = t
        answer = cap * ipow(100 + i, t) / ipow(100, t)
        op = "fincomp"
        skill = "fin.interes_compuesto"
    }
    if (nivel == 5) {
        // Punto de equilibrio: Q = CostosFijos / (Precio − CostoUnitario). Elegimos
        // margen unitario `m` y cantidad `q`, y derivamos CF = m·q → Q = CF/m = q
        // exacto y positivo. a=CF, b=Precio, a2=CostoUnitario (los tres en pesos).
        let m = 10 * g.int(2, 10)          // margen unitario: 20..100 (múltiplo de 10)
        let q = g.int(5, 40)               // unidades del punto de equilibrio
        let costo = 10 * g.int(3, 15)      // costo variable unitario: 30..150
        let precio = costo + m             // precio de venta
        let cf = m * q                     // costos fijos = margen · unidades
        a = cf
        b = precio
        a2 = costo
        answer = q                         // = cf / (precio − costo)
        op = "finbreak"
        skill = "fin.punto_equilibrio"
    }
    let vacio: List<Int> = []
    return Exercise {
        a: a,
        b: b,
        op: op,
        answer: answer,
        options: vacio,
        skill_code: skill,
        difficulty: nivel,
        a2: a2,
    }
}

// F7.4 — Trigonometría: triángulo rectángulo con figura (SVG). Respuestas SIEMPRE
// enteras y positivas (teclado sin ±). Tres tipos, todos sobre el triángulo con
// el ángulo recto abajo-izquierda (cateto horizontal + cateto vertical +
// hipotenusa):
//   - trighyp (Pitágoras): dados los dos catetos → hallar la hipotenusa.
//   - trigleg (Pitágoras): dado un cateto + la hipotenusa → hallar el otro cateto.
//   - trigang (razón, ángulo 30°): el ángulo agudo abajo-derecha mide 30°, así que
//     sin(30°) = cateto_opuesto / hipotenusa = 1/2. Con la hipotenusa PAR (2k) el
//     cateto opuesto (el vertical) es k, entero. Dos modos: dada la hipotenusa →
//     hallar el cateto opuesto (h/2); dado el cateto opuesto → hallar la hipotenusa
//     (2·cateto). Es la razón trigonométrica llevada a un caso de respuesta entera.
//
// Convención de campos por `op` (la re-lee `trig_view` para dibujar la figura):
//   trighyp → a=cateto horiz, b=cateto vert, answer=hipotenusa (incógnita).
//   trigleg → a=cateto horiz (dado), a2=hipotenusa (dada), answer=cateto vert (?).
//   trigang → a=ángulo (30), b=valor dado, a2=modo (0: dada hip → hallar cateto;
//             1: dado cateto → hallar hip), answer=lo pedido.
// F8 niveles: el sub-tipo lo elige el NIVEL: N1 Pitágoras hipotenusa con ternas
// chicas · N2 Pitágoras hipotenusa con todas las ternas · N3 Pitágoras hallar
// cateto · N4 razón 30° (dada hip → cateto) · N5 razón 30° (dado cateto → hip).
fn nivel_piso_trig(grade: Int) -> Int {
    if (grade <= 11) {
        return 1
    }
    return 2
}

fn nivel_techo_trig(grade: Int) -> Int {
    if (grade <= 10) {
        return 3
    }
    if (grade <= 11) {
        return 4
    }
    return 5
}

fn gen_trig(seed: Int, idx: Int, grade: Int) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    // Ternas pitagóricas (cateto, cateto, hipotenusa) — primitivas + escaladas.
    let tri_a = [3, 6, 5, 8, 9, 12, 15, 7]
    let tri_b = [4, 8, 12, 15, 12, 16, 20, 24]
    let tri_c = [5, 10, 13, 17, 15, 20, 25, 25]
    let nivel = nivel_por_idx(nivel_piso_trig(grade), nivel_techo_trig(grade), idx)
    let a = 0
    let b = 0
    let a2 = 0
    let answer = 0
    let op = "trighyp"
    let skill = "trig.pitagoras"
    if (nivel == 1) {
        // Pitágoras hipotenusa, ternas chicas (3-4-5, 6-8-10).
        let k = g.int(0, 1)
        a = tri_a[k]
        b = tri_b[k]
        answer = tri_c[k]
        op = "trighyp"
        skill = "trig.pitagoras"
    }
    if (nivel == 2) {
        // Pitágoras hipotenusa, todas las ternas.
        let k = g.int(0, 7)
        a = tri_a[k]
        b = tri_b[k]
        answer = tri_c[k]
        op = "trighyp"
        skill = "trig.pitagoras"
    }
    if (nivel == 3) {
        // Pitágoras: hallar el cateto que falta.
        let k = g.int(0, 7)
        a = tri_a[k]        // cateto horizontal conocido
        a2 = tri_c[k]       // hipotenusa conocida
        answer = tri_b[k]   // cateto vertical (incógnita)
        op = "trigleg"
        skill = "trig.pitagoras"
    }
    if (nivel == 4) {
        // Razón 30°: dada la hipotenusa (par) → hallar el cateto opuesto (h/2).
        let k = g.int(2, 20)
        a = 30
        b = 2 * k
        a2 = 0
        answer = k
        op = "trigang"
        skill = "trig.razon"
    }
    if (nivel == 5) {
        // Razón 30°: dado el cateto opuesto → hallar la hipotenusa (2·cateto).
        let k = g.int(2, 20)
        a = 30
        b = k
        a2 = 1
        answer = 2 * k
        op = "trigang"
        skill = "trig.razon"
    }
    let vacio: List<Int> = []
    return Exercise {
        a: a,
        b: b,
        op: op,
        answer: answer,
        options: vacio,
        skill_code: skill,
        difficulty: nivel,
        a2: a2,
    }
}

// F7.5 — Funciones: evaluar f(x) de tres familias, con el gráfico de la familia
// (SVG). La respuesta es un entero que PUEDE ser negativo (lineal/cuadrática con
// término independiente negativo) → teclado con ±. Tres tipos:
//   - funclin (lineal): f(x) = a·x + b. Pendiente a con signo (gráfico sube/baja).
//   - funccuad (cuadrática): f(x) = a·x² + b, a>0 (parábola hacia arriba).
//   - funcexp (exponencial): f(x) = a·b^x (base 2 o 3), crece.
//
// Convención de campos (la re-lee `func_view` para fórmula y gráfico):
//   a=coeficiente principal (pendiente / a de ax² / coef del exponencial),
//   b=término independiente (o la BASE en exponencial), a2=x0 (punto a evaluar),
//   answer=f(x0), op=funclin/funccuad/funcexp.
// F8 niveles: el sub-tipo lo elige el NIVEL: N1 lineal con pendiente positiva (x0
// positivo) · N2 lineal con pendiente ± · N3 cuadrática · N4 exponencial base 2 ·
// N5 exponencial base 3 con coeficiente.
fn nivel_piso_func(grade: Int) -> Int {
    if (grade <= 12) {
        return 1
    }
    return 2
}

fn nivel_techo_func(grade: Int) -> Int {
    if (grade <= 11) {
        return 3
    }
    if (grade <= 12) {
        return 4
    }
    return 5
}

fn gen_func(seed: Int, idx: Int, grade: Int) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    let nivel = nivel_por_idx(nivel_piso_func(grade), nivel_techo_func(grade), idx)
    let a = 0
    let b = 0
    let a2 = 0
    let answer = 0
    let op = "funclin"
    let skill = "func.lineal"
    if (nivel == 1) {
        // Lineal fácil: pendiente positiva, x0 positivo, b positivo → todo positivo.
        a = g.int(1, 4)
        b = g.int(0, 9)
        let x0 = g.int(1, 6)
        a2 = x0
        answer = a * x0 + b
        op = "funclin"
        skill = "func.lineal"
    }
    if (nivel == 2) {
        // Lineal: f(x) = a·x + b, con pendiente de signo aleatorio.
        let mag = g.int(1, 5)
        let neg = g.int(0, 1)
        if (neg == 1) {
            a = 0 - mag
        }
        if (neg == 0) {
            a = mag
        }
        b = g.int(0 - 9, 9)
        let x0 = g.int(0 - 4, 6)
        a2 = x0
        answer = a * x0 + b
        op = "funclin"
        skill = "func.lineal"
    }
    if (nivel == 3) {
        // Cuadrática: f(x) = a·x² + b, a>0 (parábola hacia arriba).
        a = g.int(1, 3)
        b = g.int(0 - 6, 6)
        let x0 = g.int(0 - 4, 4)
        a2 = x0
        answer = a * x0 * x0 + b
        op = "funccuad"
        skill = "func.cuadratica"
    }
    if (nivel == 4) {
        // Exponencial base 2: f(x) = 2^x, x0 chico.
        a = 1
        b = 2
        let x0 = g.int(0, 4)
        a2 = x0
        answer = ipow(2, x0)
        op = "funcexp"
        skill = "func.exponencial"
    }
    if (nivel == 5) {
        // Exponencial base 3 con coeficiente: f(x) = a·3^x.
        a = g.int(1, 2)
        b = 3
        let x0 = g.int(0, 3)
        a2 = x0
        answer = a * ipow(3, x0)
        op = "funcexp"
        skill = "func.exponencial"
    }
    let vacio: List<Int> = []
    return Exercise {
        a: a,
        b: b,
        op: op,
        answer: answer,
        options: vacio,
        skill_code: skill,
        difficulty: nivel,
        a2: a2,
    }
}

// Genera un ejercicio mezclando las operaciones apropiadas al grado. Elige la
// operación con un generador propio (determinista desde el seed) y delega en
// `gen`. (seed, idx, grade) devuelve siempre el mismo ejercicio.
fn gen_mix(seed: Int, idx: Int, grade: Int) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    let ops = ops_for_grade(grade)
    let oi = g.int(0, ops.len() - 1)
    let op = ops[oi]
    return gen(op, seed, idx, grade)
}

// --- Práctica libre (F3): topic fijo + banda de dificultad -------------------

// Grado efectivo según la banda de dificultad de Práctica libre
// (1=fácil, 2=medio, 3=difícil). La banda desplaza el rango del generador un
// grado abajo/arriba, con clamp 1..7. Banda 2 (medio) = el grado del perfil.
fn grade_for_band(grade: Int, band: Int) -> Int {
    let g = grade + band - 2
    // La banda no cruza el límite primaria/secundaria (ver grado_efectivo).
    let piso = 1
    let techo = 7
    if (grade >= 8) {
        piso = 8
        techo = 13
    }
    return iclamp(g, piso, techo)
}

// Generador UNIFICADO: lo usan tanto el render (quiz_view) como el scoring
// (Quiz.fitzv). Que sea uno solo es la garantía de que el ejercicio mostrado y
// el corregido coinciden. Los `r_*` son el snapshot de mastery (ratings por
// operación); solo el modo adaptativo los usa.
//   - modo "adaptive" (contrarreloj / desafío): selección 70/20/10 por rating.
//   - modo "practice": tema fijo ("add"|"sub"|"mul"|"div"|"mix") con banda.
//   - modo "timed": gen_mix al grado del perfil — bit-a-bit como antes (paridad
//     del juego previo a F3; lo mantiene por si se quiere un contrarreloj no
//     adaptativo, y para los tests de paridad de generadores).
fn gen_for(mode: Str, topic: Str, band: Int, seed: Int, idx: Int, grade: Int, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Exercise {
    if (mode == "adaptive" or mode == "desafio") {
        // El contrarreloj (adaptive) y el Desafío del día (desafio) comparten la
        // selección 70/20/10 por rating; difieren en el corte (reloj vs N fijo).
        return gen_adaptive(seed, idx, grade, r_add, r_sub, r_mul, r_div)
    }
    if (mode == "practice") {
        let eg = grade_for_band(grade, band)
        if (topic == "mix") {
            return gen_mix(seed, idx, eg)
        }
        return gen(topic, seed, idx, eg)
    }
    if (mode == "potencias") {
        // Juego "Potencias y raíces" (F7.1.b): no usa el rating por operación
        // (no es una de las cuatro básicas), así que ignora los r_*.
        return gen_potencia(seed, idx, grade)
    }
    return gen_mix(seed, idx, grade)
}

// --- Selección adaptativa (F3, §7) -------------------------------------------
//
// El motor sirve el próximo ejercicio según el rating Elo-lite del chico en cada
// operación (el "snapshot" de mastery, congelado al abrir la partida). Regla
// 70/20/10: 70% en la zona de desarrollo próximo (una operación al azar, a su
// grado efectivo), 20% repaso (la operación MÁS floja — la que más necesita
// práctica), 10% desafío (una operación al azar, un grado más difícil).
// Determinista desde (seed, idx, snapshot): render, scoring y persistencia
// derivan el MISMO ejercicio. Reproducible dentro de la sesión; entre sesiones
// el snapshot evoluciona → la dificultad se acomoda al chico.

// Grado efectivo del generador según el rating de una destreza. El rating
// arranca en 800 al grado del perfil; a medida que sube, corre el grado hacia
// arriba (rangos más grandes) y hacia abajo si baja — la dificultad SIGUE al
// rating (§11). 800→sin cambio, 1000→+1, 1200→+2, 600→−1. Clamp del corrimiento
// a ±3 y del grado final a 1..7 (primaria).
fn grado_efectivo(grado_perfil: Int, rating: Float) -> Int {
    let delta = round((rating - 800.0) / 200.0)
    let d = iclamp(delta, -3, 3)
    // El corrimiento por rating no cruza el límite primaria/secundaria: un perfil
    // de primaria se queda en 1..7 (positivos) y uno de secundaria en 8..13
    // (enteros con signo). Así el motor adaptativo nunca "baja" a otro nivel.
    let piso = 1
    let techo = 7
    if (grado_perfil >= 8) {
        piso = 8
        techo = 13
    }
    return iclamp(grado_perfil + d, piso, techo)
}

// Rating de una operación en el snapshot (por nombre corto "add"/"sub"/"mul"/"div").
fn rating_op(op: Str, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Float {
    return match op {
        "add" => r_add,
        "sub" => r_sub,
        "mul" => r_mul,
        "div" => r_div,
        _ => r_add,
    }
}

// La operación con MENOR rating entre las disponibles (la que más necesita
// repaso). Empates → la primera en `ops` (determinista). El repaso "real" por
// due_at vencido vive en la capa de DB (Desafío/selección de sesión, F3); acá,
// dentro del contrarreloj, la más floja es la mejor proxy sin timestamps.
// Toma el RandGen `g` para romper empates AL AZAR: con un perfil nuevo (todos los
// ratings en 800) las 4 operaciones empatan, y antes el desempate "el primero"
// devolvía SIEMPRE "add" → el 20% de repaso era siempre suma y la suma dominaba
// ~40% de la partida. Ahora, entre las de menor rating (empatadas o no), elige una
// al azar → en grados altos las 4 operaciones aparecen parejas. Determinista desde
// (seed, idx) porque `g` viene de rand.seeded — paridad con la persistencia.
fn op_mas_floja(g: RandGen, ops: List<Str>, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Str {
    let mejor_r = rating_op(ops[0], r_add, r_sub, r_mul, r_div)
    for op in ops {
        let r = rating_op(op, r_add, r_sub, r_mul, r_div)
        if (r < mejor_r) {
            mejor_r = r
        }
    }
    let flojas = ops.filter(fn(op) => rating_op(op, r_add, r_sub, r_mul, r_div) == mejor_r)
    let i = g.int(0, flojas.len() - 1)
    return flojas[i]
}

// Genera el próximo ejercicio adaptativo. `r_*` son los ratings por operación
// (800 si el chico nunca la vio). Determinista desde (seed, idx): el mismo
// (seed, idx, ratings) da SIEMPRE el mismo ejercicio.
fn gen_adaptive(seed: Int, idx: Int, grade: Int, r_add: Float, r_sub: Float, r_mul: Float, r_div: Float) -> Exercise {
    let g = rand.seeded(sub_seed(seed, idx))
    let ops = ops_for_grade(grade)
    let roll = g.int(0, 99)
    let op = "add"
    let eff = grade
    if (roll < 70) {
        // 70% zona de desarrollo próximo: una op al azar, a su grado efectivo.
        let oi = g.int(0, ops.len() - 1)
        op = ops[oi]
        eff = grado_efectivo(grade, rating_op(op, r_add, r_sub, r_mul, r_div))
    }
    if (roll >= 70 and roll < 90) {
        // 20% repaso: la op más floja (empates al azar con `g`), a su grado efectivo.
        op = op_mas_floja(g, ops, r_add, r_sub, r_mul, r_div)
        eff = grado_efectivo(grade, rating_op(op, r_add, r_sub, r_mul, r_div))
    }
    if (roll >= 90) {
        // 10% desafío: una op al azar, un grado más difícil (sin cruzar el
        // límite primaria/secundaria).
        let oi = g.int(0, ops.len() - 1)
        op = ops[oi]
        let techo = 7
        if (grade >= 8) {
            techo = 13
        }
        eff = iclamp(grado_efectivo(grade, rating_op(op, r_add, r_sub, r_mul, r_div)) + 1, 1, techo)
    }
    // gen re-seedea con el MISMO sub_seed → operandos deterministas para `eff`.
    return gen(op, seed, idx, eff)
}

// --- Verdadero o Falso (F4) --------------------------------------------------
//
// El juego V/F reusa el MISMO ejercicio adaptativo (gen_for "adaptive") pero lo
// presenta como una afirmación a juzgar: "a op b = shown", con dos botones
// (Verdadero / Falso). La mitad de las veces `shown` es la respuesta correcta
// (afirmación verdadera), la otra mitad un distractor de `ex.options`
// (afirmación falsa). Determinista desde (seed, idx) con un sub-seed propio
// (offset primo distinto) para no correlacionar con el generador del ejercicio:
// el server re-deriva el MISMO `shown` que vio el chico. El RandGen `g` es local
// (FITZ-01).

// Valor mostrado en la afirmación V/F. `es_verdad` (shown == ex.answer) se
// deriva de esto en la capa que lo use — no hace falta devolver dos valores.
fn vf_shown(ex: Exercise, seed: Int, idx: Int) -> Int {
    let g = rand.seeded(sub_seed(seed, idx) + 104729)
    let es_verdad = g.int(0, 1) == 1
    if (es_verdad) {
        return ex.answer
    }
    // Un distractor: cualquier opción que no sea la respuesta.
    let distractores: List<Int> = []
    for o in ex.options {
        if (o != ex.answer) {
            distractores.push(o)
        }
    }
    if (distractores.len() == 0) {
        return ex.answer + 1        // borde: sin distractores (no debería pasar)
    }
    let di = g.int(0, distractores.len() - 1)
    return distractores[di]
}

// --- Escalera de tablas (F4) -------------------------------------------------
//
// Juego de multiplicación pura (tablas): siempre `gen("mul", ...)`, pero con el
// grado efectivo escalado por el rating de multiplicación del chico (§7). Así la
// escalera sube de tablas fáciles a difíciles a medida que domina — sin salirse
// de la multiplicación. Determinista desde (seed, idx, r_mul): render y scoring
// derivan el MISMO ejercicio.
fn gen_escalera(seed: Int, idx: Int, grade: Int, r_mul: Float) -> Exercise {
    let eff = grado_efectivo(grade, r_mul)
    return gen("mul", seed, idx, eff)
}

// Temas de práctica disponibles según el grado: las operaciones del grado más
// "mix" (mezcla). `ops_for_grade` devuelve un literal fresco, así que el push no
// alias-ea la lista de nadie.
fn temas_practica(grade: Int) -> List<Str> {
    let out = ops_for_grade(grade)
    out.push("mix")
    return out
}

// ¿El tema `topic` es válido para el grado? (guarda de las rutas de práctica.)
fn tema_valido(topic: Str, grade: Int) -> Bool {
    for tp in temas_practica(grade) {
        if (tp == topic) {
            return true
        }
    }
    return false
}
