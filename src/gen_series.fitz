// gen_series.fitz — generador del juego "Series" (patrones numéricos).
//
// Muestra 4 términos de una secuencia y el chico tipea el 5º: "2, 4, 6, 8, ___".
// Enseña razonamiento INDUCTIVO (ver la regla), una habilidad distinta a "calculá
// esto" que cubren los demás juegos. Escala por nivel (F8): de sumar de a poco en
// 1° a Fibonacci / potencias en secundaria.
//
// Reproducible como el resto: el server re-deriva el mismo item de (seed, idx,
// grade). El RandGen `g` es LOCAL (regla FITZ-01), nunca se pasa a otra fn.
//
// La respuesta es SIEMPRE un entero positivo (teclado sin ±): las descendentes se
// arman hacia abajo pero el 5º término nunca es negativo.

from gen_arith import sub_seed, nivel_por_idx

type SerieItem {
    shown: Str = ""            // "2, 4, 6, 8, ___" (los 4 términos + hueco)
    answer: Int = 0            // el 5º término
    skill_code: Str = "patron"
    difficulty: Int = 1        // 1..5 (nivel)
}

// Piso/techo del nivel por grado (1..13). Primaria arranca con progresiones
// aditivas; secundaria suma multiplicativas, cuadrados y Fibonacci.
fn nivel_piso_series(grade: Int) -> Int {
    if (grade <= 4) {
        return 1
    }
    if (grade <= 7) {
        return 2
    }
    if (grade <= 9) {
        return 3
    }
    return 3
}

fn nivel_techo_series(grade: Int) -> Int {
    if (grade <= 2) {
        return 1
    }
    if (grade <= 4) {
        return 2
    }
    if (grade <= 6) {
        return 3
    }
    if (grade <= 8) {
        return 3
    }
    if (grade <= 9) {
        return 4
    }
    return 5
}

fn gen_series(seed: Int, idx: Int, grade: Int) -> SerieItem {
    let g = rand.seeded(sub_seed(seed, idx))
    let piso = nivel_piso_series(grade)
    let techo = nivel_techo_series(grade)
    let nivel = nivel_por_idx(piso, techo, idx)

    let t1 = 0
    let t2 = 0
    let t3 = 0
    let t4 = 0
    let ans = 0

    if (nivel == 1) {
        // Progresión aritmética ascendente simple (contar de a `step`).
        let step = g.int(1, 5)
        let start = g.int(1, 9)
        t1 = start
        t2 = start + step
        t3 = start + step * 2
        t4 = start + step * 3
        ans = start + step * 4
    }
    if (nivel == 2) {
        let kind = g.int(0, 1)
        if (kind == 0) {
            // Ascendente con paso más grande.
            let step = g.int(2, 10)
            let start = g.int(1, 20)
            t1 = start
            t2 = start + step
            t3 = start + step * 2
            t4 = start + step * 3
            ans = start + step * 4
        }
        if (kind == 1) {
            // Descendente (el 5º término, `base`, nunca es negativo).
            let step = g.int(2, 9)
            let base = g.int(0, 6)
            t1 = base + step * 4
            t2 = base + step * 3
            t3 = base + step * 2
            t4 = base + step
            ans = base
        }
    }
    if (nivel == 3) {
        let kind = g.int(0, 1)
        if (kind == 0) {
            // Duplicar (×2).
            let start = g.int(1, 5)
            t1 = start
            t2 = start * 2
            t3 = start * 4
            t4 = start * 8
            ans = start * 16
        }
        if (kind == 1) {
            // Cuadrados: (m)², (m+1)², ... 1,4,9,16,25 / 4,9,16,25,36 ...
            let m = g.int(1, 4)
            t1 = m * m
            t2 = (m + 1) * (m + 1)
            t3 = (m + 2) * (m + 2)
            t4 = (m + 3) * (m + 3)
            ans = (m + 4) * (m + 4)
        }
    }
    if (nivel == 4) {
        let kind = g.int(0, 1)
        if (kind == 0) {
            // Triplicar (×3): 3,9,27,81,243.
            let start = g.int(1, 3)
            t1 = start
            t2 = start * 3
            t3 = start * 9
            t4 = start * 27
            ans = start * 81
        }
        if (kind == 1) {
            // Diferencias crecientes (triangulares): +d, +(d+1), +(d+2), +(d+3).
            let start = g.int(1, 6)
            let d = g.int(2, 4)
            t1 = start
            t2 = start + d
            t3 = t2 + (d + 1)
            t4 = t3 + (d + 2)
            ans = t4 + (d + 3)
        }
    }
    if (nivel >= 5) {
        let kind = g.int(0, 2)
        if (kind == 0) {
            // Estilo Fibonacci: cada término es la suma de los dos anteriores.
            let a = g.int(1, 5)
            let b = g.int(a + 1, a + 6)
            t1 = a
            t2 = b
            t3 = a + b
            t4 = t2 + t3
            ans = t3 + t4
        }
        if (kind == 1) {
            // Duplicar y sumar uno (×2+1): 1,3,7,15,31.
            let start = g.int(1, 4)
            t1 = start
            t2 = start * 2 + 1
            t3 = t2 * 2 + 1
            t4 = t3 * 2 + 1
            ans = t4 * 2 + 1
        }
        if (kind == 2) {
            // Diferencias crecientes con paso más grande.
            let start = g.int(1, 8)
            let d = g.int(3, 6)
            t1 = start
            t2 = start + d
            t3 = t2 + (d + 2)
            t4 = t3 + (d + 4)
            ans = t4 + (d + 6)
        }
    }

    let shown = "{t1}, {t2}, {t3}, {t4}"
    return SerieItem {
        shown: shown,
        answer: ans,
        skill_code: "patron",
        difficulty: nivel,
    }
}
