// assets.fitz — favicon como ruta generada.
//
// El manifest se sirve como archivo estático (`public/manifest.webmanifest`)
// vía `@server(static_dir="public")` desde FITZ-02. El favicon, en cambio, se
// GENERA con `logo_svg_raw()` (single-source-of-truth de la marca), así que
// sigue siendo una ruta `@get` — no un archivo duplicado en disco.

from brand import logo_svg_raw

@get("/favicon.svg")
fn favicon() -> Response {
    return Response {
        status: 200,
        content_type: "image/svg+xml",
        headers: { "Cache-Control": "public, max-age=604800" },
        body: logo_svg_raw(),
    }
}
