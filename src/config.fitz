// config.fitz — toda la configuración por entorno en un solo lugar.
//
// Fitz no auto-carga .env (explícito > mágico), así que main.fitz llama a
// load_env(".env") al arrancar. En Docker las variables vienen del compose.

fn db_url() -> Str {
    return env_or("DATABASE_URL",
        "postgres://mathelp:mathelp@localhost:5432/mathelp?sslmode=disable")
}

fn jwt_secret() -> Str {
    return env_or("JWT_SECRET", "mathelp-dev-cambiame-en-produccion")
}

fn session_cookie_name() -> Str => "mathelp_session"

fn lang_cookie_name() -> Str => "mathelp_lang"

fn default_locale() -> Str {
    return env_or("MATHELP_DEFAULT_LOCALE", "es-AR")
}

fn app_name() -> Str => "MatHelp"

fn repo_fitz() -> Str => "https://github.com/Thegreekman76/fitz"

fn repo_liveviews() -> Str => "https://github.com/Thegreekman76/fitz-liveviews"

// Puerto: lo lee el compose. @server() necesita literal, así que si lo
// cambiás, cambialo también en main.fitz y en docker-compose.yml.
fn app_port() -> Int => 3000

// --- Reporte semanal por email ------------------------------------------------
//
// El @cron lee SÓLO estas env vars (el core del lenguaje lee SMTP_HOST/PORT/USER/
// PASSWORD/FROM/TLS por su cuenta al hacer smtp.send). El reporte está APAGADO por
// default: hay que setear MATHELP_WEEKLY_REPORT=1 y configurar el SMTP.
fn reporte_habilitado() -> Bool {
    return env_or("MATHELP_WEEKLY_REPORT", "0") == "1"
}

// La URL pública de la app (para el link "Ver el panel" del email).
fn app_url() -> Str {
    return env_or("MATHELP_PUBLIC_URL", "https://mathelp.example")
}

// Emails con acceso de administrador del sitio (super-admin). Lista separada por
// comas, SIN espacios: MATHELP_ADMIN_EMAILS=a@x.com,b@y.com. Vacío = sin admin.
// La usa el aviso de registro (Fase A) y el gate del panel admin (Fase C).
fn admin_emails() -> List<Str> {
    let raw = env_or("MATHELP_ADMIN_EMAILS", "")
    if (raw == "") {
        return []
    }
    return raw.split(",")
}

// ¿Este email es admin del sitio?
fn es_admin_email(email: Str) -> Bool {
    for a in admin_emails() {
        if (a == email) {
            return true
        }
    }
    return false
}

// Resend HTTP API — usado en prod (el VPS de DigitalOcean bloquea SMTP
// outbound). Si RESEND_API_KEY está seteada, el reporte se manda por
// https://api.resend.com/emails; si no, cae al smtp.send del core (dev local).
fn resend_api_key() -> Str => env_or("RESEND_API_KEY", "")

// From del email del reporte. Con Resend tiene que ser un dominio verificado
// (mathelp.prothos.com.ar). El core lee SMTP_FROM al hacer smtp.send; acá lo
// leemos también para pasárselo a Resend explícitamente.
fn report_from() -> Str => env_or("SMTP_FROM", "MatHelp <no-reply@mathelp.prothos.com.ar>")
