// Trigonometria.fitzv — el juego "Trigonometría" (F7.4), como LiveComponent SSR.
//
// Triángulo rectángulo con FIGURA (SVG inline). Respuesta numérica (longitud
// entera positiva) por teclado, así que va SIN ± (no hay evento signo). Ronda
// fija de N, sin reloj, no adaptativo (gen_trig no usa ratings). La persistencia
// la hace el loop del @ws en live_trigonometria.fitz.
//
// NOTA (FLV-02): el `<svg>` de la figura vive en el root diffeado del componente
// (se re-renderiza en cada tick). No lleva `<style>`/`<script>` adentro (se estila
// por clases desde brand.fitz) — el smoke E2E verifica que el diff no lo corrompe.
//
// Tres eventos: digito / borrar / answer.

from gen_arith import gen_trig
from keypad import kp_append, kp_borrar
from engine import a_int
from trig_view import trig_screen

component trig {
  state {
    seed: Int = 0
    idx: Int = 0
    grade: Int = 12
    locale: Str = "es-AR"
    correct: Int = 0
    total: Int = 0
    phase: Str = "playing"         // "playing" | "done"
    feedback: Str = ""             // "" | "ok" | "bad"
    last_answer: Int = 0           // la respuesta del ejercicio recién fallado
    entrada: Int = 0               // lo tipeado
    touched: Bool = false          // ¿tipeó algo?
    limit: Int = 10                // ejercicios por ronda
  }

  event digito() {
    if (phase == "playing") {
      if (payload.has("d")) {
        entrada = kp_append(entrada, a_int(payload["d"]), 9999)
        touched = true
      }
    }
  }

  event borrar() {
    if (phase == "playing") {
      entrada = kp_borrar(entrada)
    }
  }

  event answer() {
    if (phase == "playing") {
      if (payload.has("v")) {
        if (payload.has("ei")) {
          let ei = a_int(payload["ei"])
          if (ei == idx) {
            let given = a_int(payload["v"])
            if (touched) {
              let ex = gen_trig(seed, idx, grade)
              let acierto = given == ex.answer
              total = total + 1
              if (acierto) {
                correct = correct + 1
                feedback = "ok"
              }
              if (not acierto) {
                feedback = "bad"
                last_answer = ex.answer
              }
              entrada = 0
              touched = false
              idx = idx + 1
              if (total >= limit) {
                phase = "done"
              }
            }
          }
        }
      }
    }
  }

  <template>
    <div id="trig-app" class="mh-quiz">
      {trig_screen(seed, idx, grade, locale, correct, total, limit, phase, feedback, last_answer, entrada, touched).raw}
    </div>
  </template>
}
