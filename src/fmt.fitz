// fmt.fitz — MÓDULO AISLADO.
//
// Los format specs de Fitz v0.47.0 SÍ compilan en `fitz build` (verificado
// empíricamente contra el binario: la tabla de docs/guide.md:1266 está
// desactualizada). Pero no conocen locale: `{n:,}` siempre agrupa al estilo
// inglés — 1,234,567 — y `{r:.1%}` siempre da 42.0%.
//
// En es-AR se escribe 1.234.567 y 42,0 %. Un juego de matemática que muestra
// mal los decimales le está enseñando mal al chico: esto NO es cosmético.
//
// REGLA DEL PROYECTO: ningún número crudo en la UI. Siempre vía fmt_*.
//
// Firma pensada para migrar a `num.format(x, locale:)` cuando exista.
// Ver docs/norte-mathelp.md · FITZ-04.

// Separador de miles por locale.
fn sep_miles(locale: Str) -> Str {
    return match locale {
        "es-AR" => ".",
        "es-ES" => ".",
        "pt-BR" => ".",
        _ => ",",
    }
}

// Separador decimal por locale.
fn sep_decimal(locale: Str) -> Str {
    return match locale {
        "es-AR" => ",",
        "es-ES" => ",",
        "pt-BR" => ",",
        _ => ".",
    }
}

// Espacio antes del % (es-AR sí, en no).
fn espacio_pct(locale: Str) -> Str {
    return match locale {
        "es-AR" => " ",
        "es-ES" => " ",
        "pt-BR" => " ",
        _ => "",
    }
}

// Agrupa de a 3 desde la derecha. Recibe solo dígitos, sin signo.
fn agrupar(digitos: Str, sep: Str) -> Str {
    // La anotación NO es decorativa: sin ella `[]` infiere List<Any>, y el
    // codegen rechaza `Str + Any` — aunque `fitz check` y `fitz run` lo
    // aceptan sin chistar. Error que solo aparece al compilar. Ver T2.
    let chars: List<Str> = []
    for c in digitos.split("") {
        if (c != "") {
            chars.push(c)
        }
    }
    let n = chars.len()
    if (n <= 3) {
        return digitos
    }
    let out = ""
    let i = 0
    while (i < n) {
        let restantes = n - i
        out = out + chars[i]
        if (restantes > 1 and (restantes - 1) % 3 == 0) {
            out = out + sep
        }
        i = i + 1
    }
    return out
}

// --- API pública ---------------------------------------------------------

// Entero con separador de miles del locale.  1234567 → "1.234.567" (es-AR)
fn fmt_int(locale: Str, n: Int) -> Str {
    if (n < 0) {
        return "-" + agrupar("{0 - n}", sep_miles(locale))
    }
    return agrupar("{n}", sep_miles(locale))
}

// Decimal con N dígitos.  1234.5, 1 → "1.234,5" (es-AR)
fn fmt_dec(locale: Str, x: Float, digitos: Int) -> Str {
    let crudo = match digitos {
        0 => "{x:.0f}",
        1 => "{x:.1f}",
        2 => "{x:.2f}",
        3 => "{x:.3f}",
        _ => "{x:.2f}",
    }
    let negativo = crudo.starts_with("-")
    let cuerpo = match negativo {
        true => crudo.replace("-", ""),
        false => crudo,
    }
    let partes = cuerpo.split(".")
    let entera = agrupar(partes[0], sep_miles(locale))
    let signo = match negativo {
        true => "-",
        false => "",
    }
    if (partes.len() < 2) {
        return signo + entera
    }
    return signo + entera + sep_decimal(locale) + partes[1]
}

// Porcentaje desde una razón 0..1.  0.42, 1 → "42,0 %" (es-AR) / "42.0%" (en)
fn fmt_pct(locale: Str, razon: Float, digitos: Int) -> Str {
    return fmt_dec(locale, razon * 100.0, digitos) + espacio_pct(locale) + "%"
}

// Dinero. Recibe CENTAVOS como Int — nunca Float, para no arrastrar error
// de punto flotante en el juego del kiosco.  125000 → "$ 1.250,00" (es-AR)
fn fmt_money(locale: Str, centavos: Int) -> Str {
    let negativo = centavos < 0
    let abs_c = match negativo {
        true => 0 - centavos,
        false => centavos,
    }
    let enteros = abs_c / 100
    let resto = abs_c % 100
    let dec = match resto < 10 {
        true => "0{resto}",
        false => "{resto}",
    }
    let cuerpo = agrupar("{enteros}", sep_miles(locale)) + sep_decimal(locale) + dec
    let signo = match negativo {
        true => "-",
        false => "",
    }
    return match locale {
        "es-AR" => signo + "$ " + cuerpo,
        "es-ES" => signo + cuerpo + " €",
        "pt-BR" => signo + "R$ " + cuerpo,
        _ => signo + "$" + cuerpo,
    }
}

// Fracción para mostrar en pantalla: 3/4. Se localiza el separador visual
// por si algún locale futuro lo necesita distinto.
fn fmt_fraccion(locale: Str, num: Int, den: Int) -> Str {
    return "{num}/{den}"
}
