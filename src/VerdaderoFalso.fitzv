// VerdaderoFalso.fitzv — el juego Verdadero o Falso, como LiveComponent SSR.
//
// Mismo esqueleto que Quiz.fitzv (el contrarreloj): estado primitivo en el
// component store (keyed por instance_id), reloj empujado por el server, y el
// ejercicio se DERIVA de (seed, idx) en cada render (no se guarda). La única
// diferencia es la presentación: en vez de 4 opciones, se muestra UNA afirmación
// "a op b = shown" y dos botones (Verdadero / Falso). El valor `shown` sale de
// gen_arith.vf_shown (determinista): mitad verdad, mitad distractor.
//
// La persistencia (Attempt + mastery + racha) NO vive acá: la hace el loop del
// @ws en live_vf.fitz, que re-deriva el mismo ejercicio y valor mostrado. Los
// `event` son mutaciones puras en memoria (patrón Admin ABM / Quiz).

from gen_arith import gen_for, vf_shown
from engine import puntos, a_int
from vf_view import vf_screen

component verdadero_falso {
  state {
    seed: Int = 0
    idx: Int = 0
    grade: Int = 4
    locale: Str = "es-AR"
    score: Int = 0
    correct: Int = 0
    total: Int = 0
    racha: Int = 0
    racha_max: Int = 0
    record_prev: Int = 999999
    time_left: Int = 60
    phase: Str = "playing"         // "playing" | "done"
    feedback: Str = ""             // "" | "ok" | "bad"
    correct_last: Bool = false     // la verdad del ejercicio recién fallado (para el feedback)
    mode: Str = "adaptive"         // "adaptive" (contrarreloj V/F) | "desafio"
    r_add: Float = 800.0
    r_sub: Float = 800.0
    r_mul: Float = 800.0
    r_div: Float = 800.0
    limit: Int = 0                 // 0 = sin límite (contrarreloj); >0 = termina tras N (desafío)
  }

  event answer() {
    if (phase == "playing") {
      if (payload.has("v")) {
        if (payload.has("ei")) {
          let ei = a_int(payload["ei"])
          if (ei == idx) {
            let dijo_verdad = a_int(payload["v"]) == 1
            let ex = gen_for(mode, "mix", 2, seed, idx, grade, r_add, r_sub, r_mul, r_div)
            let shown = vf_shown(ex, seed, idx)
            let es_verdad = shown == ex.answer
            let acierto = dijo_verdad == es_verdad
            total = total + 1
            if (acierto) {
              correct = correct + 1
              score = score + puntos(true, ex.difficulty)
              feedback = "ok"
              racha = racha + 1
              if (racha > racha_max) {
                racha_max = racha
              }
            }
            if (not acierto) {
              feedback = "bad"
              racha = 0
              correct_last = es_verdad
            }
            idx = idx + 1
            if (limit > 0) {
              if (total >= limit) {
                phase = "done"
              }
            }
          }
        }
      }
    }
  }

  event tick() {
    if (phase == "playing") {
      time_left = time_left - 1
      if (time_left <= 0) {
        time_left = 0
        phase = "done"
      }
    }
  }

  // Fin del reloj (lo dispara el server al agotarse el tiempo). El conteo visible
  // es client-side (public/sound.js): así no re-renderizamos el componente entero
  // cada segundo (eso parpadeaba). El server marca "done" acá.
  event timeup() {
    if (phase == "playing") {
      time_left = 0
      phase = "done"
    }
  }

  <template>
    <div id="vf-app" class="mh-quiz">
      {vf_screen(seed, idx, grade, locale, score, correct, total, time_left, phase, feedback, correct_last, mode, r_add, r_sub, r_mul, r_div, limit, racha, racha_max, record_prev).raw}
    </div>
  </template>
}
