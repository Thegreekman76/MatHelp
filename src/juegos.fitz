// juegos.fitz — catálogo data-driven de los juegos (IA de menú, §6.5).
//
// El menú "Elegir juego" se arma desde esta lista: cada juego es una fila
// {code, min_grade, icon, route, built}. La grilla (menu.fitz) filtra por el
// grado del perfil, bloquea los que aún no le tocan (min_grade > grade) y marca
// "Próximamente" los que todavía no tienen generador (built == false). Sumar un
// juego de F4/F5 = agregar una fila acá + su .fitzv/ruta, sin tocar el menú.
//
// Decisión (§6.5): "Práctica libre" NO es una carta de esta grilla — es una
// entrada propia del home de juego (tiene su flujo tema → dificultad). Acá van
// solo los juegos con mecánica dedicada.

// Una carta del menú. `code` es el sufijo de la clave i18n "juego.<code>" y el
// ícono es un emoji visible. `route` solo importa cuando `built == true`.
type Juego {
    code: Str = ""
    min_grade: Int = 1
    icon: Str = ""
    route: Str = ""
    built: Bool = false
    modalidad: Str = "comun"     // "comun" = todos; si no, sólo esa orientación (F7.3)
    categoria: Str = "calculo"   // agrupa las cartas en el menú (F9 pulido)
    nuevo: Bool = false          // marca la carta con un badge "nuevo" (F9)
}

// El catálogo, en orden de aparición. Hoy solo el contrarreloj es jugable (F2);
// el resto llega en F4/F5 y sale "Próximamente". Los `min_grade` siguen la
// grilla por grado de §6.5, con "Problemas con historia" desde 1º (§6.6:
// razonamiento como tema transversal, no juego tardío).
fn juegos() -> List<Juego> {
    return [
        Juego { code: "contrarreloj", min_grade: 1, icon: "⏱", route: "/jugar", built: true, categoria: "calculo" },
        Juego { code: "verdadero_falso", min_grade: 1, icon: "✅", route: "/vf", built: true, categoria: "calculo" },
        Juego { code: "completa", min_grade: 2, icon: "🔢", route: "/completa", built: true, categoria: "calculo" },
        Juego { code: "escalera", min_grade: 2, icon: "🪜", route: "/escalera", built: true, categoria: "calculo" },
        Juego { code: "series", min_grade: 1, icon: "🧩", route: "/series", built: true, categoria: "pensar" , nuevo: true },
        Juego { code: "memoria", min_grade: 1, icon: "🃏", route: "/memoria", built: true, categoria: "pensar" , nuevo: true },
        Juego { code: "ordenar", min_grade: 1, icon: "📊", route: "/ordenar", built: true, categoria: "pensar" , nuevo: true },
        Juego { code: "estimar", min_grade: 3, icon: "🎯", route: "/estimar", built: true, categoria: "pensar" , nuevo: true },
        Juego { code: "estadistica", min_grade: 6, icon: "📉", route: "/estadistica", built: true, categoria: "pensar" , nuevo: true },
        Juego { code: "historia", min_grade: 1, icon: "📖", route: "/historia", built: true, categoria: "problemas" , nuevo: true },
        Juego { code: "kiosco", min_grade: 4, icon: "🧮", route: "/problemas", built: true, categoria: "problemas" },
        Juego { code: "finanzas", min_grade: 11, icon: "💰", route: "/finanzas", built: true, modalidad: "comercial", categoria: "problemas" },
        Juego { code: "fracciones", min_grade: 4, icon: "🍕", route: "/fracciones", built: true, categoria: "fracciones" },
        Juego { code: "porcentaje", min_grade: 6, icon: "％", route: "/porcentaje", built: true, categoria: "fracciones" , nuevo: true },
        Juego { code: "hora", min_grade: 2, icon: "🕐", route: "/hora", built: true, categoria: "medida" , nuevo: true },
        Juego { code: "geometria", min_grade: 5, icon: "📐", route: "/geometria", built: true, categoria: "medida" , nuevo: true },
        Juego { code: "volumen", min_grade: 6, icon: "📦", route: "/volumen", built: true, categoria: "medida" , nuevo: true },
        Juego { code: "trigonometria", min_grade: 10, icon: "🔺", route: "/trigonometria", built: true, categoria: "medida" },
        Juego { code: "enteros", min_grade: 7, icon: "±", route: "/enteros", built: true, categoria: "algebra" , nuevo: true },
        Juego { code: "potencias", min_grade: 8, icon: "🔷", route: "/potencias", built: true, categoria: "algebra" },
        Juego { code: "ecuaciones", min_grade: 8, icon: "🟰", route: "/ecuaciones", built: true, categoria: "algebra" },
        Juego { code: "funciones", min_grade: 11, icon: "📈", route: "/funciones", built: true, categoria: "algebra" },
    ]
}
