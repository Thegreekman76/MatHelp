        "tienda.avatares" => "Avatares",
        "tienda.comprar" => "Comprar",
        "tienda.monedas" => "\{0\} monedas",
        "tienda.sub" => "Ganás monedas cada vez que respondés bien. Gastalas en avatares y temas nuevos.",
        "tienda.temas" => "Temas de color",
        "tienda.titulo" => "Tienda",
