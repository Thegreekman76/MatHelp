// tests/teclado.fitz — el teclado numérico propio (keypad.fitz).
//
// Se llama `teclado` y no `keypad` a propósito: un test homónimo del módulo que
// importa se auto-importa → ciclo (FITZ-21, ver CLAUDE.md).
//
// La entrada tipeada se acumula como Int: agregar un dígito es *10 + d, borrar
// es /10. Cubre: acumulación, tope máximo, borrado, ceros a la izquierda, y que
// dígitos fuera de 0..9 se ignoren.

from keypad import kp_append, kp_borrar

@test fn acumula_digitos() {
    let e = 0
    e = kp_append(e, 5, 99999)     // 5
    e = kp_append(e, 6, 99999)     // 56
    assert_eq(e, 56)
    e = kp_append(e, 0, 99999)     // 560
    assert_eq(e, 560)
}

@test fn cero_a_la_izquierda_se_descarta() {
    let e = 0
    e = kp_append(e, 0, 99999)     // sigue 0 (0*10+0)
    assert_eq(e, 0)
    e = kp_append(e, 7, 99999)     // 7
    assert_eq(e, 7)
}

@test fn respeta_el_maximo() {
    let e = 999
    let e2 = kp_append(e, 9, 999)  // 9999 > 999 → no agrega
    assert_eq(e2, 999)
    let e3 = kp_append(99, 9, 999) // 999 == max → OK
    assert_eq(e3, 999)
}

@test fn ignora_no_digitos() {
    assert_eq(kp_append(5, 10, 99999), 5)   // 10 no es dígito
    assert_eq(kp_append(5, -1, 99999), 5)
}

@test fn borrar_quita_el_ultimo() {
    assert_eq(kp_borrar(56), 5)
    assert_eq(kp_borrar(5), 0)
    assert_eq(kp_borrar(0), 0)     // vacío queda vacío
    assert_eq(kp_borrar(560), 56)
}
