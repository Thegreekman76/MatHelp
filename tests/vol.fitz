// tests/vol.fitz — el generador de "Volumen" (gen_vol.fitz).
//
// (Nombre distinto del módulo importado → sin ciclo, FITZ-21.)
//
// Invariante clave: la respuesta coincide con la fórmula del volumen según el cuerpo
// (cubo a³ / prisma a·b·c / cilindro 3·r²·h con π≈3 / compuesto a·b·c + d³) y SIEMPRE
// es un entero positivo.

from gen_vol import gen_vol, VolItem

@test fn vol_reproducible() {
    let idx = 0
    while (idx < 60) {
        let a = gen_vol(2323, idx, 8)
        let b = gen_vol(2323, idx, 8)
        assert_eq(a.answer, b.answer)
        assert_eq(a.kind, b.kind)
        idx = idx + 1
    }
}

@test fn vol_formula_correcta() {
    let grades = [6, 7, 8, 10, 13]
    for gr in grades {
        let idx = 0
        while (idx < 30) {
            let it = gen_vol(2020, idx, gr)
            let esperado = 0
            if (it.kind == "cubo") {
                esperado = it.a * it.a * it.a
            }
            if (it.kind == "prisma") {
                esperado = it.a * it.b * it.c
            }
            if (it.kind == "cilindro") {
                esperado = 3 * it.a * it.a * it.b
            }
            if (it.kind == "compuesto") {
                esperado = it.a * it.b * it.c + it.d * it.d * it.d
            }
            assert_eq(it.answer, esperado)
            assert(it.answer > 0)
            assert(it.difficulty >= 1)
            assert(it.difficulty <= 5)
            idx = idx + 1
        }
    }
}

@test fn vol_grade6_cubo() {
    let it = gen_vol(3, 0, 6)
    assert_eq(it.kind, "cubo")
    assert_eq(it.difficulty, 1)
}

@test fn vol_rampa_por_grado() {
    let bajo = gen_vol(4, 0, 6)
    assert_eq(bajo.difficulty, 1)
    let alto = gen_vol(4, 30, 13)
    assert_eq(alto.difficulty, 5)
}
