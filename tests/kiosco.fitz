// tests/kiosco.fitz — el generador de "Problemas" (gen_kiosco.fitz).
//
// (Se llama `kiosco`, no `gen_kiosco`: distinto nombre del módulo importado, así
// que no hay auto-import ni ciclo — FITZ-21. Nombre interno histórico.)
//
// Cubre: reproducibilidad, respuesta siempre positiva, producto del pool, la
// fórmula exacta de cada tipo (total/vuelto/reparto/cuantos/oferta), la cobertura
// por grado (F8: un 4° no ve reparto/cuantos/oferta; un 7° sí) y la rampa por idx.

from gen_kiosco import gen_kiosco, kiosco_max, kiosco_items, KioscoItem

fn contiene_str(xs: List<Str>, t: Str) -> Bool {
    for x in xs {
        if (x == t) {
            return true
        }
    }
    return false
}

@test fn kiosco_reproducible() {
    let idx = 0
    while (idx < 100) {
        let a = gen_kiosco(5151, idx, 4)
        let b = gen_kiosco(5151, idx, 4)
        assert_eq(a.kind, b.kind)
        assert_eq(a.a, b.a)
        assert_eq(a.b, b.b)
        assert_eq(a.c, b.c)
        assert_eq(a.answer, b.answer)
        idx = idx + 1
    }
}

// La respuesta SIEMPRE es un entero positivo (el teclado la exige > 0). Cubre
// varios grados y muchos idx.
@test fn respuesta_siempre_positiva() {
    for grade in [4, 5, 6, 7] {
        let idx = 0
        while (idx < 60) {
            let k = gen_kiosco(2727, idx, grade)
            assert_eq(k.answer > 0, true)
            idx = idx + 1
        }
    }
}

@test fn producto_del_pool() {
    let pool = kiosco_items()
    let idx = 0
    while (idx < 100) {
        let k = gen_kiosco(333, idx, 4)
        assert_eq(contiene_str(pool, k.item), true)
        idx = idx + 1
    }
}

// Cada uno de los 10 tipos cumple su fórmula. Cubre todos los grados/idx.
@test fn cada_tipo_cumple_su_formula() {
    for grade in [4, 5, 6, 7] {
        let idx = 0
        while (idx < 60) {
            let k = gen_kiosco(8080, idx, grade)
            if (k.kind == "total") {
                assert_eq(k.answer, k.a * k.b)
            }
            if (k.kind == "suma") {
                assert_eq(k.answer, k.a + k.b + k.c)
            }
            if (k.kind == "vuelto") {
                assert_eq(k.answer, k.b - k.a)
                assert_eq(k.b > k.a, true)
            }
            if (k.kind == "falta") {
                assert_eq(k.answer, k.a - k.b)
                assert_eq(k.a > k.b, true)          // el precio es mayor que lo que tenés
            }
            if (k.kind == "comparar") {
                assert_eq(k.answer, k.a - k.b)
                assert_eq(k.a > k.b, true)          // a = el más caro
            }
            if (k.kind == "reparto") {
                assert_eq(k.a % k.b, 0)             // división exacta
                assert_eq(k.answer, k.a / k.b)
            }
            if (k.kind == "cuantos") {
                assert_eq(k.a, k.answer * k.b)      // plata = cuántos · precio
                assert_eq(k.b % 50, 0)              // precio redondo
            }
            if (k.kind == "descuento") {
                assert_eq(k.answer, k.a - k.a * k.b / 100)
                assert_eq(k.a * k.b % 100, 0)       // descuento exacto
            }
            if (k.kind == "oferta") {
                assert_eq(k.answer, k.c - k.a * k.b)
                assert_eq(k.c > k.a * k.b, true)
            }
            if (k.kind == "combo") {
                assert_eq(k.answer, k.a * k.b + k.c)
            }
            assert_eq(k.answer > 0, true)           // toda respuesta es positiva
            idx = idx + 1
        }
    }
}

// Cobertura por grado (F8): un 4° (niveles 1..2) sólo ve tipos de tier 1-2, NUNCA
// tier 3+ (reparto/descuento/combo). Un 7° (niveles 2..5) sí llega a esos.
@test fn cobertura_por_grado() {
    let g4: List<Str> = []
    let s = 0
    while (s < 60) {
        let idx = 0
        while (idx < 10) {
            let k = gen_kiosco(1000 + s, idx, 4)
            if (not contiene_str(g4, k.kind)) {
                g4.push(k.kind)
            }
            idx = idx + 1
        }
        s = s + 1
    }
    assert_eq(contiene_str(g4, "reparto"), false)     // tier 3 no le toca a 4°
    assert_eq(contiene_str(g4, "descuento"), false)   // tier 4
    assert_eq(contiene_str(g4, "combo"), false)       // tier 5
    // Y sí ve variedad de tier 1-2:
    assert_eq(contiene_str(g4, "suma") or contiene_str(g4, "total"), true)
    assert_eq(contiene_str(g4, "falta") or contiene_str(g4, "comparar") or contiene_str(g4, "vuelto"), true)

    let g7: List<Str> = []
    s = 0
    while (s < 60) {
        let idx = 0
        while (idx < 10) {
            let k = gen_kiosco(2000 + s, idx, 7)
            if (not contiene_str(g7, k.kind)) {
                g7.push(k.kind)
            }
            idx = idx + 1
        }
        s = s + 1
    }
    assert_eq(contiene_str(g7, "reparto"), true)
    assert_eq(contiene_str(g7, "descuento"), true)
    assert_eq(contiene_str(g7, "combo"), true)
}

// De-dup por sesión: en una ronda de 10 ningún problema se repite (misma firma
// kind+números). Cubre varios grados y semillas.
@test fn sin_repetidos_en_la_ronda() {
    for grade in [4, 6, 7] {
        let semilla = 0
        while (semilla < 30) {
            let vistos: List<Str> = []
            let idx = 0
            while (idx < 10) {
                let k = gen_kiosco(31415 + semilla, idx, grade)
                let f = "{k.kind}|{k.a}|{k.b}|{k.c}"
                assert_eq(contiene_str(vistos, f), false)   // no se repite
                vistos.push(f)
                idx = idx + 1
            }
            semilla = semilla + 1
        }
    }
}

// La dificultad (= nivel) sube dentro de la ronda: el primer problema es más
// fácil que el último.
@test fn dificultad_sube_con_idx() {
    let k0 = gen_kiosco(77, 0, 7)
    let k9 = gen_kiosco(77, 9, 7)
    assert_eq(k9.difficulty > k0.difficulty, true)
}
