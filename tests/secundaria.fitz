// tests/secundaria.fitz — helpers de nivel/modalidad de F7 (engine.fitz).
//
// La numeración de `grade` se extiende en F7: primaria 1..7, secundaria 8..13
// (= 1°..6°). El Ciclo Orientado (donde la modalidad importa) es 4°..6° de
// secundaria = grade 11..13. `modalidad_valida` normaliza la orientación.
//
// Corré con:  fitz test

from engine import es_secundaria, anio_secundaria, es_ciclo_orientado, modalidad_valida
from gen_arith import gen, gen_potencia, ipow, gen_ecuacion, ecuacion_correcta, gen_finanzas, gen_trig, gen_func, nivel_por_idx, grado_efectivo, nivel_piso_ecuacion, nivel_techo_ecuacion
from fmt import fmt_operando

// --- es_secundaria (grade >= 8) ---------------------------------------------

@test fn primaria_no_es_secundaria() {
    assert_eq(es_secundaria(1), false)
    assert_eq(es_secundaria(7), false)
}

@test fn desde_octavo_es_secundaria() {
    assert_eq(es_secundaria(8), true)
    assert_eq(es_secundaria(13), true)
}

// --- anio_secundaria (grade - 7 en secundaria; el grado en primaria) --------

@test fn anio_secundaria_mapea_octavo_a_primero() {
    assert_eq(anio_secundaria(8), 1)
    assert_eq(anio_secundaria(13), 6)
}

@test fn anio_secundaria_devuelve_el_grado_en_primaria() {
    assert_eq(anio_secundaria(4), 4)
    assert_eq(anio_secundaria(7), 7)
}

// --- es_ciclo_orientado (grade >= 11 = 4° de secundaria) --------------------

@test fn ciclo_basico_no_es_orientado() {
    assert_eq(es_ciclo_orientado(7), false)   // primaria
    assert_eq(es_ciclo_orientado(10), false)  // 3° secundaria (Ciclo Básico)
}

@test fn desde_cuarto_secundaria_es_orientado() {
    assert_eq(es_ciclo_orientado(11), true)   // 4° secundaria
    assert_eq(es_ciclo_orientado(13), true)   // 6° secundaria
}

// --- modalidad_valida (normaliza a un valor conocido) -----------------------

@test fn modalidad_conocida_pasa_tal_cual() {
    assert_eq(modalidad_valida("bachiller"), "bachiller")
    assert_eq(modalidad_valida("comercial"), "comercial")
    assert_eq(modalidad_valida("industrial"), "industrial")
    assert_eq(modalidad_valida("comun"), "comun")
}

@test fn modalidad_desconocida_cae_a_comun() {
    assert_eq(modalidad_valida(""), "comun")
    assert_eq(modalidad_valida("cualquier-cosa"), "comun")
    assert_eq(modalidad_valida("COMERCIAL"), "comun")   // case-sensitive a propósito
}

// --- F7.1: enteros con signo (gen para grade >= 8) --------------------------

// Determinista: mismo (op, seed, idx, grade) ⇒ mismo ejercicio (paridad
// seed+idx, la regla de oro del generador).
@test fn gen_sec_es_determinista() {
    let e1 = gen("mul", 12345, 3, 8)
    let e2 = gen("mul", 12345, 3, 8)
    assert_eq(e1.a, e2.a)
    assert_eq(e1.b, e2.b)
    assert_eq(e1.answer, e2.answer)
}

// El invariante de la operación se cumple con signo: a + b == answer (suma),
// a - b == answer (resta) — nada de forzar a >= b en secundaria.
@test fn gen_sec_suma_y_resta_cierran() {
    let s = gen("add", 777, 5, 9)
    assert_eq(s.a + s.b, s.answer)
    let r = gen("sub", 777, 5, 9)
    assert_eq(r.a - r.b, r.answer)
}

// La multiplicación con signo cierra, y la división es exacta (a / b == answer).
@test fn gen_sec_mult_y_div_cierran() {
    let m = gen("mul", 999, 2, 10)
    assert_eq(m.a * m.b, m.answer)
    let d = gen("div", 999, 2, 10)
    assert_eq(d.a / d.b, d.answer)
}

// Secundaria SÍ produce negativos: en 40 ejercicios de suma a grade 8, al menos
// uno tiene un operando o resultado negativo (con rango [-200,200] es casi
// seguro; el test es determinista sobre el seed fijo).
@test fn gen_sec_produce_negativos() {
    let hubo_negativo = false
    for i in 0..40 {
        let e = gen("add", 4242, i, 8)
        if (e.a < 0 or e.b < 0 or e.answer < 0) {
            hubo_negativo = true
        }
    }
    assert_eq(hubo_negativo, true)
}

// Primaria NO produce negativos: los operandos de suma/resta son >= 0 (paridad —
// el camino de primaria quedó intacto).
@test fn primaria_no_produce_negativos() {
    for i in 0..40 {
        let e = gen("sub", 4242, i, 4)
        assert_eq(e.a >= 0, true)
        assert_eq(e.b >= 0, true)
        assert_eq(e.answer >= 0, true)   // la resta de primaria fuerza a >= b
    }
}


// --- fmt_operando (paréntesis en negativos, byte-idéntico en >= 0) -----------

@test fn fmt_operando_no_toca_positivos() {
    assert_eq(fmt_operando("es-AR", 5), "5")
    assert_eq(fmt_operando("es-AR", 0), "0")
    assert_eq(fmt_operando("en", 42), "42")
}

@test fn fmt_operando_parentiza_negativos() {
    assert_eq(fmt_operando("es-AR", 0 - 5), "(-5)")
    assert_eq(fmt_operando("en", 0 - 42), "(-42)")
}

// --- F7.1.b: potencias y raíces ---------------------------------------------

@test fn ipow_calcula_potencias() {
    assert_eq(ipow(2, 5), 32)
    assert_eq(ipow(10, 3), 1000)
    assert_eq(ipow(0 - 3, 2), 9)       // base negativa, exp par → positivo
    assert_eq(ipow(0 - 2, 3), 0 - 8)   // base negativa, exp impar → negativo
    assert_eq(ipow(7, 0), 1)           // exponente 0
}

@test fn gen_potencia_es_determinista() {
    let e1 = gen_potencia(555, 7, 8)
    let e2 = gen_potencia(555, 7, 8)
    assert_eq(e1.a, e2.a)
    assert_eq(e1.b, e2.b)
    assert_eq(e1.answer, e2.answer)
    assert_eq(e1.op, e2.op)
}

// Cada ejercicio cumple su invariante: potencia a^b == answer; raíz exacta
// answer^b == a (el radicando); notación científica m × 10^k == answer. Grado 10
// (niveles 2..4) despliega los tres OPs (pot/raiz/scinot) al subir el idx.
@test fn gen_potencia_invariantes() {
    let vio_pot = false
    let vio_raiz = false
    let vio_scinot = false
    for i in 0..40 {
        let e = gen_potencia(31337, i, 10)
        if (e.op == "raiz") {
            assert_eq(ipow(e.answer, e.b), e.a)
            vio_raiz = true
        }
        if (e.op == "pot") {
            assert_eq(ipow(e.a, e.b), e.answer)
            vio_pot = true
        }
        if (e.op == "scinot") {
            assert_eq(e.a * ipow(10, e.b), e.answer)
            vio_scinot = true
        }
    }
    assert_eq(vio_pot, true)
    assert_eq(vio_raiz, true)
    assert_eq(vio_scinot, true)
}

// --- F7.2: ecuaciones -------------------------------------------------------

@test fn gen_ecuacion_es_determinista() {
    let e1 = gen_ecuacion(888, 4, 9)
    let e2 = gen_ecuacion(888, 4, 9)
    assert_eq(e1.a, e2.a)
    assert_eq(e1.b, e2.b)
    assert_eq(e1.answer, e2.answer)
    assert_eq(e1.op, e2.op)
}

@test fn gen_ecuacion_aparecen_los_tres_tipos() {
    let vio_lin = false
    let vio_cuad = false
    let vio_sist = false
    for i in 0..40 {
        let e = gen_ecuacion(12321, i, 11)
        if (e.op == "eclin") {
            vio_lin = true
        }
        if (e.op == "eccuad") {
            vio_cuad = true
        }
        if (e.op == "ecsist") {
            vio_sist = true
        }
    }
    assert_eq(vio_lin, true)
    assert_eq(vio_cuad, true)
    assert_eq(vio_sist, true)
}

// El sistema 2×2 tiene solución ÚNICA: el determinante a·b2 − a2·b ≠ 0. Cubre
// 40 idx deterministas (cada ecsist que aparezca).
@test fn gen_sistema_es_no_degenerado() {
    for i in 0..40 {
        let e = gen_ecuacion(555, i, 11)
        if (e.op == "ecsist") {
            let det = e.a * e.b2 - e.a2 * e.b
            assert_ne(det, 0)
        }
    }
}

@test fn ecuacion_correcta_lineal_exige_x() {
    assert_eq(ecuacion_correcta(4, 4, "eclin"), true)
    assert_eq(ecuacion_correcta(0 - 4, 4, "eclin"), false)   // -4 no resuelve
    assert_eq(ecuacion_correcta(5, 4, "eclin"), false)
}

@test fn ecuacion_correcta_cuadratica_acepta_ambas_raices() {
    assert_eq(ecuacion_correcta(7, 7, "eccuad"), true)
    assert_eq(ecuacion_correcta(0 - 7, 7, "eccuad"), true)   // ±7 valen
    assert_eq(ecuacion_correcta(6, 7, "eccuad"), false)
}

// --- F7.3: finanzas (diferencial comercial) ---------------------------------

@test fn gen_finanzas_es_determinista() {
    let e1 = gen_finanzas(999, 3, 11)
    let e2 = gen_finanzas(999, 3, 11)
    assert_eq(e1.a, e2.a)
    assert_eq(e1.b, e2.b)
    assert_eq(e1.a2, e2.a2)
    assert_eq(e1.answer, e2.answer)
    assert_eq(e1.op, e2.op)
}

// F8: cobertura por grado. Ningún grado ve los 5 tipos (cotas del currículum). Un
// 4° (grade 11, niveles 1..3) ve %, descuento e interés simple — NO compuesto ni
// punto de equilibrio. Un 6° (grade 13, niveles 2..5) sí llega a compuesto y punto
// de equilibrio (y ya no ve el % de nivel 1).
@test fn gen_finanzas_cobertura_por_grado() {
    let g11_pct = false
    let g11_desc = false
    let g11_simple = false
    let g11_comp = false
    let g11_break = false
    for i in 0..80 {
        let e = gen_finanzas(4242, i, 11)
        if (e.op == "finpct") { g11_pct = true }
        if (e.op == "findesc") { g11_desc = true }
        if (e.op == "finsimple") { g11_simple = true }
        if (e.op == "fincomp") { g11_comp = true }
        if (e.op == "finbreak") { g11_break = true }
    }
    assert_eq(g11_pct, true)
    assert_eq(g11_desc, true)
    assert_eq(g11_simple, true)
    assert_eq(g11_comp, false)    // interés compuesto no le toca a 4°
    assert_eq(g11_break, false)   // punto de equilibrio tampoco

    let g13_comp = false
    let g13_break = false
    let g13_pct = false
    for i in 0..80 {
        let e = gen_finanzas(4242, i, 13)
        if (e.op == "fincomp") { g13_comp = true }
        if (e.op == "finbreak") { g13_break = true }
        if (e.op == "finpct") { g13_pct = true }
    }
    assert_eq(g13_comp, true)
    assert_eq(g13_break, true)
    assert_eq(g13_pct, false)     // 6° ya no ve el % trivial de nivel 1
}

// Punto de equilibrio: Q = CF / (Precio − Costo). a=CF, b=Precio, a2=Costo. Q>0
// y divide exacto (por construcción CF = margen · Q). En 6° (grade 13) el nivel 5
// aparece al subir el idx.
@test fn gen_finanzas_punto_equilibrio_exacto() {
    for i in 0..80 {
        let e = gen_finanzas(4848, i, 13)
        if (e.op == "finbreak") {
            let margen = e.b - e.a2
            assert_eq(margen > 0, true)
            assert_eq(e.answer, e.a / margen)
            assert_eq(e.answer * margen, e.a)   // sin resto
        }
    }
}

// --- F7.4: trigonometría (triángulo rectángulo) -----------------------------

@test fn gen_trig_es_determinista() {
    let e1 = gen_trig(707, 5, 12)
    let e2 = gen_trig(707, 5, 12)
    assert_eq(e1.a, e2.a)
    assert_eq(e1.b, e2.b)
    assert_eq(e1.a2, e2.a2)
    assert_eq(e1.answer, e2.answer)
    assert_eq(e1.op, e2.op)
}

@test fn gen_trig_aparecen_los_tres_tipos() {
    let vio_hyp = false
    let vio_leg = false
    let vio_ang = false
    for i in 0..60 {
        let e = gen_trig(9090, i, 12)
        if (e.op == "trighyp") { vio_hyp = true }
        if (e.op == "trigleg") { vio_leg = true }
        if (e.op == "trigang") { vio_ang = true }
    }
    assert_eq(vio_hyp, true)
    assert_eq(vio_leg, true)
    assert_eq(vio_ang, true)
}

// Pitágoras cierra: en trighyp los catetos son a/b y la hipotenusa es la
// respuesta → a²+b²=answer². En trigleg el cateto conocido es a, la hipotenusa
// a2 y la incógnita answer → a²+answer²=a2².
@test fn gen_trig_pitagoras_cierra() {
    for i in 0..60 {
        let e = gen_trig(1212, i, 12)
        if (e.op == "trighyp") {
            assert_eq(e.a * e.a + e.b * e.b, e.answer * e.answer)
        }
        if (e.op == "trigleg") {
            assert_eq(e.a * e.a + e.answer * e.answer, e.a2 * e.a2)
        }
    }
}

// Razón 30°: sin(30°)=1/2. Modo 0 (dada hip par b, hallar cateto): answer=b/2.
// Modo 1 (dado cateto b, hallar hip): answer=2·b. Siempre entero positivo.
@test fn gen_trig_razon_treinta_grados() {
    for i in 0..60 {
        let e = gen_trig(3434, i, 12)
        if (e.op == "trigang") {
            assert_eq(e.a, 30)
            assert_eq(e.answer > 0, true)
            if (e.a2 == 0) {
                assert_eq(e.answer, e.b / 2)
                assert_eq(e.answer * 2, e.b)     // hipotenusa par
            }
            if (e.a2 == 1) {
                assert_eq(e.answer, e.b * 2)
            }
        }
    }
}

// --- F7.5: funciones (evaluar f(x)) -----------------------------------------

@test fn gen_func_es_determinista() {
    let e1 = gen_func(606, 6, 12)
    let e2 = gen_func(606, 6, 12)
    assert_eq(e1.a, e2.a)
    assert_eq(e1.b, e2.b)
    assert_eq(e1.a2, e2.a2)
    assert_eq(e1.answer, e2.answer)
    assert_eq(e1.op, e2.op)
}

@test fn gen_func_aparecen_las_tres_familias() {
    let vio_lin = false
    let vio_cuad = false
    let vio_exp = false
    for i in 0..60 {
        let e = gen_func(8181, i, 12)
        if (e.op == "funclin") { vio_lin = true }
        if (e.op == "funccuad") { vio_cuad = true }
        if (e.op == "funcexp") { vio_exp = true }
    }
    assert_eq(vio_lin, true)
    assert_eq(vio_cuad, true)
    assert_eq(vio_exp, true)
}

// Cada familia evalúa bien en x0 (a2): lineal a·x0+b, cuadrática a·x0²+b,
// exponencial a·b^x0. a2 es el punto; answer el valor.
@test fn gen_func_evalua_correcto() {
    for i in 0..60 {
        let e = gen_func(2929, i, 13)
        if (e.op == "funclin") {
            assert_eq(e.answer, e.a * e.a2 + e.b)
        }
        if (e.op == "funccuad") {
            assert_eq(e.answer, e.a * e.a2 * e.a2 + e.b)
            assert_eq(e.a > 0, true)          // parábola hacia arriba
        }
        if (e.op == "funcexp") {
            assert_eq(e.answer, e.a * ipow(e.b, e.a2))
            assert_eq(e.answer > 0, true)     // exponencial siempre positiva
        }
    }
}

// La pendiente del nivel 2 (lineal ±) aparece con los dos signos (gráfico
// sube/baja). Fijamos (grade 12, idx 4) → nivel 2, y variamos la semilla.
@test fn gen_func_lineal_pendiente_con_signo() {
    let vio_pos = false
    let vio_neg = false
    for s in 0..80 {
        let e = gen_func(s, 4, 12)
        if (e.op == "funclin") {
            if (e.a > 0) { vio_pos = true }
            if (e.a < 0) { vio_neg = true }
        }
    }
    assert_eq(vio_pos, true)
    assert_eq(vio_neg, true)
}

// La plata siempre es un entero POSITIVO (elegimos capitales y tasas que dividen
// exacto), y el descuento nunca deja negativo. Cubre 60 idx deterministas.
@test fn gen_finanzas_respuestas_enteras_positivas() {
    for i in 0..60 {
        let e = gen_finanzas(1717, i, 11)
        assert_eq(e.answer > 0, true)
    }
}

// Chequeo exacto del interés simple: I = C·i·t/100 sin resto. Re-derivamos con
// los mismos operandos que muestra el prompt (a=capital, b=tasa, a2=años).
@test fn gen_finanzas_simple_formula_exacta() {
    for i in 0..60 {
        let e = gen_finanzas(2626, i, 11)
        if (e.op == "finsimple") {
            assert_eq(e.answer, e.a * e.b * e.a2 / 100)
            assert_eq(e.a * e.b * e.a2 - e.answer * 100 >= 0, true)  // sin resto: divide exacto
        }
    }
}

// El porcentaje: P% de base = base·P/100, exacto.
@test fn gen_finanzas_porcentaje_formula_exacta() {
    for i in 0..60 {
        let e = gen_finanzas(3737, i, 11)
        if (e.op == "finpct") {
            assert_eq(e.answer, e.a * e.b / 100)
        }
    }
}

// --- F8: niveles y progresión graduada --------------------------------------

// La rampa: arranca en el piso, sube un nivel cada 3 idx, y no pasa el techo.
@test fn nivel_por_idx_arranca_en_piso_y_sube() {
    assert_eq(nivel_por_idx(2, 5, 0), 2)     // idx 0 → piso
    assert_eq(nivel_por_idx(2, 5, 2), 2)     // sigue en el piso
    assert_eq(nivel_por_idx(2, 5, 3), 3)     // +1 al tercer ejercicio
    assert_eq(nivel_por_idx(2, 5, 6), 4)
    assert_eq(nivel_por_idx(2, 5, 9), 5)     // llega al techo
    assert_eq(nivel_por_idx(2, 5, 30), 5)    // no lo pasa (clamp)
    assert_eq(nivel_por_idx(1, 2, 30), 2)    // techo bajo: capado en 2
}

// Cota por grado: un 1° secundaria (grade 8) NUNCA ve cuadráticas ni sistemas
// (techo 2) — sólo ecuaciones lineales, por más que suba el idx.
@test fn gen_ecuacion_grado_bajo_capado_en_lineal() {
    for i in 0..40 {
        let e = gen_ecuacion(2024, i, 8)
        assert_eq(e.op, "eclin")
    }
}

// Cota por grado: un 6° secundaria (grade 13) ARRANCA en cuadrática (piso 3), se
// saltea las lineales triviales de los primeros niveles.
@test fn gen_ecuacion_grado_alto_arranca_complejo() {
    let e = gen_ecuacion(2024, 0, 13)
    assert_eq(e.op, "eccuad")               // nivel 3 desde el idx 0
    assert_eq(e.difficulty, 3)
}

// La dificultad del Exercise = nivel: sube con el idx dentro de la ronda.
@test fn gen_ecuacion_difficulty_sube_con_idx() {
    let e0 = gen_ecuacion(77, 0, 11)        // nivel 2
    let e9 = gen_ecuacion(77, 9, 11)        // nivel 5 (techo)
    assert_eq(e0.difficulty, 2)
    assert_eq(e9.difficulty, 5)
    assert_eq(e9.difficulty > e0.difficulty, true)
}

// --- F8 Fase C: arranque adaptativo por rating de mastery -------------------

// El grado efectivo con `grado_efectivo`: a ciegas (800) juega a su grado real;
// con rating alto sube (delta = round((rating-800)/200), clamp ±3, banda 8..13).
@test fn fase_c_grado_efectivo_por_rating() {
    assert_eq(grado_efectivo(8, 800.0), 8)      // a ciegas → grado real
    assert_eq(grado_efectivo(8, 1000.0), 9)     // +1
    assert_eq(grado_efectivo(8, 1200.0), 10)    // +2
    assert_eq(grado_efectivo(13, 1600.0), 13)   // clamp a la banda secundaria (13 máx)
    assert_eq(grado_efectivo(10, 400.0), 8)     // struggling → baja (piso de banda 8)
}

// El nudge sube el piso Y el techo del juego → un chico que domina las lineales
// (rating alto) arranca en cuadrática y puede llegar a sistemas, aunque sea 1° sec.
@test fn fase_c_rating_alto_sube_la_ventana_de_nivel() {
    let eff_base = grado_efectivo(8, 800.0)     // 8
    let eff_alto = grado_efectivo(8, 1200.0)    // 10
    assert_eq(nivel_piso_ecuacion(eff_alto) > nivel_piso_ecuacion(eff_base), true)   // 2 > 1
    assert_eq(nivel_techo_ecuacion(eff_alto) > nivel_techo_ecuacion(eff_base), true) // 4 > 2
}
