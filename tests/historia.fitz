// tests/historia.fitz — el generador de "Historia" (gen_historia.fitz).
//
// (Nombre distinto del módulo importado → sin ciclo, FITZ-21.)
//
// Invariantes: reproducibilidad, la respuesta coincide con la operación del cuento,
// 4 opciones distintas con la correcta adentro (todas ≥ 0), y el nivel por grado.

from gen_historia import gen_historia, HistItem

fn contiene(xs: List<Int>, n: Int) -> Bool {
    for x in xs {
        if (x == n) {
            return true
        }
    }
    return false
}

@test fn historia_reproducible() {
    let idx = 0
    while (idx < 60) {
        let a = gen_historia(4242, idx, 4)
        let b = gen_historia(4242, idx, 4)
        assert_eq(a.answer, b.answer)
        assert_eq(a.kind, b.kind)
        assert_eq(a.nombre, b.nombre)
        idx = idx + 1
    }
}

@test fn historia_formula_y_opciones() {
    let grades = [1, 2, 4, 6, 13]
    for gr in grades {
        let idx = 0
        while (idx < 25) {
            let it = gen_historia(88, idx, gr)
            let esperado = 0
            if (it.kind == "suma") {
                esperado = it.a + it.b
            }
            if (it.kind == "resta") {
                esperado = it.a - it.b
            }
            if (it.kind == "comparar") {
                esperado = it.a - it.b
            }
            if (it.kind == "mult") {
                esperado = it.a * it.b
            }
            if (it.kind == "reparto") {
                assert_eq(it.a % it.b, 0)          // división exacta
                esperado = it.a / it.b
            }
            assert_eq(it.answer, esperado)
            assert(it.answer >= 0)
            assert_eq(it.options.len(), 4)
            assert(contiene(it.options, it.answer))
            // opciones distintas y ≥ 0
            let vistas: List<Int> = []
            for o in it.options {
                assert(o >= 0)
                assert(not contiene(vistas, o))
                vistas.push(o)
            }
            idx = idx + 1
        }
    }
}

@test fn historia_grado1_suma() {
    let it = gen_historia(7, 0, 1)
    assert_eq(it.kind, "suma")
    assert_eq(it.difficulty, 1)
}

@test fn historia_rampa_por_grado() {
    let bajo = gen_historia(9, 0, 1)
    assert_eq(bajo.difficulty, 1)
    let alto = gen_historia(9, 30, 13)
    assert_eq(alto.difficulty, 7)      // 6º sec llega a reparto (nivel 7)
}
