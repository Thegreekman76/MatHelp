// tests/series.fitz — el generador de "Series" (gen_series.fitz).
//
// (Nombre distinto del módulo importado → sin ciclo, FITZ-21.)
//
// Invariantes: reproducibilidad (el server re-deriva el mismo item), el 5º término
// nunca es negativo (teclado sin ±), siempre 4 términos mostrados, y —lo más
// fuerte— en grado 1 (progresión aritmética) la respuesta CONTINÚA la secuencia
// (diferencia constante).

from gen_series import gen_series, SerieItem

// Parsea el i-ésimo término del `shown` ("t1, t2, t3, t4").
fn nth(shown: Str, i: Int) -> Int {
    let parts = shown.split(", ")
    return match parts[i].to_int() {
        Ok(n) => n,
        Err(_) => -999999,
    }
}

@test fn series_reproducible() {
    let idx = 0
    while (idx < 60) {
        let a = gen_series(4242, idx, 7)
        let b = gen_series(4242, idx, 7)
        assert_eq(a.answer, b.answer)
        assert_eq(a.shown, b.shown)
        idx = idx + 1
    }
}

@test fn series_answer_no_negativa() {
    let grades = [1, 3, 5, 8, 11, 13]
    for gr in grades {
        let idx = 0
        while (idx < 30) {
            let it = gen_series(777, idx, gr)
            assert(it.answer >= 0)
            assert(it.difficulty >= 1)
            assert(it.difficulty <= 5)
            idx = idx + 1
        }
    }
}

@test fn series_muestra_cuatro_terminos() {
    let idx = 0
    while (idx < 40) {
        let it = gen_series(31, idx, 9)
        let parts = it.shown.split(", ")
        assert_eq(parts.len(), 4)
        idx = idx + 1
    }
}

@test fn series_grado1_es_aritmetica() {
    // Grado 1 → nivel 1 siempre: la diferencia entre términos es constante y el
    // 5º término (answer) la continúa.
    let idx = 0
    while (idx < 40) {
        let it = gen_series(9090, idx, 1)
        assert_eq(it.difficulty, 1)
        let t1 = nth(it.shown, 0)
        let t2 = nth(it.shown, 1)
        let t3 = nth(it.shown, 2)
        let t4 = nth(it.shown, 3)
        let d = t2 - t1
        assert_eq(t3 - t2, d)
        assert_eq(t4 - t3, d)
        assert_eq(it.answer - t4, d)
        idx = idx + 1
    }
}

@test fn series_rampa_por_grado() {
    // Grado bajo se queda en nivel 1; grado alto en idx avanzado alcanza 5.
    let bajo = gen_series(5, 0, 1)
    assert_eq(bajo.difficulty, 1)
    let alto = gen_series(5, 30, 13)
    assert_eq(alto.difficulty, 5)
}
