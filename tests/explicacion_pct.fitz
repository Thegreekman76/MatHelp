// tests/explicacion_pct.fitz — cómo se calcula cada porcentaje (feedback al errar).
// Números < 1000 para no arrastrar el separador de miles del locale.

from pct_view import explicar_pct
from gen_pct import PctItem

@test fn expl_pct_simple() {
    let it = PctItem { kind: "simple", n: 200, p: 25, answer: 50 }
    assert_eq(explicar_pct("es-AR", it), "200 × 25 ÷ 100 = 50")
}

@test fn expl_pct_descuento() {
    let it = PctItem { kind: "descuento", n: 500, p: 20, answer: 400 }
    assert_eq(explicar_pct("es-AR", it), "500 × 20 ÷ 100 = 100 → 500 − 100 = 400")
}

@test fn expl_pct_iva() {
    let it = PctItem { kind: "iva", n: 500, answer: 605 }
    assert_eq(explicar_pct("es-AR", it), "500 × 21 ÷ 100 = 105 → 500 + 105 = 605")
}

@test fn expl_pct_recargo() {
    let it = PctItem { kind: "recargo", n: 400, p: 10, answer: 440 }
    assert_eq(explicar_pct("es-AR", it), "400 × 10 ÷ 100 = 40 → 400 + 40 = 440")
}

@test fn expl_pct_sucesivos() {
    let it = PctItem { kind: "sucesivos", n: 800, p: 25, p2: 50, answer: 300 }
    assert_eq(explicar_pct("es-AR", it), "800 − 25% = 600 → 600 − 50% = 300")
}
