// tests/generators.fitz — los generadores de gen_arith.fitz.
//
// Cubre lo que un juego de matemática no puede permitirse equivocar:
//   - REPRODUCIBILIDAD: el mismo (seed, idx, grade) da SIEMPRE el mismo
//     ejercicio (es lo que deja "rejugar" una partida desde dos enteros).
//   - CORRECTITUD: answer == a op b para las cuatro operaciones; la división
//     es exacta; la resta nunca da negativo.
//   - OPCIONES: 4 valores, distintos, uno es la respuesta, todos >= 0.
//   - RANGOS por grado.
//   - DISTRIBUCIÓN: sobre muchas partidas aparecen las cuatro operaciones y los
//     operandos varían (no degenera en el mismo ejercicio).
//
// Corré con:  fitz test

from gen_arith import gen, gen_mix, gen_for, gen_adaptive, gen_escalera, grado_efectivo, op_mas_floja, grade_for_band, temas_practica, tema_valido, op_symbol, ops_for_grade, add_max, mul_max, vf_shown, Exercise

// --- helpers ----------------------------------------------------------------

fn contains(xs: List<Int>, target: Int) -> Bool {
    for x in xs {
        if (x == target) {
            return true
        }
    }
    return false
}

fn distinct(xs: List<Int>) -> Bool {
    let n = xs.len()
    let i = 0
    while (i < n) {
        let j = i + 1
        while (j < n) {
            if (xs[i] == xs[j]) {
                return false
            }
            j = j + 1
        }
        i = i + 1
    }
    return true
}

// answer == a op b, según la operación. Para división chequea exactitud.
fn respuesta_correcta(ex: Exercise) -> Bool {
    if (ex.op == "add") {
        return ex.answer == ex.a + ex.b
    }
    if (ex.op == "sub") {
        return ex.answer == ex.a - ex.b
    }
    if (ex.op == "mul") {
        return ex.answer == ex.a * ex.b
    }
    if (ex.op == "div") {
        return ex.b != 0 and ex.a % ex.b == 0 and ex.answer == ex.a / ex.b
    }
    return false
}

// Corre un chequeo de invariantes sobre un ejercicio: correcto, 4 opciones
// distintas, la respuesta está entre ellas, todas >= 0.
fn ejercicio_valido(ex: Exercise) -> Bool {
    if (not respuesta_correcta(ex)) {
        return false
    }
    if (ex.options.len() != 4) {
        return false
    }
    if (not distinct(ex.options)) {
        return false
    }
    if (not contains(ex.options, ex.answer)) {
        return false
    }
    for o in ex.options {
        if (o < 0) {
            return false
        }
    }
    return true
}

// --- reproducibilidad --------------------------------------------------------

@test fn mismo_seed_e_idx_da_el_mismo_ejercicio() {
    let a = gen_mix(777, 0, 4)
    let b = gen_mix(777, 0, 4)
    assert_eq(a.a, b.a)
    assert_eq(a.b, b.b)
    assert_eq(a.op, b.op)
    assert_eq(a.answer, b.answer)
    assert_eq(a.options, b.options)   // igualdad estructural de la lista
}

@test fn idx_distinto_da_ejercicio_distinto() {
    // No es garantía absoluta (podrían coincidir por azar), pero sobre estos
    // dos índices concretos el generador difiere.
    let a = gen_mix(777, 0, 4)
    let b = gen_mix(777, 1, 4)
    let iguales = a.a == b.a and a.b == b.b and a.op == b.op
    assert_eq(iguales, false)
}

@test fn seed_distinto_da_ejercicio_distinto() {
    let a = gen_mix(100, 0, 4)
    let b = gen_mix(200, 0, 4)
    let iguales = a.a == b.a and a.b == b.b and a.op == b.op and a.answer == b.answer
    assert_eq(iguales, false)
}

// --- correctitud sobre un lote ----------------------------------------------

@test fn ejercicios_mixtos_siempre_validos() {
    // 300 ejercicios sobre grado 4: todos deben ser válidos.
    let idx = 0
    while (idx < 300) {
        let ex = gen_mix(12345, idx, 4)
        assert_eq(ejercicio_valido(ex), true)
        idx = idx + 1
    }
}

@test fn cada_operacion_es_valida() {
    // Cada operación por separado, sobre varios seeds.
    let ops = ["add", "sub", "mul", "div"]
    for op in ops {
        let idx = 0
        while (idx < 60) {
            let ex = gen(op, 999, idx, 5)
            assert_eq(ex.op, op)
            assert_eq(ejercicio_valido(ex), true)
            idx = idx + 1
        }
    }
}

@test fn resta_nunca_negativa() {
    let idx = 0
    while (idx < 200) {
        let ex = gen("sub", 42, idx, 4)
        assert_eq(ex.a >= ex.b, true)
        assert_eq(ex.answer >= 0, true)
        idx = idx + 1
    }
}

@test fn division_siempre_exacta() {
    let idx = 0
    while (idx < 200) {
        let ex = gen("div", 7, idx, 6)
        assert_ne(ex.b, 0)
        assert_eq(ex.a % ex.b, 0)
        assert_eq(ex.a / ex.b, ex.answer)
        idx = idx + 1
    }
}

// --- rangos por grado --------------------------------------------------------

@test fn suma_respeta_el_rango_del_grado() {
    let hi = add_max(3)          // 100
    let idx = 0
    while (idx < 200) {
        let ex = gen("add", 555, idx, 3)
        assert_eq(ex.a >= 1 and ex.a <= hi, true)
        assert_eq(ex.b >= 1 and ex.b <= hi, true)
        idx = idx + 1
    }
}

@test fn multiplicacion_respeta_las_tablas_del_grado() {
    let hi = mul_max(4)          // 12
    let idx = 0
    while (idx < 200) {
        let ex = gen("mul", 321, idx, 4)
        assert_eq(ex.a >= 2 and ex.a <= hi, true)
        assert_eq(ex.b >= 2 and ex.b <= hi, true)
        idx = idx + 1
    }
}

// --- gating de operaciones por grado ----------------------------------------

@test fn primer_grado_solo_suma_y_resta() {
    assert_eq(ops_for_grade(1).len(), 2)
    let idx = 0
    while (idx < 100) {
        let ex = gen_mix(88, idx, 1)
        let es_suma_o_resta = ex.op == "add" or ex.op == "sub"
        assert_eq(es_suma_o_resta, true)
        idx = idx + 1
    }
}

@test fn tercer_grado_habilita_las_cuatro() {
    assert_eq(ops_for_grade(3).len(), 4)
}

// --- distribución ------------------------------------------------------------

// Sobre 400 ejercicios mixtos de grado 4 deben aparecer las CUATRO operaciones.
// Si el generador degenerara (siempre la misma op), esto lo cazaría.
@test fn las_cuatro_operaciones_aparecen() {
    let n_add = 0
    let n_sub = 0
    let n_mul = 0
    let n_div = 0
    let idx = 0
    while (idx < 400) {
        let ex = gen_mix(2026, idx, 4)
        if (ex.op == "add") {
            n_add = n_add + 1
        }
        if (ex.op == "sub") {
            n_sub = n_sub + 1
        }
        if (ex.op == "mul") {
            n_mul = n_mul + 1
        }
        if (ex.op == "div") {
            n_div = n_div + 1
        }
        idx = idx + 1
    }
    assert_eq(n_add > 0, true)
    assert_eq(n_sub > 0, true)
    assert_eq(n_mul > 0, true)
    assert_eq(n_div > 0, true)
    // Y ninguna acapara TODO (reparto razonable de 4 ops en 400 tiradas).
    assert_eq(n_add < 250, true)
    assert_eq(n_div < 250, true)
}

// Los operandos varían: sobre 100 ejercicios de suma hay al menos 10 valores
// distintos de `a` (no se queda pegado en un número).
@test fn los_operandos_varian() {
    let vistos: List<Int> = []
    let idx = 0
    while (idx < 100) {
        let ex = gen("add", 4321, idx, 5)
        if (not contains(vistos, ex.a)) {
            vistos.push(ex.a)
        }
        idx = idx + 1
    }
    assert_eq(vistos.len() >= 10, true)
}

// --- práctica libre (F3): banda de dificultad + tema fijo -------------------

fn contains_str(xs: List<Str>, target: Str) -> Bool {
    for x in xs {
        if (x == target) {
            return true
        }
    }
    return false
}

// La banda 2 (medio) es el grado del perfil; 1 baja un grado, 3 sube uno.
@test fn banda_media_es_el_grado() {
    assert_eq(grade_for_band(4, 2), 4)
    assert_eq(grade_for_band(4, 1), 3)
    assert_eq(grade_for_band(4, 3), 5)
}

// La banda clampea a 1..7 (no se sale del currículum de primaria).
@test fn banda_clampea_a_primaria() {
    assert_eq(grade_for_band(1, 1), 1)     // 1º fácil no baja de 1º
    assert_eq(grade_for_band(7, 3), 7)     // 7º difícil no sube de 7º
}

// El contrarreloj (modo != "practice") es idéntico bit-a-bit a gen_mix: la
// paridad del juego existente no se toca al sumar práctica.
@test fn gen_for_timed_es_gen_mix() {
    let idx = 0
    while (idx < 100) {
        let a = gen_for("timed", "mix", 2, 555, idx, 4, 800.0, 800.0, 800.0, 800.0)
        let b = gen_mix(555, idx, 4)
        assert_eq(a.a, b.a)
        assert_eq(a.b, b.b)
        assert_eq(a.op, b.op)
        assert_eq(a.answer, b.answer)
        assert_eq(a.options, b.options)
        idx = idx + 1
    }
}

// Práctica con tema "mix" y banda media == gen_mix al grado (identidad).
@test fn practica_mix_banda_media_es_gen_mix() {
    let a = gen_for("practice", "mix", 2, 909, 3, 5, 800.0, 800.0, 800.0, 800.0)
    let b = gen_mix(909, 3, 5)
    assert_eq(a.op, b.op)
    assert_eq(a.answer, b.answer)
    assert_eq(a.options, b.options)
}

// Práctica con tema fijo: siempre esa operación, ejercicio válido, reproducible.
@test fn practica_tema_fijo_es_valido_y_reproducible() {
    let temas = ["add", "sub", "mul", "div"]
    for op in temas {
        let idx = 0
        while (idx < 60) {
            let ex = gen_for("practice", op, 2, 4242, idx, 5, 800.0, 800.0, 800.0, 800.0)
            assert_eq(ex.op, op)
            assert_eq(ejercicio_valido(ex), true)
            // Reproducible: mismo (topic, band, seed, idx, grade) ⇒ mismo ej.
            let ex2 = gen_for("practice", op, 2, 4242, idx, 5, 800.0, 800.0, 800.0, 800.0)
            assert_eq(ex.a, ex2.a)
            assert_eq(ex.b, ex2.b)
            assert_eq(ex.answer, ex2.answer)
            idx = idx + 1
        }
    }
}

// Práctica válida sobre las tres bandas (fácil/medio/difícil no rompen nada).
@test fn practica_todas_las_bandas_validas() {
    let bandas = [1, 2, 3]
    for band in bandas {
        let idx = 0
        while (idx < 40) {
            let ex = gen_for("practice", "mul", band, 77, idx, 4, 800.0, 800.0, 800.0, 800.0)
            assert_eq(ex.op, "mul")
            assert_eq(ejercicio_valido(ex), true)
            idx = idx + 1
        }
    }
}

// Temas de práctica: las operaciones del grado + "mix". 1º = suma/resta/mix.
@test fn temas_de_practica_por_grado() {
    let t1 = temas_practica(1)
    assert_eq(t1.len(), 3)                 // add, sub, mix
    assert_eq(contains_str(t1, "mix"), true)
    assert_eq(contains_str(t1, "div"), false)
    let t3 = temas_practica(3)
    assert_eq(t3.len(), 5)                 // add, sub, mul, div, mix
    assert_eq(contains_str(t3, "div"), true)
    assert_eq(contains_str(t3, "mix"), true)
}

// Guarda de tema por grado: "mix" siempre; "div" recién desde 3º.
@test fn tema_valido_por_grado() {
    assert_eq(tema_valido("mix", 1), true)
    assert_eq(tema_valido("div", 1), false)
    assert_eq(tema_valido("div", 3), true)
    assert_eq(tema_valido("mul", 2), true)
    assert_eq(tema_valido("mul", 1), false)
}

// --- selección adaptativa (F3, §7) ------------------------------------------

// El grado efectivo del generador sigue al rating: 800 = grado del perfil, y
// corre ±1 cada 200 puntos. Es el mecanismo que hace que "la dificultad siga".
@test fn grado_efectivo_sigue_al_rating() {
    assert_eq(grado_efectivo(4, 800.0), 4)     // rating inicial → grado del perfil
    assert_eq(grado_efectivo(4, 1000.0), 5)    // +1
    assert_eq(grado_efectivo(4, 1200.0), 6)    // +2
    assert_eq(grado_efectivo(4, 600.0), 3)     // −1
}

@test fn grado_efectivo_clampea_a_primaria() {
    assert_eq(grado_efectivo(1, 200.0), 1)     // no baja de 1º
    assert_eq(grado_efectivo(7, 2000.0), 7)    // no sube de 7º
    assert_eq(grado_efectivo(4, 5000.0), 7)    // corrimiento clampeado a +3 → 7º
}

// El repaso (20%) elige la operación más floja: la de menor rating.
@test fn op_mas_floja_es_la_de_menor_rating() {
    let ops = ops_for_grade(4)                  // [add, sub, mul, div]
    assert_eq(op_mas_floja(ops, 1000.0, 1000.0, 600.0, 1000.0), "mul")
    assert_eq(op_mas_floja(ops, 500.0, 1000.0, 1000.0, 1000.0), "add")
}

// La selección adaptativa produce siempre ejercicios válidos (sobre un lote,
// con todas las ops de 4º y el 70/20/10 activo).
@test fn gen_adaptive_siempre_valido() {
    let idx = 0
    while (idx < 200) {
        let ex = gen_adaptive(9090, idx, 4, 800.0, 800.0, 800.0, 800.0)
        assert_eq(ejercicio_valido(ex), true)
        idx = idx + 1
    }
}

// Reproducible: mismo (seed, idx, snapshot) ⇒ mismo ejercicio (lo que hace que
// render, scoring y persistencia coincidan bit-a-bit).
@test fn gen_adaptive_es_reproducible() {
    let a = gen_adaptive(555, 7, 4, 1100.0, 900.0, 1300.0, 800.0)
    let b = gen_adaptive(555, 7, 4, 1100.0, 900.0, 1300.0, 800.0)
    assert_eq(a.op, b.op)
    assert_eq(a.a, b.a)
    assert_eq(a.b, b.b)
    assert_eq(a.answer, b.answer)
    assert_eq(a.options, b.options)
}

// La dificultad SIGUE al rating: con ratings altos los operandos son, en el
// máximo de un lote, más grandes que con ratings bajos (mismos seeds). El
// generador escala el grado efectivo con el rating.
@test fn gen_adaptive_ratings_altos_dan_numeros_mas_grandes() {
    let max_bajo = 0
    let max_alto = 0
    let idx = 0
    while (idx < 200) {
        let bajo = gen_adaptive(313, idx, 4, 600.0, 600.0, 600.0, 600.0)
        let alto = gen_adaptive(313, idx, 4, 1400.0, 1400.0, 1400.0, 1400.0)
        if (bajo.a > max_bajo) {
            max_bajo = bajo.a
        }
        if (alto.a > max_alto) {
            max_alto = alto.a
        }
        idx = idx + 1
    }
    assert_eq(max_alto > max_bajo, true)
}

// --- Verdadero o Falso (F4) --------------------------------------------------

// El valor mostrado es reproducible: mismo (ex, seed, idx) ⇒ mismo shown (lo que
// deja al server re-derivar exactamente la afirmación que vio el chico).
@test fn vf_shown_es_reproducible() {
    let idx = 0
    while (idx < 100) {
        let ex = gen_adaptive(4747, idx, 4, 800.0, 800.0, 800.0, 800.0)
        let s1 = vf_shown(ex, 4747, idx)
        let s2 = vf_shown(ex, 4747, idx)
        assert_eq(s1, s2)
        idx = idx + 1
    }
}

// El valor mostrado es SIEMPRE la respuesta o uno de sus distractores (nunca un
// número inventado fuera del conjunto de opciones del ejercicio).
@test fn vf_shown_es_answer_o_opcion() {
    let idx = 0
    while (idx < 200) {
        let ex = gen_adaptive(313, idx, 5, 900.0, 800.0, 1000.0, 700.0)
        let shown = vf_shown(ex, 313, idx)
        assert_eq(contains(ex.options, shown), true)
        idx = idx + 1
    }
}

// Sobre un lote aparecen AMBAS: afirmaciones verdaderas (shown == answer) y
// falsas (shown != answer). Si degenerara a "siempre verdad" o "siempre falso"
// el juego sería trivial — esto lo caza.
@test fn vf_mezcla_verdaderas_y_falsas() {
    let verdaderas = 0
    let falsas = 0
    let idx = 0
    while (idx < 300) {
        let ex = gen_adaptive(2026, idx, 4, 800.0, 800.0, 800.0, 800.0)
        let shown = vf_shown(ex, 2026, idx)
        if (shown == ex.answer) {
            verdaderas = verdaderas + 1
        }
        if (shown != ex.answer) {
            falsas = falsas + 1
        }
        idx = idx + 1
    }
    // Reparto razonable de un 50/50 sobre 300 tiradas (ni degenera ni se sesga).
    assert_eq(verdaderas > 80, true)
    assert_eq(falsas > 80, true)
}

// --- Escalera de tablas (F4) -------------------------------------------------

// Siempre multiplicación, válido y reproducible.
@test fn escalera_siempre_multiplicacion_valida() {
    let idx = 0
    while (idx < 150) {
        let ex = gen_escalera(7373, idx, 4, 800.0)
        assert_eq(ex.op, "mul")
        assert_eq(ejercicio_valido(ex), true)
        let ex2 = gen_escalera(7373, idx, 4, 800.0)
        assert_eq(ex.a, ex2.a)
        assert_eq(ex.b, ex2.b)
        assert_eq(ex.answer, ex2.answer)
        idx = idx + 1
    }
}

// La escalera sube de tablas: con rating alto los factores llegan, en el máximo
// de un lote, más grandes que con rating bajo (mismos seeds).
@test fn escalera_rating_alto_tablas_mas_grandes() {
    let max_bajo = 0
    let max_alto = 0
    let idx = 0
    while (idx < 200) {
        let bajo = gen_escalera(414, idx, 3, 600.0)
        let alto = gen_escalera(414, idx, 3, 1400.0)
        if (bajo.a > max_bajo) {
            max_bajo = bajo.a
        }
        if (alto.a > max_alto) {
            max_alto = alto.a
        }
        idx = idx + 1
    }
    assert_eq(max_alto > max_bajo, true)
}

// --- símbolos ----------------------------------------------------------------

@test fn simbolos_de_operacion() {
    assert_eq(op_symbol("add"), "+")
    assert_eq(op_symbol("sub"), "−")
    assert_eq(op_symbol("mul"), "×")
    assert_eq(op_symbol("div"), "÷")
}
