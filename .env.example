# MatHelp — copiá esto a .env y ajustá lo que haga falta.
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

# --- Postgres -----------------------------------------------------------
POSTGRES_USER=mathelp
POSTGRES_PASSWORD=mathelp
POSTGRES_DB=mathelp

# --- Aplicación ---------------------------------------------------------
# En produccion cambiala SI O SI por algo largo y aleatorio.
JWT_SECRET=mathelp-dev-cambiame-en-produccion

# Locale por defecto cuando el visitante todavia no eligio idioma.
MATHELP_DEFAULT_LOCALE=es-AR

# Puerto del host. Si lo cambias, cambia tambien la URL en start.bat.
MATHELP_PORT=3000

# --- Reporte semanal por email (opcional, APAGADO por default) -----------
# Cada lunes 9:00 UTC manda a cada familia un resumen de la semana por hijo.
# Poné MATHELP_WEEKLY_REPORT=1 y configurá el SMTP para activarlo.
MATHELP_WEEKLY_REPORT=0
# URL publica de la app (para el boton "Ver el panel" del email).
MATHELP_PUBLIC_URL=https://mathelp.example
# SMTP (lo lee el core del lenguaje al hacer smtp.send). TLS: starttls|implicit|none.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MatHelp <no-reply@mathelp.example>
SMTP_TLS=starttls
